<?xml version="1.0" encoding="utf-8"?>
<!--
  Transformación del perfil de publicación MAT.DEV (sitio IIS local en C:\inetpub\MAT).
  Visual Studio la aplica DESPUÉS de Web.Release.config, solo al publicar con este perfil.

  Por qué: Web.Release.config reemplaza las cadenas de conexión por las de MATSERVER (producción). En la PC de
  desarrollo ese servidor no existe en la red y el sitio no arrancaba después de cada publicación
  ("The network path was not found" en _AppStart.cshtml).

  Qué hace: el Web.config publicado lee las cadenas de connectionStrings.local.config, un archivo que vive solo
  en C:\inetpub\MAT (no está en git, no tiene contraseñas en el repo y la publicación no lo pisa porque el perfil
  usa DeleteExistingFiles=False). Para cambiar de base en la PC local, se edita ese archivo.
  Los otros perfiles (servidor real) no cambian: siguen con las cadenas de Web.Release.config.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings configSource="connectionStrings.local.config" xdt:Transform="Replace" />
  <!-- El sitio local es de desarrollo aunque se publique en Release: se vuelve a SystemDEV=true para ver el
       detalle de los errores (Web.Release.config lo pone en false para producción). -->
  <appSettings>
    <add key="SystemDEV" value="true" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>