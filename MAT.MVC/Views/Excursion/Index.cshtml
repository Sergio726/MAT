@model IEnumerable<MAT.Entities.Excursion>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-geo-alt"></i>
            <span>Excursiones</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/Excursion/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Excursión</span>
            </a>
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tablaExcursiones">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Costo</th>
                    <th>Observaciones</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Descripcion</strong>
                        </td>
                        <td>
                            @if (item.Costo.HasValue)
                            {
                                <span class="badge-precio badge-precio-pesos">$@item.Costo.Value.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Observaciones))
                            {
                                <span title="@item.Observaciones">@(item.Observaciones.Length > 50 ? item.Observaciones.Substring(0, 50) + "..." : item.Observaciones)</span>
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/Excursion/Edit/@item.ExcursionId" class="btn-action btn-action-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="#" class="btn-action btn-action-delete btn-eliminar-excursion" data-id="@item.ExcursionId" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            $('#tablaExcursiones').DataTable({
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ excursiones",
                    infoEmpty: "No hay excursiones disponibles",
                    infoFiltered: "(filtrado de _MAX_ excursiones totales)",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                order: [[0, "asc"]],
                pageLength: 25,
                columnDefs: [
                    { orderable: false, targets: 3 }
                ]
            });

            $('#tablaExcursiones').on('click', '.btn-eliminar-excursion', function (e) {
                e.preventDefault();
                var excursionId = $(this).data('id');
                if (confirm('¿Está seguro que desea eliminar esta excursión?')) {
                    // Aquí puedes agregar la lógica para eliminar la excursión
                }
            });
        });
    </script>
}