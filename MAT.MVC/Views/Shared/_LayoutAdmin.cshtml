@using System.Web.Security
<!DOCTYPE html>
<html>
<head>
    <title>MAT Admin</title>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    @Scripts.Render("~/bundles/modernizr")

    <!-- CSS (nuevo) -->
    <link href="~/Content/bootstrap-5.3.2.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/themes/base/jquery-ui-1.13.2.css" rel="stylesheet" />
    <link href="~/Scripts/jquery.timepicker/jquery.timepicker.css" rel="stylesheet" />
    <link href="~/Scripts/dataTable/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/mat.styles.custom.css" rel="stylesheet" />
    <link href="~/Content/admin.modern.css?v=20260330b" rel="stylesheet" />

    <!-- JS (nuevo) -->
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    @* Migrate siempre hace console.log al cargar; filtramos solo durante su carga. *@
    <script>
        (function () {
            var origLog = console.log.bind(console);
            console.log = function () {
                var a = arguments[0];
                if (typeof a === 'string' && a.indexOf('JQMIGRATE:') === 0) return;
                return origLog.apply(console, arguments);
            };
            window.__matRestoreConsoleLog = function () { console.log = origLog; };
        })();
    </script>
    <script src="~/Scripts/jquery-migrate-3.4.1.min.js"></script>
    <script>window.__matRestoreConsoleLog(); delete window.__matRestoreConsoleLog;</script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.13.2.min.js"></script>
    <script src="~/Scripts/bootstrap-5.3.2.bundle.min.js"></script>

    <script src="~/Scripts/javascript.core.js"></script>
    <script src="~/Scripts/mat.jquery.binding.js"></script>
    <script src="~/Scripts/mat.jquery.functions.js"></script>
    <script src="~/Scripts/mat.jquery.initialize.js"></script>
    <script src="~/Scripts/jquery.quick.pagination.min.js"></script>
    <script src="~/Scripts/global.js"></script>
    <script src="~/Scripts/mat.jquery.hashtable.js"></script>
    <script src="~/Scripts/jquery.mask.js"></script>
    <script src="~/Scripts/common.js"></script>
    <script src="~/Scripts/jquery.timepicker/jquery.timepicker.min.js"></script>
    <script src="~/Scripts/dataTable/jquery.dataTables.min.js"></script>
</head>
<body class="admin-modern">
    <section id="script_section">
        @RenderSection("Scripts", required: false)
    </section>

    @{
        var userName = (User != null && User.Identity != null) ? (User.Identity.Name ?? "") : "";
        var isAdminDev = !string.IsNullOrWhiteSpace(userName) && userName.ToUpper().Equals("ADMINDEV");
    }

    <div class="admin-shell">
        <!-- Toolbar nueva -->
        <nav class="navbar admin-topbar navbar-dark">
            <div class="container-fluid">
                <button class="btn btn-outline-light d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#adminOffcanvas" aria-controls="adminOffcanvas" aria-label="Abrir menú">
                    <i class="bi bi-list"></i>
                </button>

                <a class="navbar-brand d-flex align-items-center gap-2" href="/Admin/Index">
                    <i class="bi bi-shield-lock"></i>
                    <span>Administración</span>
                </a>

                <div class="d-flex align-items-center gap-2">
                    <a class="btn btn-outline-light btn-sm" href="/Home/Index" title="Volver al sitio">
                        <i class="bi bi-house-door"></i>
                        <span class="d-none d-sm-inline">Inicio</span>
                    </a>

                    @if (Request.IsAuthenticated)
                    {
                        using (Html.BeginForm("LogOff", "Account", FormMethod.Post, new { id = "adminLogoutFormTopModern" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-light btn-sm" title="Cerrar sesión">
                                <i class="bi bi-box-arrow-right"></i>
                                <span class="d-none d-sm-inline">Cerrar sesión</span>
                            </button>
                        }
                    }
                </div>
            </div>
        </nav>

        <div class="admin-main">
            <!-- Sidebar nueva (desktop) -->
            <aside class="admin-sidebar d-none d-lg-flex flex-column p-3 gap-2">
                <div class="admin-userbox">
                    <div class="name">
                        <i class="bi bi-person-circle me-2"></i>
                        @(string.IsNullOrWhiteSpace(userName) ? "Usuario" : userName)
                    </div>
                    <div class="muted">Panel Admin</div>
                </div>

                <div class="nav-section-title">Reportes</div>
                <nav class="nav nav-pills flex-column gap-1" id="adminNavDesktop">
                    <a class="nav-link" href="/Admin/Index"><i class="bi bi-grid-1x2"></i> Panel</a>
                    <a class="nav-link" href="/Admin/ResumenPagos"><i class="bi bi-cash-stack"></i> Pagos por Viaje</a>
                    <a class="nav-link" href="/Admin/ResumenPagosPorFecha"><i class="bi bi-calendar-check"></i> Pagos por Fecha</a>
                    <a class="nav-link" href="/Admin/AuditoriaFacturas"><i class="bi bi-clipboard-check"></i> Auditoría</a>
                </nav>

                <div class="nav-section-title">Usuarios</div>
                <nav class="nav nav-pills flex-column gap-1">
                    <a class="nav-link" href="/Admin/Usuarios"><i class="bi bi-people"></i> Listado de usuarios</a>
                    <a class="nav-link" href="/Admin/RegistrarVendedor"><i class="bi bi-person-plus"></i> Registrar vendedor</a>
                    <a class="nav-link" href="/Admin/MiCuenta"><i class="bi bi-key"></i> Mi cuenta</a>
                </nav>

                <div class="nav-section-title">Planillas</div>
                <nav class="nav nav-pills flex-column gap-1">
                    <a class="nav-link" href="/Admin/PlanillaServicios"><i class="bi bi-wrench-adjustable"></i> Planilla Servicios</a>
                    <a class="nav-link" href="/Admin/PlanillasGeneradas"><i class="bi bi-printer"></i> Planillas Generadas</a>
                </nav>

                <div class="nav-section-title">Sistema</div>
                <nav class="nav nav-pills flex-column gap-1">
                    <a class="nav-link" href="/Admin/ErrorLog"><i class="bi bi-bug"></i> Error Log</a>
                    <a class="nav-link" href="/Admin/Logs"><i class="bi bi-terminal"></i> Log en memoria</a>
                </nav>

                @if (isAdminDev)
                {
                    <div class="nav-section-title">Dev</div>
                    <nav class="nav nav-pills flex-column gap-1">
                        <a class="nav-link" href="/Home/HistorialPagos"><i class="bi bi-clock-history"></i> Historial Pagos</a>
                    </nav>
                }

                <div class="mt-auto pt-2">
                    <small class="text-white-50">MAT Admin</small>
                </div>
            </aside>

            <!-- Offcanvas nueva (mobile) -->
            <div class="offcanvas offcanvas-start admin-offcanvas d-lg-none" tabindex="-1" id="adminOffcanvas" aria-labelledby="adminOffcanvasLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="adminOffcanvasLabel">
                        <i class="bi bi-shield-lock me-2"></i> Administración
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                </div>
                <div class="offcanvas-body">
                    <div class="admin-userbox mb-3">
                        <div class="name"><i class="bi bi-person-circle me-2"></i>@(string.IsNullOrWhiteSpace(userName) ? "Usuario" : userName)</div>
                        <div class="muted">Panel Admin</div>
                    </div>

                    <div class="nav-section-title">Reportes</div>
                    <nav class="nav nav-pills flex-column gap-1">
                        <a class="nav-link" href="/Admin/Index"><i class="bi bi-grid-1x2"></i> Panel</a>
                        <a class="nav-link" href="/Admin/ResumenPagos"><i class="bi bi-cash-stack"></i> Pagos por Viaje</a>
                        <a class="nav-link" href="/Admin/ResumenPagosPorFecha"><i class="bi bi-calendar-check"></i> Pagos por Fecha</a>
                        <a class="nav-link" href="/Admin/AuditoriaFacturas"><i class="bi bi-clipboard-check"></i> Auditoría</a>
                    </nav>

                    <div class="nav-section-title">Usuarios</div>
                    <nav class="nav nav-pills flex-column gap-1">
                        <a class="nav-link" href="/Admin/Usuarios"><i class="bi bi-people"></i> Listado de usuarios</a>
                        <a class="nav-link" href="/Admin/RegistrarVendedor"><i class="bi bi-person-plus"></i> Registrar vendedor</a>
                        <a class="nav-link" href="/Admin/MiCuenta"><i class="bi bi-key"></i> Mi cuenta</a>
                    </nav>

                    <div class="nav-section-title">Planillas</div>
                    <nav class="nav nav-pills flex-column gap-1">
                        <a class="nav-link" href="/Admin/PlanillaServicios"><i class="bi bi-wrench-adjustable"></i> Planilla Servicios</a>
                        <a class="nav-link" href="/Admin/PlanillasGeneradas"><i class="bi bi-printer"></i> Planillas Generadas</a>
                    </nav>

                    <div class="nav-section-title">Sistema</div>
                    <nav class="nav nav-pills flex-column gap-1">
                        <a class="nav-link" href="/Admin/ErrorLog"><i class="bi bi-bug"></i> Error Log</a>
                        <a class="nav-link" href="/Admin/Logs"><i class="bi bi-terminal"></i> Log en memoria</a>
                    </nav>

                    @if (isAdminDev)
                    {
                        <div class="nav-section-title">Dev</div>
                        <nav class="nav nav-pills flex-column gap-1">
                            <a class="nav-link" href="/Home/HistorialPagos"><i class="bi bi-clock-history"></i> Historial Pagos</a>
                        </nav>
                    }
                </div>
            </div>

            <!-- Content -->
            <main class="admin-content">
                <div class="admin-content-inner">
                    @Html.Partial("_Alerts")
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    <script>
        (function () {
            // Mark active link in sidebar based on current path
            var path = (window.location.pathname || "").toLowerCase();
            var links = document.querySelectorAll(".admin-sidebar .nav-link, .admin-offcanvas .nav-link");
            for (var i = 0; i < links.length; i++) {
                var href = (links[i].getAttribute("href") || "").toLowerCase();
                if (!href) continue;
                if (path === href || path.indexOf(href + "/") === 0) {
                    links[i].classList.add("active");
                }
            }
        })();
    </script>
</body>
</html>
