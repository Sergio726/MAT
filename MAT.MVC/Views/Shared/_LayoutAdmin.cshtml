@using MAT.MVC.Infrastructure
@using System.Web.Security
@using WebMatrix.WebData
<!DOCTYPE html>
<html>
<head>
    <title>MAT Admin</title>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />

    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/bootstrap-5.3.2.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/themes/base/jquery-ui-1.13.2.css" rel="stylesheet" />
    <link href="~/Scripts/jquery.timepicker/jquery.timepicker.css" rel="stylesheet" />
    <link href="~/Scripts/dataTable/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/mat.styles.custom.css" rel="stylesheet" />
    <link href="~/Content/admin.modern.css?v=20260620c" rel="stylesheet" />

    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script>
        (function () {
            var origLog = console.log.bind(console);
            console.log = function () {
                var a = arguments[0];
                if (typeof a === 'string' && a.indexOf('JQMIGRATE:') === 0) return;
                return origLog.apply(console, arguments);
            };
            window.__matRestoreConsoleLog = function () { console.log = origLog; };
        })();
    </script>
    <script src="~/Scripts/jquery-migrate-3.4.1.min.js"></script>
    <script>window.__matRestoreConsoleLog(); delete window.__matRestoreConsoleLog;</script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.13.2.min.js"></script>
    <script src="~/Scripts/bootstrap-5.3.2.bundle.min.js"></script>
    <script src="~/Scripts/mat.admin-utils.js"></script>

    <script src="~/Scripts/javascript.core.js"></script>
    <script src="~/Scripts/mat.jquery.binding.js"></script>
    <script src="~/Scripts/mat.jquery.functions.js"></script>
    <script src="~/Scripts/mat.jquery.initialize.js"></script>
    <script src="~/Scripts/jquery.quick.pagination.min.js"></script>
    <script src="~/Scripts/global.js"></script>
    <script src="~/Scripts/mat.jquery.hashtable.js"></script>
    <script src="~/Scripts/jquery.mask.js"></script>
    <script src="~/Scripts/common.js"></script>
    <script src="~/Scripts/jquery.timepicker/jquery.timepicker.min.js"></script>
    <script src="~/Scripts/dataTable/jquery.dataTables.min.js"></script>
</head>
<body class="admin-modern">
    @{
        var userName = (User != null && User.Identity != null) ? (User.Identity.Name ?? "") : "";
        var isAdminDev = !string.IsNullOrWhiteSpace(userName) && userName.ToUpper().Equals("ADMINDEV");
        var helpPath = (Request.Url != null ? Request.Url.AbsolutePath : "") ?? "";
        var onAdminIndex = helpPath.Equals("/Admin/Index", StringComparison.OrdinalIgnoreCase)
            || helpPath.Equals("/Admin", StringComparison.OrdinalIgnoreCase);
        var pageContext = AdminHelpCatalog.ResolvePage(helpPath, isAdminDev);

        var topbarModel = new AdminTopbarViewModel
        {
            UserName = userName,
            UserInitials = AdminHelpCatalog.GetUserInitials(userName),
            PageTitle = pageContext != null ? pageContext.Title : null,
            OnAdminIndex = onAdminIndex,
            IsAuthenticated = Request.IsAuthenticated
        };

        var navModel = new AdminNavViewModel
        {
            UserName = userName,
            UserInitials = AdminHelpCatalog.GetUserInitials(userName),
            IsAdminDev = isAdminDev,
            IsOffcanvas = false,
            Sections = AdminHelpCatalog.GetSidebarSections(isAdminDev)
        };

        var navOffcanvasModel = new AdminNavViewModel
        {
            UserName = userName,
            UserInitials = AdminHelpCatalog.GetUserInitials(userName),
            IsAdminDev = isAdminDev,
            IsOffcanvas = true,
            Sections = AdminHelpCatalog.GetSidebarSections(isAdminDev)
        };

        var adminUserId = 0;
        if (WebSecurity.Initialized && WebSecurity.HasUserId)
        {
            adminUserId = WebSecurity.CurrentUserId;
        }
    }

    <div class="admin-shell" data-admin-user-id="@adminUserId">
        @Html.Partial("_AdminTopbar", topbarModel)

        <div class="admin-main">
            <aside class="admin-sidebar d-none d-lg-flex flex-column p-3 gap-2">
                @Html.Partial("_AdminNav", navModel)
            </aside>

            <div class="offcanvas offcanvas-start admin-offcanvas d-lg-none" tabindex="-1" id="adminOffcanvas" aria-labelledby="adminOffcanvasLabel">
                <div class="offcanvas-header">
                    <h5 class="offcanvas-title" id="adminOffcanvasLabel">
                        <i class="bi bi-shield-lock me-2"></i> Administración
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas" aria-label="Cerrar"></button>
                </div>
                <div class="offcanvas-body d-flex flex-column">
                    @Html.Partial("_AdminNav", navOffcanvasModel)
                </div>
            </div>

            <main class="admin-content">
                <div class="admin-content-inner">
                    @if (IsSectionDefined("BreadcrumbItems") || (pageContext != null && pageContext.ShowBreadcrumb))
                    {
                        <nav class="admin-breadcrumb" aria-label="breadcrumb">
                            <ol class="breadcrumb mb-3">
                                <li class="breadcrumb-item">
                                    <a href="@Url.Action("Index", "Admin")">Administración</a>
                                </li>
                                @if (IsSectionDefined("BreadcrumbItems"))
                                {
                                    @RenderSection("BreadcrumbItems", required: false)
                                }
                                else if (pageContext != null)
                                {
                                    if (!string.IsNullOrWhiteSpace(pageContext.SectionTitle)
                                        && !string.IsNullOrWhiteSpace(pageContext.SectionUrl)
                                        && !pageContext.Title.Equals(pageContext.SectionTitle, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <li class="breadcrumb-item">
                                            <a href="@pageContext.SectionUrl">@pageContext.SectionTitle</a>
                                        </li>
                                    }
                                    <li class="breadcrumb-item active" aria-current="page">@pageContext.Title</li>
                                }
                            </ol>
                        </nav>
                    }
                    @Html.Partial("_Alerts")
                    @RenderBody()
                </div>
            </main>
        </div>
    </div>

    @Html.Partial("_AdminConfirmModal")
    @Html.Partial("_AdminHelpModal")
    <div id="adminToastContainer" class="toast-container position-fixed bottom-0 end-0 p-3" aria-live="polite" style="z-index:1100"></div>

    @RenderSection("Scripts", required: false)

    <script src="~/Scripts/mat.admin-nav.js?v=20260620a"></script>
    <script src="~/Scripts/mat.admin-help.js?v=20260620a"></script>
</body>
</html>
