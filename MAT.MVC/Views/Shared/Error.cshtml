@{Layout = null;}
<!DOCTYPE html>
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Error - Sistema MAT</title>
    <style>
        :root {
            --brand-primary: #e63375;
            --brand-dark: #2b2d42;
            --bg-main: #f4f7f6;
            --border-color: #e5e7eb;
            --text-primary: #2b2d42;
            --text-secondary: #6b7280;
            --danger-soft: #fff1f2;
            --danger-strong: #be123c;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 1.25rem;
            background: var(--bg-main);
            color: var(--text-primary);
            font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif;
            line-height: 1.5;
        }

        .modern-error-shell {
            max-width: 860px;
            margin: 2rem auto;
            background: #fff;
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            overflow: hidden;
        }

        .modern-error-header {
            padding: 1.5rem 1.75rem;
            border-bottom: 1px solid var(--border-color);
            background: linear-gradient(180deg, #fff 0%, #fff7fa 100%);
            text-align: center;
        }

        .modern-error-title {
            margin: 0;
            color: var(--danger-strong);
            font-size: 1.9rem;
            font-weight: 700;
        }

        .modern-error-body {
            padding: 1.5rem 1.75rem;
        }

        .modern-error-message {
            margin: 0 0 1rem 0;
            padding: 1rem;
            border: 1px solid #fecdd3;
            border-left: 4px solid var(--danger-strong);
            border-radius: 10px;
            background: var(--danger-soft);
            color: var(--text-primary);
        }

        .modern-error-correlation {
            margin-top: 0.65rem;
            color: var(--text-secondary);
            font-size: 0.95rem;
        }

        .modern-error-details {
            margin: 1rem 0 0 0;
            padding: 1rem;
            border: 1px solid var(--border-color);
            border-radius: 10px;
            background: #f8fafc;
        }

        .modern-error-item { margin-bottom: 0.9rem; }
        .modern-error-item:last-child { margin-bottom: 0; }

        .modern-error-label {
            margin-bottom: 0.35rem;
            font-weight: 600;
            color: var(--text-primary);
        }

        .modern-error-value {
            margin: 0;
            padding: 0.65rem 0.75rem;
            border-radius: 8px;
            background: var(--brand-dark);
            color: #f8fafc;
            font-family: Consolas, "Courier New", monospace;
            font-size: 0.9rem;
            white-space: pre-wrap;
            word-break: break-word;
            overflow-x: auto;
        }

        .modern-error-actions {
            margin-top: 1.25rem;
            text-align: center;
        }

        .modern-error-btn {
            display: inline-block;
            padding: 0.65rem 1.1rem;
            border-radius: 10px;
            text-decoration: none;
            color: #fff;
            background: var(--brand-primary);
            font-weight: 600;
            transition: background-color .2s ease;
        }

        .modern-error-btn:hover { background: #c81d62; }

        .modern-error-footer {
            padding: 1rem 1.75rem 1.5rem 1.75rem;
            color: var(--text-secondary);
            font-size: 0.92rem;
            text-align: center;
        }

        .modern-error-time {
            margin-top: 0.5rem;
            font-size: 0.85rem;
            opacity: 0.9;
        }
    </style>
</head>
<body>
    <div class="modern-error-shell">
        <div class="modern-error-header">
            <h1 class="modern-error-title">Ups, algo salió mal</h1>
        </div>

        @{
            var isDev = string.Equals(System.Configuration.ConfigurationManager.AppSettings["SystemDEV"], "true", StringComparison.OrdinalIgnoreCase);
            // Compatible con compilación Razor/C# antigua (sin operador ?.)
            var correlationId = "";
            var ctx = System.Web.HttpContext.Current;
            if (ctx != null && ctx.Items != null && ctx.Items["MAT.CorrelationId"] != null)
            {
                correlationId = ctx.Items["MAT.CorrelationId"].ToString();
            }
            var displayMessage = isDev ? Model.Message : "Ocurrió un error inesperado. Intente nuevamente.";
        }

        <div class="modern-error-body">
        <div class="modern-error-message">
            @displayMessage
            @if (!string.IsNullOrWhiteSpace(correlationId))
            {
                <div class="modern-error-correlation">
                    ID: @correlationId
                </div>
            }
        </div>

        @if (isDev)
        {
            <div class="modern-error-details">
                <div class="modern-error-item">
                    <div class="modern-error-label">Tipo de error</div>
                    <pre class="modern-error-value">@Model.GetType().Name</pre>
                </div>

                @if (!string.IsNullOrEmpty(Model.StackTrace))
                {
                    <div class="modern-error-item">
                        <div class="modern-error-label">Stack trace</div>
                        <pre class="modern-error-value">@Model.StackTrace</pre>
                    </div>
                }

                @if (Model.InnerException != null)
                {
                    <div class="modern-error-item">
                        <div class="modern-error-label">Error interno</div>
                        <pre class="modern-error-value">@Model.InnerException.Message</pre>
                    </div>
                }
            </div>
        }

        <div class="modern-error-actions">
            <a href="/Home/Index" class="modern-error-btn">Volver al inicio</a>
        </div>
        </div>

        <div class="modern-error-footer">
            <p>Si el problema persiste, por favor contacte con su Administrador de Sistema</p>
            @if (!string.IsNullOrWhiteSpace(correlationId))
            {
                <p>ID de Error: @correlationId</p>
            }
            <div class="modern-error-time">
                @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
            </div>
        </div>
    </div>
</body>
</html>