@model MAT.MVC.Infrastructure.AdminNavViewModel
@{
    var navRootClass = Model.IsOffcanvas ? "admin-nav admin-nav--offcanvas" : "admin-nav admin-nav--sidebar";
}

<div class="@navRootClass" id="@(Model.IsOffcanvas ? "adminNavOffcanvas" : "adminNavDesktop")">
    @foreach (var navSection in Model.Sections)
    {
        var sectionPanelId = "adminNavSection-" + navSection.Id + (Model.IsOffcanvas ? "-mobile" : "");
        <div class="admin-nav-section" data-nav-section="@navSection.Id">
            <button type="button" class="admin-nav-section-toggle nav-section-title"
                    aria-expanded="true" aria-controls="@sectionPanelId"
                    data-nav-section-toggle="@navSection.Id">
                <span>@navSection.Title</span>
                <i class="bi bi-chevron-down admin-nav-section-chevron" aria-hidden="true"></i>
            </button>
            <nav class="nav nav-pills flex-column gap-1 admin-nav-section-panel" id="@sectionPanelId">
                @foreach (var item in navSection.Items)
                {
                    <a class="nav-link" href="@item.Url" data-nav-url="@item.Url" title="@item.Description">
                        <i class="bi @item.Icon admin-nav-link-icon" aria-hidden="true"></i>
                        <span class="admin-nav-link-label">@item.Title</span>
                    </a>
                }
            </nav>
        </div>
    }

    @if (!Model.IsOffcanvas)
    {
        <div class="admin-nav-footer mt-auto pt-2">
            <button type="button" class="btn admin-sidebar-collapse-btn w-100" id="adminSidebarCollapse"
                    title="Colapsar menú lateral" aria-label="Colapsar menú lateral">
                <i class="bi bi-layout-sidebar-inset" aria-hidden="true"></i>
                <span class="admin-nav-link-label">Colapsar menú</span>
            </button>
            <small class="text-white-50 d-block mt-2 admin-nav-brand">MAT Admin</small>
        </div>
    }
    else
    {
        <div class="admin-offcanvas-actions mt-auto pt-3">
            <button type="button" class="btn admin-offcanvas-action-btn w-100 mb-2" id="adminOffcanvasSearchBtn">
                <i class="bi bi-search me-2"></i>Buscar funciones
            </button>
            <button type="button" class="btn admin-offcanvas-action-btn w-100 mb-2" id="adminOffcanvasTourBtn">
                <i class="bi bi-signpost-split me-2"></i>Ver guía de inicio
            </button>
            <a href="/Home/Index" class="btn admin-offcanvas-action-btn w-100 mb-2">
                <i class="bi bi-house-door me-2"></i>Ir a la intranet
            </a>
            @if (Request.IsAuthenticated)
            {
                <a href="@Url.Action("LogOff", "Account")" class="btn admin-offcanvas-action-btn admin-offcanvas-action-btn--danger w-100" id="adminLogoutFormOffcanvas">
                    <i class="bi bi-box-arrow-right me-2"></i>Cerrar sesión
                </a>
            }
        </div>
    }
</div>
