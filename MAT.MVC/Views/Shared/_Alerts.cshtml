@{
    // Convención de claves soportadas (TempData/ViewBag):
    // - Success, Error, Warning, Info
    // - MsgError (legacy)
    // Compat: Razor con C# antiguo (sin local functions / expression-bodied members)
    Func<object, string> GetString = o => o == null ? null : o.ToString();
    Func<string, string> ToSafeHtml = s =>
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        // Encode por defecto para evitar inyección; mantener saltos de línea.
        return HttpUtility.HtmlEncode(s).Replace("\r\n", "<br/>").Replace("\n", "<br/>");
    };

    var success = GetString(TempData["Success"]) ?? GetString(ViewBag.Success);
    var info = GetString(TempData["Info"]) ?? GetString(ViewBag.Info);
    var warning = GetString(TempData["Warning"]) ?? GetString(ViewBag.Warning);
    var error =
        GetString(TempData["Error"]) ??
        GetString(ViewBag.Error) ??
        GetString(ViewBag.MsgError) ??
        GetString(TempData["MsgError"]);

    var hasModelStateErrors = !ViewData.ModelState.IsValid;
    var showModelState = hasModelStateErrors && string.IsNullOrWhiteSpace(error);
}

<div class="modern-alerts-host hidden-print">
    @if (!string.IsNullOrWhiteSpace(error))
    {
        <div class="modern-alert modern-alert-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@Html.Raw(ToSafeHtml(error))</span>
        </div>
    }

    @if (showModelState)
    {
        <div class="modern-alert modern-alert-error" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>@Html.ValidationSummary(false)</div>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(warning))
    {
        <div class="modern-alert modern-alert-warning" role="alert">
            <i class="bi bi-exclamation-circle-fill"></i>
            <span>@Html.Raw(ToSafeHtml(warning))</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(info))
    {
        <div class="modern-alert modern-alert-info" role="alert">
            <i class="bi bi-info-circle-fill"></i>
            <span>@Html.Raw(ToSafeHtml(info))</span>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(success))
    {
        <div class="modern-alert modern-alert-success" role="alert">
            <i class="bi bi-check-circle-fill"></i>
            <span>@Html.Raw(ToSafeHtml(success))</span>
        </div>
    }
</div>
