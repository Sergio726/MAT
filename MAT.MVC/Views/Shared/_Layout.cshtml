                                            </a>
                                        </li>
                                        <li>
                                            <a href="/PersonaCliente/Index">
                                                <i class="bi bi-list-ul"></i>
                                                <span>Listado</span>
                                            </a>
                                        </li>
                                    </ul>                                    
                                </li>
                                <li class="hasSubmenu">
                                    <a data-bs-toggle="collapse" href="#menu_hoteles" role="button" aria-expanded="false" aria-controls="menu_hoteles">
                                        <i class="bi bi-building"></i>
                                        <span>Hoteles</span>
                                    </a>
                                    <ul class="collapse" id="menu_hoteles">
                                        <li>
                                            <a href="/Hotel/ABM">
                                                <i class="bi bi-plus-square"></i>
