                                            </a>
                                        </li>
                                        <li>
                                            <a href="/Hotel/Index">
                                                <i class="bi bi-list-ul"></i>
                                                <span>Listado</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="hasSubmenu">
                                    <a data-bs-toggle="collapse" href="#menu_transportes" role="button" aria-expanded="false" aria-controls="menu_transportes">
                                        <i class="bi bi-bus-front"></i>
                                        <span>Transportes</span>
                                    </a>
                                    <ul class="collapse" id="menu_transportes">
                                        <li>
                                            <a href="/Transporte/Index">
                                                <i class="bi bi-list-ul"></i>
                                                <span>Listado</span>
                                            </a>
                                        </li>
                                    </ul>
                                </li>
                                <li class="hasSubmenu">
                                    <a data-bs-toggle="collapse" href="#menu_servicios" role="button" aria-expanded="false" aria-controls="menu_servicios">
                                        <i class="bi bi-tools"></i>
