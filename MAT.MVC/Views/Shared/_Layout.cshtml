    <script src="~/Scripts/formatNumber/numeral.min.js"></script>

</head>
<body>
    @* Menú angosto: se aplica antes de pintar para que no parpadee (lógica en mat.menu.js) *@
    <script>try { if (localStorage.getItem("mat.menu.rail") === "1") document.body.classList.add("menu-rail"); } catch (e) { }</script>
    <!-- Main Container Fluid -->
    <div class="container-fluid fixed menu-left">

        <!-- Top navbar unificado: logo + breadcrumb + perfil -->
        <div class="navbar main hidden-print">

            <div class="wrapper wrapper--unified">
                @* Izquierda (menú, logo, breadcrumb) y derecha con el mismo flex-basis: el buscador queda al centro *@
                <div class="topbar-izquierda">
                <!-- Mobile Menu Toggle Button -->
                <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menú">
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                </button>
                <!-- Menú angosto (solo escritorio; mat.menu.js) -->
                <button type="button" class="topbar-rail-toggle" id="menuRailToggle" aria-controls="menu" aria-expanded="true" aria-label="Contraer menú" title="Contraer menú">
                    <i class="bi bi-layout-sidebar" aria-hidden="true"></i>
                </button>
                <!-- Logo -->
                <img src="~/Images/mat header.png" alt="Marco Antonio Tours" class="user-profile-logo" />
                <!-- Breadcrumb (Volver + ruta) integrado en la barra -->
                <div class="navbar-breadcrumb">
                    @Html.Partial("_Breadcrumb")
                </div>
                </div>
                @if (Request.IsAuthenticated)
                {
                    <!-- Buscador global (Ctrl+K) -->
                    @Html.Partial("_BuscadorGlobal")
                }
                <div class="topbar-derecha">
                    @if (Request.IsAuthenticated)
                    {
                        <a href="/Presupuesto/Create" class="topbar-nuevo" aria-label="Nuevo presupuesto" title="Nuevo presupuesto">
                            <i class="bi bi-plus-lg" aria-hidden="true"></i>
                            <span>Nuevo presupuesto</span>
                        </a>
                    }
                    <!-- Campanita de avisos -->
                    @Html.Partial("_Notificaciones")
                    <!-- User Profile -->
                    <div class="user-profile-container">
                        @Html.Partial("_LoginPartial")
                    </div>
                </div>
                <ul class="topnav pull-right">
                </ul>
            </div>

        </div>
        <!-- Top navbar END -->

        <!-- Mobile Sidebar Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar menu & content wrapper -->
        <div id="wrapper">

            <!-- Sidebar Menu -->
            <div id="menu" class="hidden-print">

                <!-- Brand -->
                
                <!-- Scrollable menu wrapper with Maximum height -->
                <div class="slim-scroll" data-scroll-height="800px">
                    @Html.Partial("_MainNav")
                </div>
            </div>
            <!-- // Sidebar Menu END -->

            <!-- Content (breadcrumb ya está en el header unificado) -->
            <div id="content">
                @Html.Partial("_Alerts")
                @RenderBody()
            </div>

        </div>
        <!-- // Wrapper END -->

    </div>
    <!-- // Container END -->

    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <a class="close" data-dismiss="modal">&times;</a>
                    <h3 class="modal-title"></h3>
                </div>
                <div class="modal-body">
                    <div class="modal-image"></div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Inicializar tooltips de Bootstrap 5 después de que el DOM esté listo
        $(document).ready(function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Auto-detectar elemento activo del menú según la URL actual
            var currentPath = window.location.pathname.toLowerCase();
            var currentSearch = window.location.search.toLowerCase();
            var currentFull = currentPath + currentSearch;


            function isMenuHrefActive(href) {
                if (!href || href === '#') {
                    return false;
                }
                var menuHref = href.toLowerCase();
                var qIdx = menuHref.indexOf('?');
                var menuPath = qIdx >= 0 ? menuHref.substring(0, qIdx) : menuHref;
                var menuQuery = qIdx >= 0 ? menuHref.substring(qIdx) : '';

                if (menuQuery) {
                    return currentFull === menuHref || (currentPath === menuPath && currentSearch === menuQuery);
                }
                return currentPath === menuPath
                    || currentPath.indexOf(menuPath) === 0
                    || (menuPath.endsWith('/index') && currentPath === menuPath.replace('/index', ''));
            }

            // Página actual (bloque C del plan del panel principal): un solo ítem, el href más largo que coincide,
            // marcado con aria-current="page" (el CSS se apoya en ese atributo). El submenú que lo contiene arranca
            // abierto con la clase de Bootstrap, sin forzarlo por CSS, así se puede cerrar y el chevron y
            // aria-expanded siguen a lo que se ve. El padre queda marcado más tenue con "menu-padre-actual".
            var actual = null, largoActual = -1;
            $('#menu .menu-0 a[href]').not('[data-bs-toggle="collapse"]').each(function() {
                var href = $(this).attr('href');
                if (isMenuHrefActive(href) && href.length > largoActual) {
                    actual = this;
                    largoActual = href.length;
                }
            });

            if (actual) {
                $(actual).attr('aria-current', 'page');
                $(actual).parents('ul.collapse').each(function() {
                    $(this).addClass('show');
                    $(this).siblings('[data-bs-toggle="collapse"]').attr('aria-expanded', 'true').removeClass('collapsed');
                    $(this).parent('li.hasSubmenu').addClass('menu-padre-actual');
                });
            }

            // Mobile menu toggle
            var mobileToggle = $('#mobileMenuToggle');
            var sidebar = $('#menu');
            var overlay = $('#sidebarOverlay');

            mobileToggle.on('click', function() {
                sidebar.toggleClass('mobile-open');
                overlay.toggleClass('active');
                $('body').toggleClass('sidebar-open');
            });

            overlay.on('click', function() {
                sidebar.removeClass('mobile-open');
                overlay.removeClass('active');
                $('body').removeClass('sidebar-open');
            });

            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && sidebar.hasClass('mobile-open')) {
                    sidebar.removeClass('mobile-open');
                    overlay.removeClass('active');
                    $('body').removeClass('sidebar-open');
                }
            });

            // Close sidebar when clicking a menu link on mobile
            sidebar.on('click', 'a[href]:not([data-bs-toggle])', function() {
                if ($(window).width() <= 768) {
                    setTimeout(function() {
                        sidebar.removeClass('mobile-open');
                        overlay.removeClass('active');
                        $('body').removeClass('sidebar-open');
                    }, 150);
                }
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
