<html>
<head>

    <title>Marco Antonio Tours</title>

    <!-- Meta -->
    <meta charset="UTF-8" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimum-scale=1.0, maximum-scale=1.0">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black">
    <meta http-equiv="X-UA-Compatible" content="IE=9; IE=8; IE=7; IE=EDGE" />
    <link rel="icon" href="~/Images/favicon.ico" type="image/x-icon">
    @Styles.Render("~/Content/css")

    @Scripts.Render("~/bundles/modernizr")
    @{string fecha = "22122016";}
    <link href="~/Content/themes/base/jquery-ui-1.13.2.css" rel="stylesheet" />
    <link href="~/Content/mat.busplugin.css?t=@fecha" rel="stylesheet" />
    <link href="~/Content/preset.css" rel="stylesheet" />
    <link href="~/Content/tabla.css" rel="stylesheet" />
    <link href="~/Content/mat.perfiles.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-5.3.2.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/mat.forms.css" rel="stylesheet" />
    <link href="~/Content/voucher.css?t=@fecha" rel="stylesheet" />
    <link href="~/Scripts/jquery.timepicker/jquery.timepicker.css" rel="stylesheet" />
    <link href="~/Content/mat.styles.custom.css" rel="stylesheet" />
    @* Variables CSS para diseño SaaS moderno *@
    <link href="~/Content/saas-variables.css" rel="stylesheet" />
    @* Estilos para layout flexbox *@
    <link href="~/Content/modern-layout.css" rel="stylesheet" />
    @* Estilos modernos para menú y dashboard *@
    <link href="~/Content/modern-menu.css" rel="stylesheet" />
    <link href="~/Content/modern-dashboard.css?v=20260705e" rel="stylesheet" />
    <link href="~/Content/modern-nota-credito.css" rel="stylesheet" />
    <link href="~/Content/modern-facturas.css" rel="stylesheet" />
    <link href="~/Content/factura-detalle.css?v=20260812a" rel="stylesheet" />
    <link href="~/Content/mat.listadosimple.css" rel="stylesheet" />
    <link href="~/Content/partial-vinculacion-menor.css" rel="stylesheet" />
    <link href="~/Content/mat.busqueda.css" rel="stylesheet" />
    <link href="~/Content/mat.notacredito.css" rel="stylesheet" />
    <link href="~/Content/mat.cotizador.css" rel="stylesheet" />
    <link href="~/Content/mat.hotel.distribucion.css" rel="stylesheet" />
    <link href="~/Content/mat.habitacion.list.css" rel="stylesheet" />
    <link href="~/Content/modern-topbar.css" rel="stylesheet" />
    <link href="~/Content/modern-presupuesto.css" rel="stylesheet" />
    <link href="~/Content/modern-facturafiscal.css" rel="stylesheet" />

    @RenderSection("Styles", required: false)

    <script src="~/Scripts/preset.js"></script>
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    @* Migrate siempre hace console.log al cargar; filtramos solo durante su carga. *@
    <script>
        (function () {
            var origLog = console.log.bind(console);
            console.log = function () {
                var a = arguments[0];
                if (typeof a === 'string' && a.indexOf('JQMIGRATE:') === 0) return;
                return origLog.apply(console, arguments);
            };
            window.__matRestoreConsoleLog = function () { console.log = origLog; };
        })();
    </script>
    <script src="~/Scripts/jquery-migrate-3.4.1.min.js"></script>
    <script>window.__matRestoreConsoleLog(); delete window.__matRestoreConsoleLog;</script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/jquery-ui-1.13.2.min.js"></script>
    <script src="~/Scripts/javascript.core.js"></script>
    <script src="~/Scripts/mat.jquery.binding.js"></script>
    <script src="~/Scripts/mat.jquery.functions.js"></script>
    <script src="~/Scripts/mat.geo.localidad.js"></script>
    <script src="~/Scripts/mat.jquery.initialize.js"></script>
    <script src="~/Scripts/jquery.quick.pagination.min.js"></script>
    <script src="~/Scripts/global.js"></script>
    <script src="~/Scripts/mat.jquery.hashtable.js"></script>
    <script src="~/Scripts/bootstrap-5.3.2.bundle.min.js"></script>
    <script src="~/Scripts/jquery.mask.js"></script>
    <script src="~/Scripts/common.js"></script>
    <script src="~/Scripts/jquery.timepicker/jquery.timepicker.min.js"></script>

    <!--dataTable-->
    <link href="~/Scripts/dataTable/jquery.dataTables.min.css" rel="stylesheet" />
    <link href="~/Content/modern-datatable.css" rel="stylesheet" />
    <script src="~/Scripts/dataTable/jquery.dataTables.min.js"></script>

    <!--formatNumber-->
    <script src="~/Scripts/formatNumber/numeral.min.js"></script>

</head>
<body>
    <!-- Main Container Fluid -->
    <div class="container-fluid fixed menu-left">

        <!-- Top navbar unificado: logo + breadcrumb + perfil -->
        <div class="navbar main hidden-print">

            <div class="wrapper wrapper--unified">
                <!-- Mobile Menu Toggle Button -->
                <button type="button" class="mobile-menu-toggle" id="mobileMenuToggle" aria-label="Menú">
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                    <span class="hamburger-line"></span>
                </button>
                <!-- Logo -->
                <img src="~/Images/mat header.png" alt="Marco Antonio Tours" class="user-profile-logo" />
                <!-- Breadcrumb (Volver + ruta) integrado en la barra -->
                <div class="navbar-breadcrumb">
                    @Html.Partial("_Breadcrumb")
                </div>
                <!-- User Profile -->
                <div class="user-profile-container">
                    @Html.Partial("_LoginPartial")
                </div>
                <ul class="topnav pull-right">
                </ul>
            </div>

        </div>
        <!-- Top navbar END -->

        <!-- Mobile Sidebar Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay"></div>

        <!-- Sidebar menu & content wrapper -->
        <div id="wrapper">

            <!-- Sidebar Menu -->
            <div id="menu" class="hidden-print">

                <!-- Brand -->
                
                <!-- Scrollable menu wrapper with Maximum height -->
                <div class="slim-scroll" data-scroll-height="800px">
                    @Html.Partial("_MainNav")
                </div>
            </div>
            <!-- // Sidebar Menu END -->

            <!-- Content (breadcrumb ya está en el header unificado) -->
            <div id="content">
                @Html.Partial("_Alerts")
                @RenderBody()
            </div>

        </div>
        <!-- // Wrapper END -->

    </div>
    <!-- // Container END -->

    <div class="modal fade" id="myModal" tabindex="-1" role="dialog" aria-labelledby="myModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <a class="close" data-dismiss="modal">&times;</a>
                    <h3 class="modal-title"></h3>
                </div>
                <div class="modal-body">
                    <div class="modal-image"></div>
                </div>
            </div>
        </div>
    </div>

    <script type="text/javascript">
        // Inicializar tooltips de Bootstrap 5 después de que el DOM esté listo
        $(document).ready(function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Auto-detectar elemento activo del menú según la URL actual
            var currentPath = window.location.pathname.toLowerCase();
            var currentSearch = window.location.search.toLowerCase();
            var currentFull = currentPath + currentSearch;

            $('#menu .menu-0 > li').removeClass('active');
            $('#menu .menu-0 li').removeClass('submenu-active parent-active');

            function isMenuHrefActive(href) {
                if (!href || href === '#') {
                    return false;
                }
                var menuHref = href.toLowerCase();
                var qIdx = menuHref.indexOf('?');
                var menuPath = qIdx >= 0 ? menuHref.substring(0, qIdx) : menuHref;
                var menuQuery = qIdx >= 0 ? menuHref.substring(qIdx) : '';

                if (menuQuery) {
                    return currentFull === menuHref || (currentPath === menuPath && currentSearch === menuQuery);
                }
                return currentPath === menuPath
                    || currentPath.indexOf(menuPath) === 0
                    || (menuPath.endsWith('/index') && currentPath === menuPath.replace('/index', ''));
            }

            $('#menu .menu-0 > li > a').each(function() {
                var $link = $(this);
                if ($link.is('[data-bs-toggle="collapse"]')) {
                    return;
                }
                var href = $link.attr('href');
                if (isMenuHrefActive(href)) {
                    $link.parent('li').addClass('active');
                }
            });

            $('#menu .menu-0 ul li a').each(function() {
                var href = $(this).attr('href');
                if (isMenuHrefActive(href)) {
                    // Marcar este elemento como activo
                    $(this).parent('li').addClass('submenu-active');

                    // Expandir los menús padres
                    $(this).parents('ul.collapse').each(function() {
                        $(this).addClass('show');
                        // Buscar tanto anchor como button toggle
                        var toggleBtn = $(this).siblings('[data-bs-toggle="collapse"]');
                        toggleBtn.attr('aria-expanded', 'true');
                        $(this).parent('li.hasSubmenu').addClass('parent-active');
                    });
                }
            });

            // Mobile menu toggle
            var mobileToggle = $('#mobileMenuToggle');
            var sidebar = $('#menu');
            var overlay = $('#sidebarOverlay');

            mobileToggle.on('click', function() {
                sidebar.toggleClass('mobile-open');
                overlay.toggleClass('active');
                $('body').toggleClass('sidebar-open');
            });

            overlay.on('click', function() {
                sidebar.removeClass('mobile-open');
                overlay.removeClass('active');
                $('body').removeClass('sidebar-open');
            });

            $(document).on('keydown', function(e) {
                if (e.key === 'Escape' && sidebar.hasClass('mobile-open')) {
                    sidebar.removeClass('mobile-open');
                    overlay.removeClass('active');
                    $('body').removeClass('sidebar-open');
                }
            });

            // Close sidebar when clicking a menu link on mobile
            sidebar.on('click', 'a[href]:not([data-bs-toggle])', function() {
                if ($(window).width() <= 768) {
                    setTimeout(function() {
                        sidebar.removeClass('mobile-open');
                        overlay.removeClass('active');
                        $('body').removeClass('sidebar-open');
                    }, 150);
                }
            });
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
