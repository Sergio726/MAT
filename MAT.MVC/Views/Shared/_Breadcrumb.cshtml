@{
    var controllerObj = ViewContext.RouteData.Values["controller"];
    var actionObj = ViewContext.RouteData.Values["action"];
    var idObj = ViewContext.RouteData.Values["id"];

    var controller = controllerObj != null ? controllerObj.ToString() : "";
    var action = actionObj != null ? actionObj.ToString() : "";
    var id = idObj != null ? idObj.ToString() : "";

    // Mapeo de controladores a nombres legibles
    var controllerNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "Home", "Panel Principal" },
        { "PersonaCliente", "Clientes" },
        { "Hotel", "Hoteles" },
        { "Transporte", "Transportes" },
        { "Servicio", "Servicios" },
        { "Excursion", "Excursiones" },
        { "Precio", "Butacas" },
        { "Adicional", "Adicionales" },
        { "Viaje", "Viajes" },
        { "Reserva", "Reservas" },
        { "Factura", "Facturas" },
        { "CuentaCorriente", "Cuenta Corriente" },
        { "NotaCredito", "Notas de Credito" },
        { "Paquete", "Paquetes" },
        { "Admin", "Administracion" },
        { "Account", "Cuenta" },
        { "Busqueda", "Busqueda" }
    };

    // Mapeo de acciones a nombres legibles
    var actionNames = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase)
    {
        { "Index", "Listado" },
        { "Create", "Nuevo" },
        { "Edit", "Editar" },
        { "Details", "Detalles" },
        { "Delete", "Eliminar" },
        { "ABM", "Nuevo" },
        { "GestionViaje", "Gestion" },
        { "GestionPaquete", "Gestion" },
        { "TodosLosViajesIndex", "Todos los Viajes" },
        { "ViajesPorFecha", "Viajes por fecha" },
        { "HistorialPagos", "Historial de pagos" }
    };

    var controllerDisplayName = controllerNames.ContainsKey(controller) ? controllerNames[controller] : controller;
    var actionDisplayName = actionNames.ContainsKey(action) ? actionNames[action] : action;
    var breadcrumbActiveTitle = ViewBag.BreadcrumbActiveTitle as string;
    var breadcrumbParentUrl = ViewBag.BreadcrumbParentUrl as string;
    if (string.IsNullOrWhiteSpace(breadcrumbParentUrl)
        && controller.Equals("Reserva", StringComparison.OrdinalIgnoreCase))
    {
        breadcrumbParentUrl = "/Home/ViajesPorFecha";
    }

    var isHomePage = controller.Equals("Home", StringComparison.OrdinalIgnoreCase) &&
                     action.Equals("Index", StringComparison.OrdinalIgnoreCase);
}

<div class="content-header">
    <div class="content-header-left">
        @if (isHomePage)
        {
            @* Inicio: breadcrumb de un solo nivel, igual que el resto de las pantallas (antes, título fijo "Panel Principal") *@
            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item active" aria-current="page">
                        <i class="bi bi-house-door" aria-hidden="true"></i>
                        <span>Inicio</span>
                    </li>
                </ol>
            </nav>
        }
        else
        {
            <button type="button" class="btn-back" onclick="window.history.back()" title="Volver atras">
                <i class="bi bi-arrow-left"></i>
                <span>Volver</span>
            </button>

            <nav aria-label="breadcrumb" class="breadcrumb-nav">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">
                        <a href="/Home/Index">
                            <i class="bi bi-house-door"></i>
                            <span>Inicio</span>
                        </a>
                    </li>
                    @if (!string.IsNullOrEmpty(controller) && !controller.Equals("Home", StringComparison.OrdinalIgnoreCase))
                    {
                        var parentHref = !string.IsNullOrWhiteSpace(breadcrumbParentUrl)
                            ? breadcrumbParentUrl
                            : "/" + controller + "/Index";
                        <li class="breadcrumb-item">
                            <a href="@parentHref">@controllerDisplayName</a>
                        </li>
                    }
                    @if (!string.IsNullOrWhiteSpace(breadcrumbActiveTitle))
                    {
                        <li class="breadcrumb-item active" aria-current="page" title="@(ViewBag.Title as string ?? breadcrumbActiveTitle)">@breadcrumbActiveTitle</li>
                    }
                    else if (!string.IsNullOrEmpty(action) && !action.Equals("Index", StringComparison.OrdinalIgnoreCase))
                    {
                        Guid idGuid;
                        <li class="breadcrumb-item active" aria-current="page">
                            @actionDisplayName
                            @* Un GUID no le dice nada al usuario; los ids numéricos sí se muestran *@
                            @if (!string.IsNullOrEmpty(id) && !Guid.TryParse(id, out idGuid))
                            {
                                <span class="breadcrumb-id">#@id</span>
                            }
                        </li>
                    }
                    else
                    {
                        <li class="breadcrumb-item active" aria-current="page">@actionDisplayName</li>
                    }
                </ol>
            </nav>
        }
    </div>
</div>
