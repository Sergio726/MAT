@model IEnumerable<MAT.Entities.Persona>

@{
    ViewBag.Title = "Personas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-people"></i>
            <span>Personas</span>
        </h2>
        <div class="modern-page-actions">
            <a href="@Url.Action("Create", "Persona")" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Nueva Persona</span>
            </a>
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblPersonas" style="width: 100%;">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Fecha Nacimiento</th>
                    <th>País</th>
                    <th style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@(item.Apellido ?? "-")</strong></td>
                        <td>@(item.Nombre ?? "-")</td>
                        <td>
                            @if (item.TipoDocumento.HasValue)
                            {
                                @item.TipoDocumento.Value
                            }
                            @if (!string.IsNullOrEmpty(item.NroDocumento))
                            {
                                <text> - @item.NroDocumento</text>
                            }
                            @if (!item.TipoDocumento.HasValue && string.IsNullOrEmpty(item.NroDocumento))
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(item.Telefono ?? item.Celular ?? "-")</td>
                        <td>@(item.Email ?? "-")</td>
                        <td>
                            @if (item.FechaNacimiento.HasValue)
                            {
                                @item.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(item.PaisResidencia ?? "-")</td>
                        <td>
                            <div class="modern-table-actions">
                                <a href="@Url.Action("Details", "Persona", new { id = item.PersonaId })"
                                   class="modern-btn-icon modern-btn-icon-view" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", "Persona", new { id = item.PersonaId })"
                                   class="modern-btn-icon modern-btn-icon-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="#"
                                   class="modern-btn-icon btn-danger-icon btn-eliminar-persona"
                                   data-id="@item.PersonaId"
                                   data-nombre="@(item.Nombre + " " + item.Apellido)"
                                   title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var table = $('#tblPersonas').DataTable({
                pageLength: 25,
                order: [[0, 'asc']],
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ personas",
                    infoEmpty: "No hay personas disponibles",
                    infoFiltered: "(filtrado de _MAX_ personas totales)",
                    zeroRecords: "No se encontraron resultados",
                    emptyTable: "No hay datos disponibles",
                    loadingRecords: "Cargando...",
                    processing: "Procesando...",
                    paginate: {
                        first: "Primero",
                        last: "Ultimo",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                columnDefs: [
                    { orderable: false, searchable: false, targets: 7 }
                ],
                responsive: true,
                stateSave: true,
                autoWidth: false,
                processing: true,
                deferRender: true
            });

            // Manejar confirmacion de eliminacion
            $('#tblPersonas').on('click', '.btn-eliminar-persona', function (e) {
                e.preventDefault();
                var id = $(this).data('id');
                var nombre = $(this).data('nombre');

                if (confirm('¿Esta seguro que desea eliminar a ' + nombre + '?')) {
                    window.location.href = '@Url.Action("Delete", "Persona")/' + id;
                }
            });
        });
    </script>
}
