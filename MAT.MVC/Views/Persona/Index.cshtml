@model IEnumerable<MAT.Entities.Persona>
@using MAT.Enums

@{
    ViewBag.Title = "Personas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-people"></i>
            <span>Personas</span>
        </h2>
        <div class="modern-page-actions">
            <a href="@Url.Action("Create", "Persona")" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Nueva Persona</span>
            </a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="modern-alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table" id="tblPersonas">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Fecha Nacimiento</th>
                    <th>País</th>
                    <th style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@(item.Apellido ?? "-")</strong>
                        </td>
                        <td>@(item.Nombre ?? "-")</td>
                        <td>
                            @{
                                var tipoDoc = "";
                                if (item.TipoDocumento.HasValue)
                                {
                                    tipoDoc = ((eTipoDocumento)item.TipoDocumento.Value).ToString();
                                }
                                var nroDoc = item.NroDocumento ?? "";
                                
                                if (!string.IsNullOrEmpty(tipoDoc) || !string.IsNullOrEmpty(nroDoc))
                                {
                                    <div style="display: flex; align-items: center; gap: 0.25rem;">
                                        @if (!string.IsNullOrEmpty(tipoDoc))
                                        {
                                            <span class="badge-categoria" style="font-size: 0.75rem;">@tipoDoc</span>
                                        }
                                        @if (!string.IsNullOrEmpty(nroDoc))
                                        {
                                            <span>@nroDoc</span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Telefono) || !string.IsNullOrEmpty(item.Celular))
                            {
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="bi bi-telephone"></i>
                                    <span>@(item.Telefono ?? item.Celular)</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="bi bi-envelope"></i>
                                    <span>@item.Email</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.FechaNacimiento.HasValue)
                            {
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <i class="bi bi-calendar3"></i>
                                    <span>@item.FechaNacimiento.Value.ToString("dd/MM/yyyy")</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@(item.PaisResidencia ?? "-")</td>
                        <td>
                            <div class="modern-table-actions">
                                <a href="@Url.Action("Details", "Persona", new { id = item.PersonaId })" 
                                   class="modern-btn-icon" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="@Url.Action("Edit", "Persona", new { id = item.PersonaId })" 
                                   class="modern-btn-icon modern-btn-icon-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="@Url.Action("Delete", "Persona", new { id = item.PersonaId })" 
                                   class="modern-btn-icon btn-danger-icon btn-delete" 
                                   data-id="@item.PersonaId"
                                   data-nombre="@(item.Nombre + " " + item.Apellido)"
                                   title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var table = $('#tblPersonas').DataTable({
                order: [[0, 'asc']],
                pageLength: 25,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ personas",
                    infoEmpty: "No hay personas disponibles",
                    infoFiltered: "(filtrado de _MAX_ personas totales)",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                columnDefs: [
                    { orderable: false, targets: 7 }
                ],
                stateSave: true,
                responsive: true
            });

            // Manejar confirmación de eliminación
            $('#tblPersonas').on('click', '.btn-delete', function (e) {
                var nombre = $(this).data('nombre');
                if (!confirm('¿Está seguro que desea eliminar a ' + nombre + '?')) {
                    e.preventDefault();
                    return false;
                }
            });
        });
    </script>
}
