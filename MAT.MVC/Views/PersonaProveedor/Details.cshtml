@model MAT.Entities.PersonaProveedor
@using MAT.Enums
@using MAT.Utilities

@{
    ViewBag.Title = "Detalle del Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-building-check"></i>
            <span>Detalle del Proveedor</span>
        </h2>
    </div>

    <div class="modern-form-container">
        <h4 class="modern-form-section-title">
            <i class="bi bi-person"></i> Datos Personales
        </h4>

        <div class="modern-details-grid">
            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-hash"></i>
                    ID
                </label>
                <div class="modern-details-value">@Model.PersonaId</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-person"></i>
                    Apellido
                </label>
                <div class="modern-details-value"><strong>@Model.Apellido</strong></div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-person"></i>
                    Nombre
                </label>
                <div class="modern-details-value"><strong>@Model.Nombre</strong></div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-card-text"></i>
                    Tipo Documento
                </label>
                <div class="modern-details-value">@((eTipoDocumento)Model.TipoDocumento)</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-123"></i>
                    Nro. Documento
                </label>
                <div class="modern-details-value">@(Model.NroDocumento ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-geo-alt"></i>
                    Localidad
                </label>
                <div class="modern-details-value">
                    @if (Model.LocalidadId.HasValue)
                    {
                        @Helper.ToSelectItem("Localidad", Model.LocalidadId.ToString())
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-telephone"></i>
                    Telefono
                </label>
                <div class="modern-details-value">@(Model.Telefono ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-envelope"></i>
                    Email
                </label>
                <div class="modern-details-value">@(Model.Email ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-calendar3"></i>
                    Fecha Nacimiento
                </label>
                <div class="modern-details-value">
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        @Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-gender-ambiguous"></i>
                    Sexo
                </label>
                <div class="modern-details-value">@((eSexo)Model.Sexo)</div>
            </div>
        </div>

        <h4 class="modern-form-section-title">
            <i class="bi bi-building"></i> Datos de la Empresa
        </h4>

        <div class="modern-details-grid">
            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-building"></i>
                    Razon Social
                </label>
                <div class="modern-details-value"><strong>@(Model.RazonSocial ?? "-")</strong></div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-geo-alt-fill"></i>
                    Localidad de la Empresa
                </label>
                <div class="modern-details-value">
                    @if (Model.ProveedorLocalidadId.HasValue)
                    {
                        @Helper.ToSelectItem("Localidad", Model.ProveedorLocalidadId.ToString())
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-telephone-fill"></i>
                    Telefono de la Empresa
                </label>
                <div class="modern-details-value">@(Model.ProveedorTelefono ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-printer"></i>
                    Fax de la Empresa
                </label>
                <div class="modern-details-value">@(Model.Fax ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-globe"></i>
                    Web
                </label>
                <div class="modern-details-value">@(Model.Web ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-envelope-fill"></i>
                    Email de la Empresa
                </label>
                <div class="modern-details-value">@(Model.ProveedorEmail ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-translate"></i>
                    Idioma
                </label>
                <div class="modern-details-value">@(Model.Idioma ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-receipt"></i>
                    Condicion IVA
                </label>
                <div class="modern-details-value">@((eCondicionIVA)Model.CondicionIva)</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-upc"></i>
                    CUIT
                </label>
                <div class="modern-details-value">@(Model.Cuit ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-credit-card"></i>
                    Forma de Pago
                </label>
                <div class="modern-details-value">@((eFormaPago)Model.FormaPago)</div>
            </div>
        </div>

        <div class="modern-form-actions">
            <a href="@Url.Action("Index", "PersonaProveedor")" class="btn-modern btn-modern-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Volver a la Lista</span>
            </a>
            <a href="@Url.Action("Edit", "PersonaProveedor", new { id = Model.PersonaId })" class="btn-modern btn-modern-primary">
                <i class="bi bi-pencil"></i>
                <span>Editar</span>
            </a>
        </div>
    </div>
</div>

<style>
    .modern-form-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary, #1e293b);
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-color, #e91e63);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modern-form-section-title i {
        color: var(--primary-color, #e91e63);
    }

    .modern-form-section-title:first-of-type {
        margin-top: 0;
    }

    .modern-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        padding: 1rem 0;
    }

    .modern-details-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .modern-details-label {
        font-size: 0.85rem;
        color: var(--text-secondary, #64748b);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modern-details-label i {
        color: var(--primary-color, #e91e63);
    }

    .modern-details-value {
        font-size: 1rem;
        color: var(--text-primary, #1e293b);
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
    }
</style>
