@model IEnumerable<MAT.Entities.PersonaProveedor>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-building"></i>
            <span>Proveedores</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/PersonaProveedor/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Proveedor</span>
            </a>
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblProveedores">
            <thead>
                <tr>
                    <th>Razón Social</th>
                    <th>Localidad</th>
                    <th>Teléfono</th>
                    <th>Fax</th>
                    <th>Web</th>
                    <th>Email</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.RazonSocial</strong>
                        </td>
                        <td>@Helper.ToSelectItem("Localidad", item.ProveedorLocalidadId.ToString())</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ProveedorTelefono))
                            {
                                <i class="bi bi-telephone"></i> @item.ProveedorTelefono
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Fax))
                            {
                                @item.Fax
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Web))
                            {
                                <a href="@item.Web" target="_blank" title="Abrir sitio web">
                                    <i class="bi bi-globe"></i> @item.Web
                                </a>
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.ProveedorEmail))
                            {
                                <i class="bi bi-envelope"></i> @item.ProveedorEmail
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/PersonaProveedor/Edit/@item.PersonaId" class="btn-action btn-action-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/PersonaProveedor/Details/@item.PersonaId" class="btn-action btn-action-view" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblProveedores").DataTable({
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ proveedores",
                infoEmpty: "No hay proveedores disponibles",
                infoFiltered: "(filtrado de _MAX_ proveedores totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },
            columnDefs: [
                { orderable: false, targets: 6 }
            ]
        });
    });
</script>
