@model MAT.Entities.PersonaProveedor
@using MAT.Enums
@using MAT.Utilities

@{
    ViewBag.Title = "Nuevo Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-building-add"></i>
            <span>Nuevo Proveedor</span>
        </h2>
    </div>

    <div class="modern-form-container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <h4 class="modern-form-section-title">
                <i class="bi bi-person"></i> Datos Personales
            </h4>

            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-person"></i>
                        @Html.LabelFor(model => model.Apellido)
                    </label>
                    @Html.TextBoxFor(model => model.Apellido, new { @class = "modern-form-input", placeholder = "Apellido" })
                    @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-person"></i>
                        @Html.LabelFor(model => model.Nombre)
                    </label>
                    @Html.TextBoxFor(model => model.Nombre, new { @class = "modern-form-input", placeholder = "Nombre" })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-card-text"></i>
                        @Html.LabelFor(model => model.TipoDocumento)
                    </label>
                    @Html.DropDownListFor(model => model.TipoDocumento, eTipoDocumento.DNI.ToSelectList(), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.TipoDocumento, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-hash"></i>
                        @Html.LabelFor(model => model.NroDocumento)
                    </label>
                    @Html.TextBoxFor(model => model.NroDocumento, new { @class = "modern-form-input", placeholder = "Numero de documento" })
                    @Html.ValidationMessageFor(model => model.NroDocumento, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-geo-alt"></i>
                        @Html.LabelFor(model => model.LocalidadId, "Localidad")
                    </label>
                    <input type="text" id="txt-busqueda-localidad" class="modern-form-input" placeholder="Buscar localidad..." />
                    <input type="hidden" id="LocalidadId" name="LocalidadId" />
                    @Html.ValidationMessageFor(model => model.LocalidadId, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-telephone"></i>
                        @Html.LabelFor(model => model.Telefono)
                    </label>
                    @Html.TextBoxFor(model => model.Telefono, new { @class = "modern-form-input", placeholder = "Telefono" })
                    @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-envelope"></i>
                        @Html.LabelFor(model => model.Email)
                    </label>
                    @Html.TextBoxFor(model => model.Email, new { @class = "modern-form-input", type = "email", placeholder = "email@ejemplo.com" })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-calendar3"></i>
                        @Html.LabelFor(model => model.FechaNacimiento, "Fecha de Nacimiento")
                    </label>
                    @Html.TextBoxFor(model => model.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "modern-form-input", type = "date" })
                    @Html.ValidationMessageFor(model => model.FechaNacimiento, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-gender-ambiguous"></i>
                        @Html.LabelFor(model => model.Sexo)
                    </label>
                    @Html.DropDownListFor(model => model.Sexo, eSexo.Femenino.ToSelectList(), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.Sexo, "", new { @class = "text-danger" })
                </div>
            </div>

            <h4 class="modern-form-section-title">
                <i class="bi bi-building"></i> Datos de la Empresa
            </h4>

            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-building"></i>
                        @Html.LabelFor(model => model.RazonSocial)
                    </label>
                    @Html.TextBoxFor(model => model.RazonSocial, new { @class = "modern-form-input", placeholder = "Razon social" })
                    @Html.ValidationMessageFor(model => model.RazonSocial, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-geo-alt-fill"></i>
                        @Html.LabelFor(model => model.ProveedorLocalidadId, "Localidad de la Empresa")
                    </label>
                    <input type="text" id="txt-busqueda-localidad-empresa" class="modern-form-input" placeholder="Buscar localidad..." />
                    <input type="hidden" id="LocalidadEmpresa" name="LocalidadEmpresa" />
                    @Html.ValidationMessageFor(model => model.ProveedorLocalidadId, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-telephone-fill"></i>
                        @Html.LabelFor(model => model.ProveedorTelefono, "Telefono de la Empresa")
                    </label>
                    @Html.TextBoxFor(model => model.ProveedorTelefono, new { @class = "modern-form-input", placeholder = "Telefono de la empresa" })
                    @Html.ValidationMessageFor(model => model.ProveedorTelefono, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-printer"></i>
                        @Html.LabelFor(model => model.Fax, "Fax de la Empresa")
                    </label>
                    @Html.TextBoxFor(model => model.Fax, new { @class = "modern-form-input", placeholder = "Fax" })
                    @Html.ValidationMessageFor(model => model.Fax, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-globe"></i>
                        @Html.LabelFor(model => model.Web)
                    </label>
                    @Html.TextBoxFor(model => model.Web, new { @class = "modern-form-input", placeholder = "www.ejemplo.com" })
                    @Html.ValidationMessageFor(model => model.Web, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-envelope-fill"></i>
                        @Html.LabelFor(model => model.ProveedorEmail)
                    </label>
                    @Html.TextBoxFor(model => model.ProveedorEmail, new { @class = "modern-form-input", type = "email", placeholder = "email@empresa.com" })
                    @Html.ValidationMessageFor(model => model.ProveedorEmail, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-translate"></i>
                        @Html.LabelFor(model => model.Idioma)
                    </label>
                    @Html.TextBoxFor(model => model.Idioma, new { @class = "modern-form-input", placeholder = "Idioma" })
                    @Html.ValidationMessageFor(model => model.Idioma, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-receipt"></i>
                        @Html.LabelFor(model => model.CondicionIva)
                    </label>
                    @Html.DropDownListFor(model => model.CondicionIva, eCondicionIVA.IVA_Responsable_Inscripto.ToSelectList(), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.CondicionIva, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-upc"></i>
                        @Html.LabelFor(model => model.Cuit)
                    </label>
                    @Html.TextBoxFor(model => model.Cuit, new { @class = "modern-form-input", placeholder = "XX-XXXXXXXX-X" })
                    @Html.ValidationMessageFor(model => model.Cuit, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-credit-card"></i>
                        @Html.LabelFor(model => model.FormaPago, "Forma de Pago")
                    </label>
                    @Html.DropDownListFor(model => model.FormaPago, eFormaPago.Contado.ToSelectList(), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.FormaPago, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="modern-form-actions">
                <a href="@Url.Action("Index", "PersonaProveedor")" class="btn-modern btn-modern-secondary">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a la Lista</span>
                </a>
                <button type="submit" class="btn-modern btn-modern-primary">
                    <i class="bi bi-check-circle"></i>
                    <span>Guardar Proveedor</span>
                </button>
            </div>
        }
    </div>
</div>

<style>
    .modern-form-section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-primary, #1e293b);
        margin: 2rem 0 1rem 0;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--primary-color, #e91e63);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modern-form-section-title i {
        color: var(--primary-color, #e91e63);
    }

    .modern-form-section-title:first-of-type {
        margin-top: 0;
    }
</style>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script type="text/javascript">
        $(document).ready(function () {
            if (window.matGeo) {
                matGeo.initAutocomplete('#txt-busqueda-localidad', '#LocalidadId', {
                    context: 'Localidad personal (proveedor)',
                    minLength: 3
                });
                matGeo.initAutocomplete('#txt-busqueda-localidad-empresa', '#LocalidadEmpresa', {
                    context: 'Localidad empresa (proveedor)',
                    minLength: 3
                });
                $('#txt-busqueda-localidad, #txt-busqueda-localidad-empresa').off('keyup.autocomplete');
            }

            $("#NroDocumento").mask("99.999.999");
            $("#Cuit").mask("99-99999999-9");
        });
    </script>
}
