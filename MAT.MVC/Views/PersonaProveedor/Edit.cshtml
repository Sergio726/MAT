@model MAT.Entities.PersonaProveedor
@using MAT.Utilities
@using MAT.Enums
@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">Proveedor - Editar</h2>

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="form">
        <div class="form-label">
            @Html.LabelFor(model => model.Apellido)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Apellido)
            @Html.ValidationMessageFor(model => model.Apellido)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Nombre)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Nombre)
            @Html.ValidationMessageFor(model => model.Nombre)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.TipoDocumento)
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.TipoDocumento, eTipoDocumento.DNI.ToSelectList(Model.TipoDocumento.ToString()))
            @Html.ValidationMessageFor(model => model.TipoDocumento)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.NroDocumento)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.NroDocumento)
            @Html.ValidationMessageFor(model => model.NroDocumento)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.LocalidadId, "Localidad")
        </div>
        <div class="form-field">
            <input type="text" id="txt-busqueda-localidad" value="@Helper.GetLocalidadName(Model.LocalidadId.Value)" />
            <input type="hidden" id="Localidad" name="LocalidadId" value="@Model.LocalidadId" />
            @Html.ValidationMessageFor(model => model.LocalidadId)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Telefono)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Telefono)
            @Html.ValidationMessageFor(model => model.Telefono)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Email)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Email)
            @Html.ValidationMessageFor(model => model.Email)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.FechaNacimiento)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.FechaNacimiento)
            @Html.ValidationMessageFor(model => model.FechaNacimiento)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Sexo)
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.Sexo,eSexo.Femenino.ToSelectList())
            @Html.ValidationMessageFor(model => model.Sexo)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.RazonSocial)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.RazonSocial)
            @Html.ValidationMessageFor(model => model.RazonSocial)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.ProveedorLocalidadId, "Localidad de la empresa")
        </div>
        <div class="form-field">
            <input type="text" id="txt-busqueda-localidad-empresa" value="@Helper.GetLocalidadName(Model.ProveedorLocalidadId.Value)"/>
            <input type="hidden" id="LocalidadEmpresa" name="LocalidadEmpresa" value="@Model.ProveedorLocalidadId.Value" />
            @Html.ValidationMessageFor(model => model.ProveedorLocalidadId)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.ProveedorTelefono, "Telefono de la empresa")
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.ProveedorTelefono)
            @Html.ValidationMessageFor(model => model.ProveedorTelefono)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Fax, "Fax de la empresa")
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Fax)
            @Html.ValidationMessageFor(model => model.Fax)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Web)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Web)
            @Html.ValidationMessageFor(model => model.Web)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.ProveedorEmail)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.ProveedorEmail)
            @Html.ValidationMessageFor(model => model.ProveedorEmail)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Idioma)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Idioma)
            @Html.ValidationMessageFor(model => model.Idioma)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.CondicionIva)
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.CondicionIva, eCondicionIVA.IVA_Responsable_Inscripto.ToSelectList(Model.CondicionIva.ToString()))
            @Html.ValidationMessageFor(model => model.CondicionIva)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Cuit)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Cuit)
            @Html.ValidationMessageFor(model => model.Cuit)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.FormaPago, "Forma de pago")
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.FormaPago, eFormaPago.Contado.ToSelectList(Model.FormaPago.ToString()))
            @Html.ValidationMessageFor(model => model.FormaPago)
        </div>
                
        <p>
            <input type="submit" value="Guardar" class="btn btn-small btn-inverse view-all hidden-phone" />
            @Html.ActionLink("Volver a la lista", "Index", null, new {@class="btn btn-small btn-inverse view-all hidden-phone" })
        </p>
    </div> 
}

<script>
    $(function() {       
        $("input[type='datetime']").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2'
        });
        $("#NroDocumento").mask("99.999.999");
        $("#Cuit").mask("99-99999999-9");
    });

    
  </script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
