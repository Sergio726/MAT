@model MAT.MVC.Models.PaqueteStandard
@using MAT.Utilities
@using MAT.Enums
@{
    ViewBag.Title = "Editar Paquete";
    Layout = "~/Views/Shared/_Layout.cshtml";

    string action = (ViewBag.Action ?? "").ToString();
    string modoTexto = action == "new" ? "Nuevo" : action == "edit" ? "Editar" : "Detalle";

    string PaisID = "0";
    string LocalidadID = "0";
    string DepartamentoID = "0";
    string ProvinciaID = "0";
    string Destino = null;

    if (ViewBag.InfoDestino != null)
    {
        PaisID = ViewBag.InfoDestino.PaisID;
        LocalidadID = ViewBag.InfoDestino.LocalidadID.ToString();
        DepartamentoID = ViewBag.InfoDestino.DepartamentoID.ToString();
        ProvinciaID = ViewBag.InfoDestino.ProvinciaID.ToString();
        Destino = ViewBag.InfoDestino.Destino;
    }
}

@section Styles {
    <link href="~/Content/mat.paquete.css" rel="stylesheet" />
}

<div class="modern-page-container">
    <div class="paquete-container">
        <div class="modern-page-header">
            <h2 class="modern-page-title">
                <i class="bi bi-box-seam"></i>
                <span>Paquete — @modoTexto</span>
            </h2>
            <div class="modern-page-actions">
                <a href="/Paquete/Index" class="btn-modern btn-modern-secondary">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a la lista</span>
                </a>
            </div>
        </div>

        <div class="paquete-card">
            <!-- Imagen -->
            <div class="paquete-section divUploadImage">
                <h3 class="paquete-section-title">
                    <i class="bi bi-image"></i>
                    Imagen del Paquete
                </h3>
                <div class="image-upload-section">
                    <div class="image-preview">
                        @if (!string.IsNullOrEmpty(Model.Foto))
                        {
                            <img src="@Model.Foto" alt="Foto de Paquete" />
                        }
                        else
                        {
                            <div class="image-preview-placeholder">
                                <i class="bi bi-image"></i>
                                <span>Sin imagen</span>
                            </div>
                        }
                    </div>
                    <div class="image-upload-form">
                        @using (Html.BeginForm("UploadFile", "Paquete", FormMethod.Post, new { enctype = "multipart/form-data" }))
                        {
                            <div class="upload-input-group">
                                <input type="file" name="file" id="file" accept="image/*" />
                                <button type="submit" class="btn-modern btn-modern-secondary">
                                    <i class="bi bi-upload"></i>
                                    <span>Subir</span>
                                </button>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Formulario -->
            <form id="formPaquete">
                <input type="hidden" value="@Model.PaqueteID" id="PaqueteID" name="PaqueteID" />
                <input type="hidden" id="DestinoID" name="DestinoID" value="@Model.DestinoID" />

                <div class="paquete-section">
                    <h3 class="paquete-section-title">
                        <i class="bi bi-info-circle"></i>
                        Información General
                    </h3>
                    <div class="paquete-form-grid">
                        <div class="paquete-form-group full-width">
                            <label class="paquete-form-label" for="Descripcion">
                                <i class="bi bi-tag"></i>
                                Nombre del Paquete <span class="required">*</span>
                            </label>
                            <input type="text" id="Descripcion" name="Descripcion" class="paquete-form-input valtxt" value="@Model.Descripcion" placeholder="Ingrese el nombre del paquete" />
                        </div>

                        <div class="paquete-form-group">
                            <label class="paquete-form-label" for="Codigo">
                                <i class="bi bi-upc"></i>
                                Código
                            </label>
                            <input type="text" maxlength="50" id="Codigo" name="Codigo" class="paquete-form-input" value="@Model.Codigo" placeholder="Código del paquete" />
                        </div>

                        <div class="paquete-form-group">
                            <label class="paquete-form-label" for="Temporada">
                                <i class="bi bi-sun"></i>
                                Temporada
                            </label>
                            <select id="Temporada" name="Temporada" class="paquete-form-select">
                                @foreach (var item in eTemporada.Alta.ToSelectList())
                                {
                                    <option value="@item.Value.ToString()" @(Model.Temporada.ToString() == item.Value.ToString() ? "selected" : "")>@item.Text.ToUpper()</option>
                                }
                            </select>
                        </div>

                        <div class="paquete-form-group full-width">
                            <label class="paquete-form-label">
                                <i class="bi bi-geo-alt"></i>
                                Destino <span class="required">*</span>
                            </label>
                            <div class="destino-input-group">
                                <input type="text" maxlength="50" id="txtDestino" name="txtDestino" class="paquete-form-input valtxt" readonly placeholder="Seleccionar destino..." value="@Destino" />
                                <button type="button" title="Seleccionar destino" class="btn-destino" id="btnSeleccionarDestino" aria-label="Seleccionar destino">
                                    <i class="bi bi-geo-alt-fill"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="paquete-section">
                    <h3 class="paquete-section-title">
                        <i class="bi bi-currency-dollar"></i>
                        Configuración Financiera
                    </h3>
                    <div class="paquete-form-grid">
                        <div class="paquete-form-group">
                            <label class="paquete-form-label" for="Moneda">
                                <i class="bi bi-coin"></i>
                                Moneda
                            </label>
                            <select id="Moneda" name="Moneda" class="paquete-form-select">
                                @foreach (MAT.MVC.Models.MonedaTipo item in MAT.MVC.Models.MonedaMethod.GetMonedaTipoAll())
                                {
                                    <option value="@item.Id" @(Model.Moneda.ToString() == item.Id.ToString() ? "selected" : "")>@item.Descripcion.ToString().ToUpper() (@item.Codigo)</option>
                                }
                            </select>
                        </div>

                        <div class="paquete-form-group">
                            <label class="paquete-form-label" for="Cotizacion">
                                <i class="bi bi-currency-exchange"></i>
                                Cotización
                            </label>
                            <input type="number" id="Cotizacion" name="Cotizacion" class="paquete-form-input" value="@Model.Cotizacion" placeholder="0.00" />
                        </div>

                        <div class="paquete-form-group">
                            <label class="paquete-form-label" for="Iva">
                                <i class="bi bi-percent"></i>
                                IVA
                            </label>
                            <input id="Iva" name="Iva" type="number" class="paquete-form-input" value="@Model.Iva" placeholder="21" />
                        </div>

                        <div class="paquete-form-group">
                            <label class="paquete-form-label" for="Alicuota">
                                <i class="bi bi-calculator"></i>
                                Alícuota
                            </label>
                            <input type="number" id="Alicuota" name="Alicuota" class="paquete-form-input" value="@Model.Alicuota" placeholder="0" />
                        </div>
                    </div>
                </div>

                <div class="paquete-actions">
                    <a id="a_editar_paquete" style="display:none" href="/Paquete/Edit/?sAction=edit&sPaqueteID=@Model.PaqueteID" class="btn-modern btn-modern-primary">
                        <i class="bi bi-pencil"></i>
                        <span>Editar</span>
                    </a>
                    <button type="button" id="btn_guardar_paquete" class="btn-modern btn-modern-primary">
                        <i class="bi bi-check-lg"></i>
                        <span>Guardar</span>
                    </button>
                    @if (!string.IsNullOrEmpty(Model.PaqueteID))
                    {
                        <a href="/Paquete/Vinculos/@Model.PaqueteID" class="btn-modern btn-modern-secondary">
                            <i class="bi bi-link-45deg"></i>
                            <span>Vínculos</span>
                        </a>
                    }
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Seleccionar Destino (Bootstrap 5) -->
<div class="modal fade" id="modalDestino" tabindex="-1" aria-labelledby="modalDestinoTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDestinoTitle"><i class="bi bi-geo-alt-fill"></i> Seleccionar destino</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="paquete-form-grid" id="divDestinoForm">
                    <div class="paquete-form-group">
                        <label class="paquete-form-label" for="ddPais">País <span class="required">*</span></label>
                        <select id="ddPais" name="Pais" class="paquete-form-select">
                            <option value="0">SELECCIONE UN PAÍS</option>
                            @foreach (MAT.Entities.Pais Item in ViewBag.ListPais)
                            {
                                <option value="@Item.PaisId.ToString()" @(Item.Descripcion == "ARGENTINA" ? "selected" : "")>@Item.Descripcion</option>
                            }
                        </select>
                    </div>
                    <div class="paquete-form-group">
                        <label class="paquete-form-label" for="ddProvincia">Provincia <span class="required">*</span></label>
                        <select id="ddProvincia" name="Provincia" class="paquete-form-select">
                            <option value="0">SELECCIONE UNA PROVINCIA</option>
                        </select>
                    </div>
                    <div class="paquete-form-group">
                        <label class="paquete-form-label" for="ddDepartamento">Departamento <span class="required">*</span></label>
                        <select id="ddDepartamento" class="paquete-form-select">
                            <option value="0">SELECCIONE UN DEPARTAMENTO</option>
                        </select>
                    </div>
                    <div class="paquete-form-group">
                        <label class="paquete-form-label" for="ddLocalidad">Localidad <span class="required">*</span></label>
                        <div class="destino-input-group">
                            <select id="ddLocalidad" class="paquete-form-select">
                                <option value="0">SELECCIONE UNA LOCALIDAD</option>
                            </select>
                            <button type="button" id="lnk-Agregar-Localidad-Destino" class="btn-destino" title="Agregar localidad">
                                <i class="bi bi-plus"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnModalDestinoAceptar">
                    <i class="bi bi-check-lg"></i> Aceptar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script src="~/Scripts/mat.admin-utils.js"></script>
    <script src="~/Scripts/mat.paquete.js"></script>
    <script type="text/javascript">
        var _paquetePaisId = '@PaisID';
        var _paqueteProvinciaId = '@ProvinciaID';
        var _paqueteDepartamentoId = '@DepartamentoID';
        var _paqueteLocalidadId = '@LocalidadID';

        function LoadProvincia(idPais) {
            if (!idPais || !window.matGeo) { return; }
            matGeo.loadProvincias(idPais, {
                provinciaSelect: '#ddProvincia',
                valueKey: 'ID',
                context: 'Provincias (paquete destino)'
            });
        }

        function LoadDepartamento(idProvincia, idDepartamentoSelect) {
            idDepartamentoSelect = idDepartamentoSelect || 0;
            if (!window.matGeo || !(parseInt(idProvincia, 10) > 0)) { return; }
            matGeo.loadDepartamentos(idProvincia, {
                departamentoSelect: '#ddDepartamento',
                localidadSelect: '#ddLocalidad',
                selectedId: idDepartamentoSelect > 0 ? idDepartamentoSelect : null,
                context: 'Departamentos (paquete destino)',
                onDone: function () {
                    if (idDepartamentoSelect > 0) {
                        var locId = parseInt(_paqueteLocalidadId, 10) > 0 ? _paqueteLocalidadId : null;
                        LoadLocalidad(locId);
                    }
                }
            });
        }

        function LoadLocalidad(selectedId) {
            var idDepartamento = $('#ddDepartamento').val();
            if (!window.matGeo || !(parseInt(idDepartamento, 10) > 0)) { return; }
            matGeo.loadLocalidades(idDepartamento, {
                localidadSelect: '#ddLocalidad',
                selectedId: selectedId,
                context: 'Localidades (paquete destino)'
            });
        }

        function setDestino() {
            var selects = $("#ddPais, #ddProvincia, #ddDepartamento, #ddLocalidad");
            var b = true;
            selects.removeClass("fieldError");
            $.each(selects, function (i, el) {
                if ($(el).val().replace(/^\s+|\s+$/g, "") === "0") {
                    $(el).addClass("fieldError");
                    b = false;
                }
            });
            if (!b) {
                if (window.MatAdmin) { window.MatAdmin.toast("Complete País, Provincia, Departamento y Localidad.", "warning"); }
                return;
            }
            var sPais = $("#ddPais option:selected").text();
            var sProvincia = $("#ddProvincia option:selected").text();
            var sDepartamento = $("#ddDepartamento option:selected").text();
            var sLocalidad = $("#ddLocalidad option:selected").text();
            $("#txtDestino").val(sPais + ", " + sProvincia + ", " + sDepartamento + ", " + sLocalidad).removeClass("fieldError");
            $("#DestinoID").val($("#ddLocalidad").val());
            var modalEl = document.getElementById("modalDestino");
            if (modalEl && window.bootstrap) {
                var inst = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
                inst.hide();
            }
        }

        $(document).ready(function () {
            MatPaquete.initEdit({ action: "@action", paqueteId: "@Model.PaqueteID" });

            $("#ddPais, #ddProvincia, #ddDepartamento, #ddLocalidad").on("change", function () {
                $(this).removeClass("fieldError");
            });

            $("#ddDepartamento").on("change", function () { LoadLocalidad(); });
            $("#ddProvincia").on("change", function () { LoadDepartamento($(this).val()); });
            $("#ddPais").on("change", function () {
                LoadProvincia($(this).val());
                if (window.matGeo) {
                    matGeo.loadDepartamentos(0, { departamentoSelect: '#ddDepartamento', localidadSelect: '#ddLocalidad' });
                }
            });

            $("#lnk-Agregar-Localidad-Destino").on("click", function () {
                if (window.matGeo) {
                    matGeo.openCreateDialog({ idDepartamentoSelect: '#ddDepartamento', idLocalidadSelect: '#ddLocalidad' });
                }
                return false;
            });

            $("#btnSeleccionarDestino").on("click", function () {
                var modalEl = document.getElementById("modalDestino");
                if (modalEl && window.bootstrap) {
                    (bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl)).show();
                }
            });
            $("#btnModalDestinoAceptar").on("click", setDestino);

            var initialPaisId = _paquetePaisId !== '0' ? _paquetePaisId : $("#ddPais").val();
            if (initialPaisId && initialPaisId !== '0') { $("#ddPais").val(initialPaisId); }
            if (window.matGeo && initialPaisId && initialPaisId !== '0') {
                matGeo.loadProvincias(initialPaisId, {
                    provinciaSelect: '#ddProvincia',
                    valueKey: 'ID',
                    selectedId: parseInt(_paqueteProvinciaId, 10) > 0 ? _paqueteProvinciaId : null,
                    context: 'Provincias (paquete destino)',
                    onDone: function () {
                        var provId = $('#ddProvincia').val();
                        if (parseInt(provId, 10) > 0) {
                            var deptoId = parseInt(_paqueteDepartamentoId, 10) > 0 ? parseInt(_paqueteDepartamentoId, 10) : 0;
                            LoadDepartamento(provId, deptoId);
                        }
                    }
                });
            }

            switch ("@action") {
                case "detail":
                    $("#formPaquete input, #formPaquete select").prop("disabled", true);
                    $("#btn_guardar_paquete").hide();
                    $(".required").hide();
                    $("#a_editar_paquete").show();
                    $(".divUploadImage form").hide();
                    $("#btnSeleccionarDestino").hide();
                    break;
                case "new":
                    $(".divUploadImage").hide();
                    break;
            }
        });
    </script>
}
