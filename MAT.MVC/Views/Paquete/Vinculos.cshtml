@model List<MAT.MVC.Models.PaqueteViculosModel>
@{
    ViewBag.Title = "Vínculos del Paquete";
    Layout = "~/Views/Shared/_Layout.cshtml";
    string paqueteId = (ViewBag.PaqueteID ?? "").ToString();
    string paqueteDescripcion = (ViewBag.PaqueteDescripcion ?? "").ToString();
}

@section Styles {
    <link href="~/Content/mat.paquete.css" rel="stylesheet" />
}

<div class="modern-page-container">
    <div class="vinculos-container">
        <div class="modern-page-header">
            <h2 class="modern-page-title">
                <i class="bi bi-link-45deg"></i>
                <span>Vínculos @(string.IsNullOrEmpty(paqueteDescripcion) ? "" : "— " + paqueteDescripcion)</span>
            </h2>
            <div class="modern-page-actions">
                <a href="/Paquete/Edit/?sAction=detail&sPaqueteID=@paqueteId" class="btn-modern btn-modern-secondary">
                    <i class="bi bi-box-seam"></i>
                    <span>Ver paquete</span>
                </a>
                <a href="/Paquete/Index" class="btn-modern btn-modern-secondary">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver</span>
                </a>
            </div>
        </div>

        <div id="vinculos-sections">
            @Html.Partial("_PaqueteVinculosSections", Model)
        </div>
    </div>
</div>

<!-- Modal generico de vinculacion (Bootstrap 5) -->
<div class="modal fade" id="modalVincular" tabindex="-1" aria-labelledby="modalVincularTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalVincularTitle">Vincular</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="pq-modal-search">
                    <i class="bi bi-search"></i>
                    <input type="text" id="vincularSearch" placeholder="Buscar por descripción..." autocomplete="off" />
                </div>
                <div id="vincularGrid" class="pq-grid-container">
                    <div class="pq-loading"><span class="pq-spinner"></span> Cargando...</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@Html.Partial("_AdminConfirmModal")

@section Scripts {
    <script src="~/Scripts/mat.admin-utils.js"></script>
    <script src="~/Scripts/mat.paquete.js"></script>
    <script type="text/javascript">
        $(document).ready(function () {
            MatPaquete.initVinculos("@paqueteId");
        });
    </script>
}
