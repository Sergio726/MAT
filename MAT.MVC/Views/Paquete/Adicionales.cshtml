@model Guid

<style>
    .adicionales-modal-container {
        padding: 0.5rem;
    }
    .search-section {
        margin-bottom: 1rem;
    }
    .search-wrapper {
        position: relative;
        max-width: 400px;
    }
    .search-wrapper input {
        width: 100%;
        padding: 0.625rem 1rem;
        padding-left: 2.5rem;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s ease;
    }
    .search-wrapper input:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .search-wrapper input::placeholder {
        color: var(--text-secondary, #9ca3af);
    }
    .search-wrapper i {
        position: absolute;
        left: 0.875rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-secondary, #9ca3af);
    }
    .grid-container {
        min-height: 150px;
        background: var(--bg-secondary, #f9fafb);
        border-radius: 0.5rem;
        padding: 0.5rem;
    }
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
    }
    .btn-close-modal {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-primary, #374151);
        border: none;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-close-modal:hover {
        background: #e5e7eb;
    }
</style>

<input id="guid-paquete" type="hidden" value="@Model.ToString()" />

<div class="adicionales-modal-container">
    <div class="search-section">
        <div class="search-wrapper">
            <i class="bi bi-search"></i>
            <input id="txt-filter-adicional" type="text" placeholder="Buscar adicional por descripcion..." />
        </div>
    </div>

    <div id="grid-adicionales" class="grid-container">
        <div style="display: flex; align-items: center; justify-content: center; padding: 2rem; color: var(--text-secondary, #9ca3af);">
            <div style="width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #e91e63; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 0.5rem;"></div>
            Cargando adicionales...
        </div>
    </div>

    <div class="modal-actions">
        <a class="btn-close-modal" id="btn-cerrar-ventana-adicionales" href="#">
            <i class="bi bi-x-lg"></i>
            Cerrar
        </a>
    </div>
</div>

<script type="text/javascript">
    jQuery(function ($) {
        $("div#grid-adicionales").load("/Paquete/RenderGridAdicionales?id=" + $("#guid-paquete").val());
    });
</script>
