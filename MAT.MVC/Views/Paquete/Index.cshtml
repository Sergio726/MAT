@model List<MAT.MVC.Models.PaqueteStandard>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblPaquetes").DataTable({
            columnDefs: [
                { targets: 4, orderable: false } // Evita que se ordene la columna de acciones
            ],
            pageLength: 25,
            order: [[1, "desc"]], // Ordenar por fecha de creación descendente
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ paquetes",
                infoEmpty: "No hay paquetes disponibles",
                infoFiltered: "(filtrado de _MAX_ paquetes totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            }
        });
    });
</script>

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-box-seam"></i>
            <span>Lista de Paquetes</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/Paquete/Edit/?sAction=new" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Paquete</span>
            </a>
        </div>
    </div>

    @if (ViewData["error"] != null)
    {
        <div class="modern-alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@ViewData["error"].ToString()</span>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table" id="tblPaquetes">
            <thead>
                <tr>
                    <th>Paquete</th>
                    <th>Fecha de Creación</th>
                    <th>Moneda</th>
                    <th>Temporada</th>
                    <th style="width: 180px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (MAT.MVC.Models.PaqueteStandard item in Model)
                {
                    <tr>
                        <td><strong>@item.Descripcion</strong></td>
                        <td>
                            @if (item.FechaCreacion.Year != 1)
                            {
                                <span>@item.FechaCreacion.ToShortDateString()</span>
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            <span class="badge-moneda @(item.MonedaCodigo == "ARS" || item.MonedaCodigo == "PES" ? "badge-moneda-pesos" : "badge-moneda-dolar")">
                                @item.MonedaCodigo
                            </span>
                        </td>
                        <td>@item.Temporada</td>
                        <td>
                            <div class="table-actions">
                                <a href="/Paquete/Vinculos/@item.PaqueteID" class="btn-action btn-action-info" title="Vínculos">
                                    <i class="bi bi-link-45deg"></i>
                                </a>
                                <a href="/Paquete/Edit/?sAction=edit&sPaqueteID=@item.PaqueteID" class="btn-action btn-action-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/Paquete/Edit/?sAction=detail&sPaqueteID=@item.PaqueteID" class="btn-action btn-action-view" title="Detalle">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/Paquete/Delete/@item.PaqueteID" class="btn-action btn-action-delete" title="Eliminar" onclick="return confirm('¿Está seguro que desea eliminar este paquete?');">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
