@model Guid

<input id="guid-paquete" type="hidden" value="@Model.ToString()"
<div id="search-precio">
    <div id="busqueda-precio">
        <input id="txt-filter-precio" type="text" placeholder="Ingrese una Descripción" />
    </div>
</div>
<div id="grid-precios">
</div>

<p class="botonera-form">
    <a class="btn btn-small btn-inverse" id="btn-cerrar-ventana-precios">Cerrar</a>
</p>
<script type="text/javascript">
    jQuery(function ($) {
        $("div#grid-precios").load("/Paquete/RenderGridPrecios?id=" + $("#guid-paquete").val());
    });

</script>