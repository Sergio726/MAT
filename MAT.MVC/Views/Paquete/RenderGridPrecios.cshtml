@model IEnumerable<MAT.Entities.Precio>
@using MAT.Enums
@using MAT.Utilities
@using MAT.Entities
<table class="partial-grid mat-customtable">
    <thead>
    <tr>
        <th class="hidden">
        </th>
        <th>
            @Html.Label("Descripción")
        </th>
        <th>
        </th>       
    </tr>
        </thead>
    <tbody>    
@foreach (var item in Model) {
    <tr>
        <td class="hidden">
            @item.PrecioId
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Descripcion)
        </td>
        <td>
            <a href="#" id="btn-vincular-precio" data-precio="@item.PrecioId">
                        <img src="/Images/link.png" width="32" height="32" title="Vincular Precio" /></a>            
        </td>
    </tr>
}
        </tbody>
</table>
<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");
    });
</script>
