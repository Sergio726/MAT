@model IEnumerable<MAT.Entities.Excursion>
@using MAT.Enums
@using MAT.Utilities
@using MAT.Entities
<style>
    #tblExcursiones.dataTable thead th {
        padding: 0.75rem 1rem;
        text-align: left;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        background: var(--bg-secondary, #f9fafb);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblExcursiones.dataTable tbody td {
        padding: 0.875rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblExcursiones.dataTable tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .btn-link-modern {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: var(--primary-color, #e91e63);
        color: white;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-link-modern:hover {
        background: var(--primary-hover, #d81b60);
        color: white;
        text-decoration: none;
    }
    .btn-link-modern i {
        color: white;
    }
    .excursion-options {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 0.75rem;
    }
    .optional-check {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0.625rem;
        background: #fef3c7;
        border: 1px solid #fde68a;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #d97706;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
    }
    .optional-check:hover {
        background: #fde68a;
    }
    .optional-check input[type="checkbox"] {
        accent-color: #d97706;
        width: 14px;
        height: 14px;
        cursor: pointer;
        margin: 0;
    }
</style>
<div class="custom_margin_top_10">
    <table id="tblExcursiones" class="partial-grid" style="width:100%; border-collapse:collapse;">
   <thead>
    <tr>
        <th>
            Descripcion
        </th>
        <th>
            Opciones
        </th>
    </tr>
        </thead>

    </table>
    <div id="divTools" class="hide">
        <div class="excursion-options">
            <label class="optional-check">
                <input type="checkbox" name="IsOpcional" title="Marcar como opcional"/>
                Opcional
            </label>
            <a href="#" id="btn-vincular-excursion" data-excursion="{{ExcursionID}}" class="btn-link-modern" title="Vincular Excursion">
                <i class="bi bi-plus-lg"></i>
            </a>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function(){
        loadExcursiones();
    });

    function loadExcursiones() {
        var jResult = @Html.Raw(ViewBag.jResult);
        var jTables = eval(jResult);
        var jt = jTables["Table"];

        var table = $("#tblExcursiones").DataTable({
            "aaData": jt,
            "columns": [
        	{ "data": "Descripcion" },
        	{ "data": "ExcursionID",
        	    "mRender": function (data, type, row) {
        	        var _data = { "ExcursionID": row.ExcursionID}
        	        var data = $("#divTools").html().trim().render(_data);
        	        return data;
        	    }
        	},

            ],
            "bAutoWidth": false,
            "pageLength": 25
        });
    };
</script>
