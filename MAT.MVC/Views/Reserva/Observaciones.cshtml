<div class="modern-observaciones-container">
    <div class="modern-observaciones-header">
        <div class="modern-observaciones-title">
            <i class="bi bi-chat-left-text"></i>
            <h3>Observaciones Generales</h3>
        </div>
        <div class="modern-observaciones-actions">
            <button type="button" class="btn-modern-observacion btn-modern-observacion-secondary" onclick="javascript: fnPrintObservaciones();" title="Imprimir Observaciones">
                <i class="bi bi-printer"></i>
                <span>Imprimir</span>
            </button>
            <button type="button" class="btn-modern-observacion btn-modern-observacion-primary" onclick="javascript: fnAddObsevacion();" title="Agregar una observación">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Observación</span>
            </button>
        </div>
    </div>
    <div class="modern-observaciones-content">
        <div id="divObsGeneral" class="modern-observaciones-table-wrapper">
            <div class="text-center py-4">
                <div class="spinner-border spinner-border-sm text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        getObservacionesGenerales();

    });

    function getObservacionesGenerales() {
        var divLoading = '<div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>';
        $("#divObsGeneral").html(divLoading);
        
        $.ajax({
            url: "/Reserva/ObservacionesGenerales",
            data: { "sViajeId": "@ViewBag.ViajeID" },
            dataType: "html",
            success: function (data) {
                $("#divObsGeneral").html(data);
            }
        })
    }

    function fnAddObsevacion() {
        var url = "/Reserva/ObservacionABM?sViajeID=" + "@ViewBag.ViajeID";
        var dialogid = "popup_Observacion";
        var dialogtitle = "Agregar Observación";
        var widthsize = "min";
        ShowFormDialog(url, dialogid, dialogtitle, widthsize)
     
    }

    function fnPrintObservaciones() {
        var url = "/Reserva/PrintObservaciones?sViajeId=" + "@ViewBag.ViajeID";
        window.open(url, '_blank').print();
    }
</script>