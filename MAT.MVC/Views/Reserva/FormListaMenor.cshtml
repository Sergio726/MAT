@model List<MAT.Entities.PersonaCliente>
@using MAT.Enums
@using MAT.Utilities
@using MAT.Entities

<style>
    .form-lista-menor-container {
        padding: 0.5rem;
    }
    .help-icon-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 0.5rem;
    }
    .help-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.375rem 0.75rem;
        background: #fef3c7;
        color: #92400e;
        border-radius: 0.375rem;
        font-size: 0.75rem;
    }
    .help-badge i {
        font-size: 0.875rem;
    }
    .table-container {
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    #tblListaMenor {
        width: 100% !important;
    }
    #tblListaMenor thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblListaMenor tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblListaMenor tbody tr {
        cursor: pointer;
        transition: background 0.2s ease;
    }
    #tblListaMenor tbody tr:hover {
        background: #fce7f3;
    }
    #tblListaMenor tbody tr.selected {
        background: #fbcfe8;
    }
    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
    }
    .btn-modal {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        border: none;
        border-radius: 0.375rem;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-modal-primary {
        background: var(--primary-color, #e91e63);
        color: white;
    }
    .btn-modal-primary:hover {
        background: var(--primary-hover, #d81b60);
    }
    .btn-modal-secondary {
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-primary, #374151);
    }
    .btn-modal-secondary:hover {
        background: #e5e7eb;
    }
</style>

<div class="form-lista-menor-container">
    <div class="help-icon-row">
        <div class="help-badge" title="La lista solo muestra aquellas personas de 1 a 4 años de edad.">
            <i class="bi bi-info-circle"></i>
            Menores de 1 a 4 años
        </div>
    </div>

    <div class="table-container">
        <table id="tblListaMenor" class="display">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Nro Documento</th>
                </tr>
            </thead>
            <tbody>
                @foreach (PersonaCliente item in Model)
                {
                    <tr data-id="@item.ClienteId" data-apellido="@item.Apellido" data-nombre="@item.Nombre">
                        <td>@item.Apellido</td>
                        <td>@item.Nombre</td>
                        <td>@item.NroDocumento</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="modal-actions">
        <button type="button" class="btn-modal btn-modal-secondary" onclick="closePopup();">
            <i class="bi bi-x-lg"></i>
            Cancelar
        </button>
        <button type="button" class="btn-modal btn-modal-primary" onclick="vincularListMenor();">
            <i class="bi bi-link-45deg"></i>
            Vincular
        </button>
    </div>
</div>

<script type="text/javascript">
    var ListMenorID = [];

    $(document).ready(function () {
        $("#tblListaMenor").DataTable({
            "pageLength": 10,
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
            }
        });

        ListMenorID = [];
        $('#tblListaMenor tbody').on('click', 'tr', function () {
            var nrMenores = $("#numMenor").val();
            var MenorID = $(this).data("id");
            var idxItem = ListMenorID.indexOf(MenorID);

            if (idxItem > -1) {
                ListMenorID.splice(idxItem, 1);
                $(this).removeClass('selected');
            }
            else {
                if (nrMenores <= ListMenorID.length) {
                    return (window.alertInfo || window.alert)("Solo puede seleccionar hasta " + nrMenores + " menores. Si desea seleccionar más, cambie la cantidad de seguro de menor.", "Validación");
                }
                ListMenorID.push(MenorID);
                $(this).addClass('selected');
            }
        });
    });

    function closePopup() {
        ListMenorID = [];
        $("#divFormListaMenor").dialog("close");
    }

    function vincularListMenor() {
        var nrMenores = $("#numMenor").val();
        if (nrMenores > ListMenorID.length) {
            var n = parseInt(nrMenores) - parseInt(ListMenorID.length);
            return (window.alertInfo || window.alert)("Por favor seleccione " + n + " menores más.", "Validación");
        }
        $("#hdnListMenor").val(ListMenorID);
        $("#divFormListaMenor").dialog("close");
    }
</script>
