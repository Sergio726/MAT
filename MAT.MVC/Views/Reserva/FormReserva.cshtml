@using MAT.MVC.Models
@using MAT.Enums
@using MAT.Utilities
@model ReservaModel

<style>
    .reserva-container {
        padding: 0.5rem;
    }
    .reserva-layout {
        display: flex;
        gap: 1.5rem;
    }
    .reserva-form {
        flex: 1;
        min-width: 0;
    }
    .reserva-total {
        width: 280px;
        flex-shrink: 0;
    }
    .reserva-info-card {
        background: linear-gradient(135deg, #fce7f3 0%, #fbcfe8 100%);
        border-radius: 0.75rem;
        padding: 1rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }
    .reserva-info-icon {
        width: 40px;
        height: 40px;
        background: white;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-color, #e91e63);
        font-size: 1.25rem;
    }
    .reserva-info-content {
        flex: 1;
    }
    .reserva-info-label {
        font-size: 0.7rem;
        color: #9d174d;
        text-transform: uppercase;
        font-weight: 600;
    }
    .reserva-info-value {
        font-size: 1.25rem;
        font-weight: 700;
        color: #831843;
    }
    .reserva-form-section {
        margin-bottom: 1.25rem;
    }
    .reserva-section-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        padding-bottom: 0.5rem;
        margin-bottom: 0.75rem;
        border-bottom: 2px solid var(--primary-color, #e91e63);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .reserva-section-title i {
        color: var(--primary-color, #e91e63);
    }
    .reserva-form-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }
    .reserva-form-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .reserva-form-group.full-width {
        grid-column: span 2;
    }
    .reserva-form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .reserva-form-label i {
        color: var(--primary-color, #e91e63);
        font-size: 0.8rem;
    }
    .reserva-form-input,
    .reserva-form-select,
    .reserva-form-textarea {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        background: white;
        transition: all 0.2s ease;
    }
    .reserva-form-input:focus,
    .reserva-form-select:focus,
    .reserva-form-textarea:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .reserva-form-input:disabled,
    .reserva-form-select:disabled {
        background: var(--bg-secondary, #f9fafb);
        color: var(--text-secondary, #9ca3af);
        cursor: not-allowed;
    }
    .reserva-form-textarea {
        min-height: 70px;
        resize: vertical;
    }
    .radio-group {
        display: flex;
        gap: 1rem;
        padding: 0.25rem 0;
    }
    .radio-option {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
        font-size: 0.875rem;
        color: var(--text-primary, #374151);
    }
    .radio-option input[type="radio"] {
        accent-color: var(--primary-color, #e91e63);
    }
    .checkbox-group {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.25rem 0;
    }
    .checkbox-group input[type="checkbox"] {
        accent-color: var(--primary-color, #e91e63);
        width: 16px;
        height: 16px;
    }
    .checkbox-group label {
        font-size: 0.875rem;
        color: var(--text-primary, #374151);
        cursor: pointer;
    }
    .descuento-fields {
        display: flex;
        gap: 0.5rem;
        margin-top: 0.5rem;
    }
    .descuento-fields input {
        flex: 1;
    }
    .reserva-total-card {
        background: white;
        border-radius: 0.75rem;
        padding: 1rem;
        border: 1px solid var(--border-color, #e5e7eb);
    }
    .reserva-total-amount {
        text-align: center;
        padding: 1rem;
        background: var(--bg-secondary, #f9fafb);
        border-radius: 0.5rem;
        margin-bottom: 1rem;
    }
    .reserva-total-label {
        font-size: 0.75rem;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        font-weight: 600;
        margin-bottom: 0.25rem;
    }
    .reserva-total-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--primary-color, #e91e63);
    }
    .reserva-total-usd {
        display: none;
        font-size: 0.875rem;
        color: var(--text-secondary, #6b7280);
        margin-top: 0.25rem;
    }
    .cotizador-wrapper {
        display: none;
        margin-top: 1rem;
    }
    .cotizador-wrapper.visible {
        display: block;
    }
    .cotizador-loading {
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem;
    }
    .reserva-actions {
        display: flex;
        gap: 0.5rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
    }
    .btn-reserva {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        padding: 0.625rem 1.25rem;
        border-radius: 0.375rem;
        font-weight: 500;
        font-size: 0.875rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-reserva-primary {
        background: var(--primary-color, #e91e63);
        color: white;
    }
    .btn-reserva-primary:hover {
        background: var(--primary-hover, #d81b60);
    }
    .btn-reserva-secondary {
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-primary, #374151);
        border: 1px solid var(--border-color, #e5e7eb);
    }
    .btn-reserva-secondary:hover {
        background: var(--border-color, #e5e7eb);
    }
    .loading-spinner {
        width: 32px;
        height: 32px;
        border: 3px solid var(--border-color, #e5e7eb);
        border-top-color: var(--primary-color, #e91e63);
        border-radius: 50%;
        animation: spin 0.8s linear infinite;
    }
    @@keyframes spin {
        to { transform: rotate(360deg); }
    }
    @@media (max-width: 768px) {
        .reserva-layout {
            flex-direction: column;
        }
        .reserva-total {
            width: 100%;
        }
        .reserva-form-grid {
            grid-template-columns: 1fr;
        }
        .reserva-form-group.full-width {
            grid-column: span 1;
        }
    }
</style>

<div class="reserva-container">
    <div class="reserva-layout">
        <!-- Formulario Principal -->
        <div class="reserva-form">
            <!-- Info de Pasajes -->
            <div class="reserva-info-card">
                <div class="reserva-info-icon">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <div class="reserva-info-content">
                    <div class="reserva-info-label">Pasajes Seleccionados</div>
                    <div class="reserva-info-value">@ViewBag.CantPasajes</div>
                </div>
            </div>

            <!-- Seccion: Cliente -->
            <div class="reserva-form-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-person"></i>
                    Datos del Cliente
                </h3>
                <div class="reserva-form-grid">
                    <div class="reserva-form-group full-width">
                        <label class="reserva-form-label">
                            <i class="bi bi-search"></i>
                            Buscar Cliente
                        </label>
                        <input type="text" id="txt-busqueda-cliente" class="reserva-form-input" placeholder="Ingrese nombre o DNI..." />
                        <input type="hidden" id="Cliente" name="Cliente" />
                    </div>
                </div>
            </div>

            <!-- Seccion: Condicion de Venta -->
            <div class="reserva-form-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-cash-coin"></i>
                    Condicion de Venta
                </h3>
                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" name="condicion" value="Efectivo" checked="checked" />
                        Efectivo
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="condicion" value="Cuenta Corriente" />
                        Cuenta Corriente
                    </label>
                </div>
            </div>

            <!-- Seccion: Pago (visible solo en Efectivo) -->
            <div id="efectivo" class="reserva-form-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-credit-card"></i>
                    Informacion de Pago
                </h3>
                <div class="reserva-form-grid">
                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-wallet2"></i>
                            Forma de Pago
                        </label>
                        @Html.DropDownListFor(m => m.Pago.TipoPago, eFormaPago.Credito.ToSelectList(), new { @class = "reserva-form-select" })
                    </div>

                    <div class="reserva-form-group" id="transaccion-group" style="display: none;">
                        <label class="reserva-form-label">
                            <i class="bi bi-hash"></i>
                            N de Transaccion
                        </label>
                        <input type="text" name="TransaccionId" id="TransaccionId" class="reserva-form-input" />
                    </div>

                    <div class="reserva-form-group" id="credito-group" style="display: none;">
                        <label class="reserva-form-label">
                            <i class="bi bi-bank"></i>
                            Credito Disponible
                        </label>
                        <input type="text" name="total-credito" id="total-credito" class="reserva-form-input" disabled />
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-currency-exchange"></i>
                            Moneda
                        </label>
                        <select name="MonedaTipo" id="sMonedaTipo" class="reserva-form-select" onchange="changeMonedaTipo(this);">
                            @foreach (MAT.MVC.Models.MonedaTipo item in MAT.MVC.Models.MonedaMethod.GetMonedaTipoAll())
                            {
                                <option value="@item.Id" @(item.Id == 1 ? "selected" : "")>@item.Codigo</option>
                            }
                        </select>
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-cash"></i>
                            Monto a Abonar
                        </label>
                        <input type="text" name="MontoPago" class="reserva-form-input money" id="txtPago" placeholder="0,00" />
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-receipt"></i>
                            N de Recibo
                            <input type="radio" value="Recibo" name="comprobante" checked style="margin-left: 0.5rem;" />
                        </label>
                        <input type="text" name="Recibo" id="txtRecibo" class="reserva-form-input" />
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-file-earmark-text"></i>
                            N de Factura
                            <input type="radio" value="Factura" name="comprobante" style="margin-left: 0.5rem;" />
                        </label>
                        <input type="text" name="nroFactura" id="txtnroFactura" class="reserva-form-input" disabled="disabled" />
                    </div>

                    <div class="reserva-form-group full-width">
                        <div class="checkbox-group">
                            <input type="checkbox" name="chkDescuento" id="chkDescuento" />
                            <label for="chkDescuento">Aplicar Descuento</label>
                        </div>
                        <div class="descuento-fields">
                            <input type="text" name="Descuento" id="txtDescuento" disabled="disabled" class="reserva-form-input money" placeholder="Monto" />
                            <input type="text" name="detalledescuento" id="detalledescuento" disabled="disabled" class="reserva-form-input" placeholder="Detalle del descuento" />
                        </div>
                    </div>

                    <div class="reserva-form-group full-width">
                        <label class="reserva-form-label">
                            <i class="bi bi-chat-left-text"></i>
                            Observaciones
                        </label>
                        <textarea name="Observaciones" id="Observaciones" class="reserva-form-textarea" placeholder="Observaciones adicionales..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Acciones -->
            <div class="reserva-actions">
                <button type="button" name="btnReservarPasaje" id="btnReservarPasaje" class="btn-reserva btn-reserva-primary">
                    <i class="bi bi-check-lg"></i>
                    Confirmar Reserva
                </button>
                <button type="button" name="btnCancelarReserva" id="btnCancelarReserva" class="btn-reserva btn-reserva-secondary">
                    <i class="bi bi-x-lg"></i>
                    Cancelar
                </button>
            </div>
        </div>

        <!-- Panel Total -->
        <div class="reserva-total">
            <div class="reserva-total-card">
                <div id="divMontoTotal1" class="reserva-total-amount">
                    <div class="reserva-total-label">Monto Total</div>
                    <div class="reserva-total-value">@string.Format("{0:C}", ViewBag.MontoFactura)</div>
                </div>

                <div id="divMontoTotal2" class="reserva-total-amount" style="display: none;">
                    <div class="reserva-total-label">Total (USD)</div>
                    <div class="reserva-total-value">@string.Format("{0:C}", ViewBag.MontoFactura)</div>
                </div>

                <input type="hidden" id="hdnMontoFactura" value="@ViewBag.MontoFactura" />

                <div id="divContentCotizador" class="cotizador-wrapper">
                    <div class="cotizador-loading">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" name="jsonobject" id="jsonobject" value="@ViewBag.Pasajes" />

<script>
    var ViajeMonedaTipo = parent.$("#hdnViajeMonedaTipo").val();

    $(document).ready(function () {
        $('.money').mask("#.##0,00", { reverse: true });

        if (ViajeMonedaTipo != "1") {
            $("#divMontoTotal1").hide();
            $("#divMontoTotal2").show();
            loadCotizador();
        }

        // Client autocomplete
        $("#txt-busqueda-cliente").autocomplete({
            minLength: 3,
            source: function (request, response) {
                $.ajax({
                    url: "/Reserva/QuickClienteSearch",
                    data: { query: request.term },
                    success: function (data) {
                        response($.map(data, function (item) {
                            return {
                                label: item.Nombre + " " + item.Apellido + " | DNI " + item.NroDocumento,
                                value: item.Nombre + " " + item.Apellido,
                                id: item.ClienteId
                            }
                        }));
                    }
                });
            },
            select: function (event, ul) {
                $("#Cliente").val(ul.item.id);
            }
        });

        // Comprobante toggle
        $("input[name='comprobante']").click(function () {
            if ($(this).val() == "Recibo") {
                $("#txtRecibo").attr("disabled", false);
                $("#txtnroFactura").attr("disabled", true).val("");
            } else {
                $("#txtRecibo").attr("disabled", true).val("");
                $("#txtnroFactura").attr("disabled", false);
            }
        });

        // Descuento toggle
        $("#chkDescuento").change(function () {
            var disabled = !$(this).is(":checked");
            $("#txtDescuento, #detalledescuento").attr("disabled", disabled);
            if (disabled) {
                $("#txtDescuento, #detalledescuento").val("");
            }
        });
    });

    $(function () {
        // Hide credit display initially
        $("#credito-group").hide();

        // Condicion de venta toggle
        $("input[name='condicion']").change(function () {
            var condicion = $(this).val();
            if (condicion == "Efectivo") {
                $("#efectivo").show();
            } else {
                $("#efectivo").hide();
            }
        });

        // Payment type toggle
        $("select[name='Pago.TipoPago']").change(function () {
            var tipopago = parseInt($(this).val());
            // CREDITO, DEBITO, TRANSFERENCIA
            if (tipopago == 2 || tipopago == 3 || tipopago == 4 || tipopago == 5 || tipopago == 6) {
                $("#transaccion-group").show();
            } else {
                $("#transaccion-group").hide();
            }
        }).trigger("change");
    });

    function loadCotizador() {
        $("#divContentCotizador").addClass("visible");
        $.ajax({
            url: "/Herramientas/Cotizador",
            data: { "sMode": "1" },
            success: function (data) {
                $("#divContentCotizador").html(data);
            }
        });
    }

    function changeMonedaTipo(o) {
        var MonedaTipo = $(o).val();
        if (!$("#divContentCotizador").hasClass("visible")) {
            if (MonedaTipo != "1") {
                loadCotizador();
            }
        }
    }
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
