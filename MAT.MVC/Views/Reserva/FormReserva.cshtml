@using MAT.MVC.Models
@using MAT.Enums
@using MAT.Utilities
@model ReservaModel

<div class="reserva-container">
    <div class="reserva-layout">
        <!-- Formulario Principal -->
        <div class="reserva-form">
            <!-- Info de Pasajes -->
            <div class="reserva-info-card">
                <div class="reserva-info-icon">
                    <i class="bi bi-ticket-perforated"></i>
                </div>
                <div class="reserva-info-content">
                    <div class="reserva-info-label">Pasajes Seleccionados</div>
                    <div class="reserva-info-value">@ViewBag.CantPasajes</div>
                </div>
            </div>

            <!-- Seccion: Cliente -->
            <div class="reserva-form-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-person"></i>
                    Datos del Cliente
                </h3>
                <div class="reserva-form-grid">
                    <div class="reserva-form-group full-width">
                        <label class="reserva-form-label">
                            <i class="bi bi-person-badge"></i>
                            Buscar Cliente
                        </label>
                        <div class="cliente-search-wrapper" id="cliente-search-wrapper">
                            <i class="bi bi-search search-icon"></i>
                            <input type="text" id="txt-busqueda-cliente" class="reserva-form-input" placeholder="Escriba nombre, apellido o DNI..." autocomplete="off" />
                            <div class="search-loading"></div>
                        </div>
                        <div class="cliente-selected" id="cliente-selected">
                            <div class="cliente-selected-avatar" id="cliente-avatar">--</div>
                            <div class="cliente-selected-info">
                                <div class="cliente-selected-name" id="cliente-nombre">-</div>
                                <div class="cliente-selected-dni" id="cliente-dni">DNI: -</div>
                            </div>
                            <button type="button" class="cliente-selected-remove" id="btn-remove-cliente" title="Quitar cliente">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>
                        <input type="hidden" id="Cliente" name="Cliente" />
                    </div>
                </div>
            </div>

            <!-- Seccion: Presupuesto vinculado -->
            <div class="reserva-form-section" id="presupuesto-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-file-earmark-text"></i>
                    Presupuesto
                </h3>
                @if (ViewBag.Presupuesto != null)
                {
                    var p = ViewBag.Presupuesto;
                    <div class="reserva-presupuesto-vinculado" style="padding: 0.75rem; background: #fef3c7; border-radius: 8px; margin-bottom: 0.5rem;">
                        <strong><i class="bi bi-check-circle"></i> Presupuesto vinculado</strong>
                        <div style="font-size: 0.875rem; margin-top: 0.35rem;">
                            <span><strong>Código:</strong> @p.CodigoSeguimiento</span>
                            <span style="margin-left: 1rem;"><strong>Cliente:</strong> @p.NombreCliente</span>
                            <span style="margin-left: 1rem;"><strong>Monto:</strong> @string.Format("{0:C}", p.MontoPactado)</span>
                        </div>
                        <a href="@Url.Action("ImprimirPresupuesto", "Presupuesto", new { codigo = p.CodigoSeguimiento })" target="_blank" class="btn-modern btn-modern-secondary btn-sm" style="margin-top: 0.5rem;">
                            <i class="bi bi-download"></i> Descargar
                        </a>
                    </div>
                    <input type="hidden" id="presupuestoIdReserva" name="presupuestoIdReserva" value="@p.PresupuestoId" />
                }
                else
                {
                    <div class="presupuesto-buscar-opcional" style="display: flex; gap: 0.5rem; align-items: flex-start; flex-wrap: wrap;">
                        <input type="text" id="txt-buscar-presupuesto" class="reserva-form-input" placeholder="Código de presupuesto (opcional)" style="max-width: 220px;" />
                        <button type="button" id="btn-buscar-presupuesto" class="btn-reserva btn-reserva-secondary btn-sm">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                    <div id="presupuesto-encontrado" class="reserva-presupuesto-vinculado" style="display: none; padding: 0.75rem; background: #fef3c7; border-radius: 8px; margin-top: 0.5rem;">
                        <strong><i class="bi bi-check-circle"></i> Presupuesto encontrado</strong>
                        <div style="font-size: 0.875rem; margin-top: 0.35rem;" id="presupuesto-encontrado-datos"></div>
                        <input type="hidden" id="presupuestoIdReserva" name="presupuestoIdReserva" value="" />
                    </div>
                }
            </div>

            <!-- Seccion: Condicion de Venta -->
            <div class="reserva-form-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-cash-coin"></i>
                    Condicion de Venta
                </h3>
                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" name="condicion" value="Efectivo" checked="checked" />
                        Efectivo
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="condicion" value="Cuenta Corriente" />
                        Cuenta Corriente
                    </label>
                </div>
            </div>

            <!-- Seccion: Pago (visible solo en Efectivo) -->
            <div id="efectivo" class="reserva-form-section">
                <h3 class="reserva-section-title">
                    <i class="bi bi-credit-card"></i>
                    Informacion de Pago
                </h3>
                <div class="reserva-form-grid">
                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-wallet2"></i>
                            Forma de Pago
                        </label>
                        @Html.DropDownListFor(m => m.Pago.TipoPago, eFormaPago.Credito.ToSelectList(), new { @class = "reserva-form-select" })
                    </div>

                    <div class="reserva-form-group" id="transaccion-group" style="display: none;">
                        <label class="reserva-form-label">
                            <i class="bi bi-hash"></i>
                            N de Transaccion
                        </label>
                        <input type="text" name="TransaccionId" id="TransaccionId" class="reserva-form-input" />
                    </div>

                    <div class="reserva-form-group" id="credito-group" style="display: none;">
                        <label class="reserva-form-label">
                            <i class="bi bi-bank"></i>
                            Credito Disponible
                        </label>
                        <input type="text" name="total-credito" id="total-credito" class="reserva-form-input" disabled />
                        <div id="credito-status-msg" class="credito-status credito-info" style="display:none; margin-top:0.35rem; font-size:0.8125rem; font-weight:500;"></div>
                    </div>
                    <style>.credito-status.credito-ok { color: #059669; } .credito-status.credito-fail { color: #dc2626; } .credito-status.credito-info { color: #6b7280; }</style>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-currency-exchange"></i>
                            Moneda
                        </label>
                        <select name="MonedaTipo" id="sMonedaTipo" class="reserva-form-select" onchange="changeMonedaTipo(this);">
                            @foreach (MAT.MVC.Models.MonedaTipo item in MAT.MVC.Models.MonedaMethod.GetMonedaTipoAll())
                            {
                                <option value="@item.Id" @(item.Id == 1 ? "selected" : "")>@item.Codigo</option>
                            }
                        </select>
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-cash"></i>
                            Monto a Abonar
                        </label>
                        <input type="text" name="MontoPago" class="reserva-form-input money" id="txtPago" placeholder="0,00" />
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-receipt"></i>
                            N de Recibo
                            <input type="radio" value="Recibo" name="comprobante" checked style="margin-left: 0.5rem;" />
                        </label>
                        <input type="text" name="Recibo" id="txtRecibo" class="reserva-form-input" />
                    </div>

                    <div class="reserva-form-group">
                        <label class="reserva-form-label">
                            <i class="bi bi-file-earmark-text"></i>
                            N de Factura
                            <input type="radio" value="Factura" name="comprobante" style="margin-left: 0.5rem;" />
                        </label>
                        <input type="text" name="nroFactura" id="txtnroFactura" class="reserva-form-input" disabled="disabled" />
                    </div>

                    <div class="reserva-form-group full-width">
                        <div class="checkbox-group">
                            <input type="checkbox" name="chkDescuento" id="chkDescuento" />
                            <label for="chkDescuento">Aplicar Descuento</label>
                        </div>
                        <div class="descuento-fields">
                            <input type="text" name="Descuento" id="txtDescuento" disabled="disabled" class="reserva-form-input money" placeholder="Monto" />
                            <input type="text" name="detalledescuento" id="detalledescuento" disabled="disabled" class="reserva-form-input" placeholder="Detalle del descuento" />
                        </div>
                    </div>

                    <div class="reserva-form-group full-width">
                        <label class="reserva-form-label">
                            <i class="bi bi-chat-left-text"></i>
                            Observaciones
                        </label>
                        <textarea name="Observaciones" id="Observaciones" class="reserva-form-textarea" placeholder="Observaciones adicionales..."></textarea>
                    </div>
                </div>
            </div>

            <!-- Acciones -->
            <div class="reserva-actions">
                <button type="button" name="btnReservarPasaje" id="btnReservarPasaje" class="btn-reserva btn-reserva-primary">
                    <i class="bi bi-check-lg"></i>
                    Confirmar Reserva
                </button>
                <button type="button" name="btnCancelarReserva" id="btnCancelarReserva" class="btn-reserva btn-reserva-secondary">
                    <i class="bi bi-x-lg"></i>
                    Cancelar
                </button>
            </div>
        </div>

        <!-- Panel Total -->
        <div class="reserva-total">
            <div class="reserva-total-card">
                <div id="divMontoTotal1" class="reserva-total-amount">
                    <div class="reserva-total-label">Monto Total</div>
                    <div class="reserva-total-value">@string.Format("{0:C}", ViewBag.MontoFactura)</div>
                </div>

                <div id="divMontoTotal2" class="reserva-total-amount" style="display: none;">
                    <div class="reserva-total-label">Total (USD)</div>
                    <div class="reserva-total-value">@string.Format("{0:C}", ViewBag.MontoFactura)</div>
                </div>

                <input type="hidden" id="hdnMontoFactura" value="@ViewBag.MontoFactura" />

                <div id="divContentCotizador" class="cotizador-wrapper">
                    <div class="cotizador-loading">
                        <div class="loading-spinner"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<input type="hidden" name="jsonobject" id="jsonobject" value="@ViewBag.Pasajes" />

<script>
    var ViajeMonedaTipo = parent.$("#hdnViajeMonedaTipo").val();

    $(document).ready(function () {
        $('.money').mask("#.##0,00", { reverse: true });

        if (ViajeMonedaTipo != "1") {
            $("#divMontoTotal1").hide();
            $("#divMontoTotal2").show();
            loadCotizador();
        }

        // Client autocomplete mejorado
        $("#txt-busqueda-cliente").autocomplete({
            minLength: 2,
            delay: 300,
            source: function (request, response) {
                // Mostrar loading
                $("#cliente-search-wrapper").addClass("loading");
                
                $.ajax({
                    url: "/Reserva/QuickClienteSearch",
                    data: { query: request.term },
                    success: function (data) {
                        $("#cliente-search-wrapper").removeClass("loading");
                        
                        if (!data || data.length === 0) {
                            response([{ empty: true }]);
                            return;
                        }
                        
                        response($.map(data, function (item) {
                            var iniciales = ((item.Nombre || "").charAt(0) + (item.Apellido || "").charAt(0)).toUpperCase();
                            return {
                                label: item.Nombre + " " + item.Apellido,
                                value: item.Nombre + " " + item.Apellido,
                                id: item.ClienteId,
                                nombre: item.Nombre,
                                apellido: item.Apellido,
                                dni: item.NroDocumento,
                                telefono: item.Telefono,
                                iniciales: iniciales
                            };
                        }));
                    },
                    error: function () {
                        $("#cliente-search-wrapper").removeClass("loading");
                        response([]);
                    }
                });
            },
            select: function (event, ui) {
                if (ui.item.empty) {
                    event.preventDefault();
                    return false;
                }
                
                // Guardar ID
                $("#Cliente").val(ui.item.id);
                
                // Mostrar cliente seleccionado
                $("#cliente-avatar").text(ui.item.iniciales);
                $("#cliente-nombre").text(ui.item.nombre + " " + ui.item.apellido);
                $("#cliente-dni").html('<span class="badge">DNI</span> ' + ui.item.dni);
                $("#cliente-selected").addClass("visible");
                
                // Ocultar input de búsqueda
                $("#txt-busqueda-cliente").val("").hide();
                
                return false;
            },
            open: function () {
                // Aplicar clase personalizada al menú
                $(this).autocomplete("widget").addClass("cliente-autocomplete");
            }
        }).autocomplete("instance")._renderItem = function (ul, item) {
            // Renderizado personalizado de cada item
            if (item.empty) {
                return $("<li>")
                    .append('<div class="cliente-autocomplete-empty"><i class="bi bi-person-x"></i>No se encontraron clientes</div>')
                    .appendTo(ul);
            }
            
            var html = '<div class="ui-menu-item-wrapper">' +
                '<div class="cliente-autocomplete-avatar">' + item.iniciales + '</div>' +
                '<div class="cliente-autocomplete-info">' +
                    '<div class="cliente-autocomplete-name">' + item.nombre + ' ' + item.apellido + '</div>' +
                    '<div class="cliente-autocomplete-dni"><span class="badge">DNI</span> ' + item.dni + '</div>' +
                '</div>' +
            '</div>';
            
            return $("<li>")
                .append(html)
                .appendTo(ul);
        };
        
        // Botón para quitar cliente seleccionado
        $("#btn-remove-cliente").on("click", function () {
            $("#Cliente").val("");
            $("#cliente-selected").removeClass("visible");
            $("#txt-busqueda-cliente").show().val("").focus();
        });

        // Comprobante toggle
        $("input[name='comprobante']").click(function () {
            if ($(this).val() == "Recibo") {
                $("#txtRecibo").attr("disabled", false);
                $("#txtnroFactura").attr("disabled", true).val("");
            } else {
                $("#txtRecibo").attr("disabled", true).val("");
                $("#txtnroFactura").attr("disabled", false);
            }
        });

        // Descuento toggle
        $("#chkDescuento").change(function () {
            var disabled = !$(this).is(":checked");
            $("#txtDescuento, #detalledescuento").attr("disabled", disabled);
            if (disabled) {
                $("#txtDescuento, #detalledescuento").val("");
            }
        });

        // Buscar presupuesto por código (opcional)
        $("#btn-buscar-presupuesto").on("click", function () {
            var codigo = $("#txt-buscar-presupuesto").val().trim().toUpperCase();
            if (!codigo) {
                (window.alertInfo || window.alert)("Ingrese un código de presupuesto.", "Validación");
                return;
            }
            $.post("/Presupuesto/GetByCodigo", { codigoSeguimiento: codigo }, function (data) {
                if (data.success && data.hasPresupuesto && data.presupuesto) {
                    var p = data.presupuesto;
                    if (p.isExpirado) {
                        (window.alertWarning || window.alert)("El presupuesto está expirado.", "Presupuesto expirado");
                        return;
                    }
                    if (p.estado !== "Pendiente") {
                        (window.alertWarning || window.alert)("El presupuesto ya no está pendiente.", "Estado");
                        return;
                    }
                    $("#presupuesto-encontrado-datos").html("<span><strong>Código:</strong> " + p.codigoSeguimiento + "</span><span style='margin-left:1rem;'><strong>Cliente:</strong> " + (p.nombreCliente || p.dniCliente || "N/A") + "</span><span style='margin-left:1rem;'><strong>Monto:</strong> $" + parseFloat(p.montoPactado).toFixed(2) + "</span>");
                    $("#presupuesto-encontrado").find("input[name='presupuestoIdReserva']").val(p.presupuestoId);
                    $("#presupuesto-encontrado").show();
                } else if (data.success && !data.hasPresupuesto) {
                    (window.alertInfo || window.alert)("No se encontró presupuesto con ese código.", "Búsqueda");
                } else {
                    (window.alertError || window.alert)(data.message || "Error al buscar.", "Error");
                }
            }).fail(function () {
                (window.alertError || window.alert)("Error al buscar el presupuesto.", "Error");
            });
        });
    });

    $(function () {
        // Hide credit display initially
        $("#credito-group").hide();

        // Condicion de venta toggle
        $("input[name='condicion']").change(function () {
            var condicion = $(this).val();
            if (condicion == "Efectivo") {
                $("#efectivo").show();
            } else {
                $("#efectivo").hide();
            }
        });

        // Payment type toggle + mostrar crédito cuando es Nota de Crédito
        $("select[name='Pago.TipoPago']").change(function () {
            var tipopago = parseInt($(this).val());
            if (tipopago == 2 || tipopago == 3 || tipopago == 4 || tipopago == 5 || tipopago == 6) {
                $("#transaccion-group").show();
            } else {
                $("#transaccion-group").hide();
            }
            if (tipopago == 4) {
                $("#credito-group").show();
                var ClienteID = $("#ClienteId").val() || $("#Cliente").val();
                if (ClienteID) {
                    $("#credito-status-msg").show().removeClass("credito-ok credito-fail").addClass("credito-info").text("Cargando...");
                    $.get("/NotaCredito/getCreditoDisponible", { ClienteID: ClienteID }, function (data) {
                        var response = typeof data === "string" ? eval(data) : data;
                        if (response[0] == "Done.") {
                            $("#total-credito").val(parseFloat(response[1]));
                            if (typeof updateCreditoStatusMsg === "function") updateCreditoStatusMsg();
                        } else { $("#credito-status-msg").hide(); }
                    }).fail(function () { $("#credito-status-msg").hide(); });
                }
            } else {
                $("#credito-group").hide();
                $("#credito-status-msg").hide();
            }
        }).trigger("change");
    });

    function loadCotizador() {
        $("#divContentCotizador").addClass("visible");
        $.ajax({
            url: "/Herramientas/Cotizador",
            data: { "sMode": "1" },
            success: function (data) {
                $("#divContentCotizador").html(data);
            }
        });
    }

    function changeMonedaTipo(o) {
        var MonedaTipo = $(o).val();
        if (!$("#divContentCotizador").hasClass("visible")) {
            if (MonedaTipo != "1") {
                loadCotizador();
            }
        }
    }
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
