            </div>
        </div>
        <div class="custom_margin_left_10">
            <p>
                <input type="button" name="btnReservarPasaje" id="btnReservarPasaje" title="Reservar" value="Aceptar" class="btn btn-small btn-inverse" />
                <input type="button" name="btnCancelarReserva" id="btnCancelarReserva" title="Cancelar" value="Cancelar" class="btn btn-small btn-inverse" />
            </p>
        </div>
        
    </div>

