@*@model IEnumerable<MAT.Entities.PersonaPasajero>*@
@model List<MAT.Entities.PersonaCliente>
@using MAT.Enums
@using MAT.Utilities
@using MAT.Entities

<link href="~/Content/mat.styles.custom.css" rel="stylesheet" />
<link href="~/Scripts/dataTable/jquery.dataTables.min.css" rel="stylesheet" />
<script src="~/Scripts/dataTable/jquery.dataTables.min.js"></script>

<script type="text/javascript">
    // NO inicializar DataTables aquí - se inicializa desde SeleccionarPasajero.cshtml
    // Esto evita la doble inicialización cuando se carga el contenido via .load()
    $(function () {
        $("table tbody tr:odd").addClass("odd");

        $("#panel-bus a.selected").each(function () {
            var pasajeroid = $(this).data("pasajero");
            if (pasajeroid) {
                $("tr.row-pasajero[data-id=" + pasajeroid + "]").hide();
            }
        });
    });
</script>

<table id="grid-seleccionar-pasajero" class="grid mat-customtable">
    <thead>
    <tr>
        <th class="hidden">
        </th>
        <th>
            Apellido
        </th>
        <th>
            Nombre
        </th>
        <th>
           Tipo Documento
        </th>
        <th>
            Nro Documento
        </th>
        <th>
            Telefono
        </th>
        <th>
            Email
        </th>       
    </tr>
        </thead>
    <tbody>    
@foreach (PersonaCliente item in Model)
{
    <tr class="row-pasajero" data-id="@item.ClienteId">
        <td class="hidden">
            <label name="ClienteId">@item.ClienteId </label>
        </td>
        <td>
            @item.Apellido
        </td>
        <td>
            @item.Nombre
        </td>
        <td>
            @((eTipoDocumento)item.TipoDocumento)
            
        </td>
        <td>
            @item.NroDocumento
        </td>
        <td>
            @item.Telefono
        </td>
        <td>
            @item.Email
        </td>
    </tr>
}
        </tbody>
</table>
<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");

        $("#panel-bus a.selected").each(function () {
            var pasajeroid = $(this).data("pasajero").trim();
            $("tr.row-pasajero[data-id=" + pasajeroid + "]").hide();
        });
    });
</script>
