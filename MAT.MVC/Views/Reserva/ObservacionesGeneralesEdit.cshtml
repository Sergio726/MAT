<style>
    .obs-edit-container {
        padding: 1rem;
    }
    .obs-edit-form {
        display: grid;
        gap: 1rem;
    }
    .obs-edit-row {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 1rem;
    }
    .obs-edit-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .obs-edit-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .obs-edit-label i {
        color: var(--primary-color, #e91e63);
    }
    .obs-edit-input {
        padding: 0.625rem 0.875rem;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        background: white;
        transition: all 0.2s ease;
    }
    .obs-edit-input:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .obs-edit-input:disabled {
        background: var(--bg-secondary, #f9fafb);
        color: var(--text-secondary, #6b7280);
        cursor: not-allowed;
    }
    .obs-edit-textarea {
        min-height: 100px;
        resize: vertical;
    }
</style>

<div class="obs-edit-container">
    <div class="obs-edit-form">
        <div class="obs-edit-row">
            <div class="obs-edit-group">
                <label class="obs-edit-label">
                    <i class="bi bi-airplane"></i>
                    Viaje
                </label>
                <input type="text" class="obs-edit-input" disabled />
            </div>
            <div class="obs-edit-group">
                <label class="obs-edit-label">
                    <i class="bi bi-calendar3"></i>
                    Fecha
                </label>
                <input type="text" class="obs-edit-input" disabled />
            </div>
        </div>

        <div class="obs-edit-row">
            <div class="obs-edit-group">
                <label class="obs-edit-label">
                    <i class="bi bi-people"></i>
                    Pasajeros
                </label>
                <input type="text" class="obs-edit-input" disabled />
            </div>
        </div>

        <div class="obs-edit-row">
            <div class="obs-edit-group">
                <label class="obs-edit-label">
                    <i class="bi bi-chat-left-text"></i>
                    Detalle
                </label>
                <textarea class="obs-edit-input obs-edit-textarea" disabled></textarea>
            </div>
        </div>

        <div class="obs-edit-row">
            <div class="obs-edit-group">
                <label class="obs-edit-label">
                    <i class="bi bi-clock-history"></i>
                    Fecha de Actualización
                </label>
                <input type="text" class="obs-edit-input" disabled />
            </div>
            <div class="obs-edit-group">
                <label class="obs-edit-label">
                    <i class="bi bi-person-badge"></i>
                    Actualizado por
                </label>
                <input type="text" class="obs-edit-input" disabled />
            </div>
        </div>
    </div>
</div>
