
<fieldset class="customborder">
    <legend class="custom_font_size_12">
        Agregar persona a Lista de Espera
    </legend>

    <section class="search-perfil custom_padding_4" style="width:60%;">
        <div>
            <div class="custom_display_inline_flex custom_padding_4 custom_font_weigh_bold">
                <input type="radio" name="type_pasajero" value="Pasajero Temporal" id="op_pTemporal" checked/><label for="op_pTemporal">Pasajero Temporal</label>
            </div>
            <div id="div_B" class="custom_display_inline_flex custom_padding_4 custom_font_weigh_bold">
                <input type="radio" name="type_pasajero" value="Pasajero Frecuente" id="op_pFrecuante" /><label for="op_pFrecuante">Pasajero Frecuente</label>
            </div>
            
            <div id="busqueda-persona" class="custom_display_flex_align_items hide">
                @*<p>Lista de clientes que no se encuentran en viaje actual</p>*@
                <input id="txt-filter-persona-toWaitingList" type="text" placeholder="Ingrese Nombre o DNI" />
                <input type="hidden" id="hdnPassengerID" />
                <input type="hidden" id="hdnViajeID" value="@ViewBag.ViajeID" />

            </div>
            <div id="div-pasajero-temporal" class="custom_display_flex_align_items">
                <input id="txt-pasajero-temporal" type="text" placeholder="Apellido y Nombre" />
            </div>
        </div>
        
        <div>
            <label id="lblResultPersona" class="custom_margin_bottom_10 custom_font_size_11 custom_font_weigh_bold"></label>
            <textarea placeholder="Observaciones" id="txtObservacion" class="custom_width_100percent custom_padding_0"></textarea>
        </div>
        <div class="custom_text_aling_right">
            <input type="button" id="btnAddToList" onclick="AddToList();" value="Agregar a Lista de Espera" class="btn btn-small btn-inverse custom_margin_left_5" />
        </div>



    </section>
</fieldset>



<fieldset class="customborder">
    <legend class="custom_font_size_12">
        Lista de Espera
    </legend>
    <div id="divListOffListPassengers">
        <table id="tblWaitingList" class="mat-customtable">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Vendedor</th>
                    <th>Fecha</th>
                    <th>Observaciones</th>
                    <th></th>
                </tr>
                
            </thead>
        </table>
    </div>
</fieldset>
    

<script type="text/javascript">
    
    $("#op_pTemporal").click(function () {
        $("#div-pasajero-temporal").removeClass("hide");
        $("#busqueda-persona").addClass("hide");
        $("#hdnPassengerID").val("");
        $("#txt-filter-persona-toWaitingList").val("");
        $("#lblResultPersona").text("");
    });

    $("#op_pFrecuante").click(function () {
        $("#busqueda-persona").removeClass("hide");
        $("#div-pasajero-temporal").addClass("hide");
        $("#txt-pasajero-temporal").val("");
    });

    $(function () {
        $("#txt-filter-persona-toWaitingList").autocomplete({
            minLength: 3,
            source: function (request, response) {

                $.ajax({
                    url: "/Reserva/PersonaAutocomplete",
                    data: {
                        sParam: request.term,
                        sViajeID: $("#hdnViajeID").val()
                    },
                    success: function (data) {
                        response($.map(data,
                                    function (item) {
                                        return {
                                            label: item.Nombre + " " + item.Apellido + " - Doc: " + item.NroDocumento,
                                            value: item.Nombre + " " + item.Apellido,
                                            id: item.PersonaID,
                                        }
                                    }));
                    }
                })

            },
            select: function (event, ul) {

                var sRestult = ul.item.label;

                $("#lblResultPersona").text(sRestult);
                $("#hdnPassengerID").val(ul.item.id);
            }
        });

        Load_tblWaitingList('@ViewBag.ViajeID');
    });

    function AddToList() {
        //alert("listo!");
        //mosrtar loading


        $.ajax({
            url: "/Reserva/InsertPersonToWatingList",
            data: {
                sPersonaID: $("#hdnPassengerID").val(),
                sViajeID: $("#hdnViajeID").val(),
                sObservacion: $("#txtObservacion").val(),
                sPasajeroTemporal: $("#txt-pasajero-temporal").val()
            },
            success: function (data) {

                console.log(data);

                CleanDataInputs();
                Load_tblWaitingList('@ViewBag.ViajeID');
            }
        })

    };

  
    function CleanDataInputs(){
        $("#txt-filter-persona-toWaitingList").val("");
        $("#lblResultPersona").text("");
        $("#hdnPassengerID").val("");
        $("#txtObservacion").val("");
        $("#txt-pasajero-temporal").val("");
    }

    var tblWaitingList;
    function Load_tblWaitingList(ViajeID) {


        if (tblWaitingList != undefined) {
            tblWaitingList.clear();
            tblWaitingList.draw();
            tblWaitingList.destroy();
        }

        var jTables = '';


        $.ajax({
            url: "/Reserva/GetWatinList",
            data: {
                ViajeID: ViajeID
            },
            dataType: "json",
            success: function (data) {
                //debugger
                if (data.Error == "") {
                    jTables = JSON.parse(data.jsTable);
                    //console.log(jTables);
                }
                else {
                    alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                    console.log(data.Error);

                }

                //load table

                tblWaitingList = $("#tblWaitingList").DataTable({
                    "data": jTables.Table,
                    "columns": [
                        { "data": "Cliente" },
                        { "data": "Vendedor" },
                        { "data": "Fecha" },
                        { "data": "Observacion" },
                        {
                            "data": "Opciones",
                            "mRender": function (data, type, row) {

                                var data = "<a LinkId='" + row.Id + "' class='.delete-pas-link' href='#' onclick='deleteItemRow(this);'><img src='/Images/cross.png' width='32' height='32' title='Quitar'></a>";
                                return data;
                            }
                        }
                    ],
                    "bAutoWidth": false,
                    "pageLength": 25
                });

            }
        });


    };

  
    function deleteItemRow(link) {

        RowId = $(link).attr('linkid').toString();
       
        $.ajax({
            url: "/Reserva/DeleteToWatingList",
            data: {
                Id: RowId,
            },
            dataType: "json",
            success: function (data) {

                if (data.Mensaje == "Done") {

                    //delete row to table
                    tblWaitingList
                                .row($(link).parents('tr'))
                                .remove()
                                .draw();
                }
                else {
                    if (data.Mensaje == "Error.") {
                        alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                        console.log(data.Error);
                    }

                }

            }
        });
    }

</script>