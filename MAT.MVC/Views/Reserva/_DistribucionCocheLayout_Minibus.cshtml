@model MAT.MVC.Models.DistribucionCochePageViewModel
@using MAT.MVC.Models
@{
    var seats = Model != null && Model.Seats != null ? Model.Seats : new List<DistribucionCoche>();
}
<div class="encabezado_superior">MINI BUS</div>
<div>
    <div class="grupo1">
        @foreach (var item in seats.Where(bt => bt.ButacaNro < 45 && (bt.ButacaPosicion == "C" || bt.ButacaPosicion == "D")))
        {
            @Html.Partial("_DistribucionCocheAsiento", new DistribucionCocheSeatViewModel { Item = item, SeatClass = "asiento" })
        }
    </div>
    <div class="pasillo">
        <div class="tv tv1">TV</div>
    </div>
    <div class="grupo2">
        @foreach (var item in seats.Where(bt => bt.ButacaNro > 2 && bt.ButacaNro < 47 && (bt.ButacaPosicion == "A" || bt.ButacaPosicion == "B")))
        {
            @Html.Partial("_DistribucionCocheAsiento", new DistribucionCocheSeatViewModel { Item = item, SeatClass = "asiento_invertido" })
        }
    </div>
</div>
<div class="clear"></div>
