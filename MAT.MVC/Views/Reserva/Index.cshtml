        <script type="text/javascript">
            $(function () {
                $("#bus-tabs").tabs();
                $("#panel-bus a").each(function () {
                    var estado = parseInt($(this).data("estado"));
                    if (estado == 1) {
                        $(this).addClass("disponible");
                    } else if (estado == 3) {
                        $(this).removeClass("disponible");
                        $(this).addClass("señado");
                    } else if (estado == 4) {
                        $(this).removeClass("disponible");
                        $(this).addClass("reservado");
                    } else if (estado == 5) {
                        $(this).removeClass("disponible");
                        $(this).addClass("prereserva");
                    } else if (estado == 6) {
                        $(this).removeClass("disponible");
                        $(this).addClass("reservahotel");
                    } else if (estado == 8) {
                        $(this).removeClass("disponible");
                        $(this).addClass("reservapasajehotel");
                    } else if (estado == 9) {
                        $(this).removeClass("disponible");
                        $(this).addClass("prereservahotel");
                    }
                });
            });
        </script>

