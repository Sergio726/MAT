                                <script type="text/javascript">
                                    $(function () {
                                        $("#bus-tabs").tabs();
                                        // Función para inicializar los estados de las butacas
                                        // Solo afectar a las butacas reales (dentro de .piso_superior, .piso_inferior), no a la tabla de referencias
                                        $("#panel-bus .piso_superior a, #panel-bus .piso_inferior a").each(function () {
                                            var $butaca = $(this);
                                            var estado = parseInt($butaca.data("estado"));
                                            
                                            // Remover todas las clases de estado previas
                                            $butaca.removeClass("disponible señado reservado prereserva reservahotel reservapasajehotel prereservahotel");
                                            
                                            // Aplicar clase según el estado
                                            switch (estado) {
                                                case 1:
                                                    $butaca.addClass("disponible");
                                                    break;
                                                case 2:
                                                    // Estado 2 (Reservado sin pagar) - Similar a señado
                                                    $butaca.addClass("señado");
                                                    break;
                                                case 3:
                                                    $butaca.addClass("señado");
                                                    break;
                                                case 4:
                                                    $butaca.addClass("reservado");
                                                    break;
                                                case 5:
                                                    $butaca.addClass("prereserva");
                                                    break;
                                                case 6:
                                                    $butaca.addClass("reservahotel");
                                                    break;
                                                case 7:
                                                    // Estado 7 (Anulado) - Se mantiene sin clase específica, se maneja por data-estado en CSS
                                                    break;
                                                case 8:
                                                    $butaca.addClass("reservapasajehotel");
                                                    break;
                                                case 9:
                                                    $butaca.addClass("prereservahotel");
                                                    break;
                                                default:
                                                    // Si no tiene estado definido, asumir disponible
                                                    if (!estado || estado === 0) {
                                                        $butaca.addClass("disponible");
                                                    }
                                                    break;
                                            }
                                        });
                                    });
                                </script>

