        function reNewReserva(FacturaID) {
            if (FacturaID !="") {
                $.ajax({
                    url: "/Reserva/jRenovarPreReserva",
                    data: { "FacturaID": FacturaID},
                    dataType: "json",
                    success: function (data) {
               
                        if (data.sResult === "Done.") {
                            $("#divPreReservas").dialog("close");
                            confirm("Pre Reserva Renovada.", "Operación Exitosa");
                            setTimeout(function () { location.reload(); }, 1000);
                            
                        }
                        else {
                            alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                        }

                    }
                })
            }
