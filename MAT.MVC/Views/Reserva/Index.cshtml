        function deleteReserva(FacturaID, ClienteID) {
            var facturaid = FacturaID;
            var clienteid = ClienteID;
            var url = "/PersonaCliente/EliminarVenta?facturaid=" + facturaid + "&clienteid=" + clienteid;
            var title = "Eliminar Venta";
            var id = "EliminarVenta";
            ShowFormDialog(url, id, title, "min");
