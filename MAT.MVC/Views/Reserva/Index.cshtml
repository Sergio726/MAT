@*@model List<MAT.MVC.Models.PasajeModel>*@
@model List<ReservaStandard>

@using MAT.MVC.Models
@using MAT.Enums
@{
    Guid ViajeID = new Guid();
    Guid PaqueteID = new Guid();
    string PresupuestoCodigo = null;
    string PresupuestoNombreCliente = null;
    decimal? PresupuestoMonto = null;
    string PresupuestoId = null;

    if (Model.Count > 0)
    {
        Layout = "~/Views/Shared/_Layout.cshtml";
        ViajeID = Model.First().ViajeId;
        PaqueteID = Model.First().PaqueteID;

    }

    var presupuestoObj = ViewBag.Presupuesto as object;
    var detalleViaje = ViewBag.DetalleViaje as DetalleViaje;
    if (presupuestoObj != null)
    {
        var tipo = presupuestoObj.GetType();
        var propId = tipo.GetProperty("PresupuestoId");
        var propCodigo = tipo.GetProperty("CodigoSeguimiento");
        var propNombre = tipo.GetProperty("NombreCliente");
        var propMonto = tipo.GetProperty("MontoPactado");

        if (propId != null)
        {
            var valor = propId.GetValue(presupuestoObj, null);
            if (valor != null)
            {
                PresupuestoId = Convert.ToString(valor);
            }
        }

        if (propCodigo != null)
        {
            var valor = propCodigo.GetValue(presupuestoObj, null);
            if (valor != null)
            {
                PresupuestoCodigo = Convert.ToString(valor);
            }
        }

        if (propNombre != null)
        {
            var valor = propNombre.GetValue(presupuestoObj, null);
            if (valor != null)
            {
                PresupuestoNombreCliente = Convert.ToString(valor);
            }
        }

        if (propMonto != null)
        {
            var valor = propMonto.GetValue(presupuestoObj, null);
            if (valor != null)
            {
                PresupuestoMonto = Convert.ToDecimal(valor);
            }
        }
    }
}

<link href="~/Content/mat.styles.custom.css" rel="stylesheet" />

<div class="modern-dashboard reserva-index-page">
    @if (Model.Count > 0 && detalleViaje != null)
    {
        @Html.Partial("_ReservaViajeHero", detalleViaje)
    }

    <div class="MsgError">
        <span>@ViewBag.MsgError</span>
    </div>

    @if (!string.IsNullOrEmpty(PresupuestoCodigo))
    {
        <div class="modern-alert modern-alert-warning reserva-presupuesto-banner" style="margin-bottom: 1rem;">
            <div class="modern-alert-content" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
                <div>
                    <strong><i class="bi bi-file-earmark-text"></i> Presupuesto vinculado</strong>
                    <div style="font-size: 0.9rem; margin-top: 0.35rem;">
                        <span><strong>Código:</strong> @PresupuestoCodigo</span>
                        <span style="margin-left: 1rem;"><strong>Cliente:</strong> @PresupuestoNombreCliente</span>
                        <span style="margin-left: 1rem;"><strong>Monto:</strong> @(PresupuestoMonto.HasValue ? string.Format("{0:C}", PresupuestoMonto.Value) : "")</span>
                    </div>
                </div>
                <a href="@Url.Action("ImprimirPresupuesto", "Presupuesto", new { codigo = PresupuestoCodigo })" target="_blank" class="btn-modern btn-modern-secondary btn-sm">
