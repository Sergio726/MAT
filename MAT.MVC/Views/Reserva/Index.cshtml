                                            <div class="referencia-item referencia-item-hotel">
                                                <a class="prereservapasajehotel_ref" title="Pasaje Pre-Reserva y Hotel Pre-Reservado"></a>
                                                <span>Pre-reserva + Hotel</span>
                                            </div>
                                            <div class="referencia-item referencia-item-alert">
                                                <a class="SenaIncompleta" title="No cumple con el mínimo de Seña"></a>
                                                <span>Seña Incompleta</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </section>
                </div>
            </div>
        </div>

        <input type="hidden" id="hdnPasajeroID" value="" />
        <input type="hidden" id="hdnListMenor" value="" data-tutor="" data-complete="false" data-monto=""/>
        <input type="hidden" id="hdnViajeID" value="@ViajeID" />
        <input type="hidden" id="hdnViajeMonedaTipo" value="@Model.First().MonedaTipo.ToString()" />
        <input type="hidden" id="presupuestoCodigo" value="@(PresupuestoCodigo ?? string.Empty)" />
        <input type="hidden" id="presupuestoId" value="@(PresupuestoId ?? string.Empty)" />

        <div class="modern-alerts-container">

            @if (ViewBag.ListaEspera != null && ViewBag.ListaEspera > 0)
            {
            <div class="modern-alert modern-alert-info">
                <div class="modern-alert-content">
                    <i class="bi bi-clock-history"></i>
                    <a href="javascript: openWaitingList();" class="modern-alert-link" title="Hay clientes en lista de espera">
                        HAY CLIENTES ESPERANDO
                    </a>
                    <button type="button" class="modern-alert-close" title="Cerrar notificación" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
            }

            <div id="preReservasSection">
            @if (ViewBag.PreReservas != null && ViewBag.PreReservas.Count > 0)
            {
            <div class="modern-alert modern-alert-warning">
                <div class="modern-alert-content">
                    <i class="bi bi-exclamation-triangle"></i>
                    <a href="javascript: showPreReservas();" class="modern-alert-link" title="Ver Pre Reservas Vencidas">
                        EXISTEN PRE-RESERVAS VENCIDAS (@ViewBag.PreReservas.Count)
                    </a>
                    <button type="button" class="modern-alert-close" title="Cerrar notificación" aria-label="Cerrar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div id="divPreReservas" title="Pre Reservas Vencidas" style="display:none;">
                <div class="modern-prereservas-container">
                    <div class="modern-prereservas-header">
                        <h3><i class="bi bi-exclamation-triangle"></i> Pre Reservas Vencidas</h3>
                        <p class="modern-prereservas-subtitle">Seleccione una acción para cada pre-reserva vencida</p>
                    </div>
                    <div class="modern-prereservas-table-container">
                        <table class="modern-prereservas-table">
                            <thead>
                                <tr>
                                    <th>Butaca</th>
                                    <th>Pasajero</th>
                                    <th>Fecha de Pre Reserva</th>
                                    <th>Vencimiento</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (PreReserva item in ViewBag.PreReservas)
                                {
                                <tr>
                                    <td><span class="badge-buttaca">@item.NroButaca</span></td>
                                    <td><strong>@item.FullName</strong></td>
                                    <td>@item.FechaPreReserva.ToShortDateString()</td>
                                    <td><span class="text-danger">@item.VencimientoPreReserva.ToShortDateString()</span></td>
                                    <td class="text-center">
                                        <div class="modern-prereservas-actions">
                                            <button type="button" class="btn-action btn-action-renew" onclick="reNewReserva('@item.FacturaID');" title="Renovar Pre Reserva">
                                                <i class="bi bi-arrow-clockwise"></i>
                                                <span>Renovar</span>
                                            </button>
                                            <button type="button" class="btn-action btn-action-delete" onclick="deleteReserva('@item.FacturaID','@item.ClienteID');" title="Baja de Pre Reserva">
                                                <i class="bi bi-trash"></i>
                                                <span>Eliminar</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            }
            </div>

        </div>

    }
</div>

<script type="text/javascript">
    $(document).ready(function () {
        getPasajesSenaIncompleta();
        checkBus();

        setTimeout(formatDisplay, 2000);

        $(document).on("click", ".modern-alert-close", function () {
            $(this).closest(".modern-alert").hide();
        });
    });

    function checkBus(){
        if ("@Model.First().TransporteNroCoche" == "81") {
            $(".piso_superior .escalera").css("left","200px")
            $(".bar").css("left","230px");
        }
    }

    function formatDisplay()
    {
        var width = $(window).width();
        if (width < 800) {
            $('#panel-detalle').css('width','98%');
            $('#panel-bus').css('width','98%');
            $('.divEmergent').addClass('divEmergent_min').removeClass('divEmergent');
            $('.widget-body').collapse("hide");
            $("#btn_configuracion").click();
                            
        };
    }

    function showObservacion()
    {
        var viajeId = "@ViajeID";
        var url = "/Reserva/Observaciones?sViajeId=" + viajeId;
        var id = "divObservaciones";
        var title = "Observaciones del Viaje";
        ShowFormDialog(url, id, title, "max");
    }

    function showVinculosMenor()
    {
        var viajeId = "@ViajeID";
        // BUG P1 menores: desdeFactura=1 habilita el panel "Nueva vinculación" (antes solo se listaba).
        var url = "/Reserva/VinculacionMenor?sViajeId=" + viajeId + "&desdeFactura=1";
        var id = "divVinculosMenor";
        var title = "Vinculación de menores";
        ShowFormDialog(url, id, title, "medium");
    }

    function showFormListaMayor()
    {
        @*var viajeId = "@Model.First().Pasaje.ViajeId.Value";*@
        var viajeId = "@ViajeID";
        var url = "/Reserva/FormListaMayor?sViajeId=" + viajeId;
        var id = "divFormListaMayor";
        var title = "Lista de Pasajeros";
        ShowFormDialog(url, id, title, "medium");
    }

    function showFormListaMenor() {
        var viajeId = "@ViajeID";
        var url = "/Reserva/FormListaMenor?sViajeId=" + viajeId;
        var id = "divFormListaMenor";
        var title = "Lista de menores disponibles";
        ShowFormDialog(url, id, title, "medium");
    }


    function openWaitingList() {
        var viajeId = "@ViajeID";
        var url = "/Reserva/GetOffListPassengers?sViajeId=" + viajeId;
        var id = "divOffListPassengers";
        var title = "Lista de Espera";
        //ShowFormDialog(url, id, title, "medium");
        ShowFormDialog(url, id, title, "min");
    }


    function showPreReservas() {
        var $dialog = $("#divPreReservas");
        
        // Si el diálogo ya existe, destruirlo primero para evitar conflictos
        if ($dialog.hasClass('ui-dialog-content')) {
            $dialog.dialog('destroy');
        }
        
        $dialog.dialog({
            autoOpen: false,
            modal: true,
            width: "70%",
            maxWidth: 1000,
            minWidth: 600,
            height: "auto",
            position: { my: 'center', at: 'center', of: window },
            closeOnEscape: true,
            resizable: true,
            draggable: true,
            classes: {
                "ui-dialog": "modern-dialog-prereservas"
            },
            open: function() {
                // Asegurar que el botón de cerrar funcione correctamente
                var $closeBtn = $(this).closest('.ui-dialog').find('.ui-dialog-titlebar-close');
                $closeBtn.off('click').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    $dialog.dialog('close');
                });
            },
            close: function() {
                // Limpiar eventos al cerrar
                $(this).dialog('destroy');
            }
        });
        
        $dialog.dialog("open");
    }
    function reNewReserva(FacturaID) {
        if (FacturaID !== "") {
            $.ajax({
                url: "/Reserva/jRenovarPreReserva",
                data: { "FacturaID": FacturaID },
                dataType: "json",
                success: function (data) {
                    if (data.sResult === "Done.") {
                        $("#divPreReservas").dialog("close");
                        (window.alertSuccess || window.alert)("Pre Reserva Renovada.", "Operación Exitosa");
                        // Actualizar la sección de pre-reservas sin recargar la página
                        var viajeId = $("#hdnViajeID").val();
                        if (viajeId) {
                            $.get("/Reserva/GetPreReservasSection", { viajeId: viajeId }, function (html) {
                                $("#preReservasSection").html(html);
                            });
                        }
                    }
                    else {
                        (window.alertError || window.alert)(data.sResult || "Ha ocurrido un error, por favor intente nuevamente.", "Error");
                    }
                },
                error: function (xhr, status, err) {
                    (window.alertError || window.alert)("Error al renovar la pre-reserva. Por favor intente nuevamente.", "Error");
                }
            });
        }
    }

    //function deleteReserva(FacturaID, ClienteID) {
    //    var facturaid = FacturaID;
    //    var clienteid = ClienteID;
    //    var code = $("#Codigo").val();
    //    $.ajax({
    //        url: "/PersonaCliente/EliminarVenta",
    //        type: "POST",
    //        data: { facturaid: facturaid, clienteid: clienteid, code: '2015' },
    //        success: function (data) {
    //            $("#divPreReservas").dialog("close");
    //            var result = data == "True" ? true : false;
    //            if (result) {
    //                (window.alertSuccess || window.alert)("La Pre Reserva se dio de baja correctamente.", "Baja Correcta");
                    
    //            } 
    //        }
    //    });
    //}

    function deleteReserva(FacturaID, ClienteID) {
        var facturaid = FacturaID;
        var clienteid = ClienteID;
        var url = "/PersonaCliente/EliminarVenta?facturaid=" + facturaid + "&clienteid=" + clienteid;
        var title = "Eliminar Venta";
        var id = "EliminarVenta";
        ShowFormDialog(url, id, title, "min");
    };

    function getPasajesSenaIncompleta() {
        $.ajax({
            url: "/Reserva/jSenasIncompletasByViajeID",
            type: "POST",
            data: { ViajeID: "@ViajeID"},
            success: function (data) {
                if (data.sMsg == "Done.") {
                    var oData = eval(data.sResult);
                    if (oData.length > 0) {
                        for (var i = 0; i < oData.length; i++) {
                            $("#" + oData[i].PasajeID).addClass("señaIncompleta");
                            $("#" + oData[i].PasajeID).attr("FacturaID", oData[i].FacturaID);
                            $("#" + oData[i].PasajeID).attr("ClienteID", oData[i].ClienteID);
                        }
                    }
                    //reserva señada + hotel pre-reservado
                   
                    $(".señaIncompleta").click(function () {
                            
                        if ($(this).data("estado") == "8") {
                            var url = "/PersonaCliente/RegistrarPago?facturaid=" + $(this).attr("FacturaID") + "&clienteid=" + $(this).attr("ClienteID");
                            var title = "Registrar Pago";
                            var id = "RegistrarPago";
                            ShowFormDialog(url, id, title);
                        }
                            
                    });
                   
                   
                }
                else {
                    console.log(data.sMsg);
                }
                
                
            },
            error: function (e) {
                console.log(e)
            }
        });
    }

    function goFacturas(ViajeID) {
        var paqueteDescripcion = $("#hdnPaqueteDesctripcion").val();
        var url = "/Factura/FacturaListByViajeID?sViajeID=" + ViajeID + "&sPaquete=" + paqueteDescripcion;
       
        window.open(url, '_blank')
    }

    /* New Reserva*/
    function openNewReserva(viajeId) {            
        window.location.href = "/NuevaReserva/Index?viajeid=" + viajeId;
    };
</script>
