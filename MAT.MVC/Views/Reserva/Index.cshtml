                }
            });
        }

        function goFacturas(ViajeID) {
            var paqueteDescripcion = $("#hdnPaqueteDesctripcion").val();
            var url = "/Factura/FacturaListByViajeID?sViajeID=" + ViajeID + "&sPaquete=" + paqueteDescripcion;
           
            window.open(url, '_blank')
        }
