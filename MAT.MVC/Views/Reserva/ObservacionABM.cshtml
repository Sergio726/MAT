@model MAT.MVC.Models.ObservacionViaje.ObsViaje

<div class="modern-observacion-form-container">
    <form id="formObservaciones" class="modern-observacion-form">
        <input type="hidden" value="@Model.Id" name="Id" />
        <input type="hidden" value="@Model.Fecha" name="Fecha" id="Fecha"/>
        <input type="hidden" id="VendedorID" name="VendedorID" value="@Model.VendedorID" />
        <input type="hidden" id="hdnCategoriasID" name="CategoriaID" />
        <input type="hidden" id="ViajeID" name="ViajeID" value="@Model.ViajeID" />
        <input type="hidden" id="PasajerosID" name="PasajerosID" value="" />

        <div class="modern-form-row">
            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-calendar3"></i>
                    Fecha
                </label>
                <input type="text" class="modern-form-input modern-form-input-disabled" disabled value="@Model.Fecha" readonly />
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-person-badge"></i>
                    Vendedor
                </label>
                <input type="text" class="modern-form-input modern-form-input-disabled" disabled value="@Model.Vendedor" readonly />
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-tag"></i>
                    Categoría
                </label>
                <input type="text" id="ddCategorias" title="Categorías" class="modern-form-input modern-magicsearch" value="@Model.Categoria" />
            </div>
        </div>

        <div class="modern-form-row">
            <div class="modern-form-group modern-form-group-full">
                <label class="modern-form-label">
                    <i class="bi bi-person"></i>
                    Pasajeros
                </label>
                <input type="text" id="ddPasajeros" title="Buscar pasajero" class="modern-form-input modern-magicsearch" placeholder="Seleccione un pasajero (opcional)" />
            </div>
        </div>

        <div class="modern-form-row">
            <div class="modern-form-group modern-form-group-full">
                <label class="modern-form-label">
                    <i class="bi bi-chat-left-text"></i>
                    Observaciones
                </label>
                <textarea name="Detalle" class="modern-form-textarea" rows="6" placeholder="Ingrese las observaciones...">@Model.Detalle</textarea>
            </div>
        </div>

        <div class="modern-form-actions">
            <button type="button" class="btn-modern-observacion-form btn-modern-primary" onclick="javascript: ObservacionSave();" title="Guardar Observación">
                <i class="bi bi-check-circle"></i>
                <span>Guardar</span>
            </button>
        </div>
    </form>

</div>

<link href="~/Content/magicsearch/jquery.magicsearch.css" rel="stylesheet" />
<link href="~/Content/magicsearch/normalize.css" rel="stylesheet" />
<script src="~/Scripts/jquery.magicsearch.js"></script>
<script type="text/javascript">
    $(document).ready(function () {

        //load pasajeros
        var dataSource = @Html.Raw(ViewBag.jDDPasajeros);
        $('#ddPasajeros').magicsearch({
            dataSource: dataSource,
            fields: ['PasajeroApellido','PasajeroNombre', 'PasajeroDocumento'],
            id: 'PasajeroID',
            format: '%PasajeroApellido%' + ' ' +'%PasajeroNombre%',
            dropdownBtn: true,
            success: function(i,data){
                var PasajeroID = data.PasajeroID;
                $("#PasajerosID").val(PasajeroID);
                
            }

        });
        $("#ddPasajeros").removeClass('dropdown');

        //load categorias
        var dataSource = @Html.Raw(ViewBag.jDDCategorias);
        $('#ddCategorias').magicsearch({
            dataSource: dataSource,
            fields: ['Categoria'],
            id: 'Id',
            format: '%Categoria%',
            dropdownBtn: true,
            success: function(i,data){

                var CategoriasID = data.Id;
                $("#hdnCategoriasID").val(CategoriasID);
                
            }

        });
        $("#ddCategorias").removeClass('dropdown');

        // Estilizar magicsearch inputs
        $('.modern-magicsearch-wrapper').each(function() {
            $(this).css({
                'width': '100%',
                'display': 'block'
            });
        });

        ObservacionLoad();

    });
    
    function ObservacionLoad(){
        $("#ddCategorias").val("@Model.Categoria");
        $("#hdnCategoriasID").val("@Model.CategoriaID");
        @{string sPasajerosID = "";
          string sPasajeros = "";
          }
        @if (Model.Pasajeros != null)
	    {
            sPasajerosID = String.Join("'",Model.Pasajeros.ToList().Select(p=>p.PasajeroID).ToList());
            sPasajeros = String.Join("'", Model.Pasajeros.ToList().Select(p => p.Pasajero).ToList());
            
            
	    }
        $("#ddPasajeros").val("@sPasajeros");
        $("#PasajerosID").val("@sPasajerosID");
    };

    function ObservacionSave(){
        // Validación básica
        var detalle = $('textarea[name="Detalle"]').val().trim();
        if (!detalle) {
            (window.alertInfo || window.alert)('Por favor ingrese una observación.', 'Validación');
            $('textarea[name="Detalle"]').focus();
            return;
        }

        showLoading_div("popup_Observacion");

        var _data = $("#formObservaciones").serializeArray();

        $.ajax({
            type: "post",
            url: "/Reserva/ObservacionesGeneralesEdit",
            dataType: "json",
            data: _data,
            success: function (data) {
                if (data.Msj == "Done.") {
                    getObservacionesGenerales();
                    $("#popup_Observacion").dialog("close");
                }
                else{
                    (window.alertError || window.alert)('Ocurrió un error al intentar guardar la observación, por favor comuníquese con el administrador.', 'Error');
                    console.log(data.Msj);
                    $("#popup_Observacion").dialog("close");
                }
            },
            error: function() {
                (window.alertError || window.alert)('Ocurrió un error al intentar guardar la observación. Por favor intente nuevamente.', 'Error');
            }
        });

    };    
    

</script>