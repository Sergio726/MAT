@model List<MAT.MVC.Models.ObservacionViaje.ObsViaje>
<script type="text/javascript">
    $(document).ready(function () {
        var table = $("#tblObservaciones").DataTable({
            order: [[1, 'desc']], // Ordenar por fecha descendente
            pageLength: 25,
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ registros",
                infoEmpty: "No hay registros disponibles",
                infoFiltered: "(filtrado de _MAX_ registros totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            }
        });
    });

    function fnObservacionABM(Id)
    {
        var url = "/Reserva/ObservacionABM?sViajeID=@ViewBag.ViajeId&sId=" + Id;
        var dialogid = "popup_Observacion";
        var dialogtitle = "Agregar Observación";
        var widthsize = "min";
        ShowFormDialog(url, dialogid, dialogtitle, widthsize)
    }

    function fnObservacionesGeneralesDelete(Id) {
        if (!confirm('¿Está seguro que desea eliminar esta observación?')) {
            return;
        }
        
        $.ajax({
            type: "post",
            url: "/Reserva/ObservacionesGeneralesDelete",
            dataType: "json",
            data: { "Id": Id },
            success: function (data) {
                if (data.Result == "Done.") {
                    if (data.Msj == "Done.") {
                        getObservacionesGenerales();
                    }
                    else {
                        (window.alertInfo || window.alert)(data.Msj, "Atención");
                    }
                }
                else {
                    (window.alertError || window.alert)('Ocurrió un error al intentar eliminar la observación, por favor comuníquese con el administrador.', 'Error')
                    console.log(data.Msj);
                    $("#popup_Observacion").dialog("close");
                }
            }
        });
    }

</script>


@if (ViewBag.Error != null)
{
    <div class="modern-alert-error">
        <i class="bi bi-exclamation-circle"></i>
        <span>@ViewBag.Error</span>
    </div>    
}
else
{
    <table id="tblObservaciones" class="modern-table-observaciones">
        <thead>
            <tr>
                <th>Categoría</th>
                <th>Fecha</th>
                <th>Detalle</th>
                <th>Pasajeros</th>
                <th>Vendedor</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (MAT.MVC.Models.ObservacionViaje.ObsViaje item in Model)
            {
                <tr>
                    <td>
                        <span class="badge-categoria">@item.Categoria</span>
                    </td>
                    <td>
                        <div class="modern-observaciones-fecha">
                            <i class="bi bi-calendar3"></i>
                            <span>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    </td>
                    <td>
                        <div class="modern-observaciones-detalle">
                            @item.Detalle.TrimStart()
                        </div>
                    </td>
                    <td>
                        @if (item.Pasajeros.Count != 0)
                        {
                            <span class="badge-pasajero">
                                <i class="bi bi-person"></i>
                                <span>@item.Pasajeros.First().Pasajero</span>
                            </span>
                        }
                        else
                        {
                            <span class="table-text-muted">-</span>
                        }
                    </td>
                    <td>
                        <div class="modern-observaciones-vendedor">
                            <i class="bi bi-person-badge"></i>
                            <span>@item.Vendedor</span>
                        </div>
                        @if (item.Update.ToString() != "1/1/0001 00:00:00" && item.Update.ToString() != "01/01/0001 12:00:00 a.m.")
                        {
                            <div class="modern-observaciones-update-info">
                                <small>
                                    <i class="bi bi-clock-history"></i>
                                    Actualizado: @item.Update.ToString("dd/MM/yyyy HH:mm")
                                    @if (!string.IsNullOrEmpty(item.UpdateVendedor))
                                    {
                                        <span>por @item.UpdateVendedor</span>
                                    }
                                </small>
                            </div>
                        }
                    </td>
                    <td>
                        <div class="modern-observaciones-actions-inline">
                            <button type="button" class="btn-action-observacion btn-action-edit" onclick="fnObservacionABM(@item.Id.ToString());" title="Editar Observación">
                                <i class="bi bi-pencil"></i>
                            </button>
                            <button type="button" class="btn-action-observacion btn-action-delete" onclick="fnObservacionesGeneralesDelete(@item.Id);" title="Eliminar Observación">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

