@model List<MAT.MVC.Models.PasajeroMenorModel>

<style>
    .partial-vinculacion-container {
        padding: 0.5rem;
    }
    .print-action-row {
        display: flex;
        justify-content: flex-end;
        margin-bottom: 0.75rem;
    }
    .btn-print {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.75rem;
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-primary, #374151);
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-print:hover {
        background: #e5e7eb;
        color: var(--text-primary, #374151);
    }
    .table-scroll-container {
        max-height: 428px;
        overflow-y: auto;
        border-radius: 0.5rem;
        background: white;
    }
    #tblListMenores {
        width: 100%;
        border-collapse: collapse;
    }
    #tblListMenores thead th {
        position: sticky;
        top: 0;
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        text-align: left;
    }
    #tblListMenores thead th:first-child {
        width: 40px;
        text-align: center;
    }
    #tblListMenores tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblListMenores tbody td:first-child {
        text-align: center;
        font-weight: 500;
        color: var(--text-secondary, #6b7280);
    }
    #tblListMenores tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    #tblListMenores tbody tr:last-child td {
        border-bottom: none;
    }
    .empty-state {
        text-align: center;
        padding: 2rem;
        color: var(--text-secondary, #9ca3af);
    }
    .empty-state i {
        font-size: 2rem;
        margin-bottom: 0.5rem;
        display: block;
    }
</style>

<div class="partial-vinculacion-container">
    <div class="print-action-row">
        <a href="javascript: printMenor();" class="btn-print" title="Imprimir lista de menores">
            <i class="bi bi-printer"></i>
            Imprimir
        </a>
    </div>

    <div class="table-scroll-container">
        <table id="tblListMenores">
            <thead>
                <tr>
                    <th>#</th>
                    <th style="width: 48%;">Responsable del menor</th>
                    <th style="width: 48%;">Menor a cargo</th>
                </tr>
            </thead>
            <tbody>
                @{int i = 0;}
                @foreach (var item in Model)
                {
                    if (item.PasajeroMenorID != 0)
                    {
                        i++;
                        <tr>
                            <td>@i</td>
                            <td>@(item.ApellidoMayor + ", " + item.NombreMayor) <span style="color: #6b7280;">Doc.: @item.DocMayor</span></td>
                            <td>@(item.ApellidoMenor + ", " + item.NomreMenor) <span style="color: #6b7280;">Doc.: @item.DocMenor</span></td>
                        </tr>
                    }
                }
                @if (i == 0)
                {
                    <tr>
                        <td colspan="3">
                            <div class="empty-state">
                                <i class="bi bi-people"></i>
                                No hay menores vinculados
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    function printMenor() {
        var ViajeID = "@ViewBag.ViajeID";
        var url = "/Reserva/PartialVinculacionMenor?sViajeId=" + ViajeID + "&sPrint=Print";
        window.open(url, '_blank').print();
    }
</script>
