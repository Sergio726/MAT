@model List<MAT.MVC.Models.PasajeroMenorModel>
@using System.Linq
@{
    var viajeId = ViewBag.ViajeID as string ?? "";
    var vinculacionPorFactura = ViewBag.VinculacionPorFactura as bool? ?? false;
    var menoresVinculados = Model != null
        ? Model.Where(m => m.PasajeroMenorID != 0).ToList()
        : new List<MAT.MVC.Models.PasajeroMenorModel>();
    var urlDesvincular = Url.Action("DesvincularMenor", "Reserva");
    var totalMenores = menoresVinculados.Count;
}

<div class="listado-simple partial-vinculacion-container">
    <div class="partial-vinculacion-count-bar" aria-live="polite">
        <span class="partial-vinculacion-count-chip" title="@(vinculacionPorFactura ? "Menores con responsable asignado en esta factura" : "Menores con responsable asignado en este viaje")">
            <i class="bi bi-people-fill partial-vinculacion-count-icon" aria-hidden="true"></i>
            <span class="partial-vinculacion-count-num">@totalMenores</span>
            <span class="partial-vinculacion-count-text">@(totalMenores == 1 ? "menor vinculado" : "menores vinculados")</span>
        </span>
    </div>

    <div id="tablaVinculacionMenor" class="partial-vinculacion-tabla-wrap">
        <div class="listado-pantalla partial-vinculacion-body-scroll">
            <table id="tblPartialVinculacionMenor" class="tabla listado-simple-tabla">
                <thead>
                    <tr>
                        <td class="celda column_nro">N°</td>
                        <td class="celda column_apellido_nombre">RESPONSABLE</td>
                        <td class="celda column_vinc_menor">MENOR A CARGO</td>
                        <td class="celda column_vinc_accion">ACCIÓN</td>
                    </tr>
                </thead>
                <tbody>
                    @if (totalMenores == 0)
                    {
                        <tr class="partial-vinculacion-empty-row">
                            <td colspan="4" class="partial-vinculacion-empty-cell">
                                <div class="partial-vinculacion-empty" role="status">
                                    <div class="partial-vinculacion-empty-icon">
                                        <i class="bi bi-person-plus"></i>
                                    </div>
                                    <p class="partial-vinculacion-empty-title">Aún no hay vinculaciones</p>
                                    <p class="partial-vinculacion-empty-hint">Cuando vincule un menor a un responsable, aparecerá aquí.</p>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        int i = 0;
                        foreach (var item in menoresVinculados)
                        {
                            i++;
                            <tr>
                                <td class="celda column_nro">@i</td>
                                <td class="celda column_apellido_nombre">
                                    <div class="partial-vinculacion-person">
                                        <span class="partial-vinculacion-person-name">@(item.ApellidoMayor + ", " + item.NombreMayor)</span>
                                        <span class="partial-vinculacion-person-doc">Doc. @item.DocMayor</span>
                                    </div>
                                </td>
                                <td class="celda column_vinc_menor">
                                    <div class="partial-vinculacion-person">
                                        <span class="partial-vinculacion-person-name">@(item.ApellidoMenor + ", " + item.NomreMenor)</span>
                                        <span class="partial-vinculacion-person-doc">Doc. @item.DocMenor</span>
                                    </div>
                                </td>
                                <td class="celda column_vinc_accion">
                                    <div class="partial-vinculacion-actions">
                                        <button type="button" class="btn-action-icon btn-desvincular-menor" title="Desvincular menor"
                                                onclick="desvincularMenorPm(@item.PasajeroMenorID); return false;">
                                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                                            <span class="visually-hidden">Desvincular</span>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDesvincularMenorPm" tabindex="-1" aria-labelledby="modalDesvincularMenorPmLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title" id="modalDesvincularMenorPmLabel">Desvincular menor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body pt-0">
                ¿Desvincular este menor del responsable indicado?
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnConfirmDesvincularMenorPm">Desvincular</button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    (function () {
        var viajeId = @Html.Raw(Json.Encode(viajeId));
        var urlDesvincular = @Html.Raw(Json.Encode(urlDesvincular));
        var pendingPasajeroMenorId = null;

        function runDesvincularAjax(pasajeroMenorId) {
            $.ajax({
                url: urlDesvincular,
                type: "POST",
                data: { sViajeId: viajeId, pasajeromenorId: pasajeroMenorId },
                success: function (r) {
                    if (r && r.success) {
                        if (typeof loadPasajeroMenor === "function") {
                            loadPasajeroMenor();
                        }
                        if (typeof window.PopupDetalleFactura_Load === "function") {
                            window.PopupDetalleFactura_Load();
                        }
                        if (typeof window.alertSuccess === "function") {
                            window.alertSuccess("El menor fue desvinculado correctamente.", "Éxito");
                        }
                    } else {
                        (window.alertError || window.alert)((r && r.message) ? r.message : "No se pudo desvincular.", "Error");
                    }
                },
                error: function () {
                    (window.alertError || window.alert)("Error al desvincular. Intente nuevamente.", "Error");
                }
            });
        }

        window.desvincularMenorPm = function (pasajeroMenorId) {
            if (!pasajeroMenorId || !viajeId) {
                return;
            }
            pendingPasajeroMenorId = pasajeroMenorId;
            var el = document.getElementById("modalDesvincularMenorPm");
            if (el && typeof bootstrap !== "undefined" && bootstrap.Modal) {
                bootstrap.Modal.getOrCreateInstance(el).show();
                return;
            }
            if (window.confirm("¿Desvincular este menor del responsable indicado?")) {
                runDesvincularAjax(pasajeroMenorId);
            }
            pendingPasajeroMenorId = null;
        };

        $(function () {
            $("#btnConfirmDesvincularMenorPm").on("click", function () {
                var id = pendingPasajeroMenorId;
                if (!id) return;
                var modalEl = document.getElementById("modalDesvincularMenorPm");
                if (modalEl && typeof bootstrap !== "undefined" && bootstrap.Modal) {
                    var inst = bootstrap.Modal.getInstance(modalEl);
                    if (inst) inst.hide();
                }
                runDesvincularAjax(id);
                pendingPasajeroMenorId = null;
            });
            $("#modalDesvincularMenorPm").on("hidden.bs.modal", function () {
                pendingPasajeroMenorId = null;
            });
        });
    })();
</script>
