<script src="~/Scripts/jquery-1.8.2.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        
        var sViajeId = "@ViewBag.ViajeID";
        $.ajax({
            url: "/Reserva/GetListTutoresByViajeID",
            data: { sViajeId: sViajeId},
            dataType: "json",
            success: function (data) {
                var list = data.Tutores;
                $(".asiento").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                });
                $(".asiento_parabrisa").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                });
                $(".asiento_invertido").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                });
                $(".asiento_largo").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0 ) {
                        $(this).addClass("Tutor");
                    }
                });
            }
        });
    });

    
</script>