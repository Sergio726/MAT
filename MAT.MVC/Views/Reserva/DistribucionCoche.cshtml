<style>
    body{
      -webkit-print-color-adjust:exact;
    }
    
    #cole1{
        width: 700px;
        margin: auto
    }
    
    .grupo1, .grupo2{
        width: 44%;
        
    }
    
    .grupo1{
        float: left;
    }
    
    .grupo2{
        float:right
    }
    
    .pasillo{
        width: 10%;
        display: inline-block;
        position: relative
    }
    
    .asiento{
        width: 149px;
        display: inline-table;
        border: 1px solid #666;
        /*padding-top: 20px;
        padding-left: 1%;*/
        height:45px;
        margin-bottom: 3px;
        font-size:10pt;
        padding-left:1px;
    }
    .asiento_parabrisa{
        width: 144px;
        display: inline-table;
        border: 1px solid #666;
        /*padding-top: 20px;
        padding-left: 1%;*/
        height:45px;
        margin-bottom: 3px;
        font-size:10pt;
        float:right;
        margin-left:7px;
        padding-left:1px;
    }
    .asiento_invertido{
        border: 1px solid #666;
        display: inline-table;
        float: right;
        font-size: 10pt;
        height: 46px;
        margin-bottom: 3px;
        margin-left: 7px;
        width: 144px;
        padding-left:1px;
    }
    
    .asiento_largo{
        width: 97%;
        display: inline-table;
        border: 1px solid #666;
        /*padding-top: 20px;
        padding-left: 1%;*/
        height:45px;
        margin-bottom: 3px;
        font-size:10pt;
        float:right;
        padding-left:1px;
    }
    
    .vacio{
        border: 1px solid transparent;
        color: transparent
    }
    
    .vacio span{
        color: #000 !important;
        font-weight: bold
    }
    .encabezado_superior, .encabezado_inferior{
        background: red none repeat scroll 0 0;
        color: white;
        font-size: 10pt;
        font-weight: bold;
        margin: 0 0 5px;
        padding: 5px 0;
        text-align: center;
        width: 100%;
        
    }
    
    .clear{
        clear: both
    }
    
    .tv{
        width: 50%;
        height: 20px;
        margin: auto;
        border: 1px solid #000;
        text-align: center;
        background: yellow
    }
    
    .tv1{
        position: absolute;
        top: 0;
        left: 20px;
    }
    
    .tv2{
        position: absolute;
        top: 172px;
        left: 20px;
    }
    
    .tv3{
        position: absolute;
        top: 300px;
        left: 20px;
    }
    
    .tv4{
        position: absolute;
        top: 430px;
        left: 20px;
    }
    
    .tv5{
        position: absolute;
        top: 20px;
        left: 20px;
    }
    
    .tv6{
        position: absolute;
        top: 130px;
        left: 20px;
    }
    .spnB {
        font-size: 9pt;
    }
    .spnCodB {
        font-weight: bold;
        padding-right: 5px;
    }
    
    div.asiento.Tutor, div.asiento_parabrisa.Tutor, div.asiento_invertido.Tutor, div.asiento_largo.Tutor  {
        background-image: url(/Images/baby_negro.png);
        background-position: bottom right;
        background-repeat: no-repeat;
        background-size: 19px auto;
    }

    .asiento_parabrisa.posicion_A, .asiento_invertido.posicion_A {
        float:right;
    }

    .asiento_parabrisa.posicion_B, .asiento_invertido.posicion_B {
        float:left;
    }
   
</style>

<link href="~/Content/mat.styles.custom.css" rel="stylesheet" />
<script src="~/Scripts/jquery-1.8.2.js"></script>
<script type="text/javascript">
    $(document).ready(function () {
        
        var sViajeId = "@ViewBag.ViajeID";
        $.ajax({
            url: "/Reserva/GetListTutoresByViajeID",
            data: { sViajeId: sViajeId},
            dataType: "json",
            success: function (data) {
                var list = data.Tutores;
                $(".asiento").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                });
                $(".asiento_parabrisa").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                });
                $(".asiento_invertido").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                });
                $(".asiento_largo").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0 ) {
                        $(this).addClass("Tutor");
                    }
                });
            }
        });
    });

    
</script>