@model List<MAT.MVC.Models.DistribucionCoche>
@using MAT.MVC.Models
@{
    Layout = null;
    var fechaSalida = ViewBag.ViajeFechaSalida as string ?? "";
    var fechaRegreso = ViewBag.ViajeFechaRegreso as string ?? "";
    DateTime dtTmp;
    if (DateTime.TryParse(fechaSalida, out dtTmp)) { fechaSalida = dtTmp.ToString("dd/MM/yyyy"); }
    if (DateTime.TryParse(fechaRegreso, out dtTmp)) { fechaRegreso = dtTmp.ToString("dd/MM/yyyy"); }
    var transporteTipo = (string)ViewBag.TransporteTipo ?? "";
    var nroCoche = (string)ViewBag.NroCoche ?? "";
    var layoutModel = new DistribucionCochePageViewModel
    {
        Seats = Model ?? new List<DistribucionCoche>(),
        TransporteTipo = transporteTipo,
        NroCoche = nroCoche
    };
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Distribución de Coche</title>
    <link href="~/Content/bootstrap-5.3.2.min.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-icons.css" rel="stylesheet" />
    <link href="~/Content/saas-variables.css" rel="stylesheet" />
    <link href="~/Content/mat.listadosimple.css" rel="stylesheet" />
    <link href="~/Content/mat.listadosimple.print.css" rel="stylesheet" media="print" />
    <link href="~/Content/mat.distribucioncoche.css?v=20260707e" rel="stylesheet" />
    <link href="~/Content/modern-dashboard.css" rel="stylesheet" />
</head>
<body class="dc-page">

<div class="bus-distribution-page listado-simple">
    @if (ViewBag.Error != null && !string.IsNullOrEmpty(ViewBag.Error.ToString()))
    {
        <div class="alert alert-warning" role="alert">@ViewBag.Error</div>
    }
    @if (ViewBag.SpMigrationWarning != null && !string.IsNullOrEmpty(ViewBag.SpMigrationWarning.ToString()))
    {
        <div class="alert alert-info" role="alert">@ViewBag.SpMigrationWarning</div>
    }

    <div class="listado-simple-header EncabezadoViaje distribucion-coche-header">
        <div class="viaje-info">
            <div class="viaje-titulo">@(string.IsNullOrWhiteSpace((string)ViewBag.ViajeDescripcion) ? "Distribución de Coche" : ViewBag.ViajeDescripcion)</div>
            @if (!string.IsNullOrWhiteSpace(fechaSalida) || !string.IsNullOrWhiteSpace(fechaRegreso))
            {
                <div class="viaje-fechas">
                    @if (!string.IsNullOrWhiteSpace(fechaSalida))
                    {
                        <span><strong>Salida:</strong> @fechaSalida</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(fechaSalida) && !string.IsNullOrWhiteSpace(fechaRegreso))
                    {
                        <span class="fecha-separador">|</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(fechaRegreso))
                    {
                        <span><strong>Regreso:</strong> @fechaRegreso</span>
                    }
                </div>
            }
        </div>
        <div class="viaje-logo">
            <img src="/Images/marco_antonio_back3.png" alt="Marco Antonio Turismo" />
        </div>
    </div>

    <div class="bus-search-bar HideToPrint" role="search" aria-label="Buscar pasajero en el mapa">
        <label for="buscar-pasajero" class="bus-search-label">
            <i class="bi bi-search" aria-hidden="true"></i>
            Buscar pasajero
        </label>
        <div class="bus-search-field-wrap">
            <i class="bi bi-search bus-search-field-icon" aria-hidden="true"></i>
            <input type="search" id="buscar-pasajero" placeholder="Nombre, apellido o butaca (ej. V01, P02)..." autocomplete="off" />
        </div>
        <span id="buscar-resultado" class="bus-search-resultado" aria-live="polite"></span>
        <span class="bus-search-hint"><kbd>Enter</kbd> o <kbd>F3</kbd> para ir a la siguiente</span>
    </div>

    <div class="dc-toolbar HideToPrint">
        <div class="dc-toolbar__controls">
            <div class="dc-view-toggle btn-group" role="group" aria-label="Vista mapa o lista">
                <button type="button" class="btn btn-outline-secondary active" id="dc-btn-mapa" aria-pressed="true">
                    <i class="bi bi-grid-3x3-gap" aria-hidden="true"></i> Mapa
                </button>
                <button type="button" class="btn btn-outline-secondary" id="dc-btn-lista" aria-pressed="false">
                    <i class="bi bi-list-ul" aria-hidden="true"></i> Lista
                </button>
            </div>
            <label class="dc-vinculos-toggle">
                <input type="checkbox" id="dc-toggle-vinculos" />
                Mostrar vínculos tutor↔menor
            </label>
        </div>
        <div class="dc-toolbar__stats" aria-label="Resumen de butacas">
            <span>Ocupadas: <strong>@(ViewBag.ButacasOcupadas ?? 0) / @(ViewBag.TotalButacas ?? 0)</strong></span>
            <span>Disponibles: <strong>@(ViewBag.ButacasDisponibles ?? 0)</strong></span>
            <span>Pagados: <strong>@(ViewBag.ConteoPagados ?? 0)</strong></span>
            <span>Se&ntilde;ados: <strong>@(ViewBag.ConteoSenados ?? 0)</strong></span>
            <span>Pre-reserva: <strong>@(ViewBag.ConteoPrereserva ?? 0)</strong></span>
            @if (!string.IsNullOrWhiteSpace(transporteTipo))
            {
                <span>Transporte: <strong>@transporteTipo</strong></span>
            }
            @if (!string.IsNullOrWhiteSpace(nroCoche))
            {
                <span>Coche N&deg; <strong>@nroCoche</strong></span>
            }
            <span id="tutores-loading" class="dc-toolbar__loading text-muted">
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                Cargando tutores...
            </span>
        </div>
        <div class="dc-toolbar__actions">
            <button type="button" class="btn-print" onclick="window.print();">
                <i class="bi bi-printer-fill"></i>
                Imprimir
            </button>
        </div>
    </div>

    @Html.Partial("_DistribucionCocheLista", Model)

    <div class="bus-card" id="dc-map-view">
        <div class="bus-legend">
            <div class="bus-legend-estados">
                <div class="legend-item">
                    <div class="legend-color disponible"></div>
                    <span>Disponible</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color señado"></div>
                    <span>Se&ntilde;ado</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color reservado"></div>
                    <span>Pagado</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color prereserva"></div>
                    <span>Pre-reserva</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color reservahotel"></div>
                    <span>Pagado + Hotel</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color reservapasajehotel"></div>
                    <span>Se&ntilde;ado + Hotel</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color prereservahotel"></div>
                    <span>Pre-reserva + Hotel</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color tutor"></div>
                    <span>Tutor de Menor</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color menor"></div>
                    <span>Menor vinculado</span>
                </div>
                <div class="legend-item">
                    <div class="legend-color facility"></div>
                    <span>Servicio (Bar/Ba&ntilde;o)</span>
                </div>
            </div>
            <div class="legend-item" id="legend-tutores-loading">
                <span class="spinner-border spinner-border-sm text-secondary" role="status" aria-hidden="true"></span>
                <span class="text-muted">Cargando tutores...</span>
            </div>
        </div>
        <div class="dc-map-wrap">
            <svg class="dc-vinculos-svg" id="dc-vinculos-svg" aria-hidden="true"></svg>
            <div id="cole1">
                @if (transporteTipo == "MINIBUS")
                {
                    @Html.Partial("_DistribucionCocheLayout_Minibus", layoutModel)
                }
                else if (transporteTipo == "CAMION 4X4")
                {
                    @Html.Partial("_DistribucionCocheLayout_Camion4x4", layoutModel)
                }
                else if (transporteTipo == "PISOELEVADO")
                {
                    @Html.Partial("_DistribucionCocheLayout_PisoElevado", layoutModel)
                }
                else
                {
                    @Html.Partial("_DistribucionCocheLayout_Semicama", layoutModel)
                }
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalDetalleFacturaDistribucion" tabindex="-1" aria-labelledby="modalDetalleFacturaDistribucionLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalleFacturaDistribucionLabel">Detalle de factura</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalDetalleFacturaDistribucionBody">
                <div class="text-center text-muted py-4"><span class="spinner-border spinner-border-sm" role="status"></span> Cargando…</div>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<script src="~/Scripts/bootstrap-5.3.2.bundle.min.js"></script>
<script src="~/Scripts/mat.distribucioncoche.js?v=20260707d"></script>
<script type="text/javascript">
    $(document).ready(function () {
        MatDistribucionCoche.init({ viajeId: "@ViewBag.ViajeID" });
    });
</script>

</body>
</html>
