@model List<MAT.MVC.Models.DistribucionCoche>
@using MAT.MVC.Models
@using MAT.Enums

<div class="bus-distribution-page">
    <div class="bus-card">
        <div class="bus-legend">
            <div class="legend-item">
                <div class="legend-color occupied"></div>
                <span>Ocupado</span>
            </div>
            <div class="legend-item">
                <div class="legend-color empty"></div>
                <span>Disponible</span>
            </div>
            <div class="legend-item">
                <div class="legend-color tutor"></div>
                <span>Tutor de Menor</span>
            </div>
            <div class="legend-item">
                <div class="legend-color facility"></div>
                <span>Servicio (Bar/Baño)</span>
            </div>
        </div>
        <div id="cole1">
    @*ES MINIBUS?*@
    @if (ViewBag.TransporteTipo == "MINIBUS")
    {
        <div class="encabezado_superior">MINI BUS</div>
        <div>
            <div class="grupo1">
                @*@foreach (var item in Model.Where(bt => bt.Butaca.NroButaca.Value < 45 && (bt.Butaca.Posicion=="C" || bt.Butaca.Posicion=="D") ).OrderBy(bt => bt.Butaca.NroButaca))*@
                @foreach (var item in Model.Where(bt => bt.ButacaNro < 45 && (bt.ButacaPosicion == "C" || bt.ButacaPosicion == "D")))
                {
                    <div class="asiento" id="@(item.PasajeroID != null && item.PasajeroID != "" ? item.PasajeroID.ToString() : "")">
                        <span class="spnCodB">@item.ButacaCodigo </span>
                    
                        @if (item.PasajeroID != null && item.PasajeroID != "")
                        {
                            <span class="spnB">@item.PasajeroNombre.ToUpper() @item.PasajeroApellido.ToUpper()</span>
                        }
                    
                    </div>
                }                        
            </div>
            <div class="pasillo">
                <div class="tv tv1">TV</div>
            </div>
            <div class="grupo2">
                 @{
                var ItemPasajero3 = Model.Where(bt => bt.ButacaNro == 3).First();
                var ItemPasajero4 = Model.Where(bt => bt.ButacaNro == 4).First();
                  }

                @foreach (var item in Model.Where(bt => bt.ButacaNro > 2 && bt.ButacaNro < 47 && (bt.ButacaPosicion == "A" || bt.ButacaPosicion == "B")))
                {
                    <div class="asiento_invertido posicion_@item.ButacaPosicion" id="@(item.PasajeroID != null && item.PasajeroID != "" ? item.PasajeroID : "")">
                       <span class="spnCodB">@item.ButacaCodigo</span> 
                   
                         @if (item.PasajeroID != null && item.PasajeroID != "")
                         {
                        <span class="spnB">@item.PasajeroNombre.ToUpper() @item.PasajeroApellido.ToUpper()</span>
                         }
                    </div>
                }
            
            </div>
        </div>
        <div class="clear"></div>

    }
