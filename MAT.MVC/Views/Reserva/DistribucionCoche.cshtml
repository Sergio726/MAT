</div>

@section Styles {
<style>
    /* ===== MODERN BUS DISTRIBUTION STYLES ===== */
    body {
        -webkit-print-color-adjust: exact;
    }

    /* Page container */
    .bus-distribution-page {
        padding: 1.5rem;
        max-width: 900px;
        margin: 0 auto;
    }

    /* Card wrapper */
    .bus-card {
        background: white;
        border-radius: 1rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        margin-bottom: 1.5rem;
    }

    /* Legend */
    .bus-legend {
        display: flex;
        gap: 1.5rem;
        padding: 1rem 1.5rem;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        flex-wrap: wrap;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.813rem;
        color: #64748b;
    }

    .legend-color {
        width: 20px;
        height: 20px;
        border-radius: 4px;
        border: 1px solid rgba(0,0,0,0.1);
    }

    .legend-color.occupied {
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%);
    }

    .legend-color.empty {
        background: #f1f5f9;
        border: 2px dashed #cbd5e1;
    }

    .legend-color.tutor {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
    }

    .legend-color.facility {
        background: linear-gradient(135deg, #64748b 0%, #475569 100%);
    }

    /* Bus layout container */
    #cole1 {
        width: 700px;
        margin: auto;
        padding: 1.5rem;
    }

    .grupo1, .grupo2 {
        width: 44%;
    }

    .grupo1 {
        float: left;
    }

    .grupo2 {
        float: right;
    }

    .pasillo {
        width: 10%;
        display: inline-block;
        position: relative;
    }

    /* Base seat styling */
    .asiento, .asiento_parabrisa, .asiento_invertido, .asiento_largo {
        background: #f1f5f9;
        border: 1px solid #cbd5e1;
        border-radius: 4px;
        margin-bottom: 3px;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-size: 9pt;
        transition: all 0.2s ease;
        position: relative;
        overflow: hidden;
        box-sizing: border-box;
        padding: 4px 6px;
    }

    .asiento {
        width: 149px;
        display: inline-block;
        height: 50px;
        vertical-align: top;
    }

    .asiento_parabrisa {
        width: 144px;
        display: inline-block;
        height: 50px;
        float: right;
        margin-left: 7px;
        vertical-align: top;
    }

    .asiento_invertido {
        display: inline-block;
        float: right;
        height: 50px;
        margin-bottom: 3px;
        margin-left: 7px;
        width: 144px;
        vertical-align: top;
    }

    .asiento_largo {
        width: 97%;
        display: inline-block;
        height: 50px;
        margin-bottom: 3px;
        float: right;
        vertical-align: top;
    }

    /* Occupied seat styling */
    .asiento:not(.vacio)[id]:not([id=""]),
    .asiento_parabrisa:not(.vacio)[id]:not([id=""]),
    .asiento_invertido:not(.vacio)[id]:not([id=""]),
    .asiento_largo:not(.vacio)[id]:not([id=""]) {
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%);
        border: none;
        box-shadow: 0 2px 4px rgba(233, 30, 99, 0.3);
    }

    .asiento:not(.vacio)[id]:not([id=""]) .spnCodB,
    .asiento_parabrisa:not(.vacio)[id]:not([id=""]) .spnCodB,
    .asiento_invertido:not(.vacio)[id]:not([id=""]) .spnCodB,
    .asiento_largo:not(.vacio)[id]:not([id=""]) .spnCodB {
        color: rgba(255, 255, 255, 0.9);
    }

    .asiento:not(.vacio)[id]:not([id=""]) .spnB,
    .asiento_parabrisa:not(.vacio)[id]:not([id=""]) .spnB,
    .asiento_invertido:not(.vacio)[id]:not([id=""]) .spnB,
    .asiento_largo:not(.vacio)[id]:not([id=""]) .spnB {
        color: white;
    }

    /* Tutor styling */
    div.asiento.Tutor, div.asiento_parabrisa.Tutor, div.asiento_invertido.Tutor, div.asiento_largo.Tutor {
        background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%) !important;
        box-shadow: 0 2px 4px rgba(139, 92, 246, 0.3);
    }

    div.asiento.Tutor::after, div.asiento_parabrisa.Tutor::after,
    div.asiento_invertido.Tutor::after, div.asiento_largo.Tutor::after {
        content: '\f4fc';
        font-family: 'bootstrap-icons';
        position: absolute;
        bottom: 2px;
        right: 4px;
        font-size: 0.875rem;
        color: rgba(255,255,255,0.7);
    }

    /* Facility styling (vacio) */
    .vacio {
        background: linear-gradient(135deg, #64748b 0%, #475569 100%) !important;
        border: none !important;
        box-shadow: 0 2px 4px rgba(71, 85, 105, 0.3);
    }

    .vacio span {
        color: white !important;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    /* Section headers */
    .encabezado_superior, .encabezado_inferior {
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%);
        color: white;
        font-size: 0.875rem;
        font-weight: 600;
        margin: 0 0 1rem;
        padding: 0.75rem 1rem;
        text-align: center;
        width: 100%;
        border-radius: 8px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
