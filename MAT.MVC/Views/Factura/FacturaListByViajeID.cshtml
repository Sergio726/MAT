@{
    ViewBag.Title = "Facturas por Viaje";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-receipt"></i>
            <span>Facturas</span>
            @if (!string.IsNullOrEmpty(ViewBag.PaqueteDescripcion))
            {
                <span class="modern-page-subtitle">- @ViewBag.PaqueteDescripcion</span>
            }
        </h2>
        @if (!string.IsNullOrEmpty(ViewBag.ViajeDescripcion))
        {
            <div class="modern-page-viaje-info">
                <span class="modern-page-viaje-name">
                    <i class="bi bi-calendar-event"></i>
                    @ViewBag.ViajeDescripcion
                </span>
                @if (!string.IsNullOrEmpty(ViewBag.ViajeFechaSalida))
                {
                    <span class="modern-page-viaje-date">
                        <i class="bi bi-calendar3"></i>
                        @{
                            DateTime fechaSalida;
                            if (DateTime.TryParse(ViewBag.ViajeFechaSalida.ToString(), out fechaSalida))
                            {
                                @fechaSalida.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                @ViewBag.ViajeFechaSalida
                            }
                        }
                    </span>
                }
            </div>
        }
    </div>

    <div id="divResultSearch">
        <div class="modern-loading-container">
            <div class="modern-loading-spinner"></div>
            <span class="modern-loading-text">Cargando facturas...</span>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var ViajeID = "@ViewBag.ViajeID";

        $.ajax({
            url: "/Factura/FacturaResultSearch",
            data: {
                sPersonaID: "",
                sViajeID: ViajeID
            },
            success: function (data) {
                $("#divResultSearch").html(data);
            },
            error: function () {
                $("#divResultSearch").html('<div class="modern-alert-error"><i class="bi bi-exclamation-triangle"></i><span>Error al cargar las facturas</span></div>');
            }
        });
    });
</script>
