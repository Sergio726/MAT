<style>
    /* Modern DataTable Styles for Facturas */
    #tblFacturas.dataTable {
        width: 100% !important;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    #tblFacturas thead th {
        background: #f8f9fa !important;
        padding: 0.75rem 1rem !important;
        text-align: left;
        font-weight: 600;
        color: #374151;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid #e5e7eb !important;
        border-top: none !important;
    }
    #tblFacturas tbody td {
        padding: 0.875rem 1rem !important;
        border-bottom: 1px solid #f3f4f6 !important;
        color: #1f2937;
        background: white !important;
        vertical-align: middle;
    }
    #tblFacturas tbody tr:hover td {
        background: #f9fafb !important;
    }
    #tblFacturas tbody tr.odd td {
        background: #fafafa !important;
    }
    #tblFacturas tbody tr.odd:hover td {
        background: #f3f4f6 !important;
    }
    /* Expanded row styling */
    #tblFacturas tbody tr.shown td {
        background: #fef2f2 !important;
        border-bottom-color: #fecaca !important;
    }
    #tblFacturas tbody tr.shown + tr td {
        background: #fff5f5 !important;
        padding: 1rem 1.5rem !important;
    }
    /* Details control (expand button) */
    #tblFacturas td.details-control {
        cursor: pointer;
        text-align: center;
        width: 40px !important;
    }
    #tblFacturas td.details-control::before {
        content: '';
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: #dcfce7;
        color: #15803d;
        border-radius: 50%;
        font-family: 'bootstrap-icons';
        font-size: 0.75rem;
    }
    #tblFacturas td.details-control::before {
        content: '\F64D';
    }
    #tblFacturas tr.shown td.details-control::before {
        content: '\F2EA';
        background: #fee2e2;
        color: #dc2626;
    }
    /* Action buttons */
    .btn-ver-factura {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%);
        color: white !important;
        border-radius: 0.375rem;
        text-decoration: none !important;
        transition: all 0.2s ease;
    }
    .btn-ver-factura:hover {
        box-shadow: 0 2px 8px rgba(233, 30, 99, 0.4);
        transform: translateY(-1px);
        color: white !important;
    }
    .btn-ver-factura i {
        font-size: 0.875rem;
    }
    /* Status badges */
    .estado-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.25rem 0.625rem;
        border-radius: 9999px;
        font-size: 0.75rem;
        font-weight: 500;
    }
    .estado-prereserva {
        background: #fef3c7;
        color: #92400e;
    }
    .estado-pagado {
        background: #dcfce7;
        color: #15803d;
    }
    .estado-pendiente {
        background: #fee2e2;
        color: #dc2626;
    }
    /* DataTable controls */
    .dataTables_wrapper .dataTables_length,
    .dataTables_wrapper .dataTables_filter {
        margin-bottom: 1rem;
    }
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        font-size: 0.875rem;
    }
    .dataTables_wrapper .dataTables_filter input:focus {
        outline: none;
        border-color: #e91e63;
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .dataTables_wrapper .dataTables_info {
        color: #6b7280;
        font-size: 0.875rem;
        padding-top: 1rem;
    }
    .dataTables_wrapper .dataTables_paginate {
        padding-top: 1rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button {
        padding: 0.375rem 0.75rem;
        margin: 0 0.125rem;
        border-radius: 0.375rem;
        border: 1px solid #e5e7eb !important;
        background: white !important;
        color: #374151 !important;
        font-size: 0.875rem;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button:hover {
        background: #f3f4f6 !important;
        border-color: #d1d5db !important;
        color: #374151 !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.current {
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%) !important;
        border-color: #e91e63 !important;
        color: white !important;
    }
    .dataTables_wrapper .dataTables_paginate .paginate_button.disabled {
        opacity: 0.5;
        cursor: not-allowed;
    }
    /* Expanded content styling */
    .factura-pasajeros {
        padding: 0.5rem 0;
    }
    .factura-pasajeros-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.5rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .factura-pasajeros-title i {
        color: #e91e63;
    }
    .factura-pasajeros-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .factura-pasajeros-list li {
        background: white;
        padding: 0.375rem 0.75rem;
        border-radius: 0.375rem;
        font-size: 0.8rem;
        color: #374151;
        border: 1px solid #e5e7eb;
    }
    /* Hide old button styles */
    .button_detail {
        display: none !important;
    }
</style>

@if (ViewBag.Error != null)
{
    <div class="modern-alert-error">
        <i class="bi bi-exclamation-triangle"></i>
        <span>@ViewBag.Error</span>
    </div>
}
else
{
<script type="text/javascript">
    $(document).ready(function () {

        registerFormatNumber();

        var dataSet = @Html.Raw(ViewBag.sbDataSetJson ?? "[]");
        var jTables = eval(dataSet);
        var jt = jTables;

        var table = $("#tblFacturas").DataTable({
            "aaData": jt,
            "columns": [
        	{ "data": "NroFactura" },
                {
                    "data": "Fecha",
                    "mRender": function (data, type, row) {
                        const date = new Date(row.Fecha);
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        const hours = String(date.getHours()).padStart(2, '0');
                        const minutes = String(date.getMinutes()).padStart(2, '0');
                        const formattedDate = `${year}-${month}-${day} ${hours}:${minutes}`
                        return formattedDate;
                    }
                },
            { "data": "ClienteFullName"},
            { "data": "Monto",
            "mRender": function (data, type, row) {
                var numberFormat = formatNumberMoney(row.Monto);
                    return numberFormat;
                }
            },
        	{ "data": "EstadoDescripcion",
              "mRender": function (data, type, row) {
                  var estado = row.EstadoDescripcion || '';
                  var badgeClass = 'estado-pendiente';
                  if (estado.toLowerCase().includes('pagado')) {
                      badgeClass = 'estado-pagado';
                  } else if (estado.toLowerCase().includes('pre') || estado.toLowerCase().includes('reserva')) {
                      badgeClass = 'estado-prereserva';
                  }
                  return '<span class="estado-badge ' + badgeClass + '">' + estado + '</span>';
              }
            },
            { "data": "PaqueteDescripcion"},
            { "data": "ViajeDescripcion" },
            { "data": "FacturaID",
        	    "mRender": function (data, type, row) {
        	        return '<a href="javascript:void(0)" class="btn-ver-factura btn-detallefactura" data-facturaid="' + row.FacturaID + '" title="Ver Factura"><i class="bi bi-eye"></i></a>';
        	    }
        	},
            {
                "class": "details-control",
                "orderable": false,
                "data": null,
                "defaultContent": ""
            }
            ],
            "bAutoWidth": false,
            "pageLength": 25,
            "language": {
                "lengthMenu": "Mostrar _MENU_ Registros",
                "zeroRecords": "No se encontraron resultados",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "infoEmpty": "Mostrando 0 a 0 de 0 registros",
                "infoFiltered": "(filtrado de _MAX_ registros totales)",
                "search": "Buscar:",
                "paginate": {
                    "first": "Primero",
                    "last": "Ultimo",
                    "next": "Siguiente",
                    "previous": "Anterior"
                }
            }
        });

        $('#tblFacturas tbody').on('click', 'td.details-control', function () {
            var tr = $(this).closest('tr');
            var row = table.row( tr );

            if ( row.child.isShown() ) {
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                row.child( format(row.data()) ).show();
                tr.addClass('shown');

            }
        } );
    });

    function format ( d ) {
        var FacturaID = d.FacturaID;
        var divLoading = "<div id='"+ FacturaID + "' class='factura-pasajeros'><div style='display:flex;align-items:center;gap:0.5rem;color:#6b7280;font-size:0.875rem;'><i class='bi bi-arrow-repeat' style='animation:spin 1s linear infinite;'></i> Cargando pasajeros...</div></div>";
        $("#divMoreDetails").html(divLoading);

        getPasajeros(FacturaID);
        return sReturn = $("#divMoreDetails").html().trim();

    }


    function getPasajeros(FacturaID)
    {
        $.ajax({
            url: "/Factura/FacturaMoreDetails",
            data: { sFacturaID: FacturaID},
            success: function (data) {
                $("#" + FacturaID).html(data);
            }
        });
    }
</script>

<table class="display" id="tblFacturas">
    <thead>
        <tr>
            <th>Nro Factura</th>
            <th>Fecha</th>
            <th>Titular</th>
            <th>Monto</th>
            <th>Estado</th>
            <th>Paquete</th>
            <th>Viaje</th>
            <th style="width:50px;"></th>
            <th style="width:40px;"></th>
        </tr>
    </thead>
</table>

<div id="divMoreDetails" style="display:none;"></div>
}
