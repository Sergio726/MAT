@model MAT.MVC.Models.TransporteFormViewModel

@{
    ViewBag.Title = "Editar transporte";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-bus-front"></i>
            <span>Editar transporte @(string.IsNullOrWhiteSpace(Model.NroCoche) ? "" : "· Coche " + Model.NroCoche)</span>
        </h2>
    </div>

    <div class="modern-form-container">
        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
            </div>
        }
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })
            @Html.Partial("_TransporteForm", Model)
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
