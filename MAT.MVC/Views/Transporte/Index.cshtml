@model List<MAT.MVC.Models.TransporteModel>
@using MAT.Utilities

@{
    ViewBag.Title = "Transportes";
    Layout = "~/Views/Shared/_Layout.cshtml";

    Func<string, string> tipoIcon = tipo =>
    {
        if (string.IsNullOrWhiteSpace(tipo)) { return "bi-question-circle"; }
        switch (tipo.Trim().ToUpperInvariant())
        {
            case "MINIBUS": return "bi-bus-front";
            case "CAMION 4X4": return "bi-truck";
            case "PISOELEVADO": return "bi-layers";
            case "DOBLEPISO": return "bi-layers-fill";
            default: return "bi-bus-front";
        }
    };
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblTransportes").DataTable({
            order: [[0, 'asc']],
            pageLength: 25,
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ transportes",
                infoEmpty: "No hay transportes disponibles",
                infoFiltered: "(filtrado de _MAX_ transportes totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            }
        });
    });
</script>

<div class="modern-page-container">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-bus-front"></i>
            <span>Transportes</span>
        </h2>
        <div class="modern-page-actions">
            @Html.ActionLink("Agregar transporte", "Create", "Transporte", null, new { @class = "btn-modern btn-modern-primary" })
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblTransportes">
            <thead>
                <tr>
                    <th>Nro. coche</th>
                    <th>Tipo</th>
                    <th>Máx. pasajeros</th>
                    <th>Matrícula</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var tipoLabel = EnumExtensions.GetTipoTransporteDisplayName(item.Tipo);
                    var tipoCode = string.IsNullOrWhiteSpace(item.Tipo) ? null : item.Tipo.Trim();
                    <tr>
                        <td>
                            <strong style="color: var(--brand-primary);">@item.NroCoche</strong>
                        </td>
                        <td>
                            @if (string.IsNullOrWhiteSpace(tipoCode))
                            {
                                <span class="badge bg-secondary">Sin especificar</span>
                            }
                            else
                            {
                                <span class="badge-pasajero" title="@tipoCode">
                                    <i class="bi @tipoIcon(tipoCode)"></i>
                                    <span>@(tipoLabel ?? tipoCode)</span>
                                </span>
                            }
                        </td>
                        <td>
                            <span class="badge-pasajero">
                                <i class="bi bi-people"></i>
                                <span>@item.MaxPasajeros</span>
                            </span>
                        </td>
                        <td>
                            <strong>@item.Matricula</strong>
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/Transporte/Edit/@item.TransporteID" class="btn-action btn-action-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
