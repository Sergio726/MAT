@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Logs del sistema";
    var logs = ViewBag.Logs as List<string> ?? new List<string>();
    var correlationId = ViewBag.CorrelationId as string;
}

<div class="modern-page-container">
    <div class="modern-page-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="modern-page-title mb-0">
            <i class="bi bi-terminal"></i>
            <span>Logs del sistema <small class="text-muted fw-normal">(@logs.Count entradas)</small></span>
        </h2>
        <a href="@Url.Action("Index", "Admin")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i>Volver al panel
        </a>
    </div>

    <div class="card admin-logs-card mt-3 border">
        <div class="card-body">
            <form method="get" class="d-flex flex-wrap align-items-end gap-2">
                <div class="flex-grow-1" style="min-width: 220px; max-width: 420px;">
                    <label class="form-label mb-1" for="correlationId">Correlation ID</label>
                    <input type="text" name="correlationId" id="correlationId" value="@correlationId" class="form-control font-monospace"
                           placeholder="Filtrar por Correlation ID" />
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary btn-sm">
                        <i class="bi bi-funnel me-1"></i>Filtrar
                    </button>
                    <a href="@Url.Action("Logs")" class="btn btn-outline-secondary btn-sm">Limpiar</a>
                    <a href="@Url.Action("LogsRaw", new { correlationId = correlationId })" class="btn btn-outline-secondary btn-sm" target="_blank" rel="noopener">
                        <i class="bi bi-file-text me-1"></i>Ver como texto plano
                    </a>
                </div>
            </form>
        </div>
    </div>

    <div class="card admin-logs-output mt-3 border">
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(correlationId))
            {
                <div class="alert alert-info mb-3" role="alert">
                    Mostrando entradas para Correlation ID: <strong>@correlationId</strong>
                </div>
            }

            @if (logs.Count == 0)
            {
                <div class="alert alert-warning mb-0" role="alert">
                    <i class="bi bi-inbox me-1"></i>No hay entradas de log en memoria con ese filtro.
                </div>
            }
            else
            {
                <pre>@string.Join("\n", logs)</pre>
            }
        </div>
    </div>
</div>
