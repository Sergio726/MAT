@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Logs del sistema";
    var logs = ViewBag.Logs as List<string> ?? new List<string>();
    var correlationId = ViewBag.CorrelationId as string;
}

<div class="container-fluid py-3 px-3">
    <h2 class="mb-3">
        Logs del sistema <small class="text-muted">(@logs.Count entradas)</small>
    </h2>

    <form method="get" class="d-flex flex-wrap align-items-end gap-2 mb-3">
        <div class="input-group" style="max-width: 420px;">
            <input type="text" name="correlationId" value="@correlationId" class="form-control"
                   placeholder="Filtrar por Correlation ID" />
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-funnel me-1"></i>Filtrar
            </button>
            <a href="@Url.Action("Logs")" class="btn btn-outline-secondary">Limpiar</a>
        </div>
        <a href="@Url.Action("LogsRaw", new { correlationId = correlationId })" class="btn btn-outline-secondary" target="_blank" rel="noopener">
            <i class="bi bi-file-text me-1"></i>Ver como texto plano
        </a>
    </form>

    @if (!string.IsNullOrWhiteSpace(correlationId))
    {
        <div class="alert alert-info">
            Mostrando entradas para Correlation ID: <strong>@correlationId</strong>
        </div>
    }

    @if (logs.Count == 0)
    {
        <div class="alert alert-warning">No hay entradas de log en memoria con ese filtro.</div>
    }
    else
    {
        <pre class="rounded p-3 small overflow-auto font-monospace" style="background:#1e1e1e; color:#d4d4d4; max-height:80vh;">@string.Join("\n", logs)</pre>
    }
</div>
