@model IEnumerable<SelectListItem>
@using MAT.Utilities

<style>
    .hotel-dropdown-container {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0.5rem;
    }
    .hotel-dropdown-label {
        font-size: 0.8125rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .hotel-dropdown-label i {
        color: var(--primary-color, #e91e63);
    }
    #HotelPorViaje {
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        background: white;
        min-width: 200px;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    #HotelPorViaje:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
</style>

<div class="hotel-dropdown-container">
    <label class="hotel-dropdown-label">
        <i class="bi bi-building"></i>
        Hoteles
    </label>
    @Html.DropDownList("HotelPorViaje", Model)
</div>

<script type="text/javascript">
    $(function () {
        var hotelselected = $("#HotelPorViaje option:selected").val();
        var viajeselected = $("#Viajes option:selected").val();
        var url = "/Admin/GridPlanillaHotel?hotelid=" + hotelselected + "&viajeid=" + viajeselected;
        $("#grid_planilla").load(url);
    });
    $(document).on("change", "#HotelPorViaje", function () {
        var hotelselected = $("#HotelPorViaje option:selected").val();
        var viajeselected = $("#Viajes option:selected").val();
        var url = "/Admin/GridPlanillaHotel?hotelid=" + hotelselected + "&viajeid=" + viajeselected;
        $("#grid_planilla").load(url);
    });
</script>
