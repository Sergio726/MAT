@model IEnumerable<MAT.MVC.Models.AdminUserListItem>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="modern-page-title mb-0">
            <i class="bi bi-people"></i>
            <span>Usuarios del sistema</span>
        </h2>
        <a href="@Url.Action("RegistrarVendedor", "Admin")" class="btn-modern btn-modern-primary">
            <i class="bi bi-person-plus"></i>
            <span>Registrar vendedor</span>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string))
    {
        <div class="alert alert-success mt-3 mb-0" role="alert">@ViewBag.StatusMessage</div>
    }

    <div class="modern-table-container mt-3 table-responsive">
        <table class="modern-table table table-striped align-middle">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Usuario</th>
                    <th>Roles</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    <tr class="@(!u.IsApproved ? "table-secondary" : null)">
                        <td>@u.UserId</td>
                        <td>@Html.Encode(u.UserName)</td>
                        <td>@Html.Encode(u.RolesSummary)</td>
                        <td>
                            @if (!u.IsApproved)
                            {
                                <span class="badge bg-secondary">Deshabilitado</span>
                            }
                            else if (u.IsLockedOut)
                            {
                                <span class="badge bg-warning text-dark">Bloqueado</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a href="@Url.Action("UsuarioEditar", "Admin", new { id = u.UserId })" class="btn btn-sm btn-outline-primary" title="Editar">Editar</a>
                                <a href="@Url.Action("UsuarioResetPassword", "Admin", new { id = u.UserId })" class="btn btn-sm btn-outline-secondary" title="Restablecer contraseña">Contraseña</a>
                                @if (u.IsLockedOut)
                                {
                                    using (Html.BeginForm("UsuarioDesbloquear", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Desbloquear</button>
                                    }
                                }
                                @if (u.IsApproved)
                                {
                                    using (Html.BeginForm("UsuarioEstablecerEstado", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <input type="hidden" name="aprobado" value="false" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger js-admin-confirm-submit"
                                                data-confirm-title="Deshabilitar usuario"
                                                data-confirm-msg="¿Deshabilitar este usuario? No podrá iniciar sesión.">Deshabilitar</button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("UsuarioEstablecerEstado", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <input type="hidden" name="aprobado" value="true" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Habilitar</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
(function () {
    $(document).on("click", ".js-admin-confirm-submit", function (e) {
        e.preventDefault();
        var form = this.form;
        if (!form) return false;
        var $btn = $(this);
        var msg = $btn.data("confirmMsg") || "¿Confirmar esta acción?";
        var title = $btn.data("confirmTitle") || "Confirmación";
        confirm(msg, title,
            function () {
                var $dlg = $(this);
                try { $dlg.dialog("close"); } catch (ex) { }
                try { $dlg.remove(); } catch (ex) { }
                form.submit();
            },
            function () {
                var $dlg = $(this);
                try { $dlg.dialog("close"); } catch (ex) { }
                try { $dlg.remove(); } catch (ex) { }
            }
        );
        return false;
    });
})();
</script>
}
