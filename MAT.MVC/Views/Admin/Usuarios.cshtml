@model IEnumerable<MAT.MVC.Models.AdminUserListItem>
@{
    ViewBag.Title = "Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header d-flex flex-wrap align-items-center justify-content-between gap-2">
        <h2 class="modern-page-title mb-0">
            <i class="bi bi-people"></i>
            <span>Usuarios del sistema</span>
        </h2>
        <a href="@Url.Action("RegistrarVendedor", "Admin")" class="btn-modern btn-modern-primary">
            <i class="bi bi-person-plus"></i>
            <span>Registrar vendedor</span>
        </a>
    </div>

    @if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string))
    {
        <div class="alert alert-success mt-3 mb-0" role="alert">@ViewBag.StatusMessage</div>
    }

    <div class="modern-table-container mt-3">
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <label for="adminUsuariosFiltroEstado" class="form-label mb-0 text-nowrap">Estado</label>
            <select id="adminUsuariosFiltroEstado" class="form-select form-select-sm w-auto" aria-label="Filtrar por estado de usuario">
                <option value="">Todos</option>
                <option value="activo">Activo</option>
                <option value="deshabilitado">Deshabilitado</option>
                <option value="bloqueado">Bloqueado</option>
            </select>
        </div>
        <div class="table-responsive">
        <table id="tblAdminUsuarios" class="modern-table table table-striped align-middle w-100">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Usuario</th>
                    <th>Roles</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    string estadoFiltro = !u.IsApproved ? "deshabilitado" : (u.IsLockedOut ? "bloqueado" : "activo");
                    <tr class="@(!u.IsApproved ? "table-secondary" : null)" data-mat-estado="@estadoFiltro">
                        <td>@u.UserId</td>
                        <td>@Html.Encode(u.UserName)</td>
                        <td>@Html.Encode(u.RolesSummary)</td>
                        <td>
                            @if (!u.IsApproved)
                            {
                                <span class="badge bg-secondary">Deshabilitado</span>
                            }
                            else if (u.IsLockedOut)
                            {
                                <span class="badge bg-warning text-dark">Bloqueado</span>
                            }
                            else
                            {
                                <span class="badge bg-success">Activo</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="d-inline-flex flex-wrap justify-content-end gap-1">
                                <a href="@Url.Action("UsuarioEditar", "Admin", new { id = u.UserId })" class="btn btn-sm btn-outline-primary" title="Editar">Editar</a>
                                <a href="@Url.Action("UsuarioResetPassword", "Admin", new { id = u.UserId })" class="btn btn-sm btn-outline-secondary" title="Restablecer contraseña">Contraseña</a>
                                @if (u.IsLockedOut)
                                {
                                    using (Html.BeginForm("UsuarioDesbloquear", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Desbloquear</button>
                                    }
                                }
                                @if (u.IsApproved)
                                {
                                    using (Html.BeginForm("UsuarioEstablecerEstado", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <input type="hidden" name="aprobado" value="false" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger js-admin-confirm-submit"
                                                data-confirm-title="Deshabilitar usuario"
                                                data-confirm-msg="¿Deshabilitar este usuario? No podrá iniciar sesión.">Deshabilitar</button>
                                    }
                                }
                                else
                                {
                                    using (Html.BeginForm("UsuarioEstablecerEstado", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <input type="hidden" name="aprobado" value="true" />
                                        <button type="submit" class="btn btn-sm btn-outline-success">Habilitar</button>
                                    }
                                }
                                @if (u.MostrarEliminar)
                                {
                                    using (Html.BeginForm("UsuarioEliminar", "Admin", FormMethod.Post, new { @class = "d-inline" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="userId" value="@u.UserId" />
                                        <button type="submit" class="btn btn-sm btn-danger js-admin-confirm-submit"
                                                data-confirm-title="Eliminar usuario"
                                                data-confirm-msg="¿Eliminar definitivamente a este usuario? Se borrarán la cuenta, los roles y el perfil. Esta acción no se puede deshacer.">Eliminar</button>
                                    }
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
    </div>
</div>

<div class="modal fade" id="adminConfirmModal" tabindex="-1" aria-labelledby="adminConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="adminConfirmModalLabel">Confirmación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="adminConfirmModalMessage">
                ¿Confirmar esta acción?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="adminConfirmModalAccept">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    /* _LayoutAdmin renderiza Scripts antes del body principal: usar document.ready. */
    $(function () {
        var $tbl = $("#tblAdminUsuarios");
        if ($tbl.length && $.fn.dataTable) {
            var estadoFilter = function (settings, data, dataIndex) {
                if (!settings || !settings.nTable || settings.nTable.id !== "tblAdminUsuarios") return true;
                var sel = document.getElementById("adminUsuariosFiltroEstado");
                var v = sel ? sel.value : "";
                if (!v) return true;
                var api = new $.fn.dataTable.Api(settings);
                var row = api.row(dataIndex).node();
                return row && row.getAttribute("data-mat-estado") === v;
            };
            $.fn.dataTable.ext.search.push(estadoFilter);

            $tbl.DataTable({
                pageLength: 25,
                order: [[1, "asc"]],
                autoWidth: false,
                language: {
                    url: "/Scripts/dataTable/i18n/Spanish.json"
                },
                columnDefs: [
                    { targets: [0, 2, 3, 4], searchable: false },
                    { targets: 4, orderable: false }
                ]
            });

            $("#adminUsuariosFiltroEstado").on("change", function () {
                $tbl.DataTable().draw();
            });
        }

        var confirmModalEl = document.getElementById("adminConfirmModal");
        var confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;
        var pendingForm = null;

        $("#adminConfirmModalAccept").on("click", function () {
            if (!pendingForm) return;
            var form = pendingForm;
            pendingForm = null;
            if (confirmModal) confirmModal.hide();
            form.submit();
        });

        if (confirmModalEl) {
            confirmModalEl.addEventListener("hidden.bs.modal", function () {
                pendingForm = null;
            });
        }

        $(document).on("click", ".js-admin-confirm-submit", function (e) {
            e.preventDefault();
            var form = this.form;
            if (!form || !confirmModal) return false;
            var $btn = $(this);
            var msg = $btn.data("confirmMsg") || "¿Confirmar esta acción?";
            var title = $btn.data("confirmTitle") || "Confirmación";

            pendingForm = form;
            $("#adminConfirmModalLabel").text(title);
            $("#adminConfirmModalMessage").text(msg);
            confirmModal.show();
            return false;
        });
    });
})();
</script>
}
