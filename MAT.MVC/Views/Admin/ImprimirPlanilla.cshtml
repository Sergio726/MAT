@model MAT.Entities.Planilla
@using MAT.Utilities

<script src="~/Scripts/jquery-3.7.1.min.js"></script>
<link href="~/Content/mat.planillaprint.css" rel="stylesheet" />

<div class="encabezado planilla-print-header">
    <input id="viaje-id" type="hidden" value="@Model.ViajeId" />
    <input id="planilla-id" type="hidden" value="@Model.PlanillaId" />
    <p><strong>Fecha:</strong> @Model.FechaRegistro.ToShortDateString()</p>
    <p><strong>Total planilla:</strong> @String.Format("{0:C}", Model.Total)</p>
    <p><strong>Viaje:</strong> @Helper.GetViajeDescripcion(Model.ViajeId)</p>
</div>

<div class="hoteles">

</div>

<div class="servicios">

</div>

<script type="text/javascript">
    $(function () {
        var viajeid = $("#viaje-id").val();
        var planillaid = $("#planilla-id").val();
        $(".hoteles").load("/Admin/GridPlanillaHotelPrint?viajeid=" + viajeid + "&planillaid=" + planillaid);
        $(".servicios").load("/Admin/GridPlanillaServiciosItemPrint?planillaid=" + planillaid);
    });
</script>
