<style>
    .grid-resumen-pagos-container {
        padding: 0.5rem;
    }
    .table-container {
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    #tblPagosViaje {
        width: 100% !important;
    }
    #tblPagosViaje thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblPagosViaje tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblPagosViaje tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    #tblPagosViaje tfoot th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.875rem 1rem;
        font-size: 0.875rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        border-top: 2px solid var(--border-color, #e5e7eb);
    }
    .total-value {
        color: var(--primary-color, #0b2a4a);
        font-weight: 600;
    }
</style>

@if (ViewBag.Error != null)
{
    <script type="text/javascript">
        console.log("@ViewBag.Error");
    </script>
    return;
}

<div class="grid-resumen-pagos-container">
    @if (ViewBag.ViajeIdResumen != null)
    {
        var viajeIdResumen = (Guid)ViewBag.ViajeIdResumen;
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <a class="btn btn-outline-primary btn-sm"
               href="@Url.Action("ResumenPagosExcel", "Admin", new { ViajeID = viajeIdResumen })"
               target="_blank" rel="noopener">
                <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
            </a>
        </div>
    }
    <div class="table-container">
        <table id="tblPagosViaje" class="display">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Tipo de Pago</th>
                    <th>Nro Transacción</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th style="text-align:left;">Total</th>
                    <th colspan="3"></th>
                    <th class="total-value">@string.Format("{0:C}", ViewBag.TotalPagos)</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var dataSet = @Html.Raw(ViewBag.sbDataSetJson);
        var jTables = eval(dataSet);
        var jt = jTables;

        $("#tblPagosViaje").DataTable({
            "aaData": jt,
            "columns": [
                { "data": "Cliente" },
                { "data": "sFechaPago" },
                {
                    "data": "TipoPagoDescripcion",
                    "className": "dt-center"
                },
                { "data": "TransaccionID" },
                {
                    "data": "Monto",
                    "mRender": function (data, type, row) {
                        return "<span>$ </span>" + data;
                    },
                    "className": "dt-left"
                }
            ],
            "bAutoWidth": false,
            "pageLength": 25,
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
            }
        });
    });
</script>
