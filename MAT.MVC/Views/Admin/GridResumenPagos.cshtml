@if (ViewBag.Error != null)
{
    <script type="text/javascript">
        console.log("@ViewBag.Error");
    </script>
    return;
}

<div class="grid-resumen-pagos-container">
    @if (ViewBag.ViajeIdResumen != null)
    {
        var viajeIdResumen = (Guid)ViewBag.ViajeIdResumen;
        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
            <a class="btn btn-outline-primary btn-sm"
               href="@Url.Action("ResumenPagosExcel", "Admin", new { ViajeID = viajeIdResumen })"
               target="_blank" rel="noopener">
                <i class="bi bi-file-earmark-excel"></i> Exportar a Excel
            </a>
        </div>
    }
    <div class="table-container">
        <table id="tblPagosViaje" class="display modern-table">
            <thead>
                <tr>
                    <th>Cliente</th>
                    <th>Fecha</th>
                    <th>Tipo de Pago</th>
                    <th>Nro Transacción</th>
                    <th>Monto</th>
                </tr>
            </thead>
            <tfoot>
                <tr>
                    <th style="text-align:left;">Total</th>
                    <th colspan="3"></th>
                    <th class="total-value">@string.Format("{0:C}", ViewBag.TotalPagos)</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var dataSet = @Html.Raw(ViewBag.sbDataSetJson);
        var jTables = eval(dataSet);
        var jt = jTables;

        $("#tblPagosViaje").DataTable({
            "aaData": jt,
            "columns": [
                { "data": "Cliente" },
                { "data": "sFechaPago" },
                {
                    "data": "TipoPagoDescripcion",
                    "className": "dt-center"
                },
                { "data": "TransaccionID" },
                {
                    "data": "Monto",
                    "mRender": function (data, type, row) {
                        return "<span>$ </span>" + data;
                    },
                    "className": "dt-left"
                }
            ],
            "bAutoWidth": false,
            "pageLength": 25,
            "language": {
                "url": "/Scripts/dataTable/i18n/Spanish.json"
            }
        });
    });
</script>
