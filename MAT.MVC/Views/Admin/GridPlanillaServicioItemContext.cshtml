@model List<MAT.Entities.PlanillaServicioItem>
@using MAT.Utilities

<table class="mat-customtable">
    <thead>
        <tr>
            <th class="oculto">Id</th>
            <th>
                Descripcion
            </th>
            <th>
                Precio
            </th>
            <th>
                Cantidad
            </th>
            <th>
                Subtotal
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td class="oculto">
                    @item.PlanillaServicioItemId
                </td>
                <td>
                    @Helper.GetServicioDescripcion(item.ServicioId)
                </td> 
                <td>
                    @Helper.GetPrecioServicio(item.ServicioId)
                </td>
                <td>
                    <input type="text" class="cantidad" />
                </td>            
                <td>
                    
                </td>
            </tr>
        }
    </tbody>
</table>
<h4 id="total"></h4>
<p class="botonera-form mt-2">
    <a id="btn-generar-planilla" href="#" class="btn btn-danger">
        <i class="bi bi-file-earmark-plus me-1"></i>Generar planilla
    </a>
</p>
<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");
    });    
</script>