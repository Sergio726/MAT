@model IEnumerable<MAT.Entities.Servicio>
@using MAT.Enums
@{
    ViewBag.Title = "Servicios Administrador";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="title">Servicios</h2>

<p class="botonera-form">
    <input type="button" value="+ Agregar Servicio" class="btn btn-small btn-inverse" onclick="location.href='@Url.Action("ServiciosAdminCreate", "Admin")'" />
</p>

<table class="mat-customtable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>             
                <td>
                    @*<a href="/Servicio/Edit/@item.ServicioId">
                        <img src="/Images/pencil.png" width="32" height="32" title="Editar" /></a>*@
                    @*<a href="/Servicio/Details/@item.ServicioId">
                        <img src="/Images/notepad.png" width="32" height="32" title="Detalles" /></a>*@
                    <a href="#" id="btn-eliminar-servicio-admin" data-id="@item.ServicioId">
                        <img src="/Images/cross.png" width="32" height="32" title="Eliminar" /></a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");
    });
</script>