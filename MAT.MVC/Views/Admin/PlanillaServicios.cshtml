@using MAT.Utilities
@{
    ViewBag.Title = "PlanillaServicios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="title">Generación de Planilla - Paso 2 (Servicios)</h2>

<div class="form">
       <div class="form-label">Viajes</div>
        <div class="form-field">
            @Html.DropDownList("Viajes", Helper.ToSelectEntities("Viaje"), new { @class = "ui-button ui-widget ui-corner-all" })
            <input type="button" id="AgregarPlanillaServicioItem" title="Agregar Item" value="Agregar Item" class="btn btn-primary btn-sm" />
        </div>    
</div>

<div id="grid_items">

</div>