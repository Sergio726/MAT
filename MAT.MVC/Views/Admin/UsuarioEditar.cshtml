@model MAT.MVC.Models.AdminUsuarioEditModel
@{
    ViewBag.Title = "Editar usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section BreadcrumbItems {
    <li class="breadcrumb-item"><a href="@Url.Action("Usuarios", "Admin")">Usuarios</a></li>
    <li class="breadcrumb-item active" aria-current="page">Editar usuario</li>
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-person"></i>
            <span>Editar usuario</span>
        </h2>
        <p class="text-white-50 small mb-0">@Html.Encode(Model.UserName)</p>
    </div>

    <div class="row mt-3">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm bg-white">
                <div class="card-body p-4">
                    @using (Html.BeginForm("UsuarioEditar", "Admin", FormMethod.Post, new { @class = "" }))
                    {
                        @Html.AntiForgeryToken()
                        @Html.HiddenFor(m => m.UserId)
                        @Html.HiddenFor(m => m.UserName)

                        @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                        <div class="mb-3">
                            <label class="form-label text-secondary">Nombre de usuario</label>
                            <div class="form-control-plaintext fw-semibold">@Html.Encode(Model.UserName)</div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label text-secondary mb-2">Roles del usuario</label>
                            <div class="border rounded p-3 bg-light-subtle">
                                @if (Model.Roles != null && Model.Roles.Count > 0)
                                {
                                    for (var i = 0; i < Model.Roles.Count; i++)
                                    {
                                        @Html.HiddenFor(m => m.Roles[i].RoleName)
                                        <div class="form-check mb-2">
                                            @Html.CheckBoxFor(m => m.Roles[i].Selected, new { @class = "form-check-input", id = "role_" + i })
                                            <label for="@("role_" + i)" class="form-check-label">@Model.Roles[i].RoleName</label>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="text-secondary small">No hay roles definidos en el sistema.</div>
                                }
                            </div>
                            @Html.HiddenFor(m => m.EsAdministrador)
                            <div class="form-text">Puede asignar o quitar cualquier rol. La validación de seguridad de Administrador se aplica al guardar.</div>
                        </div>

                        <div class="mb-3 small text-secondary">
                            <div>Estado de cuenta (membership): <strong>@(Model.IsApproved ? "Aprobada (puede iniciar sesión)" : "Deshabilitada")</strong></div>
                            @if (Model.IsLockedOut)
                            {
                                <div class="text-warning mt-1"><i class="bi bi-lock"></i> Cuenta bloqueada por intentos fallidos. Use Desbloquear en el listado.</div>
                            }
                        </div>

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn-modern btn-modern-primary">Guardar cambios</button>
                            <a href="@Url.Action("Usuarios", "Admin")" class="btn btn-outline-secondary">Volver al listado</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
