@model List<List<MAT.MVC.Models.PlanillaHotelPrintModel>>
@using MAT.Utilities

@foreach (var item in Model)
{
    double _totalhotel = 0;
    <h3 class="h5 fw-semibold mb-2 mt-3">@item.FirstOrDefault().Hotel</h3>
    <table class="mat-customtable resumen-planilla table table-sm">
        <thead>
            <tr>
                <th>Tipo habitación</th>
                <th>Cantidad de personas</th>
                <th>Menores</th>
                <th>Días</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var linea in item)
            {
                <tr>
                    <td>@linea.TipoHabitacion</td>
                    <td>@linea.Pasajeros.Count</td>
                    <td>@linea.Menores</td>
                    <td>@linea.Dias</td>
                    <td class="alignright subtotal text-end" data-tipo="@linea.Habitacion.Tipo.Value">@String.Format("{0:C}", linea.Subtotal)</td>
                </tr>
                _totalhotel += linea.Subtotal;
            }
        </tbody>
    </table>
    <p class="fw-semibold mb-3">Total hotel: @String.Format("{0:C}", _totalhotel)</p>
}
