@model MAT.Entities.PrecioServicio
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Editar Precio de Servicio";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="title">Editar Precio de Servicio</h2>

<div class="form">
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true)

 
        <div class="form-label">
            Servicio
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.ServicioId, Helper.ToSelectEntities("ServicioAdmin", Model.ServicioId))
            @Html.ValidationMessageFor(model => model.ServicioId)
        </div> 
        
        <div class="form-label">
            Precio
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Precio)
            @Html.ValidationMessageFor(model => model.Precio)
        </div>
        
        <div class="form-label">
            Activo
        </div>    
        <div class="form-field">
            @Html.CheckBoxFor(model => model.Activo)
            @Html.ValidationMessageFor(model => model.Activo)
        </div>    
        
        <p>
            <input type="submit"  value="Guardar" class="btn btn-small btn-inverse view-all hidden-phone" />
        </p>
    }
</div>
