@model List<MAT.Entities.PlanillaServicioItem>
@using System.Linq
@using MAT.Utilities

<h3 class="h5 fw-semibold mb-2 mt-3 border-bottom pb-1">Servicios y agregados</h3>
@{
    var items = Model ?? new List<MAT.Entities.PlanillaServicioItem>();
    var totalServicios = items.Count > 0 ? items.Sum(x => x.Subtotal) : 0d;
}
<table class="mat-customtable servicios table table-sm table-bordered align-middle">
    <thead class="table-light">
        <tr>
            <th class="oculto">Id</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td class="oculto item-id">@item.PlanillaServicioItemId</td>
                <td>@Helper.GetServicioDescripcion(item.ServicioId)</td>
                <td>@Helper.GetPrecioServicio(item.ServicioId)</td>
                <td class="cantidad">
                    <input type="text" class="txt-cantidad cantidad-servicio-item form-control form-control-sm" style="max-width:5rem" value="@item.Cantidad" />
                </td>
                <td class="subtotal text-end">@item.Subtotal</td>
            </tr>
        }
    </tbody>
</table>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <span class="fw-semibold text-secondary small text-uppercase">Total servicios</span>
    <input type="text" class="text-total-servicios subtotales form-control form-control-sm" style="max-width:12rem" value="@totalServicios" />
</div>
