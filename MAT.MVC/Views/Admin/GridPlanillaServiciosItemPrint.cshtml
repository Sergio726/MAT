@model List<MAT.Entities.PlanillaServicioItem>
@using MAT.Utilities

<h3>SERVICIOS Y AGREGADOS</h3>
@{
    double _totalservicios = 0;
<table class="mat-customtable">
    <thead>
        <tr>
            <th>Descripcion
            </th>
            <th>Precio
            </th>
            <th>Cantidad
            </th>
            <th>Subtotal
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Helper.GetServicioDescripcion(item.ServicioId)
                </td>
                <td>
                    @String.Format("{0:C}", Helper.GetPrecioServicio(item.ServicioId))
                </td>
                <td>
                    @item.Cantidad
                </td>
                <td>
                    @String.Format("{0:C}", item.Subtotal)
                </td>
            </tr>
            _totalservicios += item.Subtotal;
        }
    </tbody>
</table>
    
    <h4>TOTAL SERVICIOS Y AGREGADOS: @String.Format("{0:C}", _totalservicios)</h4>
}