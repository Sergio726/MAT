@model List<MAT.Entities.PlanillaServicioItem>
@using System.Linq
@using MAT.Utilities

@{
    var items = Model ?? new List<MAT.Entities.PlanillaServicioItem>();
    var totalServicios = items.Count > 0 ? items.Sum(x => x.Subtotal) : 0d;
}

<h3 class="h5 fw-semibold mb-2 mt-3 border-bottom pb-1">Servicios y agregados</h3>
<table class="mat-customtable table table-sm">
    <thead>
        <tr>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Cantidad</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in items)
        {
            <tr>
                <td>@Helper.GetServicioDescripcion(item.ServicioId)</td>
                <td>@String.Format("{0:C}", Helper.GetPrecioServicio(item.ServicioId))</td>
                <td>@item.Cantidad</td>
                <td class="text-end">@String.Format("{0:C}", item.Subtotal)</td>
            </tr>
        }
    </tbody>
</table>

<p class="fw-semibold mb-3">Total servicios y agregados: @String.Format("{0:C}", totalServicios)</p>
