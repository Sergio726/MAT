@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-shield-check"></i>
            <span>Auditoría de Facturas</span>
        </h2>
    </div>

    <div class="modern-form-container">
        <form id="formFilter">
            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-calendar3"></i>
                        <span>Desde</span>
                    </label>
                    <input name='dateFrom' class="modern-form-input valtxt" id="dateFrom" type='text' tabindex='1' placeholder="Seleccione fecha">
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-calendar3"></i>
                        <span>Hasta</span>
                    </label>
                    <input name='dateTo' class="modern-form-input valtxt" id="dateTo" type='text' tabindex='2' placeholder="Seleccione fecha">
                </div>

                <div class="modern-form-group">
                    <button type="button" onclick="javascript: searchFactura();" class="btn-modern btn-modern-primary">
                        <i class="bi bi-search"></i>
                        <span>Buscar</span>
                    </button>
                </div>
            </div>
        </form>
    </div>

    <div id="divResult" class="modern-table-container">
    <table id="tblAudit" class="modern-table" style="display:none;">
        @*<thead>
            <tr>
                <th>
                    ID
                </th>
                <th>
                    Acción
                </th>
                <th>
                    Descripción
                </th>
                <th>
                    Fecha
                </th>
                <th>
                    Persona/Cliente
                </th>
                <th>
                    Vendedor
                </th>
            </tr>
        </thead>*@
    </table>
</div>

<script type="text/javascript">
    var _dataTable = "";
    $(document).ready(function () {
        var auditDpOpts = {
            dateFormat: "dd/mm/yy",
            firstDay: 1,
            changeMonth: true,
            changeYear: true,
            yearRange: "2015:2035",
            showButtonPanel: true,
            showOtherMonths: true,
            selectOtherMonths: true
        };
        $("#dateFrom").datepicker($.extend({}, auditDpOpts, {
            onClose: function (selected) {
                if (selected) {
                    var d = $("#dateFrom").datepicker("getDate");
                    if (d) $("#dateTo").datepicker("option", "minDate", d);
                }
            }
        }));
        $("#dateTo").datepicker($.extend({}, auditDpOpts, {
            onClose: function () {
                var d0 = $("#dateFrom").datepicker("getDate");
                var d1 = $("#dateTo").datepicker("getDate");
                if (d0 && d1 && d1 < d0) $("#dateTo").datepicker("setDate", d0);
            }
        }));

        $("input.modern-form-input[type='text']").on("focus click", function () {
            $(this).css("background-color", "#fff");
        });
    });

    function valForm() {
        var bResult = true;

        $.each($(".valtxt"), function (i, l) {
            if ($(this).val() == "") {
                $(this).addClass("modern-form-input-error");
                bResult = false;
            } else {
                $(this).removeClass("modern-form-input-error");
            }
        });
        if (!bResult) {
            (window.alertInfo || window.alert)("Los campos remarcados no pueden estar vacíos. Por favor revise que estén cargados de forma correcta.", "Validación");
            return bResult;
        }

        var date1 = $("#dateFrom").val();
        var date2 = $("#dateTo").val();
        if (validate_fechaMayorQue(date2, date1)) {
            (window.alertInfo || window.alert)("La fecha inicial no puede ser mayor a la fecha final.", "Validación");
             return false;
        }
        return bResult;
    }

    function searchFactura() {
        if (!valForm()) return;

        var $wrap = $("#divResult");
        var $tbl = $("#tblAudit").detach();
        var loadingHtml = '<div class="modern-loading-container"><div class="modern-loading-spinner"></div><span class="modern-loading-text">Buscando registros...</span></div>';
        $wrap.html(loadingHtml);

        var date1 = $("#dateFrom").val();
        var date2 = $("#dateTo").val();
        $.ajax({
            url: '@Url.Action("AuditFactura", "Admin")',
            type: "GET",
            data: { dateFrom: date1, dateTo: date2 },
            dataType: "json",
            success: function (data) {
                $wrap.empty().append($tbl);
                loadTable(data);
            },
            error: function () {
                $wrap.empty().append($tbl);
                $tbl.hide();
                $wrap.prepend('<div class="modern-alert-error" style="margin-bottom:1rem"><i class="bi bi-exclamation-circle"></i><span>Error al buscar registros. Por favor, intente nuevamente.</span></div>');
            }
        });
    }

    function loadTable(payload) {
        var rows = [];
        if (payload == null) {
            rows = [];
        } else if (typeof payload === "string") {
            try {
                rows = JSON.parse(payload);
            } catch (e) {
                rows = [];
            }
        } else if ($.isArray(payload)) {
            rows = payload;
        }

        var $tbl = $("#tblAudit");
        if (!$tbl.length) return;

        if ($.fn.dataTable && $.fn.dataTable.isDataTable($tbl)) {
            $tbl.DataTable().destroy();
        }
        $tbl.empty();

        _dataTable = $tbl.DataTable({
            data: rows,
            columns: [
                { title: "ID", data: "ID" },
                { title: "Acción", data: "Accion" },
                { title: "Descripción", data: "Descripcion" },
                { title: "Fecha", data: "Fecha" },
                { title: "Persona/Cliente", data: "Cliente" },
                { title: "Vendedor", data: "Vendedor" }
            ],
            autoWidth: false,
            pageLength: 25
        });

        $tbl.show();
    }

</script>
</div>