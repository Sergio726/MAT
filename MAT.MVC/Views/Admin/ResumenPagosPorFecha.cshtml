@{
    ViewBag.Title = "Resumen de Pagos por Fecha";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <header class="modern-page-header">
        <h1 class="modern-page-title">
            <i class="bi bi-calendar-check"></i>
            <span>Resumen de Pagos por Fecha</span>
        </h1>
        <p class="text-secondary small mb-0 mt-1">Seleccione una fecha para ver todos los pagos registrados ese día.</p>
    </header>

    <div class="resumen-fecha-filter-card">
        <div class="resumen-fecha-filter-group">
            <label class="resumen-fecha-filter-label" for="filtro-fecha">
                <i class="bi bi-calendar-date"></i>
                Seleccionar fecha
            </label>
            <div class="resumen-fecha-input-wrap">
                <i class="bi bi-calendar3"></i>
                <input id="filtro-fecha" class="datetime" type="text" placeholder="Seleccione una fecha..." readonly />
            </div>
        </div>
    </div>

    <div id="grid_pagos" class="resumen-fecha-results">
        <div class="resumen-fecha-placeholder">
            <i class="bi bi-calendar-event"></i>
            <p>Seleccione una fecha para ver el resumen de pagos</p>
        </div>
    </div>
</div>

<script type="text/javascript">
    $.customDate = function (dateObject) {
        var arraydate = dateObject.split('/');
        var day = parseInt(arraydate[0]);
        var month = parseInt(arraydate[1]);
        var year = parseInt(arraydate[2]);
        if (day < 10) {
            day = "0" + day;
        }
        if (month < 10) {
            month = "0" + month;
        }
        var date = year + "-" + month + "-" + day;
        return date;
    };

    $(function () {
        $("#filtro-fecha").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2',
            onSelect: function () {
                var fechaseleccionada = escape($(this).datepicker().val());
                var fechaconvertida = $.customDate(fechaseleccionada);
                var url = "/Admin/GridResumenPagosFecha?fecha=" + fechaconvertida;

                $("#grid_pagos").html(
                    '<div class="resumen-fecha-placeholder">' +
                    '<div class="modern-loading-spinner" role="status" aria-label="Cargando"></div>' +
                    '<p>Cargando pagos...</p></div>'
                );
                $("#grid_pagos").load(url);
            }
        });
    });

    function reloadPagosPorFecha() {
        var fecha = $("#filtro-fecha").val();
        if (!fecha) return;
        var url = "/Admin/GridResumenPagosFecha?fecha=" + $.customDate(escape(fecha));
        $("#grid_pagos").html(
            '<div class="resumen-fecha-placeholder">' +
            '<div class="modern-loading-spinner" role="status" aria-label="Cargando"></div>' +
            '<p>Cargando pagos...</p></div>'
        );
        $("#grid_pagos").load(url);
    }

    function cancelarPago(pagoId) {
        var doCancel = function () {
            $.ajax({
                url: "/PersonaCliente/CancelarPago",
                data: { PagoID: pagoId },
                dataType: "json",
                success: function (response) {
                    if (response && response[0] === "Done.") {
                        if (window.MatAdmin && window.MatAdmin.toast) {
                            window.MatAdmin.toast("Pago cancelado correctamente.", "success");
                        }
                        reloadPagosPorFecha();
                    } else {
                        var msg = (response && response[1]) ? response[1] : "No se pudo cancelar el pago.";
                        if (window.MatAdmin && window.MatAdmin.toast) {
                            window.MatAdmin.toast(msg, "danger");
                        } else {
                            (window.alertInfo || window.alert)(msg, "Error");
                        }
                    }
                },
                error: function () {
                    if (window.MatAdmin && window.MatAdmin.toast) {
                        window.MatAdmin.toast("Error al cancelar el pago.", "danger");
                    } else {
                        (window.alertInfo || window.alert)("Error al cancelar el pago.", "Error");
                    }
                }
            });
        };

        if (window.MatAdmin && window.MatAdmin.confirm) {
            window.MatAdmin.confirm({
                title: "Cancelar pago",
                message: "¿Está seguro de cancelar este pago?",
                confirmLabel: "Cancelar pago",
                confirmClass: "btn-danger"
            }).then(function (accepted) {
                if (accepted) doCancel();
            });
            return;
        }

        if (window.confirm("¿Está seguro de cancelar este pago?")) {
            doCancel();
        }
    }
</script>
