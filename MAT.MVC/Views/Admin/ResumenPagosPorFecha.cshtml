
@{
    ViewBag.Title = "ResumenPagosPorFecha";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<h2 class="title">Resumen de Pagos por Fecha</h2>

<div class="form">
    <div class="form-label">Fecha</div>
    <div class="form-field">
        <input id="filtro-fecha" class="datetime" type="datetime" />
        @*<input id="btn-filtrar-pagos-fecha" type="button" class="btn btn-inverse btn-small" />*@
    </div>
</div>

<div id="grid_pagos">

</div>

<script type="text/javascript">
    $.customDate = function (dateObject) {
        var arraydate = dateObject.split('/');
        var day = parseInt(arraydate[0]);
        var month = parseInt(arraydate[1]);
        var year = parseInt(arraydate[2]);
        if (day < 10) {
            day = "0" + day;
        }
        if (month < 10) {
            month = "0" + month;
        }
        var date = year + "-" + month + "-" + day;
        return date;
    }
    $(function () {
        $("input[type='datetime']").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2',
            onSelect: function () {
                var fechaseleccionada = escape($(this).datepicker().val());
                var fechaconvertida = $.customDate(fechaseleccionada);
                console.log(fechaconvertida);
                var url = "/Admin/GridResumenPagosFecha?fecha=" + fechaconvertida;;
                console.log(url);
                $("#grid_pagos").load("<div class='iconLoading'></div>");
                $("#grid_pagos").load(url);
            }
        });
    });
    $(document).on("click", "#btn-filtrar-pagos-fecha", function () {
        var fecha = $("#filtro-fecha").val();
        var url = "/Admin/GridResumenPagosFecha?fecha=" + fecha;;
        console.log(url);
        $("#grid_pagos").load(url);
    });
</script>
