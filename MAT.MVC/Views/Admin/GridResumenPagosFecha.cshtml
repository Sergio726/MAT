@model List<MAT.MVC.Models.PagoModel>

@if (ViewBag.Error != null)
{
    <div class="admin-inline-error">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@ViewBag.Error</span>
    </div>
    return;
}

@{int iCount = 0;
  decimal dSum = 0;}

<div class="grid-pagos-fecha-container">
    <div class="table-container">
        <table id="tblPagos" class="modern-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Fecha</th>
                    <th>Cliente</th>
                    <th>Nro de Recibo</th>
                    <th>Transacción</th>
                    <th>Medio de Pago</th>
                    <th>Vendedor</th>
                    <th>Monto</th>
                    <th class="admin-col-actions"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (MAT.MVC.Models.PagoModel item in Model)
                {
                    iCount += 1;
                    dSum += item.Monto;
                    <tr>
                        <td>@iCount</td>
                        <td>@item.FechaPago.ToShortDateString() @item.FechaPago.ToShortTimeString()</td>
                        <td>@item.Cliente</td>
                        <td>@item.NroRecibo</td>
                        <td>@item.TransaccionID</td>
                        <td>@item.TipoPagoDescripcion</td>
                        <td>@item.Vendedor</td>
                        <td class="monto-cell">@String.Format("{0:C}", item.Monto)</td>
                        <td>
                            <button type="button" class="btn-cancel-pago" onclick="cancelarPago('@item.PagoID');" title="Cancelar Pago">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th>Total</th>
                    <th colspan="6"></th>
                    <th colspan="2" class="total-value">@String.Format("{0:C}", dSum)</th>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
