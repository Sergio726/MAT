@using MAT.Utilities
@{
    ViewBag.Title = "Resumen de Pagos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@* Alertas globales: se muestran en _Alerts.cshtml (LayoutAdmin). *@

<link href="~/Content/magicsearch/jquery.magicsearch.css" rel="stylesheet" />
<link href="~/Content/magicsearch/normalize.css" rel="stylesheet" />
<script src="~/Scripts/jquery.magicsearch.js"></script>

<style>
    .resumen-pagos-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 0.25rem 1.5rem;
    }

    .resumen-pagos-hero {
        margin-bottom: 1.35rem;
    }

    .resumen-pagos-hero h1 {
        font-size: 1.625rem;
        font-weight: 700;
        color: #0f172a;
        letter-spacing: -0.025em;
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin: 0 0 0.35rem;
        font-family: system-ui, "Segoe UI", Roboto, sans-serif;
    }

    .resumen-pagos-hero h1 i {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 12px;
        background: linear-gradient(135deg, rgba(var(--admin-accent-rgb), 0.12) 0%, rgba(var(--admin-accent-rgb), 0.18) 100%);
        color: var(--admin-accent);
        font-size: 1.25rem;
    }

    .resumen-pagos-lead {
        margin: 0;
        font-size: 0.9375rem;
        color: #64748b;
        line-height: 1.5;
        max-width: 42rem;
    }

    /* Sin overflow:hidden: MagicSearch posiciona el dropdown dentro del panel y quedaría recortado. */
    .resumen-pagos-panel {
        background: #fff;
        border-radius: 16px;
        border: 1px solid rgba(15, 23, 42, 0.07);
        box-shadow:
            0 1px 2px rgba(15, 23, 42, 0.05),
            0 12px 32px rgba(var(--admin-accent-rgb), 0.06);
        overflow: visible;
    }

    .resumen-pagos-panel__search {
        padding: 1.35rem 1.5rem 1.25rem;
        background: linear-gradient(180deg, #fafbfd 0%, #fff 100%);
        border-bottom: 1px solid #e8edf3;
        border-radius: 16px 16px 0 0;
        position: relative;
        z-index: 2;
    }

    .resumen-pagos-panel__label {
        display: flex;
        align-items: flex-start;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }

    .resumen-pagos-panel__label-icon {
        flex-shrink: 0;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: rgba(var(--admin-accent-rgb), 0.08);
        color: var(--admin-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
    }

    .resumen-pagos-panel__title {
        margin: 0;
        font-size: 1rem;
        font-weight: 700;
        color: #0f172a;
    }

    .resumen-pagos-panel__hint {
        margin: 0.2rem 0 0;
        font-size: 0.8125rem;
        color: #64748b;
        line-height: 1.4;
    }

    .resumen-pagos-field {
        display: flex;
        align-items: stretch;
        gap: 0;
        border-radius: 12px;
        border: 1px solid #cbd5e1;
        background: #fff;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        overflow: visible;
    }

    .resumen-pagos-field:focus-within {
        border-color: var(--admin-accent);
        box-shadow: 0 0 0 3px rgba(var(--admin-accent-rgb), 0.15);
    }

    .resumen-pagos-field__accent {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        background: #f1f5f9;
        color: #64748b;
        border-right: 1px solid #e2e8f0;
    }

    .resumen-pagos-field__control {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        position: relative;
        z-index: 3;
    }

    /* MagicSearch asigna ancho en px al init; forzamos 100% del área de texto. */
    .resumen-pagos-field__control .magicsearch-wrapper {
        width: 100% !important;
        max-width: none !important;
        border: none !important;
        position: relative;
        box-sizing: border-box;
    }

    .resumen-pagos-field__control .magicsearch-wrapper input,
    .resumen-pagos-field__control .magicsearch-wrapper input.dropdown {
        width: 100% !important;
        max-width: none !important;
        border: none !important;
        border-radius: 0 !important;
        padding: 0.85rem 0.9rem !important;
        padding-right: 36px !important;
        font-size: 0.9375rem !important;
        color: #0f172a !important;
        background: transparent !important;
        font-family: system-ui, "Segoe UI", Roboto, sans-serif !important;
        box-shadow: none !important;
    }

    .resumen-pagos-field__control .magicsearch-wrapper input:focus {
        outline: none !important;
    }

    .resumen-pagos-field__control .magicsearch-arrow {
        right: 6px !important;
        width: 36px !important;
        height: 100% !important;
        border-radius: 0 10px 10px 0;
        color: var(--admin-accent);
    }

    .resumen-pagos-field__control .magicsearch-arrow:hover {
        background: rgba(var(--admin-accent-rgb), 0.06);
    }

    /* Lista tan ancha como toda la barra (icono búsqueda + input), no solo el input. */
    .resumen-pagos-field__control .magicsearch-box {
        z-index: 200 !important;
        left: -48px !important;
        width: calc(100% + 48px) !important;
        min-width: calc(100% + 48px) !important;
        box-sizing: border-box !important;
        border: 1px solid #e2e8f0 !important;
        border-radius: 10px !important;
        box-shadow: 0 10px 40px rgba(15, 23, 42, 0.12) !important;
        margin-top: 6px !important;
        font-family: system-ui, "Segoe UI", Roboto, sans-serif !important;
    }

    .resumen-pagos-field__control .magicsearch-box li.ishover {
        background: var(--admin-accent) !important;
        color: #fff !important;
    }

    .resumen-pagos-field__control .magicsearch-box li.selected {
        background: #e0e7f0 !important;
        color: #0f172a !important;
    }

    .resumen-pagos-divider {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        padding: 0 1.5rem;
        margin: -0.5rem 0 0;
        position: relative;
        z-index: 1;
    }

    .resumen-pagos-divider::before,
    .resumen-pagos-divider::after {
        content: "";
        flex: 1;
        height: 1px;
        background: linear-gradient(90deg, transparent, #e2e8f0 15%, #e2e8f0 85%, transparent);
    }

    .resumen-pagos-divider span {
        font-size: 0.6875rem;
        font-weight: 700;
        letter-spacing: 0.11em;
        text-transform: uppercase;
        color: #94a3b8;
        white-space: nowrap;
    }

    .resumen-pagos-results {
        padding: 1.5rem 1.5rem 1.75rem;
        min-height: 320px;
        border-radius: 0 0 16px 16px;
        background: #fff;
    }

    .resumen-pagos-empty {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        min-height: 280px;
        padding: 2rem 1.5rem;
        border-radius: 14px;
        background: linear-gradient(165deg, #f8fafc 0%, #f1f5f9 50%, #eef2f7 100%);
        border: 1px dashed #cbd5e1;
    }

    .resumen-pagos-empty__figure {
        width: 88px;
        height: 88px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1.25rem;
        background: #fff;
        box-shadow:
            0 2px 8px rgba(11, 42, 74, 0.06),
            inset 0 1px 0 rgba(255, 255, 255, 0.9);
        border: 1px solid rgba(15, 23, 42, 0.06);
    }

    .resumen-pagos-empty__figure i {
        font-size: 2.35rem;
        color: var(--admin-accent);
        opacity: 0.85;
    }

    .resumen-pagos-empty h2 {
        margin: 0 0 0.35rem;
        font-size: 1.0625rem;
        font-weight: 700;
        color: #334155;
    }

    .resumen-pagos-empty p {
        margin: 0;
        font-size: 0.875rem;
        color: #64748b;
        max-width: 22rem;
        line-height: 1.55;
    }

    .resumen-pagos-loading {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 280px;
        color: #64748b;
    }

    .resumen-pagos-loading .modern-loading-spinner {
        margin-bottom: 1rem;
    }

    .alert-error {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 0.5rem;
        padding: 1rem;
        margin-bottom: 1rem;
        color: #dc2626;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
</style>

<div class="resumen-pagos-page">
    <header class="resumen-pagos-hero">
        <h1>
            <i class="bi bi-cash-stack" aria-hidden="true"></i>
            Resumen de Pagos por Viaje
        </h1>
        <p class="resumen-pagos-lead">
            Elija un viaje para listar los pagos registrados, montos y totales. Puede buscar escribiendo parte del paquete o la fecha.
        </p>
    </header>

    <section class="resumen-pagos-panel" aria-labelledby="resumen-pagos-buscar">
        <div class="resumen-pagos-panel__search">
            <div class="resumen-pagos-panel__label">
                <span class="resumen-pagos-panel__label-icon" aria-hidden="true"><i class="bi bi-bus-front"></i></span>
                <div>
                    <h2 class="resumen-pagos-panel__title" id="resumen-pagos-buscar">Seleccionar viaje</h2>
                    <p class="resumen-pagos-panel__hint">Escriba para filtrar o use la flecha para desplegar la lista completa.</p>
                </div>
            </div>
            <div class="resumen-pagos-field">
                <span class="resumen-pagos-field__accent" aria-hidden="true"><i class="bi bi-search"></i></span>
                <div class="resumen-pagos-field__control">
                    <input type="text" placeholder="Buscar por viaje, paquete o fecha…" id="DDViaje" title="Escriba para buscar un viaje" autocomplete="off" />
                </div>
            </div>
        </div>

        <div class="resumen-pagos-divider"><span>Resultados</span></div>

        <div id="grid_pagos" class="resumen-pagos-results" role="region" aria-live="polite" aria-label="Resumen de pagos del viaje">
            <div class="resumen-pagos-empty">
                <div class="resumen-pagos-empty__figure">
                    <i class="bi bi-receipt-cutoff" aria-hidden="true"></i>
                </div>
                <h2>Sin viaje seleccionado</h2>
                <p>Seleccione un viaje arriba para ver el resumen de pagos y el total consolidado.</p>
            </div>
        </div>
    </section>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var dataSource = @Html.Raw(ViewBag.jDDViaje ?? "[]");
        $('#DDViaje').magicsearch({
            dataSource: dataSource,
            fields: ['Descripcion'],
            id: 'ViajeID',
            format: '%Descripcion%',
            dropdownBtn: true,
            success: function(i, data) {
                var ViajeID = data.ViajeID;
                loagGridPagos(ViajeID);
            }
        });
    });

    function loagGridPagos(ViajeID) {
        $("#grid_pagos").html(
            '<div class="resumen-pagos-loading">' +
            '<div class="modern-loading-spinner" role="status" aria-label="Cargando"></div>' +
            '<p class="modern-loading-text">Cargando pagos…</p>' +
            '</div>'
        );

        $.ajax({
            url: "/Admin/GridResumenPagos",
            data: { ViajeID: ViajeID },
            dataType: "html",
            success: function (data) {
                $("#grid_pagos").html(data);
            },
            error: function() {
                $("#grid_pagos").html(
                    '<div class="resumen-pagos-empty">' +
                    '<div class="resumen-pagos-empty__figure"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i></div>' +
                    '<h2>No se pudieron cargar los datos</h2>' +
                    '<p>Intente de nuevo. Si el problema continúa, revise la consola o los registros del servidor.</p>' +
                    '</div>'
                );
            }
        });
    }
</script>
