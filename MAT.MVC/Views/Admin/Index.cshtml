@{
    ViewBag.Title = "Panel de Administración";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="admin-hub admin-container">
    <div class="admin-header" id="admin-tour-header">
        <h1 class="admin-title">
            <i class="bi bi-shield-lock"></i>
            Panel de Administración
        </h1>
        <p class="admin-subtitle">Sección exclusiva para administradores del sistema</p>
    </div>

    <div class="admin-section" id="admin-tour-section-reportes">
        <h2 class="admin-section-title">
            <i class="bi bi-bar-chart-line"></i>
            Reportes y Consultas
        </h2>
        <div class="admin-cards-grid">
            <a href="/Admin/ResumenPagos" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-warning">
                    <i class="bi bi-bus-front"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Pagos por Viaje</h3>
                    <p class="admin-card-description">Consultar resumen de pagos agrupados por viaje</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>

            <a href="/Admin/ResumenPagosPorFecha" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-primary">
                    <i class="bi bi-calendar-week"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Pagos por Fecha</h3>
                    <p class="admin-card-description">Consultar pagos filtrados por rango de fechas</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>

            <a href="/Admin/AuditoriaFacturas" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-info">
                    <i class="bi bi-clipboard-check"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Auditoría de facturas</h3>
                    <p class="admin-card-description">Revisar historial y auditoría de facturas</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>

            <a href="@Url.Action("Index", "Reportes")" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-success">
                    <i class="bi bi-graph-up-arrow"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Reportes operativos</h3>
                    <p class="admin-card-description">Ventas, pagos y ranking de vendedores</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>
        </div>
    </div>

    <div class="admin-section" id="admin-tour-section-usuarios">
        <h2 class="admin-section-title">
            <i class="bi bi-people"></i>
            Usuarios
        </h2>
        <div class="admin-cards-grid">
            <a href="/Admin/Usuarios" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-primary">
                    <i class="bi bi-people"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Listado de usuarios</h3>
                    <p class="admin-card-description">Ver cuentas registradas y roles asignados</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>

            <a href="/Admin/RegistrarVendedor" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-success">
                    <i class="bi bi-person-plus"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Registrar vendedor</h3>
                    <p class="admin-card-description">Alta de cuenta y datos de vendedor (mismo flujo que registro público, sin cerrar sesión)</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>

            <a href="/Admin/MiCuenta" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-warning">
                    <i class="bi bi-key"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Mi cuenta</h3>
                    <p class="admin-card-description">Cambiar la contraseña del usuario con el que inició sesión</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>
        </div>
    </div>

    <div class="admin-section" id="admin-tour-section-sistema">
        <h2 class="admin-section-title">
            <i class="bi bi-activity"></i>
            Sistema y diagnóstico
        </h2>
        <div class="admin-cards-grid">
            <a href="/Admin/ErrorLog" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-info">
                    <i class="bi bi-bug"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Error Log</h3>
                    <p class="admin-card-description">Errores en base y correlation ID</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>
            <a href="/Admin/Logs" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-warning">
                    <i class="bi bi-terminal"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Log en memoria</h3>
                    <p class="admin-card-description">Traza del proceso en memoria</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>
            <a href="/Admin/SistemaParametros" class="admin-card admin-card-link">
                <div class="admin-card-icon icon-primary">
                    <i class="bi bi-shield-lock"></i>
                </div>
                <div class="admin-card-content">
                    <h3 class="admin-card-title">Códigos de confirmación</h3>
                    <p class="admin-card-description">Gestionar códigos para eliminar ventas/pasajeros</p>
                </div>
                <i class="bi bi-chevron-right admin-card-arrow"></i>
            </a>
        </div>
    </div>

    <section class="admin-help-search-section" id="admin-tour-search" aria-labelledby="adminHelpHubSearchTitle">
        <h2 class="admin-help-search-section-title" id="adminHelpHubSearchTitle">
            <i class="bi bi-search"></i>
            Buscar funciones
        </h2>
        <p class="admin-help-search-compact-hint text-secondary small mb-0">
            <i class="bi bi-keyboard me-1"></i>
            Buscar herramientas: use el botón <strong>Buscar</strong> en la barra superior, el menú de usuario o el atajo <kbd class="admin-help-kbd-inline">Ctrl+K</kbd>.
        </p>
        <div class="admin-help-search-expanded">
            <div class="admin-help-search-input-wrap">
                <i class="bi bi-search admin-help-search-icon" aria-hidden="true"></i>
                <input type="search" class="form-control form-control-lg admin-help-search-input" id="adminHelpHubSearchInput"
                       placeholder="Buscar reportes, usuarios, logs, códigos…" autocomplete="off" aria-label="Buscar herramientas del panel admin" />
                <kbd class="admin-help-kbd-hint d-none d-md-inline">Ctrl+K</kbd>
            </div>
            <div id="adminHelpHubSearchResults" class="admin-help-search-results" role="listbox" aria-label="Resultados de búsqueda en el panel"></div>
        </div>
    </section>

    @{
        var adminUserName = (User != null && User.Identity != null) ? (User.Identity.Name ?? "") : "";
    }
    @if (!string.IsNullOrWhiteSpace(adminUserName) && adminUserName.ToUpper().Equals("ADMINDEV"))
    {
        <div class="admin-section admin-dev-section">
            <h2 class="admin-section-title">
                <i class="bi bi-code-slash"></i>
                Herramientas de Desarrollo
                <span class="admin-dev-badge">
                    <i class="bi bi-lock"></i>
                    Solo ADMINDEV
                </span>
            </h2>
            <div class="admin-cards-grid">
                <a href="/Home/HistorialPagos" class="admin-card admin-card-link">
                    <div class="admin-card-icon icon-success">
                        <i class="bi bi-clock-history"></i>
                    </div>
                    <div class="admin-card-content">
                        <h3 class="admin-card-title">Historial</h3>
                        <p class="admin-card-description">Acceder al historial completo de pagos del sistema</p>
                    </div>
                    <i class="bi bi-chevron-right admin-card-arrow"></i>
                </a>
            </div>
        </div>
    }
</div>
