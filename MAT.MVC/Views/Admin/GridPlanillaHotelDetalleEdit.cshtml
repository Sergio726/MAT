@model List<List<MAT.MVC.Models.PlanillaHotelPrintModel>>
@using MAT.Utilities

@foreach (var item in Model)
{
    double _totalhotel = 0;
<h3>@item.FirstOrDefault().Hotel</h3>
<table class="mat-customtable planilla-habitaciones">
    <thead>
        <tr>
            <th class="oculto item-id">Id</th>
            <th class="oculto">Precio</th>
            <th class="oculto">Precio Menor</th>
            <th>Tipo Habitacion</th>
            <th>Cantidad de Personas</th>
            <th>Menores</th>
            <th>Dias</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var linea in item)
        {
            <tr>
                <td class="oculto item-id">@linea.HabitacionItem.PlanillaHabitacionItemId</td>
                <td class="oculto precio">@linea.PrecioHabitacion.Precio</td>
                <td class="oculto preciomenor">@linea.PrecioMenor</td>
                <td>@linea.TipoHabitacion</td>
                <td class="cantidad_pasajeros">@linea.Pasajeros.Count</td>
                <td class="cantidad_menores">@linea.Menores</td>
                <td class="dias"><input type="text" class="txt-dias" value="@linea.Dias" /></td>
                <td class="alignright subtotal" data-tipo="@linea.Habitacion.Tipo.Value">@String.Format("{0:C}",linea.Subtotal)</td>
            </tr>
            _totalhotel += linea.Subtotal;
        }
    </tbody>
</table>
    <div class="form">
        <div class="form-label">
            TOTAL HOTEL
        </div>
        <div class="form-field">
            <input type="text" class="text-total-hotel subtotales" value="@_totalhotel" />
        </div>
    </div>
}