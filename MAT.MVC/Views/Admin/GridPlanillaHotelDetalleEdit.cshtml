@model List<List<MAT.MVC.Models.PlanillaHotelPrintModel>>
@using MAT.Utilities

@foreach (var item in Model)
{
    double _totalhotel = 0;
    <h3 class="h5 fw-semibold mb-2 mt-3 border-bottom pb-1">@item.FirstOrDefault().Hotel</h3>
    <table class="mat-customtable planilla-habitaciones table table-sm table-bordered align-middle">
        <thead class="table-light">
            <tr>
                <th class="oculto item-id">Id</th>
                <th class="oculto">Precio</th>
                <th class="oculto">Precio Menor</th>
                <th>Tipo habitación</th>
                <th>Cantidad de personas</th>
                <th>Menores</th>
                <th>Días</th>
                <th class="text-end">Subtotal</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var linea in item)
            {
                <tr>
                    <td class="oculto item-id">@linea.HabitacionItem.PlanillaHabitacionItemId</td>
                    <td class="oculto precio">@linea.PrecioHabitacion.Precio</td>
                    <td class="oculto preciomenor">@linea.PrecioMenor</td>
                    <td>@linea.TipoHabitacion</td>
                    <td class="cantidad_pasajeros">@linea.Pasajeros.Count</td>
                    <td class="cantidad_menores">@linea.Menores</td>
                    <td class="dias"><input type="text" class="txt-dias form-control form-control-sm" style="max-width:5rem" value="@linea.Dias" /></td>
                    <td class="alignright subtotal text-end" data-tipo="@linea.Habitacion.Tipo.Value">@String.Format("{0:C}", linea.Subtotal)</td>
                </tr>
                _totalhotel += linea.Subtotal;
            }
        </tbody>
    </table>
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <span class="fw-semibold text-secondary small text-uppercase">Total hotel</span>
        <input type="text" class="text-total-hotel subtotales form-control form-control-sm" style="max-width:12rem" value="@_totalhotel" />
    </div>
}
