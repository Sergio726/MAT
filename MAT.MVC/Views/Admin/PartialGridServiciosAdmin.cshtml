@model IEnumerable<MAT.Entities.Servicio>
@using MAT.Enums

<style>
    .servicios-admin-table-container {
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .servicios-admin-table {
        width: 100%;
        border-collapse: collapse;
    }
    .servicios-admin-table thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        text-align: left;
    }
    .servicios-admin-table tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .servicios-admin-table tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .servicios-admin-table tbody tr:last-child td {
        border-bottom: none;
    }
    .btn-select {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: #dbeafe;
        color: #2563eb;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-select:hover {
        background: #2563eb;
        color: white;
    }
</style>

<div class="servicios-admin-table-container">
    <table class="servicios-admin-table">
        <thead>
            <tr>
                <th>Descripción</th>
                <th style="width: 50px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Descripcion</td>
                    <td>
                        <a href="#" id="btn-seleccionar-servicio-admin" data-id="@item.ServicioId" class="btn-select" title="Seleccionar">
                            <i class="bi bi-link-45deg"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
