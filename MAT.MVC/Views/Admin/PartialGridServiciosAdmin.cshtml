@model IEnumerable<MAT.Entities.Servicio>
@using MAT.Enums

<table class="mat-customtable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>             
                <td>
                    <a href="#" id="btn-seleccionar-servicio-admin" data-id="@item.ServicioId">
                        <img src="/Images/link.png" width="32" height="32" title="Seleccionar" /></a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");
    });
</script>