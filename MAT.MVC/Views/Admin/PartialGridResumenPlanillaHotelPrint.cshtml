@model IEnumerable<MAT.MVC.Models.ResumenPlanillaPrintModel>

<h3 class="h5 fw-semibold mb-2 mt-2">@ViewData["Hotel"].ToString().ToUpper()</h3>
<table class="mat-customtable resumen-planilla table table-sm">
    <thead>
        <tr>
            <th>Tipo habitación</th>
            <th>Cantidad de personas</th>
            <th>Menores</th>
            <th class="text-end">Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.TipoHabitacion</td>
                <td>@item.CantidadPersonas</td>
                <td>@item.CantidadMenores</td>
                <td class="alignright subtotal text-end" data-tipo="@item.IntTipoHabitacion">@String.Format("{0:C}", item.Subtotal)</td>
            </tr>
        }
    </tbody>
</table>
<p class="fw-semibold mb-3">Total hotel: @String.Format("{0:C}", ViewData["TotalHotel"])</p>
