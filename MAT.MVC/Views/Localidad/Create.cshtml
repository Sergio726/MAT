@using MAT.Enums
@using MAT.Utilities

@{
    Layout = null;
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-geo-alt"></i>
            <span>Nueva Localidad</span>
        </h2>
    </div>

    <div class="modern-form-container">
        <div class="modern-form-grid">
            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-map"></i>
                    <span>Provincia</span>
                </label>
                <select id="ddProvincia" class="modern-form-select" onchange="fn_Unsubscribe();">
                    <option value="0">SELECCIONE UNA PROVINCIA</option>
                    @foreach (var item in Helper.ToSelectEntitiesLocalidades("Provincia", null))
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-building"></i>
                    <span>Departamento</span>
                </label>
                <select id="popin_ddDepartamento" class="modern-form-select">
                    <option value="0">SELECCIONE UN DEPARTAMENTO</option>
                </select>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-geo-alt"></i>
                    <span>Localidad</span>
                </label>
                <input id="txtLocalidad" type="text" class="modern-form-input" placeholder="INGRESE UNA NUEVA LOCALIDAD" />
            </div>

            <div class="modern-form-group" style="grid-column: 1 / -1;">
                <button type="button" class="btn-modern btn-modern-primary" onclick="AddLocalidad();" title="Agregar una nueva localidad.">
                    <i class="bi bi-plus-circle"></i>
                    <span>Agregar Localidad</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function fn_Unsubscribe() {
        var idProvincia = $("#ddProvincia").val();
        if (!(parseInt(idProvincia, 10) > 0)) {
            return;
        }

        if (window.matGeo && typeof window.matGeo.loadDepartamentos === 'function') {
            window.matGeo.loadDepartamentos(idProvincia, {
                departamentoSelect: '#popin_ddDepartamento',
                context: 'Departamentos (alta localidad)'
            });
            return;
        }

        $.ajax({
            type: 'POST',
            url: '/Localidad/GetDepartamento',
            data: { sIdProvincia: idProvincia },
            dataType: 'json',
            success: function (response) {
                if (response.Result === 'Done.') {
                    var list;
                    try {
                        list = JSON.parse(response.LDepartamento);
                    } catch (e) {
                        list = [];
                    }
                    $('#popin_ddDepartamento').empty().append(
                        $('<option>', { value: '0', text: 'SELECCIONE UN DEPARTAMENTO' })
                    );
                    for (var i = 0; i < list.length; i++) {
                        $('#popin_ddDepartamento').append(
                            $('<option>', { value: list[i].IdDepartamento, text: list[i].Nombre })
                        );
                    }
                } else if (window.matGeo) {
                    window.matGeo.handleJsonError(response, 'Departamentos (alta localidad)');
                } else {
                    (window.alertError || window.alert)(response.Result, 'Error');
                }
            },
            error: function (xhr) {
                if (window.matGeo) {
                    window.matGeo.handleAjaxError(xhr, 'Departamentos (alta localidad)');
                } else {
                    (window.alertError || window.alert)('Error de comunicación con el servidor.', 'Error');
                }
            }
        });
    }

    function AddLocalidad() {
        if ($('#ddProvincia').val() === '0') {
            return (window.alertInfo || window.alert)('Por favor seleccione una provincia.', 'Validación');
        }
        if ($('#popin_ddDepartamento').val() === '0') {
            return (window.alertInfo || window.alert)('Por favor seleccione un Departamento.', 'Validación');
        }

        var nombreLocalidad = $('#txtLocalidad').val().trim();
        if (nombreLocalidad === '') {
            return (window.alertInfo || window.alert)('Por favor ingrese una localidad.', 'Validación');
        }

        var idDepartamento = $('#popin_ddDepartamento').val();

        $.ajax({
            type: 'POST',
            url: '/Localidad/AddLocalidad',
            data: {
                sIdDepartamento: idDepartamento,
                sLocalidad: nombreLocalidad
            },
            dataType: 'json',
            success: function (response) {
                if (response.Result === 'Done.') {
                    var localidadId = parseInt(response.Id, 10);
                    if (localidadId > 0 && window.matGeo && typeof window.matGeo.triggerLocalidadCreated === 'function') {
                        window.matGeo.triggerLocalidadCreated({
                            localidadId: localidadId,
                            nombre: nombreLocalidad.toUpperCase(),
                            idDepartamento: parseInt(idDepartamento, 10)
                        });
                    }
                    (window.alertSuccess || window.alert)('Se agregó una localidad.', 'Operación Exitosa');
                    $('#AgregarLocalidad').dialog('close');
                } else if (window.matGeo) {
                    window.matGeo.handleJsonError(response, 'Alta de localidad');
                } else {
                    (window.alertError || window.alert)(response.Result, 'Error');
                }
            },
            error: function (xhr) {
                if (window.matGeo) {
                    window.matGeo.handleAjaxError(xhr, 'Alta de localidad');
                } else {
                    (window.alertError || window.alert)('Error de comunicación con el servidor.', 'Error');
                }
            }
        });
    }
</script>
