@using MAT.Enums
@using MAT.Utilities

@{
    Layout = null;
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-geo-alt"></i>
            <span>Nueva Localidad</span>
        </h2>
    </div>

    <div class="modern-form-container">
        <div class="modern-form-grid">
            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-map"></i>
                    <span>Provincia</span>
                </label>
                <select id="ddProvincia" class="modern-form-select" onchange="fn_Unsubscribe();">
                    <option value="0">SELECCIONE UNA PROVINCIA</option>
                    @foreach (var item in Helper.ToSelectEntitiesLocalidades("Provincia", null))
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-building"></i>
                    <span>Departamento</span>
                </label>
                <select id="popin_ddDepartamento" class="modern-form-select">
                    <option value="0">SELECCIONE UN DEPARTAMENTO</option>
                </select>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-geo-alt"></i>
                    <span>Localidad</span>
                </label>
                <input id="txtLocalidad" type="text" class="modern-form-input" placeholder="INGRESE UNA NUEVA LOCALIDAD" />
            </div>

            <div class="modern-form-group" style="grid-column: 1 / -1;">
                <button type="button" class="btn-modern btn-modern-primary" onclick="AddLocalidad();" title="Agregar una nueva localidad.">
                    <i class="bi bi-plus-circle"></i>
                    <span>Agregar Localidad</span>
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    function fn_Unsubscribe() {
        if (parseInt($("#ddProvincia").val()) > 0) {
            var IdProvincia = $("#ddProvincia").val();

            $.ajax({
                type: "POST",
                url: "/Localidad/GetDepartamento",
                data: { "sIdProvincia": IdProvincia },
                dataType: "json",
                success: function (response) {
                    if (response.Result == "Done.") {
                        var list = eval(response.LDepartamento);
                        $('#popin_ddDepartamento option').remove();
                        document.getElementById("popin_ddDepartamento").options[0] = new Option("SELECCIONE UN DEPARTAMENTO", "0");
                        for (var i = 0; i < list.length; i++) {
                            var sValue = list[i].IdDepartamento;
                            var sName = list[i].Nombre;
                            document.getElementById("popin_ddDepartamento").options[document.getElementById("popin_ddDepartamento").options.length] = new Option(sName, sValue);
                        }
                    }
                    else {
                        (window.alertError || window.alert)(response.Result, "Error");
                    }
                }
            });
        }
    }

    function AddLocalidad() {
        if ($("#ddProvincia").val() == "0") {
            return (window.alertInfo || window.alert)("Por favor seleccione una provincia.", "Validación");
        }
        if ($("#popin_ddDepartamento").val() == "0") {
            return (window.alertInfo || window.alert)("Por favor seleccione un Departamento.", "Validación");
        }
        if ($("#txtLocalidad").val().trim() == "") {
            return (window.alertInfo || window.alert)("Por favor ingrese una localidad.", "Validación");
        }

        var IdDepartamento = $("#popin_ddDepartamento").val();
        var Localidad = $("#txtLocalidad").val().trim();

        $.ajax({
            type: "POST",
            url: "/Localidad/AddLocalidad",
            data: {
                "sIdDepartamento": IdDepartamento,
                "sLocalidad": Localidad
            },
            dataType: "json",
            success: function (response) {
                if (response.Result == "Done.") {
                    (window.alertSuccess || window.alert)("Se agregó una localidad.", "Operación Exitosa");
                    $("#AgregarLocalidad").dialog("close");
                }
                else {
                    (window.alertError || window.alert)(response.Result, "Error");
                }
            }
        });
    }
</script>
