@model IEnumerable<MAT.Entities.Precio>

@{
    ViewBag.Title = "Precios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-tag"></i>
            <span>Precios de Butacas</span>
        </h2>
        <div class="modern-page-actions">
            <button type="button" class="btn-modern btn-modern-primary" onclick="javascript: editPrecio('0');">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Precio</span>
            </button>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="modern-alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table" id="tblPrecios">
            <thead>
                <tr>
                    <th>Monto</th>
                    <th>Vigencia</th>
                    <th>Descripción</th>
                    <th>Descripción para Voucher</th>
                    <th>Mes</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>

        <div id="divTools" style="display:none;">
            <div class="modern-table-actions">
                <a href="javascript: editPrecio('{{PrecioID}}');" class="modern-btn-icon modern-btn-icon-edit" title="Editar">
                    <i class="bi bi-pencil"></i>
                </a>
                <a href="javascript: deletePrecio('{{PrecioID}}');" class="modern-btn-icon btn-danger-icon deleteRow" title="Eliminar">
                    <i class="bi bi-trash"></i>
                </a>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">

    $(document).ready(function () {
        var jResult = @Html.Raw(ViewBag.jResult);
            var jTables = eval(jResult);
            var jt = jTables["Table"];
        
            var table = $("#tblPrecios").DataTable({
                aaData: jt,
                columns: [
                    { 
                        data: "Monto",
                        render: function(data, type, row) {
                            return '<span class="badge badge-pesos">$' + parseFloat(data).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + '</span>';
                        }
                    },
                    { data: "Vigencia" },
                    { data: "Descripcion" },
                    { data: "DescripcionVoucher" },
                    { data: "Mes" },
                    { 
                        data: "PrecioID",
                        orderable: false,
                        render: function (data, type, row) {
                            var _data = {"PrecioID": row.PrecioID};
                            var html = $("#divTools").html().trim();
                            if (typeof html.render === 'function') {
                                return html.render(_data);
                            }
                            return html.replace(/\{\{PrecioID\}\}/g, row.PrecioID);
                        }
                    }
                ],
                pageLength: 25,
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ precios",
                    infoEmpty: "No hay precios disponibles",
                    infoFiltered: "(filtrado de _MAX_ precios totales)",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                }
            });

            $('#tblPrecios a.deleteRow').on( 'click', function () {
                $(this).parent().parent().parent('tr').addClass('removeRow');
                table.row('.removeRow').remove().draw( false );
                
            });
 
        //$('.deleteRow').parent().parent().parent('tr')
            
    });

    function editPrecio(PrecioID){
        var url = "/Precio/ABM?PrecioID=" + PrecioID;
        var title = "Precios"; //Titulo Modificado por petición del cliente. Detalle de Factura -> Nota de Crédito
        var id = "popupPrecios";
        
        ShowFormDialogCloseRefresh(url, id, title,"medium");
    }

    function deletePrecio(PrecioID) {
        //return;
        $.ajax({
            url: "/Precio/Delete",
            type: "POST",
            data: {PrecioID: PrecioID},
            dataType: "json",
            success: function (data) {
                if (data[0] == "Done.") {
                    console.log('succesfull');
                }
                else {
                    alert("Se produjo un error. Asegurece que el precio que quiere eliminar no este vinculado en algun Paquete.");
                    console.log(data[1]);
                }
            },
            error: function (e) {
                alert("Se produjo un error. Contactese con el administrador.");
                console.log(e);
            }
        })
    }
</script>