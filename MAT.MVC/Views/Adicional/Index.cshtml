@model IEnumerable<MAT.Entities.Adicional>

@{
    ViewBag.Title = "Adicionales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">Adicionales</h2>

<p class="botonera-form">
    <input type="button" value="+ Agregar Adicional" class="btn btn-small btn-inverse" onclick="location.href='@Url.Action("Create", "Adicional")'" />
</p>

<table class="mat-customtable">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Monto)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Descripcion)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Monto)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Descripcion)
                </td>
                <td>
                    <a href="/Adicional/Edit/@item.AdicionalId">
                        <img src="/Images/pencil.png" width="32" height="32" title="Editar" /></a>
                    @*<a href="/Adicional/Details/@item.AdicionalId">
                        <img src="/Images/notepad.png" width="32" height="32" title="Detalles" /></a>*@
                    <a href="#" id="btn-eliminar-adicional" data-id="@item.AdicionalId">
                        <img src="/Images/cross.png" width="32" height="32" title="Eliminar" /></a>
                </td>
            </tr>
        }
    </tbody>
</table>
<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");
    });
</script>