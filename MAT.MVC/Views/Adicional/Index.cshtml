@model IEnumerable<MAT.Entities.Adicional>

@{
    ViewBag.Title = "Adicionales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-plus-square"></i>
            <span>Adicionales</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/Adicional/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Adicional</span>
            </a>
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblAdicionales">
            <thead>
                <tr>
                    <th>Monto</th>
                    <th>Descripción</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            @if (item.Monto.HasValue)
                            {
                                <span class="badge badge-pesos">$@item.Monto.Value.ToString("N2")</span>
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            <strong>@item.Descripcion</strong>
                        </td>
                        <td>
                            <div class="modern-table-actions">
                                <a href="/Adicional/Edit/@item.AdicionalId" class="modern-btn-icon modern-btn-icon-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="#" class="modern-btn-icon btn-danger-icon btn-eliminar-adicional" data-id="@item.AdicionalId" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript">
        $(document).ready(function () {
            var table = $('#tblAdicionales').DataTable({
                language: {
                    search: "Buscar:",
                    lengthMenu: "Mostrar _MENU_ registros",
                    info: "Mostrando _START_ a _END_ de _TOTAL_ adicionales",
                    infoEmpty: "No hay adicionales disponibles",
                    infoFiltered: "(filtrado de _MAX_ adicionales totales)",
                    paginate: {
                        first: "Primero",
                        last: "Último",
                        next: "Siguiente",
                        previous: "Anterior"
                    }
                },
                order: [[1, "asc"]],
                pageLength: 25,
                columnDefs: [
                    { orderable: false, targets: 2 }
                ]
            });

            $('#tblAdicionales').on('click', '.btn-eliminar-adicional', function (e) {
                e.preventDefault();
                var adicionalId = $(this).data('id');
                if (confirm('¿Está seguro que desea eliminar este adicional?')) {
                    // Aquí puedes agregar la lógica para eliminar el adicional
                }
            });
        });
    </script>
}