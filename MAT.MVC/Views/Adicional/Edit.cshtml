@model MAT.Entities.Adicional

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">Editar Adicional</h2>

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="form">

       <div class="form-label">
            @Html.LabelFor(model => model.Monto)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Monto)
            @Html.ValidationMessageFor(model => model.Monto)
        </div>
        

        <div class="form-label">
            @Html.LabelFor(model => model.Descripcion)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Descripcion)
            @Html.ValidationMessageFor(model => model.Descripcion)
        </div>

        <p class="botonera-form">
            <input type="submit" value="Guardar" class="btn btn-inverse btn-small" />
            <a href="/Adicional/Index" class="btn btn-inverse btn-small">Lista de Adicionales</a>
        </p>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
