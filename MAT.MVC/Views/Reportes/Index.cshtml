@{
    ViewBag.Title = "Reportes operativos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header mb-3">
        <h1 class="modern-page-title mb-0">
            <i class="bi bi-graph-up-arrow"></i>
            <span>Reportes operativos</span>
        </h1>
        <p class="text-secondary small mt-2 mb-0">Ventas, pagos y ranking de compras. Solo administradores.</p>
    </div>

    <div class="row g-3">
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none shadow-sm border-0" href="@Url.Action("ReporteVentas", "Reportes")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-receipt-cutoff fs-5"></i></span>
                        <span class="fw-semibold text-dark">Reporte de ventas</span>
                    </div>
                    <p class="small text-secondary mb-0">Facturas, viajes, montos y saldos por rango de fechas o por viaje.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none shadow-sm border-0" href="@Url.Action("ReportePagos", "Reportes")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle bg-success bg-opacity-10 text-success p-2"><i class="bi bi-cash-coin fs-5"></i></span>
                        <span class="fw-semibold text-dark">Reporte de pagos</span>
                    </div>
                    <p class="small text-secondary mb-0">Movimientos de pago, tipo de venta y texto de viaje.</p>
                </div>
            </a>
        </div>
        <div class="col-md-4">
            <a class="card h-100 text-decoration-none shadow-sm border-0" href="@Url.Action("ReporteRanking", "Reportes")">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="rounded-circle bg-warning bg-opacity-10 text-warning p-2"><i class="bi bi-trophy fs-5"></i></span>
                        <span class="fw-semibold text-dark">Ranking de compras</span>
                    </div>
                    <p class="small text-secondary mb-0">Ranking de clientes y viajes según volumen de compras.</p>
                </div>
            </a>
        </div>
    </div>
</div>
