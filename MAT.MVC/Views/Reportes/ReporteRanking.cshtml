@{
    ViewBag.Title = "Ranking de compras";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="modern-page-title mb-0">
                <i class="bi bi-trophy"></i>
                <span>Ranking de compras</span>
            </h1>
            <p class="small text-secondary mb-0 mt-1">
                Visualizá quiénes compraron más, filtrando por <strong>rango de fechas</strong> o por <strong>viaje</strong> (no ambos a la vez).
                Una vez que se cargan los resultados podés buscar un cliente específico sin repetir la consulta.
                Usá <em>Exportar Excel</em> para descargar el listado completo.
            </p>
        </div>
        <a href="@Url.Action("Index", "Reportes")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Índice reportes</a>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="mb-3">
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoFechas" value="fechas" checked autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoFechas">Por fechas</label>
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoViaje" value="viaje" autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoViaje">Por viaje</label>
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2" id="grpFechas">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="from">Desde</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="from" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="to">Hasta</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="to" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2 d-none" id="grpViaje">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label small mb-0" for="viajeBuscar">Viaje</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="viajeBuscar" placeholder="Buscá por nombre o abrí la lista reciente…" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" id="btnViajeLista" title="Últimos 30 viajes por fecha de salida" aria-label="Abrir lista de viajes recientes"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                    </div>
                    <input type="hidden" id="viajeId" value="" />
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn btn-primary btn-sm" id="btnBuscar"><i class="bi bi-search"></i> Consultar</button>
                <button type="button" class="btn btn-outline-success btn-sm" id="btnExcel"
                        title="Descarga todos los registros de la última consulta, sin importar los filtros de vista">
                    <i class="bi bi-file-earmark-excel"></i> Exportar Excel
                </button>
            </div>
            <div class="alert alert-danger d-none mt-3 mb-0 py-2 small" id="alertErr" role="alert"></div>
        </div>
    </div>

    <div id="filtroFront" class="card shadow-sm border-0 mb-3 d-none">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="filtCliente"><i class="bi bi-person"></i> Filtrar cliente</label>
                    <input type="text" class="form-control form-control-sm" id="filtCliente" placeholder="Nombre del cliente…" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="filtViaje"><i class="bi bi-geo-alt"></i> Filtrar viaje</label>
                    <input type="text" class="form-control form-control-sm" id="filtViaje" placeholder="Nombre del viaje…" autocomplete="off" />
                </div>
                <div class="col-md-auto">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLimpiarFiltro">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="reporteRankingIndicadores" class="d-none mb-3" aria-live="polite">
        <h2 class="h6 fw-bold text-primary mb-3">Resumen de la consulta</h2>
        <p class="small text-secondary mb-3">Totales sobre el resultado del servidor (no cambian al filtrar cliente o viaje en la tabla).</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 row-cols-xxl-5 g-3">
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Registros</span>
                            <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary p-2"><i class="bi bi-list-ul"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indRankFilas">0</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Clientes distintos</span>
                            <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-people"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indRankClientes">0</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Viajes distintos</span>
                            <span class="rounded-circle bg-success bg-opacity-10 text-success p-2"><i class="bi bi-geo-alt"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indRankViajes">0</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Facturas distintas</span>
                            <span class="rounded-circle bg-warning bg-opacity-10 text-warning p-2"><i class="bi bi-receipt"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indRankFacturas">0</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Mejor rank. viajes</span>
                            <span class="rounded-circle bg-info bg-opacity-10 text-info p-2"><i class="bi bi-trophy"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indRankMejorViaje">—</p>
                        <p class="small text-secondary mb-0">Menor número = viaje más “popular” según la métrica del sistema</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="rankingLeyenda" class="d-none mb-3">
        <button class="btn btn-outline-secondary btn-sm" type="button" data-bs-toggle="collapse" data-bs-target="#rankingLeyendaBody"
                aria-expanded="false" aria-controls="rankingLeyendaBody">
            <i class="bi bi-question-circle me-1"></i> Cómo leer el ranking
        </button>
        <div class="collapse mt-2" id="rankingLeyendaBody">
            <div class="alert alert-light border small mb-0" role="note">
                <ul class="mb-0 ps-3">
                    <li><strong>Fact. viaje:</strong> cantidad de <em>filas de factura</em> del resultado asociadas a ese viaje (no es cantidad de clientes únicos).</li>
                    <li><strong>Rank. viajes:</strong> posición del viaje según ese valor (ranking denso, orden descendente): <strong>#1</strong> = viaje con el valor más alto.</li>
                    <li><strong>Rank. clientes:</strong> posición del cliente según cuántos viajes distintos compró en el conjunto filtrado (ranking denso).</li>
                </ul>
            </div>
        </div>
    </div>

    <div class="modern-table-container">
        <div class="table-responsive">
            <table class="modern-table table table-striped table-sm w-100" id="tblReporte"></table>
        </div>
    </div>
</div>

@section Scripts {
<script src="@Url.Content("~/Scripts/mat.reportes-utils.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-excel-export.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-viaje-autocomplete.js")"></script>
<script>
$(function () {
    var urlJson  = '@Url.Action("Ranking", "Reportes")';
    var urlExcel = '@Url.Action("RankingExcel", "Reportes")';
    var urlBuscarViajes = '@Url.Action("BuscarViajes", "Reportes")';
    var dt = null;

    $.datepicker.regional['es'] = {
        closeText: 'Cerrar', prevText: '‹', nextText: '›',
        currentText: 'Hoy', monthNames: ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
        monthNamesShort: ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'],
        dayNames: ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'],
        dayNamesShort: ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'], dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','Sá'],
        weekHeader: 'Sm', dateFormat: 'dd/mm/yy', firstDay: 1,
        isRTL: false, showMonthAfterYear: false, yearSuffix: ''
    };
    $(".mat-datepicker").datepicker($.extend({}, $.datepicker.regional['es'], {
        changeMonth: true, changeYear: true, yearRange: '2015:2035',
        showButtonPanel: true, showOtherMonths: true, selectOtherMonths: true,
        maxDate: '+5y'
    }));

    if (window.MatReportes && window.MatReportes.initViajeAutocomplete) {
        window.MatReportes.initViajeAutocomplete({
            urlBuscarViajes: urlBuscarViajes,
            inputSearch: "#viajeBuscar",
            inputHidden: "#viajeId",
            buttonLista: "#btnViajeLista"
        });
    }

    function normalizeDate(val) { return (val || "").trim().replace(/\//g, "-"); }
    function modo() { return $("#modoViaje").is(":checked") ? "viaje" : "fechas"; }
    function syncGrupos() {
        if (modo() === "viaje") { $("#grpFechas").addClass("d-none"); $("#grpViaje").removeClass("d-none"); }
        else {
            $("#grpFechas").removeClass("d-none"); $("#grpViaje").addClass("d-none");
            $("#viajeBuscar").val("").removeData("matViajeLabel");
            $("#viajeId").val("");
        }
    }
    function queryParams() {
        var p = {};
        if (modo() === "viaje") p.viajeId = $("#viajeId").val().trim();
        else { p.from = normalizeDate($("#from").val()); p.to = normalizeDate($("#to").val()); }
        return p;
    }
    function showErr(t) {
        var $a = $("#alertErr");
        if (t) { $a.text(t).removeClass("d-none"); } else { $a.addClass("d-none").text(""); }
    }

    function renderIndicadoresRanking(rows) {
        var $box = $("#reporteRankingIndicadores");
        var $leg = $("#rankingLeyenda");
        if (!rows || rows.length === 0) {
            $box.addClass("d-none");
            $leg.addClass("d-none");
            return;
        }
        var setC = {};
        var setV = {};
        var setF = {};
        var minRankViajes = null;
        var i, r, n;
        for (i = 0; i < rows.length; i++) {
            r = rows[i];
            if (r.clienteId) setC[r.clienteId] = 1;
            if (r.viajeId) setV[r.viajeId] = 1;
            if (r.facturaId) setF[r.facturaId] = 1;
            if (r.rankingViajes != null && r.rankingViajes !== "") {
                n = parseInt(r.rankingViajes, 10);
                if (!isNaN(n)) minRankViajes = minRankViajes === null ? n : Math.min(minRankViajes, n);
            }
        }
        $("#indRankFilas").text(String(rows.length));
        $("#indRankClientes").text(String(Object.keys(setC).length));
        $("#indRankViajes").text(String(Object.keys(setV).length));
        $("#indRankFacturas").text(String(Object.keys(setF).length));
        $("#indRankMejorViaje").text(minRankViajes !== null ? String(minRankViajes) : "—");
        $box.removeClass("d-none");
        $leg.removeClass("d-none");
    }

    /* ── Render helpers ──────────────────────────────────────────── */

    function escHtml(s) {
        return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function renderRankBadge(val) {
        if (val == null || val === "") return '<span class="text-muted">-</span>';
        var n = parseInt(val, 10);
        if (isNaN(n)) return escHtml(String(val));
        if (n === 1) return '<span class="badge bg-warning-subtle text-warning fw-bold">#1</span>';
        if (n === 2) return '<span class="badge bg-secondary-subtle text-secondary fw-bold">#2</span>';
        if (n === 3) return '<span class="badge bg-danger-subtle text-danger fw-bold">#3</span>';
        return '<span class="text-muted small">#' + n + '</span>';
    }

    function renderNumCentered(val, type) {
        if (type !== "display") return val != null ? val : 0;
        if (val == null || val === "") return '<span class="text-muted">-</span>';
        var n = parseInt(val, 10);
        if (isNaN(n)) return escHtml(String(val));
        return '<span class="fw-semibold">' + n + '</span>';
    }

    /* tooltips en th: DataTables no soporta title nativo en columns, se aplica post-init */
    var COL_TOOLTIPS = {
        3: "Pasajes incluidos en esta factura",
        4: "Viajes distintos que compró este cliente en la consulta",
        5: "Pasajes totales que compró este cliente en la consulta",
        6: "Filas de factura asociadas a este viaje (no clientes únicos)",
        7: "Posición del cliente por cantidad de viajes comprados (ranking denso)",
        8: "Posición del viaje por su métrica de popularidad (ranking denso)"
    };

    function applyHeaderTooltips() {
        if (!dt) return;
        dt.columns().every(function (idx) {
            if (COL_TOOLTIPS[idx]) {
                var $th = $(dt.column(idx).header());
                $th.attr("title", COL_TOOLTIPS[idx]).css("cursor", "help");
                if (window.bootstrap && bootstrap.Tooltip) {
                    new bootstrap.Tooltip($th[0], { trigger: "hover focus", placement: "top" });
                }
            }
        });
    }

    /* Índices de columna para filtros front */
    var COL_CLIENTE = 1;
    var COL_VIAJE   = 2;

    function renderTable(rows) {
        renderIndicadoresRanking(rows || []);
        var $tbl = $("#tblReporte");
        if (dt) { dt.destroy(); $tbl.empty(); }
        dt = $tbl.DataTable({
            data: rows || [],
            columns: [
                { data: "fecha", title: '<i class="bi bi-calendar3 me-1"></i>Fecha',
                  render: function (d) { return window.MatReportes.formatFechaES(d); } },
                { data: "clienteFullName", title: '<i class="bi bi-person me-1"></i>Cliente' },
                { data: "viajeDescripcion", title: '<i class="bi bi-geo-alt me-1"></i>Viaje',
                  render: function (d, type, row) {
                      if (type !== "display") return d || "";
                      var fecha = window.MatReportes.formatFechaES(row.viajeFechaSalida);
                      var esc = escHtml(d);
                      return '<span class="text-truncate d-inline-block" style="max-width:220px" title="' + esc + '">' + (esc || "-") + '</span>' +
                          (fecha ? '<br><span class="text-muted small"><i class="bi bi-calendar3 me-1"></i>' + fecha + '</span>' : '');
                  } },
                { data: "cantidadPasajesXFactura", title: "Pasajes fact.", className: "text-center",
                  render: function (d, type) { return renderNumCentered(d, type); } },
                { data: "cantViajesCompradosXCliente", title: "Viajes cl.", className: "text-center",
                  render: function (d, type) { return renderNumCentered(d, type); } },
                { data: "cantPasajesCompradosXCliente", title: "Pasajes cl.", className: "text-center",
                  render: function (d, type) { return renderNumCentered(d, type); } },
                { data: "cantClientesEligieronViaje", title: "Fact. viaje", className: "text-center",
                  render: function (d, type) { return renderNumCentered(d, type); } },
                { data: "rankingClientesCompradoresViajes", title: "Rank. clientes", className: "text-center",
                  render: function (d, type) {
                      if (type !== "display") return d != null ? d : "";
                      return renderRankBadge(d);
                  } },
                { data: "rankingViajes", title: "Rank. viajes", className: "text-center",
                  render: function (d, type) {
                      if (type !== "display") return d != null ? d : "";
                      return renderRankBadge(d);
                  } },
                { data: "facturaId",  title: "Factura",    visible: false },
                { data: "clienteId",  title: "Cliente ID", visible: false },
                { data: "viajeId",    title: "Viaje ID",   visible: false }
            ],
            pageLength: 25,
            autoWidth: false,
            language: { url: "/Scripts/dataTable/i18n/Spanish.json" },
            initComplete: function () { applyHeaderTooltips(); }
        });
        $("#filtroFront").toggleClass("d-none", !rows || rows.length === 0);
        limpiarFiltros();
    }

    function limpiarFiltros() {
        $("#filtCliente,#filtViaje").val("");
        if (dt) {
            dt.columns(COL_CLIENTE).search("").columns(COL_VIAJE).search("").draw();
        }
    }

    $('input[name="modoFiltro"]').on("change", syncGrupos);
    syncGrupos();

    $("#btnBuscar").on("click", function () {
        showErr("");
        $("#reporteRankingIndicadores").addClass("d-none");
        $("#rankingLeyenda").addClass("d-none");
        $.getJSON(urlJson, queryParams()).done(function (res) {
            if (!res.ok) { showErr(res.message || "Error"); return; }
            renderTable(res.data);
        }).fail(function (xhr) { showErr(window.MatReportes.parseHttpErrorBody(xhr)); });
    });

    $("#btnExcel").on("click", function () {
        window.MatReportes.downloadReporteExcel(urlExcel, queryParams, showErr);
    });

    $("#filtCliente").on("input", function () {
        if (dt) dt.columns(COL_CLIENTE).search($(this).val()).draw();
    });
    $("#filtViaje").on("input", function () {
        if (dt) dt.columns(COL_VIAJE).search($(this).val()).draw();
    });
    $("#btnLimpiarFiltro").on("click", limpiarFiltros);
});
</script>
}
