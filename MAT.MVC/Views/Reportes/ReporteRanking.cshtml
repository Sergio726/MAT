@{
    ViewBag.Title = "Ranking de compras";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

@section BreadcrumbItems {
    <li class="breadcrumb-item"><a href="@Url.Action("Index", "Reportes")">Reportes</a></li>
    <li class="breadcrumb-item active" aria-current="page">Ranking</li>
}

<div class="modern-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="modern-page-title mb-0">
                <i class="bi bi-trophy"></i>
                <span>Ranking de compras</span>
            </h1>
            <p class="small text-secondary mb-0 mt-1">
                Dashboard de estadísticas de compras. Filtrá por <strong>rango de fechas</strong> o por <strong>viaje</strong>.
                Hacé clic en cada tarjeta para ver el detalle.
            </p>
        </div>
        <a href="@Url.Action("Index", "Reportes")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Índice reportes</a>
    </div>

    <!-- ── Filtros ──────────────────────────────────────────────── -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="mb-3">
                <div class="btn-group" role="group" aria-label="Modo filtro">
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoFechas" value="fechas" checked autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoFechas">Por fechas</label>
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoViaje" value="viaje" autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoViaje">Por viaje</label>
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2" id="grpFechas">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="from">Desde</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="from" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="to">Hasta</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="to" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2 d-none" id="grpViaje">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label small mb-0" for="viajeBuscar">Viaje</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="viajeBuscar" placeholder="Buscá por nombre o abrí la lista reciente…" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" id="btnViajeLista" title="Últimos 30 viajes por fecha de salida" aria-label="Abrir lista de viajes recientes"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                    </div>
                    <input type="hidden" id="viajeId" value="" />
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <button type="button" class="btn-modern btn-modern-primary btn-sm" id="btnBuscar"><i class="bi bi-search"></i> Consultar</button>
                <button type="button" class="btn btn-outline-danger btn-sm d-none" id="btnDescargarPdf">
                    <i class="bi bi-file-earmark-pdf"></i> Descargar PDF
                </button>
            </div>
            <div class="alert alert-danger d-none mt-3 mb-0 py-2 small" id="alertErr" role="alert"></div>
        </div>
    </div>

    <!-- ── Estado vacío ─────────────────────────────────────────── -->
    <div id="dashboardEmpty" class="admin-empty-state text-center py-5 d-none">
        <i class="bi bi-inbox admin-empty-icon text-secondary d-block mb-2"></i>
        <p class="admin-empty-title mb-1">Sin resultados para el período seleccionado</p>
        <p class="admin-empty-hint text-secondary mb-0">Probá otro rango de fechas o un viaje distinto</p>
    </div>

    <!-- ── Dashboard de tarjetas ────────────────────────────────── -->
    <div id="dashboardCards" class="d-none mb-3">
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 row-cols-xxl-5 g-3">
            <!-- Registros -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100 ranking-card-kpi card-sin-datos" role="button" tabindex="0"
                     data-modal="modalRegistros" title="Ver detalle de registros">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Registros</span>
                            <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary p-2"><i class="bi bi-list-ul"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="kpiRegistros">0</p>
                        <p class="small text-secondary mb-0">transacciones</p>
                    </div>
                </div>
            </div>
            <!-- Clientes -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100 ranking-card-kpi card-sin-datos" role="button" tabindex="0"
                     data-modal="modalClientes" title="Ver detalle de clientes">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Clientes</span>
                            <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-people"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="kpiClientes">0</p>
                        <p class="small text-secondary mb-0">compraron en el período</p>
                    </div>
                </div>
            </div>
            <!-- Pasajeros -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100 ranking-card-kpi card-sin-datos" role="button" tabindex="0"
                     data-modal="modalPasajeros" title="Ver detalle de pasajeros por viaje">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Pasajeros</span>
                            <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-person-badge"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="kpiPasajeros">0</p>
                        <p class="small text-secondary mb-0">pasajes vendidos</p>
                    </div>
                </div>
            </div>
            <!-- Facturas -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100 ranking-card-kpi card-sin-datos" role="button" tabindex="0"
                     data-modal="modalFacturas" title="Ver detalle de facturas">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Facturas</span>
                            <span class="rounded-circle bg-warning bg-opacity-10 text-warning p-2"><i class="bi bi-receipt"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="kpiFacturas">0</p>
                        <p class="small text-secondary mb-0">facturas registradas</p>
                    </div>
                </div>
            </div>
            <!-- Top viajes -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100 ranking-card-kpi card-sin-datos" role="button" tabindex="0"
                     data-modal="modalTopViajes" title="Ver ranking completo de viajes">
                    <div class="card-body py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <span class="small fw-semibold text-body-secondary">Top viajes</span>
                            <span class="rounded-circle bg-success bg-opacity-10 text-success p-2"><i class="bi bi-geo-alt"></i></span>
                        </div>
                        <div id="kpiTopViajes" class="mb-0">
                            <span class="text-muted small">—</span>
                        </div>
                        <p class="small text-secondary mb-0 mt-1">viajes más vendidos</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ── Modal: Registros ─────────────────────────────────────── -->
    <div class="modal fade" id="modalRegistros" tabindex="-1" aria-labelledby="modalRegistrosLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalRegistrosLabel"><i class="bi bi-list-ul me-1"></i> Registros</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6"><input type="text" class="form-control form-control-sm ranking-modal-search" placeholder="Buscar cliente o viaje…" autocomplete="off" /></div>
                        <div class="col-md-auto"><span class="badge bg-secondary ranking-modal-count">0 de 0</span></div>
                    </div>
                    <div class="table-responsive admin-modal-table-wrap">
                        <table class="table table-sm table-striped ranking-modal-table w-100"><thead></thead><tbody></tbody></table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button></div>
            </div>
        </div>
    </div>

    <!-- ── Modal: Clientes ──────────────────────────────────────── -->
    <div class="modal fade" id="modalClientes" tabindex="-1" aria-labelledby="modalClientesLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalClientesLabel"><i class="bi bi-people me-1"></i> Clientes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6"><input type="text" class="form-control form-control-sm ranking-modal-search" placeholder="Buscar cliente…" autocomplete="off" /></div>
                        <div class="col-md-auto"><span class="badge bg-secondary ranking-modal-count">0 de 0</span></div>
                    </div>
                    <div class="table-responsive admin-modal-table-wrap">
                        <table class="table table-sm table-striped ranking-modal-table w-100"><thead></thead><tbody></tbody></table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button></div>
            </div>
        </div>
    </div>

    <!-- ── Modal: Pasajeros ─────────────────────────────────────── -->
    <div class="modal fade" id="modalPasajeros" tabindex="-1" aria-labelledby="modalPasajerosLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalPasajerosLabel"><i class="bi bi-person-badge me-1"></i> Pasajeros por viaje</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6"><input type="text" class="form-control form-control-sm ranking-modal-search" placeholder="Buscar viaje…" autocomplete="off" /></div>
                        <div class="col-md-auto"><span class="badge bg-secondary ranking-modal-count">0 de 0</span></div>
                    </div>
                    <div class="table-responsive admin-modal-table-wrap">
                        <table class="table table-sm table-striped ranking-modal-table w-100"><thead></thead><tbody></tbody></table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button></div>
            </div>
        </div>
    </div>

    <!-- ── Modal: Facturas ──────────────────────────────────────── -->
    <div class="modal fade" id="modalFacturas" tabindex="-1" aria-labelledby="modalFacturasLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalFacturasLabel"><i class="bi bi-receipt me-1"></i> Facturas</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6"><input type="text" class="form-control form-control-sm ranking-modal-search" placeholder="Buscar cliente o viaje…" autocomplete="off" /></div>
                        <div class="col-md-auto"><span class="badge bg-secondary ranking-modal-count">0 de 0</span></div>
                    </div>
                    <div class="table-responsive admin-modal-table-wrap">
                        <table class="table table-sm table-striped ranking-modal-table w-100"><thead></thead><tbody></tbody></table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button></div>
            </div>
        </div>
    </div>

    <!-- ── Modal: Top viajes ────────────────────────────────────── -->
    <div class="modal fade" id="modalTopViajes" tabindex="-1" aria-labelledby="modalTopViajesLabel" aria-hidden="true">
        <div class="modal-dialog modal-xl modal-fullscreen-md-down">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalTopViajesLabel"><i class="bi bi-geo-alt me-1"></i> Ranking de viajes</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-3">
                    <div class="row g-2 mb-3">
                        <div class="col-md-6"><input type="text" class="form-control form-control-sm ranking-modal-search" placeholder="Buscar viaje…" autocomplete="off" /></div>
                        <div class="col-md-auto"><span class="badge bg-secondary ranking-modal-count">0 de 0</span></div>
                    </div>
                    <div class="table-responsive admin-modal-table-wrap">
                        <table class="table table-sm table-striped ranking-modal-table w-100"><thead></thead><tbody></tbody></table>
                    </div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Cerrar</button></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="@Url.Content("~/Scripts/lib/html2pdf.bundle.min.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-utils.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-viaje-autocomplete.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-ranking-dashboard.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-ranking-modals.js")"></script>
<script>
$(function () {
    var urlJson = '@Url.Action("Ranking", "Reportes")';
    var urlBuscarViajes = '@Url.Action("BuscarViajes", "Reportes")';
    var lastRows = [];

    /* ── Datepicker ES ──────────────────────────────────────── */
    $.datepicker.regional['es'] = {
        closeText: 'Cerrar', prevText: '\u2039', nextText: '\u203a',
        currentText: 'Hoy',
        monthNames: ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
        monthNamesShort: ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'],
        dayNames: ['Domingo','Lunes','Martes','Mi\u00e9rcoles','Jueves','Viernes','S\u00e1bado'],
        dayNamesShort: ['Dom','Lun','Mar','Mi\u00e9','Jue','Vie','S\u00e1b'],
        dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','S\u00e1'],
        weekHeader: 'Sm', dateFormat: 'dd/mm/yy', firstDay: 1,
        isRTL: false, showMonthAfterYear: false, yearSuffix: ''
    };
    $(".mat-datepicker").datepicker($.extend({}, $.datepicker.regional['es'], {
        changeMonth: true, changeYear: true, yearRange: '2015:2035',
        showButtonPanel: true, showOtherMonths: true, selectOtherMonths: true, maxDate: '+5y'
    }));

    /* Pre-cargar último mes (30 días exactos para evitar desborde de días) */
    var hoy = new Date();
    var hace30 = new Date(hoy.getTime() - 30 * 24 * 60 * 60 * 1000);
    $('#from').datepicker('setDate', hace30);
    $('#to').datepicker('setDate', hoy);

    /* ── Viaje autocomplete ─────────────────────────────────── */
    if (window.MatReportes && window.MatReportes.initViajeAutocomplete) {
        window.MatReportes.initViajeAutocomplete({
            urlBuscarViajes: urlBuscarViajes,
            inputSearch: "#viajeBuscar",
            inputHidden: "#viajeId",
            buttonLista: "#btnViajeLista"
        });
    }

    /* ── Helpers ─────────────────────────────────────────────── */
    function normalizeDate(val) { return (val || "").trim().replace(/\//g, "-"); }
    function modo() { return $("#modoViaje").is(":checked") ? "viaje" : "fechas"; }
    function syncGrupos() {
        if (modo() === "viaje") { $("#grpFechas").addClass("d-none"); $("#grpViaje").removeClass("d-none"); }
        else { $("#grpFechas").removeClass("d-none"); $("#grpViaje").addClass("d-none"); $("#viajeBuscar").val(""); $("#viajeId").val(""); }
    }
    function queryParams() {
        var p = {};
        if (modo() === "viaje") p.viajeId = $("#viajeId").val().trim();
        else { p.from = normalizeDate($("#from").val()); p.to = normalizeDate($("#to").val()); }
        return p;
    }
    function showErr(t) {
        var $a = $("#alertErr");
        if (t) $a.text(t).removeClass("d-none"); else $a.addClass("d-none").text("");
    }

    $('input[name="modoFiltro"]').on("change", syncGrupos);
    syncGrupos();

    /* ── Init módulos JS ────────────────────────────────────── */
    if (window.MatReportes && window.MatReportes.RankingDashboard) {
        window.MatReportes.RankingDashboard.init({ getLastRows: function () { return lastRows; } });
    }
    if (window.MatReportes && window.MatReportes.RankingModals) {
        window.MatReportes.RankingModals.init({ getLastRows: function () { return lastRows; } });
    }

    /* ── Buscar ──────────────────────────────────────────────── */
    function buscar() {
        showErr("");
        if (modo() === "viaje" && !$("#viajeId").val().trim()) {
            showErr("Seleccioná un viaje de la lista.");
            return;
        }
        $("#dashboardCards, #dashboardEmpty, #btnDescargarPdf").addClass("d-none");
        $(".ranking-card-kpi").addClass("card-sin-datos");
        var $btn = $("#btnBuscar");
        if (window.MatAdmin) MatAdmin.showLoading($btn[0]);

        $.getJSON(urlJson, queryParams())
            .done(function (res) {
                if (!res.ok) { showErr(res.message || "Error"); return; }
                lastRows = res.data || [];

                if (lastRows.length === 0) {
                    if (window.MatReportes && window.MatReportes.RankingDashboard) {
                        window.MatReportes.RankingDashboard.render([]);
                    }
                    $("#dashboardEmpty").removeClass("d-none");
                    return;
                }

                $(".ranking-card-kpi").removeClass("card-sin-datos");
                $("#dashboardCards").removeClass("d-none");
                $("#btnDescargarPdf").removeClass("d-none");

                if (window.MatReportes && window.MatReportes.RankingDashboard) {
                    window.MatReportes.RankingDashboard.render(lastRows);
                }
            })
            .fail(function (xhr) {
                var parseFn = window.MatReportes && window.MatReportes.parseHttpErrorBody;
                showErr(parseFn ? parseFn(xhr) : "Error de conexión");
            })
            .always(function () {
                if (window.MatAdmin) MatAdmin.hideLoading($btn[0]);
            });
    }

    $("#btnBuscar").on("click", buscar);

    /* ── PDF ─────────────────────────────────────────────────── */
    $("#btnDescargarPdf").on("click", function () {
        if (!lastRows.length) return;
        window.MatReportes.RankingDashboard.downloadPdf();
    });

    /* ── Auto-consulta al cargar ─────────────────────────────── */
    buscar();
});
</script>
}
