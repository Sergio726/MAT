@{
    ViewBag.Title = "Reporte de ventas";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="modern-page-title mb-0">
                <i class="bi bi-receipt-cutoff"></i>
                <span>Reporte de ventas</span>
            </h1>
            <p class="small text-secondary mb-0 mt-1">
                Consultá las ventas realizadas filtrando por <strong>rango de fechas</strong> o por <strong>viaje</strong> (no ambos a la vez).
                Una vez que carguen los resultados podés acotar la vista por vendedor o cliente sin necesidad de volver a consultar.
                Usá <em>Exportar Excel</em> para descargar el listado completo de la consulta.
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="@Url.Action("Index", "Reportes")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Índice reportes</a>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="mb-3">
                <div class="btn-group" role="group" aria-label="Modo filtro">
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoFechas" value="fechas" checked autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoFechas">Por fechas</label>
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoViaje" value="viaje" autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoViaje">Por viaje</label>
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2" id="grpFechas">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="from">Desde</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="from" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="to">Hasta</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="to" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2 d-none" id="grpViaje">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label small mb-0" for="viajeBuscar">Viaje</label>
                    <input type="text" class="form-control form-control-sm" id="viajeBuscar" placeholder="Escribí al menos 2 letras del nombre del viaje…" autocomplete="off" />
                    <input type="hidden" id="viajeId" value="" />
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <button type="button" class="btn btn-primary btn-sm" id="btnBuscar"><i class="bi bi-search"></i> Consultar</button>
                <button type="button" class="btn btn-outline-success btn-sm" id="btnExcel" title="Descarga todos los resultados de la consulta, sin aplicar el filtro de la tabla"><i class="bi bi-file-earmark-excel"></i> Exportar Excel</button>
            </div>
            <div class="alert alert-danger d-none mt-3 mb-0 py-2 small" id="alertErr" role="alert"></div>
        </div>
    </div>

    <div id="filtroFront" class="card shadow-sm border-0 mb-3 d-none">
        <div class="card-body py-2">
            <p class="small text-secondary mb-2"><i class="bi bi-funnel"></i> Acotar resultados en pantalla (sin nueva consulta):</p>
            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small mb-0" for="filtVendedor">Vendedor</label>
                    <input type="text" class="form-control form-control-sm" id="filtVendedor" placeholder="Nombre del vendedor…" autocomplete="off" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small mb-0" for="filtCliente">Cliente</label>
                    <input type="text" class="form-control form-control-sm" id="filtCliente" placeholder="Nombre del cliente…" autocomplete="off" />
                </div>
                <div class="col-md-2 d-flex align-items-end">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLimpiarFiltro"><i class="bi bi-x-lg"></i> Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    <div id="reporteVentasIndicadores" class="d-none mb-3" aria-live="polite">
        <h2 class="h6 fw-bold text-primary mb-3">Resumen de la consulta</h2>
        <p class="small text-secondary mb-3">Totales calculados sobre el resultado devuelto por el servidor (no cambian al filtrar la tabla por vendedor o cliente).</p>
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 row-cols-xxl-5 g-3">
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Total facturado</span>
                            <span class="rounded-circle bg-success bg-opacity-10 text-success p-2"><i class="bi bi-currency-dollar"></i></span>
                        </div>
                        <div class="reporte-ventas-kpi-montos" data-kpi="facturado"></div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Total cobrado</span>
                            <span class="rounded-circle bg-warning bg-opacity-10 text-warning p-2"><i class="bi bi-credit-card"></i></span>
                        </div>
                        <div class="reporte-ventas-kpi-montos" data-kpi="cobrado"></div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Saldo pendiente</span>
                            <span class="rounded-circle bg-danger bg-opacity-10 text-danger p-2"><i class="bi bi-cash-stack"></i></span>
                        </div>
                        <div class="reporte-ventas-kpi-montos" data-kpi="saldo"></div>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Ventas con pago</span>
                            <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-receipt"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indVentasConPago">0</p>
                        <p class="small text-secondary mb-0">Filas con monto pagado &gt; 0</p>
                    </div>
                </div>
            </div>
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Total de filas</span>
                            <span class="rounded-circle bg-secondary bg-opacity-10 text-secondary p-2"><i class="bi bi-list-ul"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-0" id="indTotalFilas">0</p>
                        <p class="small text-secondary mb-0">Registros en el resultado</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modern-table-container">
        <div class="table-responsive">
            <table class="modern-table table table-striped table-sm w-100" id="tblReporte" style="min-width: 860px"></table>
        </div>
    </div>
</div>

@section Scripts {
<script src="@Url.Content("~/Scripts/mat.reportes-excel-export.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-viaje-autocomplete.js")"></script>
<script>
$(function () {
    var urlJson = '@Url.Action("Ventas", "Reportes")';
    var urlExcel = '@Url.Action("VentasExcel", "Reportes")';
    var urlBuscarViajes = '@Url.Action("BuscarViajes", "Reportes")';
    var dt = null;

    // Inicializar datepicker en español
    $.datepicker.regional['es'] = {
        closeText: 'Cerrar', prevText: '‹', nextText: '›',
        currentText: 'Hoy', monthNames: ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
        monthNamesShort: ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'],
        dayNames: ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'],
        dayNamesShort: ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'], dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','Sá'],
        weekHeader: 'Sm', dateFormat: 'dd/mm/yy', firstDay: 1,
        isRTL: false, showMonthAfterYear: false, yearSuffix: ''
    };
    $(".mat-datepicker").datepicker($.extend({}, $.datepicker.regional['es'], {
        changeMonth: true, changeYear: true, yearRange: '2015:2035',
        showButtonPanel: true, showOtherMonths: true, selectOtherMonths: true,
        maxDate: '+5y'
    }));

    if (window.MatReportes && window.MatReportes.initViajeAutocomplete) {
        window.MatReportes.initViajeAutocomplete({
            urlBuscarViajes: urlBuscarViajes,
            inputSearch: "#viajeBuscar",
            inputHidden: "#viajeId"
        });
    }

    /* ── Helpers ─────────────────────────────────────────────────── */
    function modo() {
        return $("#modoViaje").is(":checked") ? "viaje" : "fechas";
    }

    function syncGrupos() {
        if (modo() === "viaje") {
            $("#grpFechas").addClass("d-none");
            $("#grpViaje").removeClass("d-none");
        } else {
            $("#grpFechas").removeClass("d-none");
            $("#grpViaje").addClass("d-none");
            $("#viajeBuscar").val("").removeData("matViajeLabel");
            $("#viajeId").val("");
        }
    }

    /* Convierte dd/mm/yyyy → dd-mm-yyyy que el backend acepta */
    function normalizeDate(val) {
        return (val || "").trim().replace(/\//g, "-");
    }

    function queryParams() {
        var p = {};
        if (modo() === "viaje") {
            p.viajeId = $("#viajeId").val().trim();
        } else {
            p.from = normalizeDate($("#from").val());
            p.to   = normalizeDate($("#to").val());
        }
        return p;
    }

    function showErr(t) {
        var $a = $("#alertErr");
        if (t) { $a.text(t).removeClass("d-none"); } else { $a.addClass("d-none").text(""); }
    }

    /* ── Tabla ───────────────────────────────────────────────────── */
    /* Índices de columna usados en el filtro front */
    var COL_VENDEDOR = 4;  /* vendedorFullName */
    var COL_CLIENTE  = 6;  /* clienteFullName  */

    var moneyFmt = new Intl.NumberFormat("es-AR", { minimumFractionDigits: 0, maximumFractionDigits: 2 });

    function parseMoneyCell(v) {
        if (v == null || v === "") return 0;
        if (typeof v === "number") return isNaN(v) ? 0 : v;
        var s = String(v).trim().replace(/\s/g, "");
        var n = parseFloat(s.replace(/\./g, "").replace(",", "."));
        return isNaN(n) ? 0 : n;
    }

    function renderMonedaRowsHtml(totPorMoneda) {
        var parts = [];
        var order = [
            { key: "1", label: "$ARS", cls: "success" },
            { key: "3", label: "U$S", cls: "info" }
        ];
        var j, k, val, orderI;
        for (j = 0; j < order.length; j++) {
            orderI = order[j];
            k = orderI.key;
            val = totPorMoneda[k] || 0;
            if (val === 0 && !totPorMoneda._showZero) continue;
            parts.push(
                "<div class=\"d-flex flex-wrap align-items-center gap-2 py-1 border-bottom border-light\">" +
                "<span class=\"badge rounded-pill bg-" + orderI.cls + "-subtle text-" + orderI.cls + "\">" + orderI.label + "</span>" +
                "<span class=\"fw-semibold ms-auto\">$ " + moneyFmt.format(val) + "</span></div>"
            );
        }
        if ((totPorMoneda._otra || 0) !== 0) {
            parts.push(
                "<div class=\"d-flex flex-wrap align-items-center gap-2 py-1\">" +
                "<span class=\"badge rounded-pill bg-secondary-subtle text-secondary\">Otra</span>" +
                "<span class=\"fw-semibold ms-auto\">$ " + moneyFmt.format(totPorMoneda._otra) + "</span></div>"
            );
        }
        if (parts.length === 0) {
            parts.push("<span class=\"text-secondary small\">Sin montos</span>");
        }
        return parts.join("");
    }

    function aggregateVentasRows(rows) {
        var facturado = { "1": 0, "3": 0, _otra: 0 };
        var cobrado = { "1": 0, "3": 0, _otra: 0 };
        var saldo = { "1": 0, "3": 0, _otra: 0 };
        var conPago = 0;
        var i, r, m, mp;
        for (i = 0; i < rows.length; i++) {
            r = rows[i];
            m = String(r.monedaTipo != null ? r.monedaTipo : "").trim();
            if (m !== "1" && m !== "3") m = "_otra";
            mp = parseMoneyCell(r.montoPagado);
            if (mp > 0) conPago++;
            facturado[m] = (facturado[m] || 0) + parseMoneyCell(r.totalFactura);
            cobrado[m] = (cobrado[m] || 0) + mp;
            saldo[m] = (saldo[m] || 0) + parseMoneyCell(r.saldo);
        }
        return { facturado: facturado, cobrado: cobrado, saldo: saldo, conPago: conPago, totalFilas: rows.length };
    }

    function renderIndicadoresVentas(rows) {
        var $box = $("#reporteVentasIndicadores");
        if (!rows || rows.length === 0) {
            $box.addClass("d-none");
            return;
        }
        var agg = aggregateVentasRows(rows);
        ["facturado", "cobrado", "saldo"].forEach(function (k) {
            var obj = agg[k];
            var flat = { "1": obj["1"] || 0, "3": obj["3"] || 0, _otra: obj._otra || 0, _showZero: true };
            $box.find("[data-kpi=\"" + k + "\"]").html(renderMonedaRowsHtml(flat));
        });
        $("#indVentasConPago").text(String(agg.conPago));
        $("#indTotalFilas").text(String(agg.totalFilas));
        $box.removeClass("d-none");
    }

    function renderTable(rows) {
        renderIndicadoresVentas(rows || []);
        var $tbl = $("#tblReporte");
        if (dt) { dt.destroy(); $tbl.empty(); }
        dt = $tbl.DataTable({
            data: rows || [],
            columns: [
                { data: "viajeDescripcion",  title: "Viaje" },
                { data: "fechaSalida",        title: "Fecha salida",
                  render: function (d) { return d ? (typeof d === "string" ? d : "") : ""; } },
                { data: "cantidadButacas",   title: "Butacas" },
                { data: "facturaFecha",       title: "F. factura" },
                { data: "vendedorFullName",   title: "Vendedor" },
                { data: "facturaEstado",      title: "Estado" },
                { data: "clienteFullName",    title: "Cliente" },
                { data: "monedaTipo",         title: "Mon." },
                { data: "totalFactura",       title: "Total" },
                { data: "montoPagado",        title: "Pagado" },
                { data: "saldo",              title: "Saldo" }
            ],
            pageLength: 25,
            autoWidth: false,
            language: { url: "/Scripts/dataTable/i18n/Spanish.json" }
        });
        /* Mostrar panel de filtro front y limpiar valores anteriores */
        $("#filtVendedor, #filtCliente").val("");
        dt.columns().search("").draw();
        $("#filtroFront").removeClass("d-none");
    }

    /* ── Filtro front (vendedor / cliente) ───────────────────────── */
    $("#filtVendedor").on("input", function () {
        if (dt) dt.column(COL_VENDEDOR).search($(this).val().trim()).draw();
    });
    $("#filtCliente").on("input", function () {
        if (dt) dt.column(COL_CLIENTE).search($(this).val().trim()).draw();
    });
    $("#btnLimpiarFiltro").on("click", function () {
        $("#filtVendedor, #filtCliente").val("");
        if (dt) dt.columns([COL_VENDEDOR, COL_CLIENTE]).search("").draw();
    });

    /* ── Modo filtro ─────────────────────────────────────────────── */
    $('input[name="modoFiltro"]').on("change", syncGrupos);
    syncGrupos();

    /* ── Consultar ───────────────────────────────────────────────── */
    $("#btnBuscar").on("click", function () {
        showErr("");
        $("#reporteVentasIndicadores").addClass("d-none");
        $("#filtroFront").addClass("d-none");
        $.getJSON(urlJson, queryParams())
            .done(function (res) {
                if (!res.ok) { showErr(res.message || "Error"); return; }
                renderTable(res.data);
            })
            .fail(function (xhr) {
                showErr(window.MatReportes.parseHttpErrorBody(xhr));
            });
    });

    /* ── Excel (exporta el total de la consulta, sin filtro front) ─ */
    $("#btnExcel").on("click", function () {
        window.MatReportes.downloadReporteExcel(urlExcel, queryParams, showErr);
    });
});
</script>
}
