@{
    ViewBag.Title = "Reporte de pagos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<div class="modern-page-container">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
        <div>
            <h1 class="modern-page-title mb-0">
                <i class="bi bi-cash-coin"></i>
                <span>Reporte de pagos</span>
            </h1>
            <p class="small text-secondary mb-0 mt-1">
                Consultá los pagos registrados filtrando por <strong>rango de fechas</strong> o por <strong>viaje</strong> (no ambos a la vez).
                Podés indicar también el tipo de venta. Una vez cargados los resultados, afinás la vista por vendedor o cliente sin volver a consultar.
                Usá <em>Exportar Excel</em> para descargar el listado completo de la consulta.
            </p>
        </div>
        <a href="@Url.Action("Index", "Reportes")" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left"></i> Índice reportes</a>
    </div>

    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body">
            <div class="mb-3">
                <div class="btn-group" role="group">
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoFechas" value="fechas" checked autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoFechas">Por fechas</label>
                    <input type="radio" class="btn-check" name="modoFiltro" id="modoViaje" value="viaje" autocomplete="off" />
                    <label class="btn btn-outline-primary btn-sm" for="modoViaje">Por viaje</label>
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2" id="grpFechas">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="from">Desde</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="from" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="to">Hasta</label>
                    <input type="text" class="form-control form-control-sm mat-datepicker" id="to" placeholder="dd/mm/aaaa" autocomplete="off" />
                </div>
            </div>
            <div class="row g-2 align-items-end mb-2 d-none" id="grpViaje">
                <div class="col-md-8 col-lg-6">
                    <label class="form-label small mb-0" for="viajeBuscar">Viaje</label>
                    <div class="input-group input-group-sm">
                        <input type="text" class="form-control" id="viajeBuscar" placeholder="Buscá por nombre o abrí la lista reciente…" autocomplete="off" />
                        <button type="button" class="btn btn-outline-secondary" id="btnViajeLista" title="Últimos 30 viajes por fecha de salida" aria-label="Abrir lista de viajes recientes"><i class="bi bi-chevron-down" aria-hidden="true"></i></button>
                    </div>
                    <input type="hidden" id="viajeId" value="" />
                </div>
            </div>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="tipoVentaId">Tipo de venta</label>
                    <select class="form-select form-select-sm" id="tipoVentaId">
                        <option value="">(Todos)</option>
                        <option value="1">Oficina</option>
                        <option value="2">Online</option>
                    </select>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-primary btn-sm" id="btnBuscar"><i class="bi bi-search"></i> Consultar</button>
                <button type="button" class="btn btn-outline-success btn-sm" id="btnExcel"
                        title="Descarga todos los registros de la última consulta, sin importar los filtros de vista">
                    <i class="bi bi-file-earmark-excel"></i> Exportar Excel
                </button>
            </div>
            <div class="alert alert-danger d-none mt-3 mb-0 py-2 small" id="alertErr" role="alert"></div>
        </div>
    </div>

    <div id="filtroFront" class="card shadow-sm border-0 mb-3 d-none">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="filtVendedor"><i class="bi bi-person-badge"></i> Filtrar vendedor</label>
                    <input type="text" class="form-control form-control-sm" id="filtVendedor" placeholder="Nombre del vendedor…" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="filtCliente"><i class="bi bi-person"></i> Filtrar cliente</label>
                    <input type="text" class="form-control form-control-sm" id="filtCliente" placeholder="Nombre del cliente…" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small mb-0" for="filtTipoPago"><i class="bi bi-credit-card"></i> Filtrar medio de pago</label>
                    <input type="text" class="form-control form-control-sm" id="filtTipoPago" placeholder="Ej. efectivo, tarjeta…" autocomplete="off" />
                </div>
                <div class="col-md-auto">
                    <button type="button" class="btn btn-outline-secondary btn-sm" id="btnLimpiarFiltro">
                        <i class="bi bi-x-circle"></i> Limpiar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <div id="reportePagosIndicadores" class="d-none mb-3" aria-live="polite">
        <h2 class="h6 fw-bold text-primary mb-3">Resumen de la consulta</h2>
        <p class="small text-secondary mb-3">Totales calculados sobre el resultado devuelto por el servidor (no cambian al filtrar la tabla por vendedor, cliente o medio de pago).</p>

        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-4 g-3 mb-3">
            <!-- Total cobrado -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Total cobrado</span>
                            <span class="rounded-circle bg-success bg-opacity-10 text-success p-2"><i class="bi bi-currency-dollar"></i></span>
                        </div>
                        <div id="kpiTotalCobrado"></div>
                    </div>
                </div>
            </div>
            <!-- Resumen operativo -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Resumen operativo</span>
                            <span class="rounded-circle bg-primary bg-opacity-10 text-primary p-2"><i class="bi bi-receipt"></i></span>
                        </div>
                        <p class="fs-4 fw-bold mb-1" id="kpiTotalPagos">0</p>
                        <p class="small text-secondary mb-1">pagos registrados</p>
                        <p class="small text-secondary mb-0"><span class="fw-semibold" id="kpiFacturasDistintas">0</span> facturas distintas</p>
                    </div>
                </div>
            </div>
            <!-- Por tipo de venta -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Por tipo de venta</span>
                            <span class="rounded-circle bg-warning bg-opacity-10 text-warning p-2"><i class="bi bi-shop"></i></span>
                        </div>
                        <div id="kpiTipoVenta"></div>
                    </div>
                </div>
            </div>
            <!-- Por medio de pago -->
            <div class="col">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="small fw-semibold text-body-secondary">Por medio de pago</span>
                            <span class="rounded-circle bg-info bg-opacity-10 text-info p-2"><i class="bi bi-credit-card"></i></span>
                        </div>
                        <div id="kpiMedioPago"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modern-table-container">
        <div class="table-responsive">
            <table class="modern-table table table-striped table-sm w-100" id="tblReporte"></table>
        </div>
    </div>
</div>

@section Scripts {
<script src="@Url.Content("~/Scripts/mat.reportes-utils.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-excel-export.js")"></script>
<script src="@Url.Content("~/Scripts/mat.reportes-viaje-autocomplete.js")"></script>
<script>
$(function () {
    var urlJson  = '@Url.Action("Pagos", "Reportes")';
    var urlExcel = '@Url.Action("PagosExcel", "Reportes")';
    var urlBuscarViajes = '@Url.Action("BuscarViajes", "Reportes")';
    var dt = null;

    // Inicializar datepicker en español
    $.datepicker.regional['es'] = {
        closeText: 'Cerrar', prevText: '‹', nextText: '›',
        currentText: 'Hoy', monthNames: ['Enero','Febrero','Marzo','Abril','Mayo','Junio','Julio','Agosto','Septiembre','Octubre','Noviembre','Diciembre'],
        monthNamesShort: ['Ene','Feb','Mar','Abr','May','Jun','Jul','Ago','Sep','Oct','Nov','Dic'],
        dayNames: ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'],
        dayNamesShort: ['Dom','Lun','Mar','Mié','Jue','Vie','Sáb'], dayNamesMin: ['Do','Lu','Ma','Mi','Ju','Vi','Sá'],
        weekHeader: 'Sm', dateFormat: 'dd/mm/yy', firstDay: 1,
        isRTL: false, showMonthAfterYear: false, yearSuffix: ''
    };
    $(".mat-datepicker").datepicker($.extend({}, $.datepicker.regional['es'], {
        changeMonth: true, changeYear: true, yearRange: '2015:2035',
        showButtonPanel: true, showOtherMonths: true, selectOtherMonths: true,
        maxDate: '+5y'
    }));

    if (window.MatReportes && window.MatReportes.initViajeAutocomplete) {
        window.MatReportes.initViajeAutocomplete({
            urlBuscarViajes: urlBuscarViajes,
            inputSearch: "#viajeBuscar",
            inputHidden: "#viajeId",
            buttonLista: "#btnViajeLista"
        });
    }

    function normalizeDate(val) { return (val || "").trim().replace(/\//g, "-"); }
    function modo() { return $("#modoViaje").is(":checked") ? "viaje" : "fechas"; }
    function syncGrupos() {
        if (modo() === "viaje") { $("#grpFechas").addClass("d-none"); $("#grpViaje").removeClass("d-none"); }
        else {
            $("#grpFechas").removeClass("d-none"); $("#grpViaje").addClass("d-none");
            $("#viajeBuscar").val("").removeData("matViajeLabel");
            $("#viajeId").val("");
        }
    }
    function queryParams() {
        var p = { tipoVentaId: $("#tipoVentaId").val() };
        if (modo() === "viaje") p.viajeId = $("#viajeId").val().trim();
        else { p.from = normalizeDate($("#from").val()); p.to = normalizeDate($("#to").val()); }
        return p;
    }
    function showErr(t) {
        var $a = $("#alertErr");
        if (t) { $a.text(t).removeClass("d-none"); } else { $a.addClass("d-none").text(""); }
    }

    /* ── KPI helpers ────────────────────────────────────────────── */
    var MR = window.MatReportes;

    function renderMonedaLines(obj) {
        var order = [
            { key: "1", label: "$ARS", cls: "success" },
            { key: "3", label: "U$D", cls: "info" }
        ];
        var parts = [];
        for (var j = 0; j < order.length; j++) {
            var o = order[j], val = obj[o.key] || 0;
            if (val === 0 && !obj._showZero) continue;
            parts.push(
                '<div class="d-flex flex-wrap align-items-center gap-2 py-1 border-bottom border-light">' +
                '<span class="badge rounded-pill bg-' + o.cls + '-subtle text-' + o.cls + '">' + o.label + '</span>' +
                '<span class="fw-semibold ms-auto">' + MR.currencySymbol(o.key) + MR.moneyFmt.format(val) + '</span></div>'
            );
        }
        if ((obj._otra || 0) !== 0) {
            parts.push(
                '<div class="d-flex flex-wrap align-items-center gap-2 py-1">' +
                '<span class="badge rounded-pill bg-secondary-subtle text-secondary">Otra</span>' +
                '<span class="fw-semibold ms-auto">$ ' + MR.moneyFmt.format(obj._otra) + '</span></div>'
            );
        }
        return parts.length ? parts.join("") : '<span class="text-secondary small">Sin montos</span>';
    }

    function pct(n, total) {
        if (!total) return "0";
        var v = (n / total * 100);
        return v < 1 && v > 0 ? "< 1" : v.toFixed(0);
    }

    function escHtml(s) {
        return String(s || "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");
    }

    function aggregatePagos(rows) {
        var cobrado = { "1": 0, "3": 0, _otra: 0, _showZero: true };
        var facturas = {};
        var porTipoVenta = {};
        var porMedio = {};
        var total = rows.length;

        for (var i = 0; i < total; i++) {
            var r = rows[i];
            var m = String(r.monedaTipo != null ? r.monedaTipo : "").trim();
            if (m !== "1" && m !== "3") m = "_otra";
            var monto = MR.parseMoneyCell(r.monto);
            cobrado[m] = (cobrado[m] || 0) + monto;

            if (r.facturaId) facturas[r.facturaId] = true;

            var tv = r.tipoVentaDescripcion || "Sin dato";
            if (!porTipoVenta[tv]) porTipoVenta[tv] = { count: 0, "1": 0, "3": 0, _otra: 0 };
            porTipoVenta[tv].count++;
            porTipoVenta[tv][m] = (porTipoVenta[tv][m] || 0) + monto;

            var mp = r.pagoDescripcion || "Sin descripción";
            if (!porMedio[mp]) porMedio[mp] = { count: 0, "1": 0, "3": 0, _otra: 0 };
            porMedio[mp].count++;
            porMedio[mp][m] = (porMedio[mp][m] || 0) + monto;
        }

        return {
            cobrado: cobrado,
            totalPagos: total,
            facturasDistintas: Object.keys(facturas).length,
            porTipoVenta: porTipoVenta,
            porMedio: porMedio
        };
    }

    function renderGroupCard(groups, totalRows, containerId) {
        var arr = [];
        for (var k in groups) { if (groups.hasOwnProperty(k)) arr.push({ nombre: k, data: groups[k] }); }
        arr.sort(function (a, b) { return b.data.count - a.data.count; });

        var html = "";
        var limit = 6;
        var othersData = null;

        for (var i = 0; i < arr.length; i++) {
            var g = arr[i];
            if (i >= limit) {
                if (!othersData) othersData = { count: 0, "1": 0, "3": 0, _otra: 0 };
                othersData.count += g.data.count;
                othersData["1"] += g.data["1"];
                othersData["3"] += g.data["3"];
                othersData._otra += g.data._otra;
                continue;
            }
            html += renderGroupItem(g.nombre, g.data, totalRows);
        }
        if (othersData) {
            html += renderGroupItem("Otros", othersData, totalRows);
        }
        if (!html) html = '<span class="text-secondary small">Sin datos</span>';
        $(containerId).html(html);
    }

    function renderGroupItem(nombre, data, totalRows) {
        var h = '<div class="mb-2">';
        h += '<div class="d-flex justify-content-between align-items-center">';
        h += '<span class="small fw-semibold">' + escHtml(nombre) + '</span>';
        h += '<span class="small text-secondary">' + data.count + ' (' + pct(data.count, totalRows) + '%)</span>';
        h += '</div>';
        var barWidth = totalRows ? Math.max(2, data.count / totalRows * 100) : 0;
        h += '<div class="progress mt-1" style="height:5px">';
        h += '<div class="progress-bar bg-primary bg-opacity-75" style="width:' + barWidth.toFixed(1) + '%"></div>';
        h += '</div>';
        var monedas = { "1": data["1"] || 0, "3": data["3"] || 0, _otra: data._otra || 0 };
        var monedaParts = [];
        if (monedas["1"]) monedaParts.push('<span class="badge rounded-pill bg-success-subtle text-success me-1">$ARS</span>' + MR.currencySymbol("1") + MR.moneyFmt.format(monedas["1"]));
        if (monedas["3"]) monedaParts.push('<span class="badge rounded-pill bg-info-subtle text-info me-1">U$D</span>' + MR.currencySymbol("3") + MR.moneyFmt.format(monedas["3"]));
        if (monedas._otra) monedaParts.push('<span class="badge rounded-pill bg-secondary-subtle text-secondary me-1">Otra</span>$ ' + MR.moneyFmt.format(monedas._otra));
        if (monedaParts.length) {
            h += '<div class="small text-secondary mt-1 d-flex flex-wrap gap-2">' + monedaParts.join(" ") + '</div>';
        }
        h += '</div>';
        return h;
    }

    function renderIndicadoresPagos(rows) {
        var $box = $("#reportePagosIndicadores");
        if (!rows || rows.length === 0) { $box.addClass("d-none"); return; }
        var agg = aggregatePagos(rows);
        $("#kpiTotalCobrado").html(renderMonedaLines(agg.cobrado));
        $("#kpiTotalPagos").text(String(agg.totalPagos));
        $("#kpiFacturasDistintas").text(String(agg.facturasDistintas));
        renderGroupCard(agg.porTipoVenta, agg.totalPagos, "#kpiTipoVenta");
        renderGroupCard(agg.porMedio, agg.totalPagos, "#kpiMedioPago");
        $box.removeClass("d-none");
    }

    /* ── Tabla ───────────────────────────────────────────────────── */

    /* ── Render helpers para celdas ─────────────────────────────── */

    function renderTipoVentaBadge(val) {
        if (!val) return '<span class="badge bg-secondary-subtle text-secondary">-</span>';
        var lower = val.toLowerCase();
        var cls = "secondary";
        if (lower.indexOf("oficina") !== -1) cls = "primary";
        else if (lower.indexOf("online") !== -1) cls = "info";
        return '<span class="badge bg-' + cls + '-subtle text-' + cls + '">' + escHtml(val) + '</span>';
    }

    function renderMedioPagoBadge(val) {
        if (!val) return '<span class="text-muted small">-</span>';
        var lower = val.toLowerCase();
        var icon = "bi-credit-card";
        if (lower.indexOf("efect") !== -1) icon = "bi-cash-stack";
        else if (lower.indexOf("transfer") !== -1) icon = "bi-bank";
        else if (lower.indexOf("cheque") !== -1) icon = "bi-file-earmark-text";
        else if (lower.indexOf("tarjeta") !== -1 || lower.indexOf("débito") !== -1 || lower.indexOf("debito") !== -1) icon = "bi-credit-card-2-front";
        return '<span class="text-nowrap"><i class="bi ' + icon + ' text-secondary me-1"></i>' + escHtml(val) + '</span>';
    }

    function renderRank(val) {
        if (val == null || val === "") return '<span class="text-muted">-</span>';
        var n = parseInt(val, 10);
        if (isNaN(n)) return escHtml(String(val));
        if (n === 1) return '<span class="badge bg-warning-subtle text-warning fw-bold">#1</span>';
        if (n === 2) return '<span class="badge bg-secondary-subtle text-secondary fw-bold">#2</span>';
        if (n === 3) return '<span class="badge bg-danger-subtle text-danger fw-bold">#3</span>';
        return '<span class="text-muted small">#' + n + '</span>';
    }

    /* Índices de columna para filtros front — deben coincidir con el orden de columns[] */
    var COL_MEDIO    = 3;
    var COL_VENDEDOR = 7;
    var COL_CLIENTE  = 8;

    function renderTable(rows) {
        renderIndicadoresPagos(rows);
        var $tbl = $("#tblReporte");
        if (dt) { dt.destroy(); $tbl.empty(); }
        dt = $tbl.DataTable({
            data: rows || [],
            columns: [
                { data: "fechaPago", title: "Fecha pago",
                  render: function (d) { return window.MatReportes.formatFechaES(d); } },
                { data: "monto", title: "Monto", className: "text-end",
                  render: function (d, type, row) { return MR.renderMontoCurrency(d, row.monedaTipo, type); } },
                { data: "monedaTipo", title: "Mon.",
                  render: function (d, type) {
                      return type !== "display" ? (d || "") : MR.renderMonedaBadge(d);
                  } },
                { data: "pagoDescripcion", title: "Medio de pago",
                  render: function (d, type) {
                      if (type !== "display") return d || "";
                      return renderMedioPagoBadge(d);
                  } },
                { data: "tipoVentaDescripcion", title: "Tipo venta",
                  render: function (d, type) {
                      if (type !== "display") return d || "";
                      return renderTipoVentaBadge(d);
                  } },
                { data: "cantidadTipoPago", title: "Cant.", visible: false },
                { data: "rankingTipoPago", title: "Rank.", visible: false },
                { data: "vendedorFullName", title: "Vendedor" },
                { data: "clienteFullName",  title: "Cliente" },
                { data: "viaje", title: "Viaje",
                  render: function (d, type) {
                      if (type !== "display") return d || "";
                      var esc = escHtml(d);
                      return '<span class="text-truncate d-inline-block" style="max-width:220px" title="' + esc + '">' + (esc || "-") + '</span>';
                  } },
                { data: "facturaId", title: "Factura", visible: false }
            ],
            pageLength: 25,
            autoWidth: false,
            language: $.extend(
                { url: "/Scripts/dataTable/i18n/Spanish.json" },
                MR.dataTableEmptyLanguage(
                    "No hay pagos para este filtro",
                    "Probá otro rango de fechas o un viaje distinto"
                )
            )
        });
        $("#filtroFront").toggleClass("d-none", !rows || rows.length === 0);
        limpiarFiltros();
    }

    function limpiarFiltros() {
        $("#filtVendedor,#filtCliente,#filtTipoPago").val("");
        if (dt) {
            dt.columns(COL_VENDEDOR).search("")
              .columns(COL_CLIENTE).search("")
              .columns(COL_MEDIO).search("").draw();
        }
    }

    $('input[name="modoFiltro"]').on("change", syncGrupos);
    syncGrupos();

    $("#btnBuscar").on("click", function () {
        showErr("");
        var $btn = $("#btnBuscar");
        var $tableWrap = $(".modern-table-container").first();
        if (window.MatAdmin) {
            MatAdmin.showLoading($btn[0]);
            if ($tableWrap.length) MatAdmin.showLoading($tableWrap[0], { mode: "overlay", text: "Consultando..." });
        }
        $.getJSON(urlJson, queryParams())
            .done(function (res) {
                if (!res.ok) { showErr(res.message || "Error"); return; }
                renderTable(res.data);
            })
            .fail(function (xhr) { showErr(window.MatReportes.parseHttpErrorBody(xhr)); })
            .always(function () {
                if (window.MatAdmin) {
                    MatAdmin.hideLoading($btn[0]);
                    if ($tableWrap.length) MatAdmin.hideLoading($tableWrap[0]);
                }
            });
    });

    $("#btnExcel").on("click", function () {
        window.MatReportes.downloadReporteExcel(urlExcel, queryParams, showErr);
    });

    $("#filtVendedor").on("input", function () {
        if (dt) dt.columns(COL_VENDEDOR).search($(this).val()).draw();
    });
    $("#filtCliente").on("input", function () {
        if (dt) dt.columns(COL_CLIENTE).search($(this).val()).draw();
    });
    $("#filtTipoPago").on("input", function () {
        if (dt) dt.columns(COL_MEDIO).search($(this).val()).draw();
    });
    $("#btnLimpiarFiltro").on("click", limpiarFiltros);
});
</script>
}
