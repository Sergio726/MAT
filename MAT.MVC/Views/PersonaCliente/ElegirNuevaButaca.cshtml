@*@model List<MAT.MVC.Models.PasajeModel>*@
@model List<MAT.MVC.Models.ReservaStandard>
@using MAT.MVC.Models
@using MAT.Enums
@{
    ViewBag.Title = "Elegir Nueva Butaca";
}

<input type="hidden" id="hdnCambiarButaca" value="true" />
<div class="oculto">
    Id Pasajero:
    <input type="text" id="id_pasajero" />
    Id Viaje:
    <input type="text" id="id_viaje" value="@Model.First().ViajeId" />
    Id Pasaje:
    <input type="text" id="id_pasaje" value="@ViewData["pasajeid"]" />
    Id Anterior:
    <input type="text" id="id_anterior" value="@ViewData["anteriorid"]" />
    Id Paquete:
    <input type="text" id="id_paquete" value="@Model.First().PaqueteID" />
</div>


<section id="panel-bus" class="custom_display_box">
    <div id="container">
        @*MINIBUS*@
        @if (Model.Count() <= 24)
        {
            <div id="coche_minibus" data-id="@Model.First().TransporteID" data-numero="@Model.First().TransporteNroCoche">
                <div id="bus-tabs" class="scroll_x">
                    <ul>
                        <li><a href="#tabs-1">Piso Superior</a></li>
                    </ul>
                    <div id="tabs-1">
                        <h2>MINI BUS</h2>
                        <ul class="piso_superior_edicion">
                            
                            <li class="tv1">TV</li>
                         
                             @foreach (ReservaStandard pasaje in Model.Where(p => p.ButacaPiso == 1))
                             {
                                 if (pasaje.PasajeroId != null)
                                 {
                                     string sPosition = "top";
                                     if (pasaje.ButacaPosicion == "A")
                                     {
                                         sPosition = "bottom";
                                     }
                                     <li class="seat_@pasaje.ButacaFila @pasaje.ButacaPosicion"><a href="#row_@pasaje.ButacaFila" id="@pasaje.PasajeId" data-piso="@pasaje.ButacaPiso" data-estado="@pasaje.EstadoPasaje" title="@pasaje.PasajeroNombre @pasaje.PasajeroApellido" data-toggle="tooltip" data-placement="@sPosition" data-pasajero="@pasaje.PasajeroId" data-precio="" data-adicionales="">@pasaje.ButacaCodigoButaca</a></li>    
                                     
                                     
                                 }
                                 else
                                 {
                                    <li class="seat_@pasaje.ButacaFila @pasaje.ButacaPosicion"><a href="#row_@pasaje.ButacaFila" id="@pasaje.PasajeId" data-piso="@pasaje.ButacaPiso" data-estado="@pasaje.EstadoPasaje" title="@pasaje.ButacaCodigoButaca" data-pasajero="" data-precio="" data-adicionales="">@pasaje.ButacaCodigoButaca</a></li>   
                                 }

                             }
                        </ul>
                    </div>
                   
                </div>

            </div>
        }
        else
        { 
            <div id="coche51_61" data-id="@Model.First().TransporteID" data-numero="@Model.First().TransporteNroCoche">
            <div id="bus-tabs">
                <ul>
                    <li><a href="#tabs-1">Piso Superior</a></li>
                    <li><a href="#tabs-2">Piso Inferior</a></li>
                </ul>
                <div id="tabs-1">
                    <h2>PISO SUPERIOR SEMI CAMA</h2>
                    <ul class="piso_superior_edicion">
                        <li class="escalera">ESCALERA</li>
                        <li class="bar">BAR</li>
                        <li class="tv1">TV</li>
                        <li class="tv2">TV</li>
                        <li class="tv3">TV</li>
                        <li class="tv4">TV</li>
                        @foreach (ReservaStandard pasaje in Model.Where(p => p.ButacaPiso == 1))
                        {
                            if (pasaje.PasajeroId != null)
                            {
                            <li class="seat_@pasaje.ButacaFila @pasaje.ButacaPosicion"><a href="#row_@pasaje.ButacaFila" id="@pasaje.PasajeId" data-piso="@pasaje.ButacaPiso" data-estado="@pasaje.EstadoPasaje" title="@pasaje.ButacaCodigoButaca" data-pasajero="@pasaje.PasajeroId" data-precio="" data-adicionales="">@pasaje.ButacaCodigoButaca</a></li>    
                            }
                            else
                            {
                            <li class="seat_@pasaje.ButacaFila @pasaje.ButacaPosicion"><a href="#row_@pasaje.ButacaFila" id="@pasaje.PasajeId" data-piso="@pasaje.ButacaPiso" data-estado="@pasaje.EstadoPasaje" title="@pasaje.ButacaCodigoButaca" data-pasajero="" data-precio="" data-adicionales="">@pasaje.ButacaCodigoButaca</a></li>   
                            }

                        }
                    </ul>
                </div>
                <div id="tabs-2">
                    <h2>PISO INFERIOR CAMA</h2>
                    <!--<ul class="piso_inferior_edicion">-->
                     <ul class="piso_inferior_edicion">
                        <li class="escalera">ESCALERA</li>
                        <li class="bar">BAR</li>
                        <li class="banio">BAÑO</li>
                        <li class="tv1">TV</li>
                        @foreach (ReservaStandard pasaje in Model.Where(p => p.ButacaPiso == 2))
                        {
                            <li class="seat_@pasaje.ButacaFila @pasaje.ButacaPosicion"><a href="#row_@pasaje.ButacaFila" id="@pasaje.PasajeId" data-piso="@pasaje.ButacaPiso" data-estado="@pasaje.EstadoPasaje" title="@pasaje.ButacaCodigoButaca" data-pasajero="" data-precio="" data-adicionales="">@pasaje.ButacaCodigoButaca</a></li>
                        }
                    </ul>
                </div>
            </div>

        </div>
        }
        
    </div>
   @* <div class="custom_width_25percent custom_margin_left_10">
        <span class="required">* Si el pasaje tiene una habitacion reservada, esta sera dada de baja al cambiar de butaca.</span>
    </div>*@
</section>


 <script type="text/javascript">
                
                $(function () {
                    $("#bus-tabs").tabs();
                    $("#panel-bus a").each(function () {
                        var estado = parseInt($(this).data("estado"));
                        if (estado == 1) {
                            $(this).addClass("disponible");
                        } else if (estado == 2 || estado == 3) {
                            $(this).removeClass("disponible");
                            $(this).addClass("señado");
                        } else if (estado == 4) {
                            $(this).removeClass("disponible");
                            $(this).addClass("reservado");
                        } else if (estado == 5) {
                            $(this).removeClass("disponible");
                            $(this).addClass("prereserva");
                        } else if (estado == 6) {
                            $(this).removeClass("disponible");
                            $(this).addClass("reservahotel");
                        } else if (estado == 8) {
                            $(this).removeClass("disponible");
                            $(this).addClass("reservapasajehotel");
                        } else if (estado == 9) {
                            $(this).removeClass("disponible");
                            $(this).addClass("prereservahotel");
                        }
                    });
                });
            </script>