@model List<MAT.MVC.Models.PaquetePrecio>
@if (ViewBag.Error != null)
{
    <div class="modern-alert-error"><i class="bi bi-exclamation-circle"></i><span>@ViewBag.Error</span></div>    
}
else
{
    <div class="modern-card" style="padding: 1.5rem;">
        <div class="modern-form-group">
            @foreach (MAT.MVC.Models.PaquetePrecio item in Model)
            {
                <label class="modern-form-radio-label" style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 0.75rem;">
                    <input type="radio" name="precio" value="@item.PrecioID"/>
                    <span>@item.Descripcion.ToString()</span>
                </label>
            }
        </div>
        <div class="modern-form-actions" style="margin-top: 1rem; justify-content: flex-end;">
            <button type="button" class="btn-modern btn-modern-primary" id="btnCambiarPrecio" onclick="fnSetPrecio('@ViewBag.DetalleFacturaId');">
                <i class="bi bi-tag"></i>
                <span>Cambiar Precio</span>
            </button>
        </div>
    </div>
    <script type="text/javascript">
        function fnSetPrecio(DetalleFacturaId) {
            var PrecioSelected = $("input[name='precio']:checked").val();
            $.ajax({
                url: "/PersonaCliente/DetalleFacturaSetPrecio",
                data: {
                    DetalleFacturaId: DetalleFacturaId,
                    PrecioId: PrecioSelected
                },
                success: function (data) {
                    if (data[0] == "Done.") {
                        PopupDetalleFactura_Load();
                        $("#PopinPrecioList").dialog("close");
                    }
                    else {
                        (window.alertError || window.alert)("Se produjo un error. Contáctese con el administrador.", "Error");
                        console.log(data[1]);
                    }
                                        
                },
                error: function (e) {
                    (window.alertError || window.alert)("Se produjo un error. Contáctese con el administrador.", "Error");
                    console.log(e);
                }
            })
        }
    </script>
}