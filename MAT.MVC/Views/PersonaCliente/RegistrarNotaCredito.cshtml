@using MAT.Entities
@using MAT.MVC.Models
@model NotaCreditoModel

@if (ViewBag.Error != null)
{
    <script type="text/javascript">
        console.log("@ViewBag.Error");
    </script>
    return;
}
<div class="modal-form mat-nc">
    <form id="formNotaCredito" class="modal-form" autocomplete="off">
        <div class="mat-nc-summary">
            <div class="mat-nc-summary-card">
                <div class="mat-nc-summary-label">
                    <i class="bi bi-calendar-event"></i>
                    Días restantes a la salida
                </div>
                <div class="mat-nc-summary-value text-brand">@Model.Dias días</div>
            </div>

            <div class="mat-nc-summary-card">
                <div class="mat-nc-summary-label">
                    <i class="bi bi-receipt"></i>
                    Total de factura
                </div>
                <div class="mat-nc-summary-value">@string.Format("{0:C}", ViewBag.MontoFactura)</div>
            </div>

            <div class="mat-nc-summary-card">
                <div class="mat-nc-summary-label">
                    <i class="bi bi-cash-stack"></i>
                    Total de pagos
                </div>
                <div class="mat-nc-summary-value text-success">@string.Format("{0:C}", ViewBag.TotalPagos)</div>
            </div>
        </div>

        <div class="modal-form-row">
            <div class="modal-form-group">
                <label class="modal-form-label" for="NroNota">
                    <i class="bi bi-hash me-1 text-brand"></i>
                    N° de nota <span class="text-danger">*</span>
                </label>
                <input type="text" id="NroNota" name="NroNota" class="modal-form-control" placeholder="Ingrese número de nota" />
                <div class="mat-field-error" data-for="NroNota"></div>
            </div>

            <div class="modal-form-group">
                <label class="modal-form-label" for="MontoNota">
                    <i class="bi bi-currency-dollar me-1 text-brand"></i>
                    Monto de nota de crédito <span class="text-danger">*</span>
                </label>
                <input type="text" id="MontoNota" name="MontoNota" class="modal-form-control money" value="@String.Format("{0:N2}", Model.MontoNota)" />
                <div class="mat-field-error" data-for="MontoNota"></div>
            </div>
        </div>

        <div class="modal-form-row">
            <div class="modal-form-group">
                <label class="modal-form-label" for="MontoRetencion">
                    <i class="bi bi-percent me-1 text-brand"></i>
                    Monto a retener <span class="text-danger">*</span>
                </label>
                <input type="text" id="MontoRetencion" name="MontoRetencion" class="modal-form-control money" value="@String.Format("{0:N2}", Model.MontoRetencion)" />
                <div class="mat-field-error" data-for="MontoRetencion"></div>
            </div>
        </div>

        <div class="modal-form-row">
            <div class="modal-form-group mat-nc-full">
                <label class="modal-form-label" for="DetalleNotaCredito">
                    <i class="bi bi-card-text me-1 text-brand"></i>
                    Detalle <span class="text-danger">*</span>
                </label>
                <textarea id="DetalleNotaCredito" name="Detalle" class="modal-form-control" rows="4" placeholder="Ingrese el detalle de la nota de crédito..."></textarea>
                <div class="mat-field-error" data-for="DetalleNotaCredito"></div>
            </div>
        </div>

        <input type="hidden" value="@Model.Dias" id="Dias" name="Dias" />
        <input type="hidden" value="@Model.ClienteID" id="ClienteID" name="ClienteID" />
        <input type="hidden" value="@ViewBag.FacturaID" id="FacturaID" name="FacturaID" />
        <input type="hidden" value="@ViewBag.TotalPagos" id="hdnTotalPagos" name="hdnTotalPagos" />
    </form>

    <div class="modal-form-actions">
        <button type="button" id="btn-retencion" class="btn btn-primary">
            <i class="bi bi-check-lg"></i>
            Aceptar
        </button>
        <button type="button" id="btn-retencion-cancelar" class="btn btn-secondary">
            <i class="bi bi-x-lg"></i>
            Cancelar
        </button>
    </div>
</div>
