@using MAT.Entities
@using MAT.MVC.Models
@model NotaCreditoModel

@if (ViewBag.Error != null)
{
    <div class="mat-nc mat-nc-error-state">
        <div class="mat-nc-error-icon">
            <i class="bi bi-exclamation-circle"></i>
        </div>
        <p class="mat-nc-error-message">@ViewBag.Error</p>
        <p class="mat-nc-error-hint">Puede emitir una nota de crédito cuando el pasajero decide no viajar o alguno de los pasajeros de la factura no viaja, siempre que el viaje haya sido pagado en su totalidad.</p>
        <div class="mat-nc-actions">
            <button type="button" id="btn-notacredito-cerrar" class="mat-nc-btn mat-nc-btn-secondary">
                <i class="bi bi-x-lg"></i>
                Cerrar
            </button>
        </div>
    </div>
    return;
}

<style>
    /* ============================================================
       NOTA DE CRÉDITO - Modal Rediseñado
       ============================================================ */
    .mat-nc {
        padding: 0;
        font-family: inherit;
    }

    /* Header con resumen */
    .mat-nc-header {
        display: flex;
        align-items: stretch;
        gap: 0.75rem;
        background: #f8fafc;
        border-bottom: 1px solid #e5e7eb;
        padding: 0.875rem 1rem;
        margin: -1rem -1rem 1rem -1rem;
    }
    .mat-nc-header-item {
        flex: 1;
        display: flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.5rem 0.75rem;
        background: white;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
    }
    .mat-nc-header-icon {
        width: 1.75rem;
        height: 1.75rem;
        background: rgba(233, 30, 99, 0.1);
        border-radius: 0.375rem;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--primary-color, #e91e63);
        font-size: 0.8125rem;
    }
    .mat-nc-header-data {
        flex: 1;
    }
    .mat-nc-header-label {
        font-size: 0.625rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
    }
    .mat-nc-header-value {
        font-size: 0.9375rem;
        font-weight: 700;
        color: #1e293b;
    }

    /* Información del viaje */
    .mat-nc-viaje {
        padding: 0.625rem 0.75rem;
        margin-bottom: 1rem;
        background: #f1f5f9;
        border: 1px solid #e2e8f0;
        border-radius: 0.5rem;
    }
    .mat-nc-viaje-title {
        font-size: 0.6875rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
        color: #64748b;
        margin-bottom: 0.5rem;
    }
    .mat-nc-viaje-title i { color: var(--primary-color, #e91e63); margin-right: 0.25rem; }
    .mat-nc-viaje-row { display: flex; flex-wrap: wrap; gap: 1rem; }
    .mat-nc-viaje-item { display: flex; flex-direction: column; gap: 0.125rem; }
    .mat-nc-viaje-label { font-size: 0.6875rem; color: #64748b; }
    .mat-nc-viaje-value { font-size: 0.875rem; font-weight: 600; color: #1e293b; }

    /* Sección de montos */
    .mat-nc-montos {
        display: flex;
        gap: 0.75rem;
        margin-bottom: 1rem;
    }
    .mat-nc-monto {
        flex: 1;
        padding: 0.875rem;
        border-radius: 0.5rem;
        border: 1px solid;
    }
    .mat-nc-monto.credito {
        background: #f0fdf4;
        border-color: #86efac;
    }
    .mat-nc-monto.retencion {
        background: #fef2f2;
        border-color: #fca5a5;
    }
    .mat-nc-monto.devolucion {
        background: #eff6ff;
        border-color: #93c5fd;
    }
    .mat-nc-monto-header {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 0.625rem;
    }
    .mat-nc-monto-icon {
        width: 1.5rem;
        height: 1.5rem;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 0.6875rem;
        color: white;
        flex-shrink: 0;
    }
    .mat-nc-monto.credito .mat-nc-monto-icon { background: #16a34a; }
    .mat-nc-monto.retencion .mat-nc-monto-icon { background: #dc2626; }
    .mat-nc-monto.devolucion .mat-nc-monto-icon { background: #2563eb; }
    .mat-nc-monto-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: #374151;
    }
    .mat-nc-monto-badge {
        margin-left: auto;
        font-size: 0.625rem;
        padding: 0.1875rem 0.5rem;
        border-radius: 0.25rem;
        font-weight: 600;
        flex-shrink: 0;
    }
    .mat-nc-monto.credito .mat-nc-monto-badge {
        background: #dcfce7;
        color: #166534;
    }
    .mat-nc-monto.retencion .mat-nc-monto-badge {
        background: #fee2e2;
        color: #991b1b;
    }
    .mat-nc-monto.devolucion .mat-nc-monto-badge {
        background: #dbeafe;
        color: #1e40af;
    }
    .mat-nc-monto-input {
        width: 100%;
        padding: 0.5rem 0.625rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        font-size: 0.9375rem;
        font-weight: 600;
        color: #1e293b;
        background: white;
        text-align: right;
    }
    .mat-nc-monto-input:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 2px rgba(233, 30, 99, 0.15);
    }
    .mat-nc-monto-hint {
        margin-top: 0.375rem;
        font-size: 0.6875rem;
        color: #64748b;
    }

    /* Campo de detalle */
    .mat-nc-detalle {
        margin-bottom: 0.875rem;
    }
    .mat-nc-detalle-label {
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        color: #374151;
        margin-bottom: 0.375rem;
    }
    .mat-nc-detalle-label i {
        color: var(--primary-color, #e91e63);
        margin-right: 0.25rem;
    }
    .mat-nc-detalle-input {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid #d1d5db;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        color: #1e293b;
        resize: none;
        height: 60px;
        box-sizing: border-box;
    }
    .mat-nc-detalle-input:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 2px rgba(233, 30, 99, 0.15);
    }
    .mat-nc-detalle-input::placeholder {
        color: #9ca3af;
    }

    /* Card de instrucciones */
    .mat-nc-info {
        background: #fffbeb;
        border: 1px solid #fcd34d;
        border-radius: 0.5rem;
        padding: 0.625rem 0.75rem;
        margin-bottom: 0.75rem;
    }
    .mat-nc-info-title {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: #92400e;
        margin-bottom: 0.375rem;
    }
    .mat-nc-info-title i {
        color: var(--primary-color, #e91e63);
    }
    .mat-nc-info-list {
        margin: 0;
        padding-left: 1.125rem;
        font-size: 0.75rem;
        color: #78350f;
        line-height: 1.5;
    }
    .mat-nc-info-list li {
        margin-bottom: 0.125rem;
    }

    /* Acciones del modal */
    .mat-nc-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding-top: 0.75rem;
        border-top: 1px solid #e5e7eb;
    }
    .mat-nc-btn {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 1rem;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 600;
        cursor: pointer;
        border: none;
        transition: all 0.15s ease;
    }
    .mat-nc-btn-primary {
        background: var(--primary-color, #e91e63);
        color: white;
    }
    .mat-nc-btn-primary:hover {
        background: #c2185b;
    }
    .mat-nc-btn-secondary {
        background: #f3f4f6;
        color: #374151;
        border: 1px solid #d1d5db;
    }
    .mat-nc-btn-secondary:hover {
        background: #e5e7eb;
    }

    /* Estado de error */
    .mat-nc-error-state {
        text-align: center;
        padding: 2rem 1.5rem;
    }
    .mat-nc-error-icon {
        font-size: 3rem;
        color: #f59e0b;
        margin-bottom: 1rem;
    }
    .mat-nc-error-message {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        margin: 0 0 0.5rem 0;
    }
    .mat-nc-error-hint {
        font-size: 0.875rem;
        color: #6b7280;
        margin: 0 0 1.5rem 0;
        line-height: 1.5;
    }

    /* Errores de validación */
    .mat-nc .mat-field-error {
        font-size: 0.6875rem;
        color: #dc2626;
        margin-top: 0.25rem;
        min-height: 0.875rem;
    }
    .mat-nc .mat-nc-monto-input.is-invalid {
        border-color: #dc2626 !important;
        box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.15) !important;
    }
    .mat-nc .mat-nc-detalle-input.is-invalid {
        border-color: #dc2626 !important;
        box-shadow: 0 0 0 2px rgba(220, 38, 38, 0.15) !important;
    }

    /* Barra de estado: suma Crédito + Retenido + Devolución */
    .mat-nc-status-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding: 0.625rem 0.75rem;
        margin-bottom: 1rem;
        border-radius: 0.5rem;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        font-size: 0.8125rem;
    }
    .mat-nc-status-bar .mat-nc-status-label {
        font-weight: 600;
        color: #64748b;
    }
    .mat-nc-status-bar .mat-nc-status-sum {
        font-weight: 700;
        color: #1e293b;
    }
    .mat-nc-status-bar .mat-nc-status-sep {
        color: #94a3b8;
        font-weight: 500;
    }
    .mat-nc-status-bar .mat-nc-status-total {
        font-weight: 600;
        color: #475569;
    }
    .mat-nc-status-bar .mat-nc-status-msg {
        margin-left: auto;
        font-size: 0.75rem;
        font-weight: 600;
    }
    .mat-nc-status-bar.mat-nc-status-ok {
        background: #f0fdf4;
        border-color: #86efac;
    }
    .mat-nc-status-bar.mat-nc-status-ok .mat-nc-status-msg {
        color: #166534;
    }
    .mat-nc-status-bar.mat-nc-status-error {
        background: #fef2f2;
        border-color: #fca5a5;
    }
    .mat-nc-status-bar.mat-nc-status-error .mat-nc-status-msg {
        color: #991b1b;
    }
    .mat-nc-status-bar.mat-nc-status-pending .mat-nc-status-msg {
        color: #92400e;
    }

    /* Responsive */
    @@media (max-width: 600px) {
        .mat-nc-header {
            flex-direction: column;
        }
        .mat-nc-montos {
            flex-direction: column;
        }
    }

    /* Ajuste del dialog - más ancho */
    .ui-dialog[aria-describedby="NotaCredito"] {
        min-width: 580px !important;
    }
    .ui-dialog[aria-describedby="NotaCredito"] .ui-dialog-content {
        padding: 1rem !important;
    }
    .ui-dialog[aria-describedby="NotaCredito"] .ui-dialog-titlebar {
        background: white !important;
        border: none !important;
        border-bottom: 1px solid #e5e7eb !important;
        padding: 0.75rem 1rem !important;
    }
    .ui-dialog[aria-describedby="NotaCredito"] .ui-dialog-title {
        color: var(--primary-color, #e91e63) !important;
        font-weight: 700 !important;
        font-size: 1rem !important;
    }
    .ui-dialog[aria-describedby="NotaCredito"] .ui-dialog-title span {
        color: #6b7280 !important;
        font-weight: 500 !important;
    }
    .ui-dialog[aria-describedby="NotaCredito"] .ui-dialog-titlebar-close {
        color: #6b7280 !important;
        opacity: 1 !important;
    }
    .ui-dialog[aria-describedby="NotaCredito"] .ui-dialog-titlebar-close:hover {
        color: var(--primary-color, #e91e63) !important;
    }
</style>

<div class="mat-nc" data-nronota="@(Model.NroNota ?? "")">
    <form id="formNotaCredito" autocomplete="off">
        <!-- Header con resumen -->
        <div class="mat-nc-header">
            <div class="mat-nc-header-item">
                <div class="mat-nc-header-icon">
                    <i class="bi bi-receipt"></i>
                </div>
                <div class="mat-nc-header-data">
                    <div class="mat-nc-header-label">Total Factura</div>
                    <div class="mat-nc-header-value">@string.Format("{0:C}", ViewBag.MontoFactura)</div>
                </div>
            </div>
            <div class="mat-nc-header-item">
                <div class="mat-nc-header-icon">
                    <i class="bi bi-check-circle"></i>
                </div>
                <div class="mat-nc-header-data">
                    <div class="mat-nc-header-label">Total Pagado</div>
                    <div class="mat-nc-header-value">@string.Format("{0:C}", ViewBag.TotalPagos)</div>
                </div>
            </div>
            <div class="mat-nc-header-item">
                <div class="mat-nc-header-icon">
                    <i class="bi bi-calendar-event"></i>
                </div>
                <div class="mat-nc-header-data">
                    <div class="mat-nc-header-label">Días para salida</div>
                    <div class="mat-nc-header-value">@Model.Dias días</div>
                </div>
            </div>
        </div>

        @if (Model.ViajeFecha.HasValue || !string.IsNullOrEmpty(Model.ViajeNombre))
        {
        <!-- Información del viaje -->
        <div class="mat-nc-viaje">
            <div class="mat-nc-viaje-title"><i class="bi bi-geo-alt"></i> Viaje asociado</div>
            <div class="mat-nc-viaje-row">
                @if (!string.IsNullOrEmpty(Model.ViajeNombre))
                {
                    <div class="mat-nc-viaje-item">
                        <span class="mat-nc-viaje-label">Nombre</span>
                        <span class="mat-nc-viaje-value">@Model.ViajeNombre</span>
                    </div>
                }
                @if (Model.ViajeFecha.HasValue)
                {
                    <div class="mat-nc-viaje-item">
                        <span class="mat-nc-viaje-label">Fecha salida</span>
                        <span class="mat-nc-viaje-value">@Model.ViajeFecha.Value.ToString("dd/MM/yyyy")</span>
                    </div>
                }
            </div>
        </div>
        }

        <!-- Montos -->
        <div class="mat-nc-montos">
            <div class="mat-nc-monto credito">
                <div class="mat-nc-monto-header">
                    <div class="mat-nc-monto-icon"><i class="bi bi-piggy-bank"></i></div>
                    <span class="mat-nc-monto-label">Crédito</span>
                    <span class="mat-nc-monto-badge">@string.Format("{0:P0}", ViewBag.PorcentajeCreditoSugerido ?? 0)</span>
                </div>
                <input type="text" id="MontoNota" name="MontoNota" class="mat-nc-monto-input money" value="@String.Format("{0:N2}", Model.MontoNota)" placeholder="$0,00" />
                <div class="mat-field-error" data-for="MontoNota"></div>
                <div class="mat-nc-monto-hint">Para futuras compras</div>
            </div>

            <div class="mat-nc-monto retencion">
                <div class="mat-nc-monto-header">
                    <div class="mat-nc-monto-icon"><i class="bi bi-dash-circle"></i></div>
                    <span class="mat-nc-monto-label">Retenido</span>
                    <span class="mat-nc-monto-badge">@string.Format("{0:P0}", ViewBag.PorcentajeRetencionSugerido ?? 0)</span>
                </div>
                <input type="text" id="MontoRetencion" name="MontoRetencion" class="mat-nc-monto-input money" value="@String.Format("{0:N2}", Model.MontoRetencion)" placeholder="$0,00" />
                <div class="mat-field-error" data-for="MontoRetencion"></div>
                <div class="mat-nc-monto-hint">Gastos operativos</div>
            </div>

            <div class="mat-nc-monto devolucion">
                <div class="mat-nc-monto-header">
                    <div class="mat-nc-monto-icon"><i class="bi bi-cash"></i></div>
                    <span class="mat-nc-monto-label">Devolución</span>
                    <span class="mat-nc-monto-badge">Opcional</span>
                </div>
                <input type="text" id="MontoDevolucion" name="MontoDevolucion" class="mat-nc-monto-input money" value="@String.Format("{0:N2}", Model.MontoDevolucion)" placeholder="$0,00" />
                <div class="mat-field-error" data-for="MontoDevolucion"></div>
                <div class="mat-nc-monto-hint">Dinero al cliente</div>
            </div>
        </div>

        <!-- Barra de estado: suma en tiempo real -->
        <div class="mat-nc-status-bar mat-nc-status-pending" id="matNcStatusBar" role="status" aria-live="polite">
            <span class="mat-nc-status-label">Distribución:</span>
            <span class="mat-nc-status-sum" id="matNcStatusSum">$ 0,00</span>
            <span class="mat-nc-status-sep">/</span>
            <span class="mat-nc-status-total" id="matNcStatusTotal">$ 0,00</span>
            <span class="mat-nc-status-msg" id="matNcStatusMsg">La suma debe coincidir con el total disponible</span>
        </div>

        <!-- Detalle -->
        <div class="mat-nc-detalle">
            <label class="mat-nc-detalle-label" for="DetalleNotaCredito">
                <i class="bi bi-card-text"></i>
                Detalle de la nota <span style="color: #dc2626;">*</span>
            </label>
            <textarea id="DetalleNotaCredito" name="Detalle" class="mat-nc-detalle-input" placeholder="Ej: Cancelación por motivos personales..."></textarea>
            <div class="mat-field-error" data-for="DetalleNotaCredito"></div>
        </div>

        <!-- Info -->
        <div class="mat-nc-info">
            <div class="mat-nc-info-title">
                <i class="bi bi-lightbulb"></i>
                Cómo usar el crédito
            </div>
            <ul class="mat-nc-info-list">
                <li>El crédito puede usarse como forma de pago en futuras reservas.</li>
                <li>Al registrar un pago, seleccione <strong>Nota de Crédito</strong> como forma de pago.</li>
            </ul>
        </div>

        <input type="hidden" value="@Model.Dias" id="Dias" name="Dias" />
        <input type="hidden" value="@Model.ClienteID" id="ClienteID" name="ClienteID" />
        <input type="hidden" value="@ViewBag.FacturaID" id="FacturaID" name="FacturaID" />
        <input type="hidden" value="@ViewBag.TotalPagos" id="hdnTotalPagos" name="hdnTotalPagos" />
        <input type="hidden" value="@ViewBag.MontoFactura" id="hdnMontoFactura" name="hdnMontoFactura" />
        <input type="hidden" id="NroNota" name="NroNota" value="@(Model.NroNota ?? "")" />
    </form>

    <!-- Acciones -->
    <div class="mat-nc-actions">
        <button type="button" id="btn-retencion-cancelar" class="mat-nc-btn mat-nc-btn-secondary">
            <i class="bi bi-x-lg"></i>
            Cancelar
        </button>
        <button type="button" id="btn-retencion" class="mat-nc-btn mat-nc-btn-primary">
            <i class="bi bi-check-lg"></i>
            Generar Nota
        </button>
    </div>
</div>

<script type="text/javascript">
    (function() {
        // Actualizar título del dialog con el número de nota
        var nroNota = "@Html.Raw(Model.NroNota ?? "")";
        var $dialog = $("#NotaCredito").closest(".ui-dialog");
        if ($dialog.length && nroNota) {
            var $title = $dialog.find(".ui-dialog-title");
            if ($title.length) {
                $title.html('Nota de Crédito <span style="opacity:0.8;font-weight:400;margin-left:0.5rem;">#' + nroNota + '</span>');
            }
        }

        // Barra de estado: actualizar suma al cambiar Crédito, Retenido o Devolución
        function parseMoneyVal(val) {
            var s = (val == null ? "" : String(val)).trim();
            s = s.replace(/[^\d,.\-]/g, "");
            s = s.replace(/\./g, "").replace(",", ".");
            var n = parseFloat(s);
            return isNaN(n) ? 0 : n;
        }
        function updateNotaCreditoStatusBar() {
            var $bar = $("#matNcStatusBar");
            var $sum = $("#matNcStatusSum");
            var $total = $("#matNcStatusTotal");
            var $msg = $("#matNcStatusMsg");
            if (!$bar.length) return;
            var totalPagos = parseMoneyVal($("#hdnTotalPagos").val());
            var totalFactura = parseMoneyVal($("#hdnMontoFactura").val());
            var totalDisponible = totalPagos > 0 ? totalPagos : totalFactura;
            var montoNota = parseMoneyVal($("#MontoNota").val());
            var montoRetencion = parseMoneyVal($("#MontoRetencion").val());
            var montoDevolucion = parseMoneyVal($("#MontoDevolucion").val());
            var suma = montoNota + montoRetencion + montoDevolucion;
            var totalFormatted = (typeof formatNumberMoney === "function") ? formatNumberMoney(totalDisponible) : "$ " + totalDisponible.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            var sumFormatted = (typeof formatNumberMoney === "function") ? formatNumberMoney(suma) : "$ " + suma.toLocaleString("es-AR", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            $sum.text(sumFormatted);
            $total.text(totalFormatted);
            $bar.removeClass("mat-nc-status-ok mat-nc-status-error mat-nc-status-pending");
            if (totalDisponible <= 0) {
                $bar.addClass("mat-nc-status-pending");
                $msg.text("Total no disponible");
                return;
            }
            if (Math.abs(suma - totalDisponible) < 0.01) {
                $bar.addClass("mat-nc-status-ok");
                $msg.html("<i class=\"bi bi-check-circle-fill\"></i> Coincide con el total");
            } else if (suma > totalDisponible) {
                $bar.addClass("mat-nc-status-error");
                $msg.html("<i class=\"bi bi-exclamation-circle-fill\"></i> La suma supera el total");
            } else {
                $bar.addClass("mat-nc-status-pending");
                $msg.text("La suma debe coincidir con el total disponible");
            }
        }
        updateNotaCreditoStatusBar();
        $(document).on("input change", "#NotaCredito #MontoNota, #NotaCredito #MontoRetencion, #NotaCredito #MontoDevolucion", function () {
            updateNotaCreditoStatusBar();
        });
    })();
</script>
