@if (ViewBag.Error != null)
{
    <div class="modern-alert-error">
        <i class="bi bi-exclamation-circle"></i>
        <span>@ViewBag.Error</span>
    </div>
    return;
}

<script type="text/javascript">
    $(document).ready(function () {
        var table = $("#tblPagos").DataTable({
            "columnDefs": [
                {
                    "targets": [0,1,7,8,9],
                    "orderable": false
                },
            ]
        });

        $('#tblPagos tbody').on('click', 'td.details-control', function () {
            var tr = $(this).closest('tr');
            var row = table.row(tr);
            var icon = $(this).find('i');

            if (row.child.isShown()) {
                // This row is already open - close it
                row.child.hide();
                tr.removeClass('shown');
                icon.removeClass('bi-chevron-up').addClass('bi-chevron-down');
            }
            else {
                // Open this row
                row.child(format($(tr).attr("id").replace('r_',''))).show();
                tr.addClass('shown');
                icon.removeClass('bi-chevron-down').addClass('bi-chevron-up');
            }
        });
    });

    function format(d) {
        
        var PagoID = d;
        var divLoading = '<div id="' + PagoID + '" class="modern-loading-container" style="padding: 2rem;"><div class="modern-loading-spinner"></div><span class="modern-loading-text">Cargando detalles...</span></div>';
        $("#divPagoMoreDetails").html(divLoading);

        getPagoDetalle(PagoID);
        return sReturn = $("#divPagoMoreDetails").html().trim();

    }


    function getPagoDetalle(PagoID) {
        
        $.ajax({
            url: "/Pago/GetPagoDetalleByPagoID",
            data: { PagoID: PagoID },
            success: function (data) {
                
                var _data = {
                    "MontoRecibido": formatNumberMoney(data.MontoRecibido),
                    "MonedaRecibida": data.MonedaRecibida.trim(),
                    "MontoEquivalente": formatNumberMoney(data.MontoEquivalente),
                    "MonedaEquivalente": data.MonedaEquivalente.trim(),
                    "Cotizacion": formatNumberMoney(data.Cotizacion),
                    "Fecha": data.Fecha
                }
                var _html = $("#divPagoDetalle").html().trim().render(_data);
                $("#" + PagoID).html(_html);
                $("#" + PagoID).removeClass("modern-loading-container");

            }
        });

        // return  $("#divPagoMoreDetails").html().trim();
    }
</script>


@model List<MAT.MVC.Models.PagoModel>
@{int iCount = 0;
  decimal dSum = 0;}
<div class="modern-table-container">
<table id="tblPagos" class="modern-table" style="width:100%;">
    <thead> 
        <tr>
            <th></th>
            <th>Fecha</th>
            <th>Nro de Recibo</th>
            <th>Transacción</th>
            <th>Medio de Pago</th>
            <th>Vendedor</th>
            <th>Monto</th>
            <th>Moneda</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody >
        @foreach (MAT.MVC.Models.PagoModel item in Model)
        {
            iCount += 1;
            dSum += item.Monto;
        <tr id="r_@item.PagoID">
            <td>@iCount</td>
            <td>@item.FechaPago.ToShortDateString() @item.FechaPago.ToShortTimeString()</td>
            <td>@item.NroRecibo</td>
            <td>@item.TransaccionID</td>
            <td>
                @{
                    var tipoPago = (item.TipoPagoDescripcion ?? "").Trim();
                    var tipoPagoLower = tipoPago.ToLower();
                    var tipoPagoClass = "text-bg-secondary";
                    if (tipoPagoLower.Contains("contado") || tipoPagoLower.Contains("efectivo")) { tipoPagoClass = "text-bg-success"; }
                    else if (tipoPagoLower.Contains("transfer")) { tipoPagoClass = "text-bg-info"; }
                    else if (tipoPagoLower.Contains("tarjeta")) { tipoPagoClass = "text-bg-primary"; }
                    else if (tipoPagoLower.Contains("mercado")) { tipoPagoClass = "text-bg-warning"; }
                }
                <span class="badge @tipoPagoClass">@tipoPago</span>
            </td>
            <td>@item.Vendedor</td>
            <td>@String.Format("{0:C}", item.Monto)</td>
            <td title="Tipo de Moneda del Paquete">
                <span class="badge text-bg-light" style="border: 1px solid var(--border-color, #e5e7eb);">
                    @item.MonedaPaquete.Trim()
                </span>
            </td>
            <td>
                <a href="javascript:cancelarPago('@item.PagoID','@ViewBag.FacturaID');" id="lnkCancelarPago" class="modern-btn-icon modern-btn-icon-danger" title="Cancelar Pago">
                    <i class="bi bi-x-circle"></i>
                </a>
            </td>
            <td class="@(item.Moneda.Trim() != "ARS" || item.MonedaPaquete.Trim() !="ARS"? "details-control text-center": "")">
                @if (item.Moneda.Trim() != "ARS" || item.MonedaPaquete.Trim() != "ARS")
                {
                    <i class="bi bi-chevron-down"></i>
                }
            </td>
        </tr>    
        }
        
    </tbody>
    <tfoot>
        <tr>
            <th>Total</th>
            <th colspan="5"></th>
            @if (Model.Count() > 0)
            {
                <th colspan="4">
                    @String.Format("{0:C}", dSum)
                    <span class="badge text-bg-light" style="border: 1px solid var(--border-color, #e5e7eb); margin-left: .25rem;">
                        @Model.First().MonedaPaquete.Trim()
                    </span>
                </th>    
            }
            else
            {
                <th colspan="4">@String.Format("{0:C}", 0)</th>
            }
            
        </tr>
    </tfoot>
    
</table>
 <div id="divPagoMoreDetails" style="display:none;">
   
</div>

<div id="divPagoDetalle" style="display:none;">
    <div class="modern-pago-detalle">
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Monto Recibido:</span>
            <span class="modern-pago-detalle-value">{{MontoRecibido}} ({{MonedaRecibida}})</span>
        </div>
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Monto Equivalente:</span>
            <span class="modern-pago-detalle-value">{{MontoEquivalente}} ({{MonedaEquivalente}})</span>
        </div>
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Cotización:</span>
            <span class="modern-pago-detalle-value">1 U$D = {{Cotizacion}}</span>
        </div>
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Fecha de Transacción:</span>
            <span class="modern-pago-detalle-value">{{Fecha}}</span>
        </div>
    </div>
</div>
</div>

<style>
    .modern-pago-detalle {
        padding: 1rem;
        background: var(--bg-secondary, #f9fafb);
        border-radius: 0.5rem;
        margin: 0.5rem 0;
    }
    .modern-pago-detalle-item {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .modern-pago-detalle-item:last-child {
        border-bottom: none;
    }
    .modern-pago-detalle-label {
        font-weight: 600;
        font-size: 0.875rem;
        color: var(--text-secondary, #6b7280);
    }
    .modern-pago-detalle-value {
        font-weight: 500;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
    }
</style>