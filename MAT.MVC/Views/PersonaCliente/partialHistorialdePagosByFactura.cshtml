@if (ViewBag.Error != null)
{
    <div class="modern-alert-error">
        <i class="bi bi-exclamation-circle"></i>
        <span>@ViewBag.Error</span>
    </div>
    return;
}

<script type="text/javascript">
    $(document).ready(function () {
        var $tbl = $("#tblPagos");
        if ($.fn.DataTable && $.fn.DataTable.isDataTable && $.fn.DataTable.isDataTable($tbl)) {
            try { $tbl.DataTable().destroy(); } catch (e) { }
        }

        var table = $tbl.DataTable({
            "columnDefs": [
                {
                    "targets": [8,9,10],
                    "orderable": false
                },
            ]
        });

        $('#tblPagos tbody').off('click.pagos', 'td.details-control').on('click.pagos', 'td.details-control', function () {
            var tr = $(this).closest('tr');
            var row = table.row(tr);

            if (row.child.isShown()) {
                // This row is already open - close it
                row.child.hide();
                tr.removeClass('shown');
            }
            else {
                // Open this row
                row.child(format($(tr).attr("id").replace('r_',''))).show();
                tr.addClass('shown');
            }
        });
    });

    function format(d) {
        
        var PagoID = d;
        var divLoading = '<div id="' + PagoID + '" class="modern-loading-container" style="padding: 2rem;"><div class="modern-loading-spinner"></div><span class="modern-loading-text">Cargando detalles...</span></div>';
        $("#divPagoMoreDetails").html(divLoading);

        getPagoDetalle(PagoID);
        return sReturn = $("#divPagoMoreDetails").html().trim();

    }


    function getPagoDetalle(PagoID) {
        
        $.ajax({
            url: "/Pago/GetPagoDetalleByPagoID",
            data: { PagoID: PagoID },
            success: function (data) {
                var _html;
                if (data.CanceladoPorNotaCredito) {
                    _html = '<div class="modern-pago-detalle modern-pago-cancelado-nc"><i class="bi bi-x-circle"></i> Pago cancelado por nota de crédito</div>';
                } else {
                    var _data = {
                        "MontoRecibido": formatNumberMoney(data.MontoRecibido),
                        "MonedaRecibida": (data.MonedaRecibida || "").trim(),
                        "MontoEquivalente": formatNumberMoney(data.MontoEquivalente),
                        "MonedaEquivalente": (data.MonedaEquivalente || "").trim(),
                        "Cotizacion": formatNumberMoney(data.Cotizacion),
                        "Fecha": data.Fecha || ""
                    };
                    _html = $("#divPagoDetalle").html().trim().render(_data);
                }
                $("#" + PagoID).html(_html);
                $("#" + PagoID).removeClass("modern-loading-container");
            }
        });
    }
</script>


@model List<MAT.MVC.Models.PagoModel>
@{
    int iCount = 0;
    decimal dSum = 0;
    if (Model != null)
    {
        foreach (var p in Model) { dSum += p.Monto; }
    }
}
<div class="mat-pagos">
    <div class="mat-pagos-header">
        <div class="mat-pagos-summary">
            <div class="mat-pagos-summary-label">Total</div>
            <div class="mat-pagos-summary-value">
                <span class="mat-pagos-summary-amount">@String.Format("{0:C}", dSum)</span>
                @if (Model != null && Model.Count > 0)
                {
                    <span class="mat-badge mat-badge--pastel-slate">@Model.First().MonedaPaquete.Trim()</span>
                }
            </div>
        </div>
    </div>

    <div class="modern-table-container mat-pagos-tablewrap">
<table id="tblPagos" class="display" style="width:100%;">
    <thead> 
        <tr>
            <th>#</th>
            <th>Fecha</th>
            <th>Recibo</th>
            <th>Transacción</th>
            <th>Medio</th>
            <th>Vendedor</th>
            <th>Monto</th>
            <th>Moneda</th>
            <th>Estado</th>
            <th></th>
            <th></th>
        </tr>
    </thead>
    <tbody >
        @foreach (MAT.MVC.Models.PagoModel item in Model)
        {
            iCount += 1;
        <tr id="r_@item.PagoID">
            <td>@iCount</td>
            <td>
                <div class="mat-pago-fecha">
                    <div class="mat-pago-date">@item.FechaPago.ToShortDateString()</div>
                    <div class="mat-pago-fecha-time">@item.FechaPago.ToShortTimeString()</div>
                </div>
            </td>
            <td>
                @{
                    var recibo = (item.NroRecibo ?? "").Trim();
                }
                @if (string.IsNullOrWhiteSpace(recibo))
                {
                    <span class="mat-empty" aria-label="Sin recibo">—</span>
                }
                else
                {
                    <span class="mat-mono mat-ellipsis" title="@recibo">@recibo</span>
                }
            </td>
            <td>
                @{
                    var trx = (item.TransaccionID ?? "").Trim();
                }
                @if (string.IsNullOrWhiteSpace(trx))
                {
                    <span class="mat-empty" aria-label="Sin transacción">—</span>
                }
                else
                {
                    <span class="mat-mono mat-ellipsis" title="@trx">@trx</span>
                }
            </td>
            <td>
                @{
                    var tipoPago = (item.TipoPagoDescripcion ?? "").Trim();
                }
                @if (string.IsNullOrWhiteSpace(tipoPago))
                {
                    <span class="mat-empty" aria-label="Sin medio">—</span>
                }
                else
                {
                    <span class="mat-pago-medio" title="@tipoPago">@tipoPago</span>
                }
            </td>
            <td>
                <span class="mat-pago-vendedor mat-ellipsis" title="@item.Vendedor">
                    @item.Vendedor
                </span>
            </td>
            <td class="text-end">
                <span class="mat-pago-monto">@String.Format("{0:C}", item.Monto)</span>
            </td>
            <td>
                @{
                    var m = (item.Moneda ?? "").Trim();
                    var monedaClass = "mat-badge--pastel-slate";
                    if (m == "ARS") { monedaClass = "mat-badge--pastel-green"; }
                    else if (m == "USD") { monedaClass = "mat-badge--pastel-blue"; }
                }
                <span class="mat-badge @monedaClass">@m</span>
            </td>
            <td>
                @if (item.CanceladoPorNotaCredito)
                {
                    <span class="mat-badge mat-badge--pastel-amber" title="Pago cancelado por nota de crédito">
                        <i class="bi bi-info-circle"></i> Cancelado por N.C.
                    </span>
                }
                else
                {
                    <span class="mat-empty" aria-label="Vigente">—</span>
                }
            </td>
            <td>
                <a href="javascript:cancelarPago('@item.PagoID','@ViewBag.FacturaID');"
                   id="lnkCancelarPago"
                   class="modern-btn-icon modern-btn-icon-danger mat-pago-cancel"
                   title="Cancelar Pago">
                    <i class="bi bi-x-circle"></i>
                </a>
            </td>
            <td class="@(item.Moneda.Trim() != "ARS" || item.MonedaPaquete.Trim() !="ARS"? "details-control": "")"></td>
        </tr>    
        }
        
    </tbody>
    <tfoot>
        <tr>
            <th>Total</th>
            <th colspan="6"></th>
            @if (Model.Count() > 0)
            {
                <th colspan="4">
                    @String.Format("{0:C}", dSum)
                    <span class="mat-badge mat-badge--pastel-slate" style="margin-left: .25rem;">
                        @Model.First().MonedaPaquete.Trim()
                    </span>
                </th>    
            }
            else
            {
                <th colspan="4">@String.Format("{0:C}", 0)</th>
            }
            
        </tr>
    </tfoot>
    
</table>
 <div id="divPagoMoreDetails" style="display:none;">
   
</div>

<div id="divPagoDetalle" style="display:none;">
    <div class="modern-pago-detalle">
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Monto recibido</span>
            <span class="modern-pago-detalle-value">
                {{MontoRecibido}}
                <span class="mat-badge mat-badge--pastel-slate">{{MonedaRecibida}}</span>
            </span>
        </div>
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Equivalente</span>
            <span class="modern-pago-detalle-value">
                {{MontoEquivalente}}
                <span class="mat-badge mat-badge--pastel-slate">{{MonedaEquivalente}}</span>
            </span>
        </div>
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Cotización</span>
            <span class="modern-pago-detalle-value">1 U$D = {{Cotizacion}}</span>
        </div>
        <div class="modern-pago-detalle-item">
            <span class="modern-pago-detalle-label">Fecha transacción</span>
            <span class="modern-pago-detalle-value">{{Fecha}}</span>
        </div>
    </div>
</div>
</div>
</div>