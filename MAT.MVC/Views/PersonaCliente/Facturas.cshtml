@using MAT.Entities
@using MAT.Enums
@using MAT.Utilities
@model List<MAT.MVC.Models.FacturaStandard>
@{
    ViewBag.Title = "Facturas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-facturas-container">
    @if (Model.Count() == 0)
    {
        <div class="modern-facturas-empty">
            <i class="bi bi-file-earmark-x"></i>
            <h4>El Cliente seleccionado no tiene ninguna factura asociada.</h4>
            <a href="@Url.Action("Index", "PersonaCliente")" class="modern-facturas-btn-back">
                <i class="bi bi-arrow-left"></i>
                Lista de clientes
            </a>
        </div>
    }
    else
    {
        <div class="modern-facturas-header">
            <h2 class="modern-facturas-title">
                <i class="bi bi-receipt"></i>
                Facturas
            </h2>
            <span class="modern-facturas-badge">
                <i class="bi bi-person"></i>
                @Model.First().ClienteNombre @Model.First().ClienteApellido
            </span>
        </div>

        <div class="modern-facturas-table-wrap">
            <table class="modern-facturas-table">
                <thead>
                    <tr>
                        <th>N° Factura</th>
                        <th>Monto</th>
                        <th>Fecha Facturación</th>
                        <th>Estado</th>
                        <th class="modern-facturas-th-actions"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (MAT.MVC.Models.FacturaStandard factura in Model.ToList())
                    {
                        <tr>
                            <td><span class="modern-facturas-numero">@factura.NroFactura</span></td>
                            <td><span class="modern-facturas-monto">@string.Format("{0:C}", factura.Monto)</span></td>
                            <td>@factura.Fecha</td>
                            <td>@factura.EstadoDescripcion</td>
                            <td>
                                @if (factura.Estado != (int)eEstadoFactura.NotadeCredito)
                                {
                                    <a href="#" data-facturaid="@factura.FacturaID" title="Ver Factura" class="modern-facturas-btn-detail btn-detallefactura">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                }
                                else if (factura.NotaID.HasValue)
                                {
                                    <a href="#" class="modern-facturas-btn-detail modern-facturas-btn-nota btn-ver-nota-credito" data-notaid="@factura.NotaID.Value" title="Ver nota de crédito">
                                        <i class="bi bi-credit-card-2-front"></i>
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <a href="@Url.Action("Index", "PersonaCliente")" class="modern-facturas-btn-back">
            <i class="bi bi-arrow-left"></i>
            Lista de clientes
        </a>

        <input type="hidden" id="hdnClienteID" value="@ViewBag.ClienteID" />

        <script type="text/javascript">
            $(document).on("click", ".btn-ver-nota-credito", function (e) {
                e.preventDefault();
                var notaid = $(this).data("notaid");
                if (notaid && typeof ShowFormDialog === "function") {
                    var url = "/NotaCredito/partialNotaCredito?NotaID=" + notaid;
                    ShowFormDialog(url, "popinNota", "Nota de Crédito", "medium");
                }
            });
        </script>
    }
</div>