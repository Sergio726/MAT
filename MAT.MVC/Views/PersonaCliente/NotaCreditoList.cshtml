<div class="nota-credito-list-container">
    <div class="nota-credito-header">
        <h2 class="nota-credito-title">
            <i class="bi bi-credit-card-2-front"></i>
            Lista de Notas de Credito
        </h2>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@ViewBag.Error</span>
        </div>
    }
    else
    {
        <div class="nota-credito-filters">
            <div class="nota-credito-filter-bar">
                <i class="bi bi-funnel" aria-hidden="true"></i>
                <label for="chkSoloCreditoPositivo" class="nota-credito-filter-label">
                    <input type="checkbox" id="chkSoloCreditoPositivo" value="1" class="nota-credito-filter-check" />
                    <span class="nota-credito-filter-switch"></span>
                    <span class="nota-credito-filter-text">Solo crédito &gt; 0</span>
                </label>
            </div>
        </div>
        <div class="table-container">
            <table id="tblCreditoClienteList" class="display">
                <thead>
                    <tr>
                        <th style="width:250px;">Cliente</th>
                        <th>Monto</th>
                        <th style="width:110px;">Última fecha</th>
                        <th style="width:120px;"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="modalMovimientosNotaCreditoOverlay" class="mat-modal-overlay-movimientos" role="dialog" aria-labelledby="modalMovimientosNotaCreditoTitle">
            <div id="modalMovimientosNotaCredito" class="mat-modal-box-movimientos">
                <div class="mat-modal-titlebar-movimientos">
                    <span id="modalMovimientosNotaCreditoTitle" class="mat-modal-title-movimientos">Movimientos Nota de Crédito</span>
                    <button type="button" class="mat-modal-close-movimientos" id="btnModalMovimientosCerrarX" title="Cerrar" aria-label="Cerrar">&times;</button>
                </div>
                <div id="divContentMovimientoNotaCredito" class="mat-modal-content-movimientos"></div>
            </div>
        </div>

        <script type="text/javascript">
            $(document).ready(function () {
                registerFormatNumber();

                var dataSet = @Html.Raw(ViewBag.sbDataSetJson);
                var jTables = eval(dataSet);
                var jt = jTables;

                var table = $("#tblCreditoClienteList").DataTable({
                    "aaData": jt,
                    "columns": [
                        {
                            "data": "FullName",
                            "sClass": "left"
                        },
                        {
                            "data": "Monto",
                            "mRender": function (data, type, row) {
                                var numberFormat = formatNumberMoney(row.Monto);
                                return numberFormat;
                            }
                        },
                        {
                            "data": "UltimaFecha",
                            "mRender": function (data, type, row) {
                                if (!row.UltimaFecha) return '-';
                                var d;
                                if (typeof row.UltimaFecha === 'string' && /\/Date\((-?\d+)\)\//.test(row.UltimaFecha)) {
                                    d = new Date(parseInt(row.UltimaFecha.replace(/\/Date\((-?\d+)\)\//, '$1'), 10));
                                } else {
                                    d = new Date(row.UltimaFecha);
                                }
                                if (isNaN(d.getTime())) return '-';
                                return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
                            }
                        },
                        {
                            "data": "ClienteID",
                            "mRender": function (data, type, row) {
                                var nombre = (row.FullName || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                                return '<button type="button" class="btn-movimientos" onclick="loadDivMovimientoNotaCredito(\'' + row.ClienteID + '\', \'' + nombre + '\')"><i class="bi bi-list-ul"></i> Movimientos</button>';
                            }
                        },
                    ],
                    "bAutoWidth": false,
                    "pageLength": 25,
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                    }
                });

                $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                    if (settings.nTable.id !== "tblCreditoClienteList") return true;
                    if (!$("#chkSoloCreditoPositivo").is(":checked")) return true;
                    var row = settings.aoData[dataIndex]._aData;
                    var monto = parseFloat(row.Monto);
                    return !isNaN(monto) && monto > 0;
                });

                $("#chkSoloCreditoPositivo").on("change", function () {
                    table.draw();
                });
            });

            function cerrarPopupMovimientosNota() {
                $("#modalMovimientosNotaCreditoOverlay").removeClass("is-open");
            }

            $("#btnModalMovimientosCerrarX").on("click", function (e) {
                e.preventDefault();
                cerrarPopupMovimientosNota();
            });
            $(document).on("click", "#btn-cerrar-movimientos-nota", function (e) {
                e.preventDefault();
                cerrarPopupMovimientosNota();
            });
            $("#modalMovimientosNotaCreditoOverlay").on("click", function (e) {
                if (e.target === this) { e.preventDefault(); cerrarPopupMovimientosNota(); }
            });
            $(document).on("keydown", function (e) {
                if (e.keyCode === 27 && $("#modalMovimientosNotaCreditoOverlay").hasClass("is-open")) {
                    e.preventDefault();
                    cerrarPopupMovimientosNota();
                }
            });

            function loadDivMovimientoNotaCredito(ClienteID, clienteNombre) {
                var $overlay = $("#modalMovimientosNotaCreditoOverlay");
                var $content = $("#divContentMovimientoNotaCredito");
                $("#modalMovimientosNotaCreditoTitle").text("Notas de Credito");

                $content.html(
                    '<div style="display: flex; align-items: center; justify-content: center; padding: 2rem; color: #9ca3af;">' +
                    '<div style="width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #e91e63; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 0.5rem;"></div>' +
                    'Cargando movimientos...' +
                    '</div>'
                );
                $overlay.addClass("is-open");

                $.ajax({
                    url: "/NotaCredito/partialMovimientoNotaCredito",
                    data: { ClienteID: ClienteID },
                    success: function (data) {
                        $content.html(data);
                    },
                    error: function (e) {
                        $content.html(
                            '<div style="text-align: center; padding: 2rem; color: #dc2626;">' +
                            '<i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>' +
                            '<p>Se produjo un error. Contactese con el administrador.</p>' +
                            '</div>'
                        );
                        console.log(e);
                    }
                });
            }
        </script>
    }
</div>
