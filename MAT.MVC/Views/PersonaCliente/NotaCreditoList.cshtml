<style>
    .nota-credito-list-container {
        padding: 0.5rem;
    }
    .nota-credito-header {
        margin-bottom: 1rem;
    }
    .nota-credito-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }
    .nota-credito-title i {
        color: var(--primary-color, #e91e63);
    }
    .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 0.5rem;
        padding: 1rem;
        color: #dc2626;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .table-container {
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    #tblCretitoClienteList {
        width: 100% !important;
    }
    #tblCretitoClienteList thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblCretitoClienteList tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblCretitoClienteList tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .btn-movimientos {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        padding: 0.375rem 0.75rem;
        background: var(--primary-color, #e91e63);
        color: white;
        border: none;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        width: 100%;
    }
    .btn-movimientos:hover {
        background: var(--primary-hover, #d81b60);
        color: white;
    }
</style>

<div class="nota-credito-list-container">
    <div class="nota-credito-header">
        <h2 class="nota-credito-title">
            <i class="bi bi-credit-card-2-front"></i>
            Lista de Notas de Credito
        </h2>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@ViewBag.Error</span>
        </div>
    }
    else
    {
        <div class="table-container">
            <table id="tblCretitoClienteList" class="display">
                <thead>
                    <tr>
                        <th style="width:250px;">Cliente</th>
                        <th>Monto</th>
                        <th style="width:120px;"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="divPopupDetalleNotaCredito" title="Movimientos" style="display: none;">
            <div id="divContentMovimientoNotaCredito"></div>
        </div>

        <script type="text/javascript">
            $(document).ready(function () {
                registerFormatNumber();

                var dataSet = @Html.Raw(ViewBag.sbDataSetJson);
                var jTables = eval(dataSet);
                var jt = jTables;

                $("#tblCretitoClienteList").DataTable({
                    "aaData": jt,
                    "columns": [
                        {
                            "data": "FullName",
                            "sClass": "left"
                        },
                        {
                            "data": "Monto",
                            "mRender": function (data, type, row) {
                                var numberFormat = formatNumberMoney(row.Monto);
                                return numberFormat;
                            }
                        },
                        {
                            "data": "ClienteID",
                            "mRender": function (data, type, row) {
                                return '<button class="btn-movimientos" onclick="loadDivMovimientoNotaCredito(\'' + row.ClienteID + '\')"><i class="bi bi-list-ul"></i> Movimientos</button>';
                            }
                        },
                    ],
                    "bAutoWidth": false,
                    "pageLength": 25,
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                    }
                });
            });

            function loadDivMovimientoNotaCredito(ClienteID) {
                $("#divContentMovimientoNotaCredito").html(
                    '<div style="display: flex; align-items: center; justify-content: center; padding: 2rem; color: #9ca3af;">' +
                    '<div style="width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #e91e63; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 0.5rem;"></div>' +
                    'Cargando movimientos...' +
                    '</div>'
                );
                $("#divPopupDetalleNotaCredito").dialog("open");
                $("#divPopupDetalleNotaCredito").dialog({
                    modal: true,
                    position: { my: 'top', at: 'top', of: window },
                    width: "80%"
                });

                $.ajax({
                    url: "/NotaCredito/partialMovimientoNotaCredito",
                    data: { ClienteID: ClienteID },
                    success: function (data) {
                        $("#divContentMovimientoNotaCredito").html(data);
                    },
                    error: function (e) {
                        $("#divContentMovimientoNotaCredito").html(
                            '<div style="text-align: center; padding: 2rem; color: #dc2626;">' +
                            '<i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>' +
                            '<p>Se produjo un error. Contactese con el administrador.</p>' +
                            '</div>'
                        );
                        console.log(e);
                    }
                });
            }
        </script>
    }
</div>
