<style>
    .nota-credito-list-container {
        padding: 0.5rem;
    }
    .nota-credito-header {
        margin-bottom: 1rem;
    }
    .nota-credito-filters {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 1rem;
        padding: 0.5rem 0;
    }
    .nota-credito-filters label {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: var(--text-secondary, #6b7280);
        cursor: pointer;
    }
    .nota-credito-filters input[type="checkbox"] {
        width: 1rem;
        height: 1rem;
        cursor: pointer;
    }
    .nota-credito-title {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0;
    }
    .nota-credito-title i {
        color: var(--primary-color, #e91e63);
    }
    .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 0.5rem;
        padding: 1rem;
        color: #dc2626;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .table-container {
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    #tblCretitoClienteList {
        width: 100% !important;
    }
    #tblCretitoClienteList thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblCretitoClienteList tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    #tblCretitoClienteList tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .btn-movimientos {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.25rem;
        padding: 0.375rem 0.75rem;
        background: var(--primary-color, #e91e63);
        color: white;
        border: none;
        border-radius: 0.375rem;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
        width: 100%;
    }
    .btn-movimientos:hover {
        background: var(--primary-hover, #d81b60);
        color: white;
    }
    .mat-modal-overlay-movimientos {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0,0,0,0.45);
        z-index: 9998;
        display: none;
    }
    .mat-modal-overlay-movimientos.is-open {
        display: block;
    }
    .mat-modal-box-movimientos {
        position: fixed;
        top: 50px;
        left: 50%;
        transform: translateX(-50%);
        width: 80%;
        min-width: 400px;
        max-width: 900px;
        max-height: calc(100vh - 100px);
        background: white;
        border-radius: 0.5rem;
        box-shadow: 0 10px 40px rgba(0,0,0,0.2);
        z-index: 9999;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }
    .mat-modal-titlebar-movimientos {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        background: var(--primary-color, #e91e63);
        color: white;
        font-weight: 600;
        flex-shrink: 0;
    }
    .mat-modal-title-movimientos { font-size: 1rem; }
    .mat-modal-close-movimientos {
        background: transparent;
        border: none;
        color: white;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
        padding: 0 0.25rem;
        opacity: 0.9;
    }
    .mat-modal-close-movimientos:hover { opacity: 1; }
    .mat-modal-content-movimientos {
        padding: 0;
        overflow: auto;
        flex: 1;
        min-height: 0;
    }
</style>

<div class="nota-credito-list-container">
    <div class="nota-credito-header">
        <h2 class="nota-credito-title">
            <i class="bi bi-credit-card-2-front"></i>
            Lista de Notas de Credito
        </h2>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@ViewBag.Error</span>
        </div>
    }
    else
    {
        <div class="nota-credito-filters">
            <label for="chkSoloCreditoPositivo">
                <input type="checkbox" id="chkSoloCreditoPositivo" value="1" />
                Solo crédito &gt; 0
            </label>
        </div>
        <div class="table-container">
            <table id="tblCretitoClienteList" class="display">
                <thead>
                    <tr>
                        <th style="width:250px;">Cliente</th>
                        <th>Monto</th>
                        <th style="width:110px;">Última fecha</th>
                        <th style="width:120px;"></th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div id="modalMovimientosNotaCreditoOverlay" class="mat-modal-overlay-movimientos" role="dialog" aria-labelledby="modalMovimientosNotaCreditoTitle">
            <div id="modalMovimientosNotaCredito" class="mat-modal-box-movimientos">
                <div class="mat-modal-titlebar-movimientos">
                    <span id="modalMovimientosNotaCreditoTitle" class="mat-modal-title-movimientos">Movimientos Nota de Crédito</span>
                    <button type="button" class="mat-modal-close-movimientos" id="btnModalMovimientosCerrarX" title="Cerrar" aria-label="Cerrar">&times;</button>
                </div>
                <div id="divContentMovimientoNotaCredito" class="mat-modal-content-movimientos"></div>
            </div>
        </div>

        <script type="text/javascript">
            $(document).ready(function () {
                registerFormatNumber();

                var dataSet = @Html.Raw(ViewBag.sbDataSetJson);
                var jTables = eval(dataSet);
                var jt = jTables;

                var table = $("#tblCretitoClienteList").DataTable({
                    "aaData": jt,
                    "columns": [
                        {
                            "data": "FullName",
                            "sClass": "left"
                        },
                        {
                            "data": "Monto",
                            "mRender": function (data, type, row) {
                                var numberFormat = formatNumberMoney(row.Monto);
                                return numberFormat;
                            }
                        },
                        {
                            "data": "UltimaFecha",
                            "mRender": function (data, type, row) {
                                if (!row.UltimaFecha) return '-';
                                var d;
                                if (typeof row.UltimaFecha === 'string' && /\/Date\((-?\d+)\)\//.test(row.UltimaFecha)) {
                                    d = new Date(parseInt(row.UltimaFecha.replace(/\/Date\((-?\d+)\)\//, '$1'), 10));
                                } else {
                                    d = new Date(row.UltimaFecha);
                                }
                                if (isNaN(d.getTime())) return '-';
                                return ('0' + d.getDate()).slice(-2) + '/' + ('0' + (d.getMonth() + 1)).slice(-2) + '/' + d.getFullYear();
                            }
                        },
                        {
                            "data": "ClienteID",
                            "mRender": function (data, type, row) {
                                var nombre = (row.FullName || '').replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;');
                                return '<button type="button" class="btn-movimientos" onclick="loadDivMovimientoNotaCredito(\'' + row.ClienteID + '\', \'' + nombre + '\')"><i class="bi bi-list-ul"></i> Movimientos</button>';
                            }
                        },
                    ],
                    "bAutoWidth": false,
                    "pageLength": 25,
                    "language": {
                        "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                    }
                });

                $.fn.dataTable.ext.search.push(function (settings, data, dataIndex) {
                    if (settings.nTable.id !== "tblCretitoClienteList") return true;
                    if (!$("#chkSoloCreditoPositivo").is(":checked")) return true;
                    var row = settings.aoData[dataIndex]._aData;
                    var monto = parseFloat(row.Monto);
                    return !isNaN(monto) && monto > 0;
                });

                $("#chkSoloCreditoPositivo").on("change", function () {
                    table.draw();
                });
            });

            function cerrarPopupMovimientosNota() {
                $("#modalMovimientosNotaCreditoOverlay").removeClass("is-open");
            }

            $("#btnModalMovimientosCerrarX").on("click", function (e) {
                e.preventDefault();
                cerrarPopupMovimientosNota();
            });
            $(document).on("click", "#btn-cerrar-movimientos-nota", function (e) {
                e.preventDefault();
                cerrarPopupMovimientosNota();
            });
            $("#modalMovimientosNotaCreditoOverlay").on("click", function (e) {
                if (e.target === this) { e.preventDefault(); cerrarPopupMovimientosNota(); }
            });
            $(document).on("keydown", function (e) {
                if (e.keyCode === 27 && $("#modalMovimientosNotaCreditoOverlay").hasClass("is-open")) {
                    e.preventDefault();
                    cerrarPopupMovimientosNota();
                }
            });

            function loadDivMovimientoNotaCredito(ClienteID, clienteNombre) {
                var $overlay = $("#modalMovimientosNotaCreditoOverlay");
                var $content = $("#divContentMovimientoNotaCredito");
                $("#modalMovimientosNotaCreditoTitle").text("Notas de Credito");

                $content.html(
                    '<div style="display: flex; align-items: center; justify-content: center; padding: 2rem; color: #9ca3af;">' +
                    '<div style="width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #e91e63; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 0.5rem;"></div>' +
                    'Cargando movimientos...' +
                    '</div>'
                );
                $overlay.addClass("is-open");

                $.ajax({
                    url: "/NotaCredito/partialMovimientoNotaCredito",
                    data: { ClienteID: ClienteID },
                    success: function (data) {
                        $content.html(data);
                    },
                    error: function (e) {
                        $content.html(
                            '<div style="text-align: center; padding: 2rem; color: #dc2626;">' +
                            '<i class="bi bi-exclamation-triangle" style="font-size: 2rem;"></i>' +
                            '<p>Se produjo un error. Contactese con el administrador.</p>' +
                            '</div>'
                        );
                        console.log(e);
                    }
                });
            }
        </script>
    }
</div>
