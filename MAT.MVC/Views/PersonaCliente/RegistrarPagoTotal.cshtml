@using MAT.MVC.Models
@using MAT.Enums
@using MAT.Utilities

<style>
    .pago-total-container {
        padding: 0.5rem;
    }
    .pago-total-form {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .pago-total-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
    }
    .pago-form-group {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .pago-form-group.full-width {
        grid-column: span 2;
    }
    .pago-form-label {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .pago-form-label i {
        color: var(--primary-color, #e91e63);
        font-size: 0.8rem;
    }
    .pago-form-input,
    .pago-form-select {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.375rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        background: white;
        transition: all 0.2s ease;
    }
    .pago-form-input:focus,
    .pago-form-select:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .pago-form-input:disabled {
        background: var(--bg-secondary, #f9fafb);
        color: var(--text-secondary, #9ca3af);
        cursor: not-allowed;
    }
    .saldo-display {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.75rem;
        background: linear-gradient(135deg, #fce7f3 0%, #fbcfe8 100%);
        color: #db2777;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
    }
    .pago-actions {
        display: flex;
        gap: 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
    }
    .btn-pago {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.375rem;
        padding: 0.625rem 1.25rem;
        border-radius: 0.375rem;
        font-weight: 500;
        font-size: 0.875rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-pago-primary {
        background: var(--primary-color, #e91e63);
        color: white;
    }
    .btn-pago-primary:hover {
        background: var(--primary-hover, #d81b60);
    }
    .credito-status.credito-ok { color: #059669; }
    .credito-status.credito-fail { color: #dc2626; }
    .credito-status.credito-info { color: #6b7280; }
    @@media (max-width: 500px) {
        .pago-total-grid {
            grid-template-columns: 1fr;
        }
        .pago-form-group.full-width {
            grid-column: span 1;
        }
    }
</style>

@if (ViewBag.SaldoError != null)
{
    <div class="alert alert-warning" role="alert" style="margin-bottom: 1rem;">
        <i class="bi bi-exclamation-triangle"></i> @ViewBag.SaldoError
    </div>
}

<div class="pago-total-container">
    <div class="pago-total-form">
        <div class="pago-total-grid">
            <div class="pago-form-group">
                <label class="pago-form-label">
                    <i class="bi bi-credit-card"></i>
                    Forma de Pago
                </label>
                <select id="tipopago" name="tipopago" class="pago-form-select">
                    @foreach (var item in eFormaPago.Credito.ToSelectList())
                    {
                        <option value="@item.Value">@item.Text</option>
                    }
                </select>
            </div>

            <div class="pago-form-group" id="transaccion-group" style="display: none;">
                <label class="pago-form-label">
                    <i class="bi bi-hash"></i>
                    N° de Transacción
                </label>
                <input type="text" name="TransaccionID" id="TransaccionID" class="pago-form-input" disabled="disabled" />
            </div>

            <div class="pago-form-group" id="credito-disponible-group" style="display: none;">
                <label class="pago-form-label">
                    <i class="bi bi-bank"></i>
                    Crédito disponible
                </label>
                <input type="text" id="total-credito" class="pago-form-input" disabled />
                <div id="credito-status-msg" class="credito-status" style="display:none; margin-top:0.35rem; font-size:0.8125rem; font-weight:500;"></div>
            </div>
            <div class="pago-form-group">
                <label class="pago-form-label">
                    <i class="bi bi-cash"></i>
                    Monto a Abonar
                </label>
                <div class="saldo-display">
                    <i class="bi bi-currency-dollar"></i>
                    @String.Format("{0:0.00}", ViewBag.Saldo)
                </div>
                <input type="hidden" name="MontoPago" id="txtPago" value="@String.Format("{0:0.00}", ViewBag.Saldo)" />
            </div>

            <div class="pago-form-group">
                <label class="pago-form-label">
                    <i class="bi bi-receipt"></i>
                    N° de Recibo
                </label>
                <input type="text" name="Recibo" id="Recibo" class="pago-form-input" placeholder="Número de recibo" />
            </div>

            <div class="pago-form-group">
                <label class="pago-form-label">
                    <i class="bi bi-file-text"></i>
                    N° de Factura
                </label>
                <input type="text" name="Factura" id="Factura" class="pago-form-input" placeholder="Número de factura" />
            </div>
        </div>

        <div class="pago-actions">
            <button type="button" name="btnRegistrarPago" id="btnRegistrarPago" class="btn-pago btn-pago-primary">
                <i class="bi bi-check-lg"></i>
                Registrar Pago Total
            </button>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        // Handle payment type change
        $("#tipopago").change(function () {
            var tipoPago = $(this).val();
            if (tipoPago == "1") {
                $("#transaccion-group").hide();
                $("#credito-disponible-group").hide();
                $("#TransaccionID").attr("disabled", true);
            } else {
                $("#transaccion-group").show();
                $("#TransaccionID").attr("disabled", false);
            }
            if (tipoPago == "4") {
                $("#credito-disponible-group").show();
                var ClienteID = "@ViewBag.ClienteID";
                var SaldoFactura = parseFloat("@ViewBag.Saldo".replace(",", ".")) || 0;
                $("#credito-status-msg").show().removeClass("credito-ok credito-fail").addClass("credito-info").text("Cargando...");
                $.get("/NotaCredito/getCreditoDisponible", { ClienteID: ClienteID }, function (data) {
                    var response = typeof data === "string" ? eval(data) : data;
                    if (response[0] == "Done.") {
                        var cred = parseFloat(response[1]);
                        $("#total-credito").val(cred);
                        var $msg = $("#credito-status-msg").removeClass("credito-info");
                        if (cred >= SaldoFactura) {
                            $msg.addClass("credito-ok").html("<i class=\"bi bi-check-circle-fill\"></i> Saldo suficiente para este pago");
                        } else {
                            $msg.addClass("credito-fail").html("<i class=\"bi bi-exclamation-circle-fill\"></i> Saldo insuficiente. Crédito disponible: " + (typeof formatNumberMoney === "function" ? formatNumberMoney(cred) : cred));
                        }
                    } else { $("#credito-status-msg").hide(); }
                }).fail(function () { $("#credito-status-msg").hide(); });
            } else {
                $("#credito-disponible-group").hide();
                $("#credito-status-msg").hide();
            }
        });

        // Handle payment registration
        $("#btnRegistrarPago").click(function () {
            var monto = $("#txtPago").val();
            var tipopago = parseInt($("#tipopago").val());
            if (tipopago === 4) {
                var cred = parseFloat($("#total-credito").val());
                var montoNum = parseFloat(String(monto).replace(",", ".")) || 0;
                if (!isNaN(cred) && montoNum > cred) {
                    (window.alertInfo || window.alert)("Crédito insuficiente. El cliente no tiene saldo suficiente para este pago.", "Validación");
                    return;
                }
            }
            var nrofactura = $("#Factura").val();
            var nrorecibo = $("#Recibo").val();
            var FacturaID = "@ViewBag.FacturaID";
            var ClienteID = "@ViewBag.ClienteID";
            var TransaccionID = $("#TransaccionID").val();

            $.ajax({
                url: "/PersonaCliente/RegistrarPagoTotal",
                type: "POST",
                data: {
                    monto: monto,
                    tipopago: tipopago,
                    TransaccionID: TransaccionID,
                    factura: nrofactura,
                    recibo: nrorecibo,
                    FacturaID: FacturaID,
                    ClienteID: ClienteID
                },
                success: function (data) {
                    var result = data.Success;
                    $("#PagoTotal").dialog("close");
                    if (result) {
                        (window.alertSuccess || window.alert)("Pago recibido correctamente.", "Éxito");
                        PopupDetalleFactura_Load();
                        if (data.PagoID && data.FacturaID) {
                            imprimirReciboPago(data.PagoID, data.FacturaID);
                        }
                    } else {
                        (window.alertError || window.alert)("Error de Sistema. Contacte con el Administrador.", "Error");
                    }
                },
                error: function (xhr, status, error) {
                    var msg = "Error al registrar el pago. ";
                    if (xhr.status === 500) msg += "Error interno del servidor.";
                    else if (xhr.status === 0) msg += "Verifique su conexión.";
                    else if (xhr.responseText) msg += (xhr.responseText.substring(0, 150) || error);
                    (window.alertError || window.alert)(msg, "Error");
                }
            });
        });
    });
</script>
