@using MAT.Enums
@using MAT.Utilities
@using MAT.MVC.Infrastructure
@{
    ViewBag.Title = "Clientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var categorias = SeguimientoCatalog.GetCategorias();
    var tiposCliente = Enum.GetValues(typeof(eTipoCliente)).Cast<eTipoCliente>();
}

@section Styles {
    <link href="@Url.Content("~/Content/mat.clientes.listado.css?v=20261105a")" rel="stylesheet" />
}

<div class="modern-page-container clientes-listado">
    <div class="modern-page-header">
        <h1 class="modern-page-title">
            <i class="bi bi-people" aria-hidden="true"></i>
            <span>Clientes</span>
        </h1>
        <div class="modern-page-actions">
            <button type="button" class="btn-modern btn-modern-secondary" onclick="openClientesNuevosModal()">
                <i class="bi bi-calendar-range" aria-hidden="true"></i>
                <span>Altas por período</span>
            </button>
            <a href="@Url.Action("Create", "PersonaCliente")" class="btn-modern btn-modern-primary">
                <i class="bi bi-person-plus" aria-hidden="true"></i>
                <span>Nuevo cliente</span>
            </a>
        </div>
    </div>

    @if (TempData["aviso"] != null)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2" role="status">
            <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
            <span>@TempData["aviso"]</span>
        </div>
    }

    <form id="clFiltros" class="cl-filtros" role="search" autocomplete="off" onsubmit="return false;">
        <div class="cl-buscador">
            <label for="clTexto" class="visually-hidden">Buscar cliente</label>
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" id="clTexto" class="modern-form-input" placeholder="Nombre, DNI, teléfono o email"
                   aria-describedby="clAyuda" />
            <button type="button" id="clLimpiar" class="cl-limpiar d-none" aria-label="Limpiar búsqueda"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="cl-filtro">
            <label for="clTipo" class="modern-form-label">Tipo de cliente</label>
            <select id="clTipo" class="modern-form-select">
                <option value="">Todos</option>
                @foreach (var t in tiposCliente)
                {
                    <option value="@((int)t)">@t.GetDescription()</option>
                }
            </select>
        </div>
        <div class="cl-filtro">
            <label for="clCategoria" class="modern-form-label">Categoría</label>
            <select id="clCategoria" class="modern-form-select">
                <option value="">Todas</option>
                @foreach (var c in categorias)
                {
                    <option value="@c.Codigo">@c.Nombre</option>
                }
            </select>
        </div>
        <p id="clAyuda" class="cl-ayuda">Podés escribir el DNI o el teléfono con o sin puntos, guiones ni espacios, y varias palabras en cualquier orden.</p>
    </form>

    <div class="cl-barra" aria-live="polite">
        <span id="clContador" class="cl-contador">Buscando…</span>
        <label class="cl-inactivos form-check mb-0">
            <input type="checkbox" id="clInactivos" class="form-check-input" />
            <span class="form-check-label">Mostrar dados de baja</span>
        </label>
        <label class="cl-tamanio">
            <span>Por página</span>
            <select id="clTamanio" class="modern-form-select">
                <option value="25">25</option>
                <option value="50">50</option>
                <option value="100">100</option>
            </select>
        </label>
    </div>

    <div id="clError" class="alert alert-danger d-none" role="alert"></div>

    <div class="cl-tabla-wrap">
        <table class="cl-tabla" aria-describedby="clContador">
            <thead>
                <tr>
                    <th scope="col" aria-sort="ascending"><button type="button" class="cl-orden" data-orden="apellido">Cliente <i class="bi" aria-hidden="true"></i></button></th>
                    <th scope="col" aria-sort="none"><button type="button" class="cl-orden" data-orden="documento">Documento <i class="bi" aria-hidden="true"></i></button></th>
                    <th scope="col">Contacto</th>
                    <th scope="col">Categoría</th>
                    <th scope="col" aria-sort="none"><button type="button" class="cl-orden" data-orden="alta">Alta <i class="bi" aria-hidden="true"></i></button></th>
                    <th scope="col" class="text-end"><span class="visually-hidden">Acciones</span></th>
                </tr>
            </thead>
            <tbody id="clFilas"></tbody>
        </table>
    </div>

    <div id="clVacio" class="modern-empty-state d-none">
        <i class="bi bi-person-x" aria-hidden="true"></i>
        <h2 class="h5">No se encontraron clientes</h2>
        <p class="text-muted">Probá con menos palabras o sacá los filtros.</p>
    </div>

    <nav id="clPaginacion" class="cl-paginacion" aria-label="Páginas de clientes"></nav>
</div>

@Html.Partial("_ModalClientesNuevosPorPeriodo")

@section Scripts {
    <script src="@Url.Content("~/Scripts/mat.clientes.listado.js?v=20261105a")"></script>
    <script>
        MatClientesListado.init({
            urlBuscar: "@Url.Action("Buscar", "PersonaCliente")",
            urlFicha: "@Url.Action("Details", "PersonaCliente")",
            urlEditar: "@Url.Action("Edit", "PersonaCliente")"
        });
    </script>
}
