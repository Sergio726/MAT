@model MAT.Entities.PersonaCliente
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Detalle de Cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-person-vcard"></i>
            <span>@Model.Apellido, @Model.Nombre</span>
            <span class="client-type-badge ms-2">
                <i class="bi bi-tag-fill"></i>
                @(((eTipoCliente)Model.TipoId).ToString())
            </span>
        </h2>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Edit", "PersonaCliente", new { id = Model.PersonaId })" class="btn-modern btn-modern-primary">
                <i class="bi bi-pencil"></i>
                <span>Editar</span>
            </a>
            <a href="@Url.Action("Index", "PersonaCliente")" class="btn-modern btn-modern-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Volver a lista de clientes</span>
            </a>
        </div>
    </div>

    <div class="d-flex flex-column gap-3">
        <!-- Datos personales -->
        <section class="modern-card" aria-labelledby="heading-datos-personales">
            <div class="modern-card-header">
                <h3 id="heading-datos-personales" class="modern-card-title">
                    <i class="bi bi-person me-2"></i>
                    <span>Datos personales</span>
                </h3>
            </div>
            <div class="modern-card-content">
                <div class="modern-detail-grid">
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">ID Cliente</span>
                        <span class="modern-detail-value">@Model.PersonaId</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Apellido</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Apellido) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Apellido) ? "Sin definir" : Model.Apellido)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Nombre</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Nombre) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Nombre) ? "Sin definir" : Model.Nombre)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Tipo de documento</span>
                        <span class="modern-detail-value">@(((eTipoDocumento)Model.TipoDocumento).ToString())</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">N° de documento</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.NroDocumento) ? "empty" : "")">@(string.IsNullOrEmpty(Model.NroDocumento) ? "Sin definir" : Model.NroDocumento)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Fecha de nacimiento</span>
                        <span class="modern-detail-value">@(Model.FechaNacimiento.HasValue ? Model.FechaNacimiento.Value.ToString("dd/MM/yyyy") : "Sin definir")</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Sexo</span>
                        <span class="modern-detail-value">@(((eSexo)Model.Sexo).ToString())</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Nacionalidad</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Nacionalidad) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Nacionalidad) ? "Sin definir" : Model.Nacionalidad)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">País de residencia</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.PaisResidencia) ? "empty" : "")">@(string.IsNullOrEmpty(Model.PaisResidencia) ? "Sin definir" : Model.PaisResidencia)</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Información de contacto -->
        <section class="modern-card" aria-labelledby="heading-contacto">
            <div class="modern-card-header">
                <h3 id="heading-contacto" class="modern-card-title">
                    <i class="bi bi-telephone me-2"></i>
                    <span>Información de contacto</span>
                </h3>
            </div>
            <div class="modern-card-content">
                <div class="modern-detail-grid">
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Domicilio</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Domicilio) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Domicilio) ? "Sin definir" : Model.Domicilio)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Teléfono</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Telefono) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Telefono) ? "Sin definir" : Model.Telefono)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Celular</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Celular) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Celular) ? "Sin definir" : Model.Celular)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Email</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Email) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Email) ? "Sin definir" : Model.Email)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Fax</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Fax) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Fax) ? "Sin definir" : Model.Fax)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Web</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Web) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Web) ? "Sin definir" : Model.Web)</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Ubicación -->
        <section class="modern-card" aria-labelledby="heading-ubicacion">
            <div class="modern-card-header">
                <h3 id="heading-ubicacion" class="modern-card-title">
                    <i class="bi bi-geo-alt me-2"></i>
                    <span>Ubicación</span>
                </h3>
            </div>
            <div class="modern-card-content">
                <div class="modern-detail-grid">
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Provincia</span>
                        <span class="modern-detail-value @(!Model.Provincia.HasValue ? "empty" : "")">
                            @if (Model.Provincia.HasValue) { @Helper.ToSelectItem("Provincia", Model.Provincia.Value.ToString()) } else { <span>Sin definir</span> }
                        </span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Localidad</span>
                        <span class="modern-detail-value">@Helper.ToSelectItem("Localidad", Model.LocalidadId.ToString())</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Datos fiscales y empresa -->
        <section class="modern-card" aria-labelledby="heading-fiscales">
            <div class="modern-card-header">
                <h3 id="heading-fiscales" class="modern-card-title">
                    <i class="bi bi-receipt me-2"></i>
                    <span>Datos fiscales y empresa</span>
                </h3>
            </div>
            <div class="modern-card-content">
                <div class="modern-detail-grid">
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Razón social</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.RazonSocial) ? "empty" : "")">@(string.IsNullOrEmpty(Model.RazonSocial) ? "Sin definir" : Model.RazonSocial)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">CUIT/CUIL</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Cuit) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Cuit) ? "Sin definir" : Model.Cuit)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Condición IVA</span>
                        <span class="modern-detail-value">@(((eCondicionIVA)Model.CondicionIva).GetDescription())</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Forma de pago</span>
                        <span class="modern-detail-value">@(((eFormaPago)Model.FormaPago).ToString())</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Empresa</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Empresa) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Empresa) ? "Sin definir" : Model.Empresa)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Ocupación</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Ocupacion) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Ocupacion) ? "Sin definir" : Model.Ocupacion)</span>
                    </div>
                </div>
            </div>
        </section>

        <!-- Información adicional -->
        <section class="modern-card" aria-labelledby="heading-adicional">
            <div class="modern-card-header">
                <h3 id="heading-adicional" class="modern-card-title">
                    <i class="bi bi-info-circle me-2"></i>
                    <span>Información adicional</span>
                </h3>
            </div>
            <div class="modern-card-content">
                <div class="modern-detail-grid">
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Tipo de cliente</span>
                        <span class="modern-detail-value">@(((eTipoCliente)Model.TipoId).ToString())</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Vendedor asignado</span>
                        <span class="modern-detail-value">@(Model.VendedorId.HasValue ? Helper.GetVendedorName(Model.VendedorId.Value) : "Sin asignar")</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Idioma</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Idioma) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Idioma) ? "Sin definir" : Model.Idioma)</span>
                    </div>
                    <div class="modern-detail-group">
                        <span class="modern-detail-label">Promotor</span>
                        <span class="modern-detail-value @(string.IsNullOrEmpty(Model.Promotor) ? "empty" : "")">@(string.IsNullOrEmpty(Model.Promotor) ? "Sin definir" : Model.Promotor)</span>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Observacion))
                {
                    <div class="modern-detail-group mt-3">
                        <span class="modern-detail-label">Observaciones</span>
                        <span class="modern-detail-value" style="white-space: pre-wrap;">@Model.Observacion</span>
                    </div>
                }
            </div>
        </section>
    </div>
</div>
