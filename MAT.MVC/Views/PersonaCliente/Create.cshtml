@model MAT.MVC.Models.Clientes.ClienteFormModel
@{
    ViewBag.Title = "Nuevo cliente";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="@Url.Content("~/Content/mat.clientes.form.css?v=20261104a")" rel="stylesheet" />
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h1 class="modern-page-title">
            <i class="bi bi-person-plus" aria-hidden="true"></i>
            <span>Nuevo cliente</span>
        </h1>
    </div>

    @if (TempData["ok"] != null)
    {
        <div class="alert alert-success d-flex align-items-center gap-2" role="status">
            <i class="bi bi-check-circle" aria-hidden="true"></i>
            <span>@TempData["ok"]</span>
        </div>
    }

    @Html.Partial("_ClienteForm", Model)
</div>

@section Scripts {
    @* jQuery Validate y la validación discreta ya los carga _Layout: cargarlos otra vez (bundle jqueryval) reemplaza las reglas propias. *@
    <script src="@Url.Content("~/Scripts/mat.clientes.form.js?v=20261104b")"></script>
    <script>
        MatClienteForm.init({
            urlDocumento: "@Url.Action("DocumentoDisponible", "PersonaCliente")",
            urlFicha: "@Url.Action("Details", "PersonaCliente")",
            urlInfoLocalidad: "@Url.Action("GetInfoByLocalidadId", "Localidad")"
        });
    </script>
}
