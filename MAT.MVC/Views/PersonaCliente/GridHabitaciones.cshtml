@model List<MAT.MVC.Models.HabitacionDisponibilidad>

<script type="text/javascript">
    $(document).ready(function () {
        $("#GridHabitacion").DataTable({
            "searching": false,
            "bLengthChange": false
        })
    })
    
    
</script>

<input type="hidden" id="input-viaje-id" value="@ViewData["viajeid"]" />

<table id="GridHabitacion" class="mat-customtable">
    <thead>
        <tr>
            <th>
                   N° - HAB
            </th>
            <th>
                Hotel
            </th>
             <th>
                Tipo
            </th>
            <th>
                Disponibilidad
            </th>
            <th style="min-width:10px;"></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.NroHabitacion @item.HabitacionNombre
                </td>
                <td>
                    @item.HotelNombre
                </td>
                <td>
                    @item.HabitacionTipo
                </td>                
                <td>
                    @item.Disponibilidad
                </td>
                <td id="td-@item.HabitacionID">
                    @if (item.Disponibilidad > 0 && ViewBag.HabitacionSelected == null)
                    {
                       <a class="aReserva btn btn-inverse btn-small" data-viaje="@ViewData["viajeid"]" data-habitacionid="@item.HabitacionID" id="@item.HabitacionID">Reservar</a>    
                    }
                    else if (item.HabitacionID == ViewBag.HabitacionSelected)
                    {
                        
                        <a href="javascript:eliminarReservaHotel('@ViewBag.PasajeroId','@ViewBag.HabitacionSelected','@ViewData["viajeid"].ToString()');"><div class='divDelete' title='Eliminar reserva de habitación.' ></div></a>
                    }             
                                     
                                       
                </td>
            </tr>
        }
    </tbody>
</table>

<script type="text/javascript">
    $(function () {
        $("table tbody tr:odd").addClass("odd");
    });
</script>
