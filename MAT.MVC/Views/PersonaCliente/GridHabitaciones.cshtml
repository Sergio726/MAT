@model List<MAT.MVC.Models.HabitacionDisponibilidad>

<style>
    .habitacion-grid-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }
    .habitacion-grid-table thead th {
        background: #f8f9fa;
        padding: 0.75rem;
        text-align: left;
        font-weight: 600;
        color: #374151;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 2px solid #e5e7eb;
    }
    .habitacion-grid-table tbody td {
        padding: 0.75rem;
        border-bottom: 1px solid #f3f4f6;
        color: #1f2937;
    }
    .habitacion-grid-table tbody tr:hover {
        background: #f9fafb;
    }
    .habitacion-grid-table tbody tr:nth-child(odd) {
        background: #fafafa;
    }
    .habitacion-grid-table tbody tr:nth-child(odd):hover {
        background: #f3f4f6;
    }
    .disponibilidad-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 28px;
        height: 28px;
        padding: 0 0.5rem;
        border-radius: 0.375rem;
        font-weight: 600;
        font-size: 0.8rem;
    }
    .disponibilidad-badge.available {
        background: #dcfce7;
        color: #15803d;
    }
    .disponibilidad-badge.unavailable {
        background: #fee2e2;
        color: #dc2626;
    }
    .btn-reservar {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        padding: 0.375rem 0.75rem;
        background: linear-gradient(135deg, #e91e63 0%, #c2185b 100%);
        color: white;
        border: none;
        border-radius: 0.375rem;
        font-size: 0.75rem;
        font-weight: 500;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-reservar:hover {
        box-shadow: 0 2px 6px rgba(233, 30, 99, 0.3);
        color: white;
        text-decoration: none;
    }
    .btn-eliminar-reserva {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: #fee2e2;
        color: #dc2626;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .btn-eliminar-reserva:hover {
        background: #fecaca;
        color: #b91c1c;
    }
    .btn-eliminar-reserva i {
        font-size: 0.875rem;
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        $("#GridHabitacion").DataTable({
            "searching": false,
            "bLengthChange": false
        })
    })
</script>

<input type="hidden" id="input-viaje-id" value="@ViewData["viajeid"]" />

<table id="GridHabitacion" class="habitacion-grid-table">
    <thead>
        <tr>
            <th>N° - HAB</th>
            <th>Hotel</th>
            <th>Tipo</th>
            <th>Disponibilidad</th>
            <th style="width: 100px;"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <strong>@item.NroHabitacion</strong> @item.HabitacionNombre
                </td>
                <td>@item.HotelNombre</td>
                <td>@item.HabitacionTipo</td>
                <td>
                    <span class="disponibilidad-badge @(item.Disponibilidad > 0 ? "available" : "unavailable")">
                        @item.Disponibilidad
                    </span>
                </td>
                <td id="td-@item.HabitacionID">
                    @if (item.Disponibilidad > 0 && ViewBag.HabitacionSelected == null)
                    {
                        <a class="aReserva btn-reservar" data-viaje="@ViewData["viajeid"]" data-habitacionid="@item.HabitacionID" id="@item.HabitacionID">
                            <i class="bi bi-check-lg"></i>
                            Reservar
                        </a>
                    }
                    else if (item.HabitacionID == ViewBag.HabitacionSelected)
                    {
                        <a href="javascript:eliminarReservaHotel('@ViewBag.PasajeroId','@ViewBag.HabitacionSelected','@ViewData["viajeid"].ToString()');" class="btn-eliminar-reserva" title="Eliminar reserva de habitación">
                            <i class="bi bi-trash3"></i>
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
