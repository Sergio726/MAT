@model MAT.MVC.Models.EliminarVentaModel

<style>
    .eliminar-venta-container {
        padding: 1.5rem;
        text-align: center;
    }
    .eliminar-venta-icon {
        width: 60px;
        height: 60px;
        background: #fee2e2;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    .eliminar-venta-icon i {
        font-size: 1.75rem;
        color: #dc2626;
    }
    .eliminar-venta-title {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }
    .eliminar-venta-description {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }
    .eliminar-venta-form {
        max-width: 280px;
        margin: 0 auto;
    }
    .form-group-modern {
        margin-bottom: 1.25rem;
        text-align: left;
    }
    .form-label-modern {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.375rem;
    }
    .form-input-modern {
        width: 100%;
        padding: 0.625rem 0.875rem;
        border: 1px solid #d1d5db;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }
    .form-input-modern:focus {
        outline: none;
        border-color: #e91e63;
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .btn-eliminar-confirm {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        width: 100%;
        padding: 0.75rem 1.25rem;
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 0.5rem;
        font-size: 0.875rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-eliminar-confirm:hover {
        background: #b91c1c;
    }
    .btn-eliminar-confirm:active {
        transform: scale(0.98);
    }
</style>

<div class="eliminar-venta-container">
    <div class="eliminar-venta-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <div class="eliminar-venta-title">Confirmar eliminación</div>
    <p class="eliminar-venta-description">
        Para eliminar esta venta, ingrese el código de seguridad asignado por el administrador del sistema.
    </p>

    <div class="eliminar-venta-form">
        <div class="form-group-modern">
            <label class="form-label-modern" for="Codigo">Código de Seguridad</label>
            <input type="password" name="Codigo" id="Codigo" class="form-input-modern" placeholder="Ingrese el código" />
        </div>

        <input type="hidden" id="FacturaId" name="FacturaId" value="@Model.FacturaId" />
        <input type="hidden" id="ClienteId" name="ClienteId" value="@Model.ClienteId" />

        <button type="button" name="btnEliminarVenta" id="btnEliminarVenta" class="btn-eliminar-confirm">
            <i class="bi bi-trash3"></i>
            Eliminar Venta
        </button>
    </div>
</div>
