@model MAT.MVC.Models.EliminarVentaModel

<style>
    .eliminar-venta-container {
        padding: 1.5rem;
        text-align: center;
    }
    .eliminar-venta-icon {
        width: 60px;
        height: 60px;
        background: #fee2e2;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem;
    }
    .eliminar-venta-icon i {
        font-size: 1.75rem;
        color: #dc2626;
    }
    .eliminar-venta-title {
        font-size: 1rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 0.5rem;
    }
    .eliminar-venta-description {
        font-size: 0.875rem;
        color: #6b7280;
        margin-bottom: 1.5rem;
        line-height: 1.5;
    }
    .eliminar-venta-form {
        max-width: 280px;
        margin: 0 auto;
    }
</style>

<div class="eliminar-venta-container">
    <div class="eliminar-venta-icon">
        <i class="bi bi-exclamation-triangle"></i>
    </div>
    <div class="eliminar-venta-title">Confirmar eliminación</div>
    <p class="eliminar-venta-description">
        Para eliminar esta venta, ingrese el código de seguridad asignado por el administrador del sistema.
    </p>

    <div class="eliminar-venta-form">
        <div class="modern-form-group">
            <label class="modern-form-label" for="Codigo">Código de Seguridad</label>
            <input type="password" name="Codigo" id="Codigo" class="modern-form-input" placeholder="Ingrese el código" />
        </div>

        <input type="hidden" id="FacturaId" name="FacturaId" value="@Model.FacturaId" />
        <input type="hidden" id="ClienteId" name="ClienteId" value="@Model.ClienteId" />

        <button type="button" name="btnEliminarVenta" id="btnEliminarVenta" class="btn-modern btn-modern-danger">
            <i class="bi bi-trash3"></i>
            Eliminar Venta
        </button>
    </div>
</div>
