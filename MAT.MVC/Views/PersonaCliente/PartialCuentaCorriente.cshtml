@using MAT.MVC.Models
@model CuentaModel
@using MAT.Enums

<style>
    .cuenta-corriente-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    .cuenta-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .cuenta-table thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        text-align: left;
    }
    .cuenta-table tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .cuenta-table tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .valor-debe {
        font-weight: 500;
        color: #dc2626;
    }
    .valor-haber {
        font-weight: 500;
        color: #059669;
    }
    .btn-detalle {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        background: #dbeafe;
        color: #2563eb;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-detalle:hover {
        background: #2563eb;
        color: white;
    }
    .resumen-table {
        width: 100%;
        border-collapse: collapse;
        background: var(--bg-secondary, #f9fafb);
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .resumen-table thead th {
        background: var(--primary-color, #e91e63);
        padding: 0.625rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: white;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        text-align: center;
    }
    .resumen-table tbody td {
        padding: 0.875rem 1rem;
        font-size: 1rem;
        font-weight: 600;
        text-align: center;
    }
    .resumen-debe {
        color: #dc2626;
    }
    .resumen-haber {
        color: #059669;
    }
    .resumen-total {
        color: var(--primary-color, #e91e63);
    }
</style>

<div class="cuenta-corriente-container">
    <table class="cuenta-table">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Concepto</th>
                <th>Medio de Pago</th>
                <th>Debe</th>
                <th>Haber</th>
                <th style="width: 50px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (Resumen item in Model.ResumenCuenta)
            {
                <tr>
                    <td>@item.Fecha</td>
                    <td>@item.Descripcion</td>
                    <td>@(item.TipoPago != null ? ((eFormaPago)item.TipoPago).ToString() : "")</td>
                    <td><span class="valor-debe">@string.Format("-{0:C}", item.Debe)</span></td>
                    <td><span class="valor-haber">@string.Format("{0:C}", item.Haber)</span></td>
                    <td>
                        <a href="#" id="btn-resumen-linea" data-comprobanteid="@item.Comprobante" class="btn-detalle" title="Detalles">
                            <i class="bi bi-file-earmark-text"></i>
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <table class="resumen-table">
        <thead>
            <tr>
                <th>Total Debe</th>
                <th>Total Haber</th>
                <th>Total Unificado</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td class="resumen-debe">@string.Format("{0:C}", Model.TotalDebe)</td>
                <td class="resumen-haber">@string.Format("{0:C}", Model.TotalHaber)</td>
                <td class="resumen-total">@string.Format("{0:C}", Model.Unificado)</td>
            </tr>
        </tbody>
    </table>
</div>
