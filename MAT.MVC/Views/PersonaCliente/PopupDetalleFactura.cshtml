<div id="divPopupDetalleFactura">
    <div class="modern-loading-container">
        <div class="modern-loading-spinner"></div>
        <span class="modern-loading-text">Cargando detalle de factura...</span>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        PopupDetalleFactura_Load();
    });

    function PopupDetalleFactura_Load() {
        var FacturaID = "@ViewBag.FacturaID";
        $.ajax({
            url: "/PersonaCliente/DetalleFacturaFast",
            data: {
                facturaid: FacturaID
            },
            success: function (data) {
                $("#divPopupDetalleFactura").html(data);
            },
            error: function (e) {
                // Fallback: endpoint legacy (mantener operatividad si el SP nuevo aún no está deployado)
                $.ajax({
                    url: "/PersonaCliente/DetalleFactura",
                    data: { facturaid: FacturaID },
                    success: function (html) {
                        $("#divPopupDetalleFactura").html(html);
                    },
                    error: function (e2) {
                        var divError = '<div class="modern-alert-error"><i class="bi bi-exclamation-circle"></i><span>Se produjo un error. Contactese con el administrador.</span></div>';
                        $("#divPopupDetalleFactura").html(divError);
                        console.log(e2);
                    }
                });
                console.log(e);
            }
        })
    }


    // Pagos (Factura): un solo dialog top-level usando ShowFormDialog
    function pagosFactura(FacturaID) {
        if (typeof window.openPagosFacturaDialog === "function") {
            window.openPagosFacturaDialog(FacturaID);
        } else {
            var url = "/PersonaCliente/partialHistorialdePagosByFactura?FacturaID=" + encodeURIComponent(FacturaID || "");
            ShowFormDialog(url, "PopinPagosFactura", "Pagos", "wide");
        }
    }

    function cancelarPago(PagoID, FacturaID) {
        $.ajax({
            url: "/PersonaCliente/CancelarPago",
            data: { PagoID: PagoID },
            dataType: "html",
            success: function (data) {
                var response = eval(data);
                if (response[0] == "Done.") {
                    PopupDetalleFactura_Load();
                    // refrescar popin de pagos si está abierto
                    try {
                        if ($("#PopinPagosFactura").length && typeof $("#PopinPagosFactura").dialog === "function") {
                            $("#PopinPagosFactura").dialog("close");
                        }
                    } catch (e) { }
                    pagosFactura(FacturaID);
                } else {
                    console.log(response[1]);
                }
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>
<input type="hidden" id="hdnPasajeroID" value=""/>
<input type="hidden" id="hdnPasajeID" value="" />
<input type="hidden" id="hdnHabitacionID" value="" />


