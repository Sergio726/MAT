<div id="divPopupDetalleFactura">
    <div class="modern-loading-container">
        <div class="modern-loading-spinner"></div>
        <span class="modern-loading-text">Cargando detalle de factura...</span>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        PopupDetalleFactura_Load();
    });

    function PopupDetalleFactura_Load() {
        var FacturaID = "@ViewBag.FacturaID";
        $.ajax({
            url: "/PersonaCliente/DetalleFactura",
            data: {
                facturaid: FacturaID
            },
            success: function (data) {
                $("#divPopupDetalleFactura").html(data);
            },
            error: function (e) {
                var divError = '<div class="modern-alert-error"><i class="bi bi-exclamation-circle"></i><span>Se produjo un error. Contactese con el administrador.</span></div>';
                $("#divPopupDetalleFactura").html(divError);
                console.log(e);
            }
        })
    }


    //seccion pagos
    function pagosFactura(FacturaID) {
        //$(".ui-dialog-content").dialog("close");
        $("#divContentPagos_DetalleFactura").html(divLoading);

        var $dlg = $("#divPopup_DetalleFactura");
        var hasInstance = false;
        try { hasInstance = !!$dlg.dialog("instance"); } catch (e) { hasInstance = !!$dlg.data("ui-dialog"); }

        if (!hasInstance) {
            $dlg.dialog({
                autoOpen: false,
                modal: true,
                closeOnEscape: true,
                resizable: false,
                draggable: false,
                position: { my: 'center', at: 'center', of: window },
                width: "80%",
                dialogClass: "mat-pagos-dialog",
                open: function () {
                    var $self = $(this);
                    // asegurar que el X cierre
                    try {
                        var $w = $self.dialog("widget");
                        $w.find(".ui-dialog-titlebar-close")
                            .off("click.matPagosClose")
                            .on("click.matPagosClose", function (e) {
                                e.preventDefault();
                                $self.dialog("close");
                            });
                    } catch (e) { }
                }
            });
        }

        $dlg.dialog("open");
        
        $.ajax({
            url: "/PersonaCliente/partialHistorialdePagosByFactura",
            data: { FacturaID: FacturaID },
            dataType: "html",
            success: function (data) {
                $("#divContentPagos_DetalleFactura").html(data);
            },
            error: function (e) {
                console.log(e);
            }
        });
    }

    function cancelarPago(PagoID, FacturaID) {
        $.ajax({
            url: "/PersonaCliente/CancelarPago",
            data: { PagoID: PagoID },
            dataType: "html",
            success: function (data) {
                var response = eval(data);
                if (response[0] == "Done.") {
                    PopupDetalleFactura_Load();
                    $("#divContentPagos_DetalleFactura").dialog("close");
                    pagosFactura(FacturaID);
                } else {
                    console.log(response[1]);
                }
            },
            error: function (e) {
                console.log(e);
            }
        });
    }
</script>
<input type="hidden" id="hdnPasajeroID" value=""/>
<input type="hidden" id="hdnPasajeID" value="" />
<input type="hidden" id="hdnHabitacionID" value="" />

<div id="divPopup_DetalleFactura" title="Pagos" style="display:none;">
    <div id="divContentPagos_DetalleFactura"></div>
</div>
