@using MAT.Entities
@using MAT.Enums
@using MAT.Utilities
@using MAT.MVC.Models

@model FacturaStandard
@{
    Guid FacturaID = Model.FacturaID;
    Guid ClienteID = Model.ClienteID;
    double dTotal = 0;
    double dTotalPagos = Model.Monto - Model.Saldo;
}

<style>
    .factura-detail-container {
        padding: 0.5rem;
    }
    .factura-info-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 0.75rem;
        margin-bottom: 1.25rem;
    }
    .factura-info-item {
        display: flex;
        flex-direction: column;
        gap: 0.25rem;
    }
    .factura-info-item.full-width {
        grid-column: span 2;
    }
    .factura-info-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }
    .factura-info-value {
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        padding: 0.5rem 0.625rem;
        background: var(--bg-secondary, #f9fafb);
        border-radius: 0.375rem;
        display: flex;
        align-items: center;
        gap: 0.375rem;
    }
    .factura-info-value i {
        color: var(--primary-color, #e91e63);
        font-size: 0.875rem;
    }
    .factura-info-value .currency-badge {
        background: var(--primary-color, #e91e63);
        color: white;
        padding: 0.125rem 0.375rem;
        border-radius: 0.25rem;
        font-size: 0.7rem;
        font-weight: 600;
        margin-left: 0.25rem;
    }
    .factura-section {
        margin-bottom: 1rem;
    }
    .factura-section-title {
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        padding: 0.5rem 0.75rem;
        background: var(--bg-secondary, #f3f4f6);
        border-radius: 0.375rem 0.375rem 0 0;
        border-bottom: 2px solid var(--primary-color, #e91e63);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .factura-section-title i {
        color: var(--primary-color, #e91e63);
    }
    .factura-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.8rem;
    }
    .factura-table thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.5rem;
        text-align: left;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        font-size: 0.7rem;
        text-transform: uppercase;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .factura-table tbody td {
        padding: 0.5rem;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        color: var(--text-primary, #1f2937);
    }
    .factura-table tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .factura-table tfoot th {
        background: var(--bg-secondary, #f3f4f6);
        padding: 0.625rem 0.5rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        border-top: 2px solid var(--border-color, #e5e7eb);
    }
    .btn-action-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border-radius: 0.375rem;
        border: none;
        cursor: pointer;
        transition: all 0.2s ease;
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-secondary, #6b7280);
        text-decoration: none;
    }
    .btn-action-icon:hover {
        background: var(--primary-color, #e91e63);
        color: white;
    }
    .btn-eliminar-pasajero {
        background: #fee2e2;
        color: #dc2626;
    }
    .btn-eliminar-pasajero:hover {
        background: #dc2626;
        color: white;
    }
    .btn-eliminar-pasajero:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }
    .factura-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
        margin-top: 1rem;
    }
    .btn-factura {
        display: inline-flex;
        align-items: center;
        gap: 0.375rem;
        padding: 0.5rem 0.875rem;
        border-radius: 0.375rem;
        font-weight: 500;
        font-size: 0.75rem;
        text-decoration: none;
        transition: all 0.2s ease;
        border: none;
        cursor: pointer;
    }
    .btn-factura-primary {
        background: var(--primary-color, #e91e63);
        color: white !important;
    }
    .btn-factura-primary:hover {
        background: var(--primary-hover, #d81b60);
        color: white !important;
        text-decoration: none;
    }
    .btn-factura-secondary {
        background: var(--bg-secondary, #f3f4f6);
        color: var(--text-primary, #374151);
        border: 1px solid var(--border-color, #e5e7eb);
    }
    .btn-factura-secondary:hover {
        background: var(--border-color, #e5e7eb);
        color: var(--text-primary, #374151);
        text-decoration: none;
    }
    .btn-factura-danger {
        background: #fee2e2;
        color: #dc2626;
        border: 1px solid #fecaca;
    }
    .btn-factura-danger:hover {
        background: #fecaca;
        color: #dc2626;
        text-decoration: none;
    }
    .dialog-hidden {
        display: none;
    }
    .dialog-content {
        padding: 1rem;
    }
    .dialog-content .form-group {
        margin-bottom: 0.75rem;
    }
    .dialog-content label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-secondary, #6b7280);
        margin-bottom: 0.25rem;
    }
    .dialog-content input[type="number"],
    .dialog-content input[type="text"] {
        width: 100%;
        padding: 0.5rem 0.75rem;
        border: 1px solid var(--border-color, #e5e7eb);
        border-radius: 0.375rem;
        font-size: 0.875rem;
    }
    .dialog-content input:focus {
        outline: none;
        border-color: var(--primary-color, #e91e63);
        box-shadow: 0 0 0 3px rgba(233, 30, 99, 0.1);
    }
    .dialog-content .radio-group {
        display: flex;
        gap: 1rem;
        margin: 0.5rem 0;
    }
    .dialog-content .radio-group label {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        cursor: pointer;
    }
    @@media (max-width: 480px) {
        .factura-info-grid {
            grid-template-columns: 1fr;
        }
        .factura-info-item.full-width {
            grid-column: span 1;
        }
        .factura-actions {
            flex-direction: column;
        }
        .btn-factura {
            justify-content: center;
        }
    }
</style>

<div class="factura-detail-container">
    @{
        string sUSD = "";
        if (Model.MonedaTipo != 1)
        {
            sUSD = "USD";
        }
    }

    <!-- Informacion de la Factura -->
    <div class="factura-info-grid">
        <div class="factura-info-item">
            <span class="factura-info-label">Monto</span>
            <span class="factura-info-value">
                <i class="bi bi-currency-dollar"></i>
                @String.Format("{0:C}", Model.Monto)
                @if (!string.IsNullOrEmpty(sUSD))
                {
                    <span class="currency-badge">@sUSD</span>
                }
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Saldo</span>
            <span class="factura-info-value">
                <i class="bi bi-wallet2"></i>
                @String.Format("{0:C}", Model.Saldo)
                @if (!string.IsNullOrEmpty(sUSD))
                {
                    <span class="currency-badge">@sUSD</span>
                }
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Fecha</span>
            <span class="factura-info-value">
                <i class="bi bi-calendar3"></i>
                @Model.Fecha
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Cliente</span>
            <span class="factura-info-value">
                <i class="bi bi-person"></i>
                @(Model.ClienteApellido + " " + Model.ClienteNombre)
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Vendedor</span>
            <span class="factura-info-value">
                <i class="bi bi-person-badge"></i>
                @(Model.VendedorApellido + " " + Model.VendedorNombre)
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Paquete</span>
            <span class="factura-info-value">
                <i class="bi bi-box-seam"></i>
                @Model.PaqueteDescripcion
            </span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Observaciones))
        {
            <div class="factura-info-item full-width">
                <span class="factura-info-label">Observaciones</span>
                <span class="factura-info-value">
                    <i class="bi bi-chat-left-text"></i>
                    @Model.Observaciones
                </span>
            </div>
        }
    </div>

    <!-- Tabla de Pasajeros/Butacas -->
    <div class="factura-section">
        <div class="factura-section-title">
            <i class="bi bi-people"></i>
            Pasajeros
        </div>
        <table class="factura-table">
            <thead>
                <tr>
                    <th>Butaca</th>
                    <th>Pasajero</th>
                    <th style="width: 70px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FacturaDetalle item in ViewBag.FacturaDetalle)
                {
                    <tr>
                        <td>
                            <strong>@item.ButacaNro</strong>
                        </td>
                        <td>@item.PasajeroNombre @item.PasajeroApellido</td>
                        <td>
                            <div style="display: flex; gap: 0.25rem;">
                                <a href="#" class="btn-action-icon btn-editar-butaca" id="btn-editar-butaca" data-anterior="@item.ButacaID" data-pasaje="@item.PasajeID" title="Editar Butaca">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (item.HabitacionID != new Guid("00000000-0000-0000-0000-000000000000") && item.HabitacionID != null)
                                {
                                    <a href="#" class="btn-action-icon btn-editar-habitacion" id="btn-editar-habitacion" title="Editar Habitacion" data-factura="@(Model.FacturaID.ToString() ?? "")" data-anterior="@item.HabitacionID" data-pasaje="@item.PasajeID" data-viaje="@item.ViajeID" data-pasajero="@item.PasajeroID">
                                        <i class="bi bi-door-open"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="#" class="btn-action-icon btn-editar-habitacion" id="btn-editar-habitacion" title="Agregar Habitacion" data-factura="@(Model.FacturaID.ToString() ?? "")" data-pasaje="@item.PasajeID" data-viaje="@item.ViajeID" data-pasajero="@item.PasajeroID">
                                        <i class="bi bi-door-open"></i>
                                    </a>
                                }
                                <a href="#" class="btn-action-icon btn-eliminar-pasajero" data-pasaje="@item.PasajeID" data-factura="@Model.FacturaID" data-pasajero="@item.PasajeroNombre @item.PasajeroApellido" title="Eliminar Pasajero">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Tabla de Menores (si existen) -->
    @if (ViewBag.ListMenores.Count > 0)
    {
        <div class="factura-section">
            <div class="factura-section-title">
                <i class="bi bi-shield-check"></i>
                Seguro Menor
            </div>
            <table id="tblListMenores" class="factura-table">
                <thead>
                    <tr>
                        <th style="width: 40px;">#</th>
                        <th>Responsable del menor</th>
                        <th>Menor a cargo</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 0;}
                    @foreach (PasajeroMenorModel item in ViewBag.ListMenores)
                    {
                        i++;
                        if (item.PasajeroMenorID != 0)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@(item.ApellidoMayor + ", " + item.NombreMayor + " Doc.: " + item.DocMayor)</td>
                                <td>@(item.ApellidoMenor + ", " + item.NomreMenor + " Doc.: " + item.DocMenor)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Tabla de Items -->
    <div class="factura-section">
        <div class="factura-section-title">
            <i class="bi bi-list-ul"></i>
            Items
        </div>
        <table class="factura-table">
            <thead>
                <tr>
                    <th style="width: 40px;">#</th>
                    <th>Fecha</th>
                    <th>Detalle</th>
                    <th style="width: 60px;">Cant.</th>
                    <th>Precio</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int iNro = 0;
                    foreach (DBOFacturaDetalle item in ViewBag.ExtendFacturaDetalle)
                    {
                        iNro += 1;
                        dTotal += item.Precio;
                        <tr>
                            <td>@iNro</td>
                            <td>@item.Fecha</td>
                            <td>@item.Detalle</td>
                            <td>@item.Cantidad</td>
                            <td>
                                <div style="display: flex; align-items: center; gap: 0.375rem;">
                                    <span>@String.Format("{0:C}", item.Precio)</span>
                                    @if (item.Detalle.Contains("PAQUETE"))
                                    {
                                        <a href="javascript: fnCambiarPrecio('@item.Id','@Model.FacturaID');" title="Cambiar Precio" class="btn-action-icon" style="width: 24px; height: 24px;">
                                            <i class="bi bi-pencil" style="font-size: 0.7rem;"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" style="text-align: right;">Total</th>
                    <th>@String.Format("{0:C}", dTotal)</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Acciones -->
    <div class="factura-actions">
        @if (Model.Estado == (int)eEstadoFactura.Pagado)
        {
            <a href="#" id="btn-imprimirvouchers" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-primary">
                <i class="bi bi-printer"></i>
                Imprimir Vouchers
            </a>
            <a href="#" id="btn-notacredito" data-facturaid="@FacturaID" data-clienteid="@ClienteID" data-fecha="@Model.Fecha" data-monto="@Model.Monto" class="btn-factura btn-factura-secondary">
                <i class="bi bi-file-earmark-minus"></i>
                Nota de Credito
            </a>
        }
        else
        {
            <a href="#" id="btn-abrirregistrarpago" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-primary">
                <i class="bi bi-cash"></i>
                Pago Parcial
            </a>
            <a href="#" id="btn-abrirpagototal" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-primary">
                <i class="bi bi-cash-stack"></i>
                Pago Total
            </a>
            <a href="#" id="btn-descuentoRecargo" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-secondary" onclick="javascript: $('#divDescuentoRecargo').dialog({width: 400,modal: true});">
                <i class="bi bi-percent"></i>
                Descuento/Recargo
            </a>
            <a href="#" id="btn-notacredito" data-facturaid="@FacturaID" data-clienteid="@ClienteID" data-fecha="@Model.Fecha" data-monto="@Model.Monto" class="btn-factura btn-factura-secondary">
                <i class="bi bi-file-earmark-minus"></i>
                Nota de Credito
            </a>
        }
        <a href="javascript:pagosFactura('@FacturaID');" class="btn-factura btn-factura-secondary" title="Ver pagos de esta factura">
            <i class="bi bi-receipt"></i>
            Pagos
        </a>
        <a href="#" id="btn-eliminarventa" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-danger">
            <i class="bi bi-trash3"></i>
            Eliminar Venta
        </a>
    </div>
</div>

<!-- Dialogs -->
<div id="divSelectTipoVoucher" title="Tipo de Voucher" class="dialog-hidden">
    <div class="dialog-content">
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a href="javascript: imprimirVoucher('@FacturaID','Grupal');" class="btn-factura btn-factura-secondary" style="justify-content: center;">
                <i class="bi bi-people"></i>
                Grupal
            </a>
            <a href="javascript: imprimirVoucher('@FacturaID','Individual');" class="btn-factura btn-factura-secondary" style="justify-content: center;">
                <i class="bi bi-person"></i>
                Individual
            </a>
            <label style="display: flex; align-items: center; gap: 0.5rem; cursor: pointer; margin-top: 0.5rem;">
                <input type="checkbox" id="chkInfoAdicional" />
                <span>Incluir Informacion Adicional</span>
            </label>
        </div>
    </div>
</div>

<div id="Voucher_dialog-message" title="Atencion">
</div>

<div id="divDescuentoRecargo" title="Descuento/Recargo" class="dialog-hidden">
    <div class="dialog-content">
        <div class="form-group">
            <label for="nMonto">Monto <span style="color: #ef4444;">*</span></label>
            <input type="number" id="nMonto" min="0" max="100000" value="0" />
        </div>
        <div class="form-group">
            <label for="txtDetalleDR">Detalle <span style="color: #ef4444;">*</span></label>
            <input type="text" id="txtDetalleDR" maxlength="100" />
        </div>
        <div class="form-group">
            <label>Tipo</label>
            <div class="radio-group">
                <label>
                    <input type="radio" name="rDR" value="Descuento" checked />
                    Descuento
                </label>
                <label>
                    <input type="radio" name="rDR" value="Incremento" />
                    Incremento
                </label>
            </div>
        </div>
        <div style="margin-top: 1rem; text-align: right;">
            <button type="button" class="btn-factura btn-factura-primary" onclick="addDR()">
                <i class="bi bi-plus-lg"></i>
                Agregar
            </button>
        </div>
    </div>
</div>

<input type="hidden" id="hdnTotalPagos" value="@dTotalPagos" />
<input type="hidden" id="hdnViajeMonedaTipo" value="@Model.MonedaTipo" />

<script type="text/javascript">
    $(function () {
        if ($(".btn-editar-habitacion").length != $(".btn-editar-butaca").length) {
            alert("Opcion Imprimir Voucher no disponible. Debe reservar las habitaciones para el/los pasajero/s correspondientes.");
            $("#btn-imprimirvouchers").hide();
        }
        $("#btn-abrirregistrarpago").click(function () {
            var url = "/PersonaCliente/RegistrarPago?facturaid=" + $(this).data("facturaid") + "&clienteid=" + $(this).data("clienteid");
            var title = "Registrar Pago";
            var id = "RegistrarPago";
            ShowFormDialog(url, id, title);
        });

        //pago total habilitado solo para pesos ARG
        if ("@Model.MonedaTipo.ToString()" == "1") {
            $("#btn-abrirpagototal").click(function () {
                var url = "/PersonaCliente/RegistrarPagoTotal?facturaid=" + $(this).data("facturaid") + "&clienteid=" + $(this).data("clienteid");
                var title = "Pago Total de Factura";
                var id = "PagoTotal";
                ShowFormDialog(url, id, title);
            });
        }
        else {
            $("#btn-abrirpagototal").attr("disabled", "disabled");
            $("#btn-abrirpagototal").attr("title", "Solo habilitado para pago en Pesos.");
            $("#btn-abrirpagototal").css("opacity", "0.5");
            $("#btn-abrirpagototal").css("cursor", "not-allowed");
        }

        $("#btn-eliminarventa").click(function () {
            var url = "/PersonaCliente/EliminarVenta?facturaid=" + $(this).data("facturaid") + "&clienteid=" + $(this).data("clienteid");
            var title = "Eliminar Venta";
            var id = "EliminarVenta";
            ShowFormDialog(url, id, title, "min");
        });

        $("#aCheckInforAd, #chkInfoAdicional").click(function (e) {
            if (e.target.id === "aCheckInforAd") {
                $("#chkInfoAdicional").prop("checked", !$("#chkInfoAdicional").is(":checked"));
            }
        });

        // Manejar click en botón eliminar pasajero
        $(document).on("click", ".btn-eliminar-pasajero", function (e) {
            e.preventDefault();
            var pasajeID = $(this).data("pasaje");
            var facturaID = $(this).data("factura");
            var pasajeroNombre = $(this).data("pasajero");
            
            if (!confirm("¿Está seguro que desea eliminar al pasajero " + pasajeroNombre + " de esta factura?\n\nEsta acción:\n- Eliminará el pasajero de la factura\n- Liberará la butaca asignada\n- Liberará la habitación si tiene una asignada\n- Actualizará el monto total de la factura\n\nEsta acción no se puede deshacer.")) {
                return false;
            }
            
            // Mostrar loading
            var $btn = $(this);
            var originalHtml = $btn.html();
            $btn.html('<i class="bi bi-hourglass-split"></i>').prop('disabled', true);
            
            $.ajax({
                url: "/PersonaCliente/EliminarPasajeroDeFactura",
                type: "POST",
                data: {
                    pasajeID: pasajeID,
                    facturaID: facturaID
                },
                success: function (data) {
                    if (data[0] == "Done.") {
                        // Mostrar mensaje de éxito de manera moderna
                        if (typeof ShowSuccessMessage === 'function') {
                            ShowSuccessMessage(data[1], 'Operación Exitosa', function() {
                                // Recargar el detalle de la factura después de cerrar el mensaje
                                if (typeof window.PopupDetalleFactura_Load === 'function') {
                                    window.PopupDetalleFactura_Load();
                                } else if (typeof PopupDetalleFactura_Load === 'function') {
                                    PopupDetalleFactura_Load();
                                } else {
                                    // Si estamos en un popup/dialog, cerrarlo y recargar
                                    var $dialog = $('.ui-dialog:visible');
                                    if ($dialog.length > 0 && $dialog.find('#Detalles').length > 0) {
                                        // Estamos en el modal de detalle de factura
                                        setTimeout(function() {
                                            window.location.reload();
                                        }, 300);
                                    } else {
                                        location.reload();
                                    }
                                }
                            });
                        } else {
                            // Fallback a alert si la función no existe
                            alert(data[1]);
                            if (typeof window.PopupDetalleFactura_Load === 'function') {
                                window.PopupDetalleFactura_Load();
                            } else if (typeof PopupDetalleFactura_Load === 'function') {
                                PopupDetalleFactura_Load();
                            } else {
                                location.reload();
                            }
                        }
                    } else {
                        alert("Error: " + data[1]);
                        $btn.html(originalHtml).prop('disabled', false);
                    }
                },
                error: function (xhr, status, error) {
                    alert("Error al eliminar el pasajero. Por favor, intente nuevamente.");
                    console.error("Error:", error);
                    $btn.html(originalHtml).prop('disabled', false);
                }
            });
        });
    });

    function addDR() {
        var FacturaID = "@FacturaID";
        var Monto = $("#nMonto").val();
        var Detalle = $("#txtDetalleDR").val()
        if (Monto <= 0) {
            return alert("Debe agregar un monto.");
        }
        if (Detalle.trim() == '') {
            return alert("Debe ingresar un detalle.");
        }

        var DescuentoIncremento = $("input[name='rDR']:checked").val();

        $.ajax({
            url: "/PersonaCliente/AddDescuentoRecargo",
            data: {
                sFacturaID: FacturaID,
                sMonto: Monto,
                sDetalle: Detalle,
                sDescuentoIncremento: DescuentoIncremento
            },
            success: function (data) {
                if (data.Estado == "Done.") {
                    $('#divDescuentoRecargo').dialog('close');
                    PopupDetalleFactura_Load();
                }
                else {
                    alert("Se produjo un error. Contactese con el administrador.");
                    console.log(data.Estado);
                }
            },
            error: function (e) {
                alert("Se produjo un error. Contactese con el administrador.");
                console.log(e);
            }
        })
    }

    function fnCambiarPrecio(DetalleFacturaId, FacturaId) {
        var htmlLoading = "<div class='loading-container'><div class='loading-spinner'></div></div>";
        ShowFormDialogHTML(htmlLoading, "PopinPrecioList", "Cambiar Precio", "min");
        $.ajax({
            url: "/PersonaCliente/CambiarPrecioList",
            data: {
                DetalleFacturaId: DetalleFacturaId,
                FacturaId: FacturaId
            },
            success: function (data) {
                $("#PopinPrecioList").html(data);
            },
            error: function (e) {
                alert("Se produjo un error. Contactese con el administrador.");
                console.log(e);
            }
        })
    }

    // Función para mostrar pagos de la factura
    function pagosFactura(FacturaID) {
        var divLoading = "<div class='modern-loading-container' style='padding: 2rem;'><div class='modern-loading-spinner'></div><span class='modern-loading-text'>Cargando pagos...</span></div>";
        
        // Crear el div del popup si no existe
        if ($("#divPopup_DetalleFactura").length === 0) {
            $("body").append('<div id="divPopup_DetalleFactura" title="Pagos" style="display:none;"><div id="divContentPagos_DetalleFactura"></div></div>');
        }
        
        $("#divContentPagos_DetalleFactura").html(divLoading);
        $("#divPopup_DetalleFactura").dialog({
            modal: true,
            position: { my: 'center', at: 'center', of: window },
            width: "80%",
            open: function() {
                // Cargar los pagos
                $.ajax({
                    url: "/PersonaCliente/partialHistorialdePagosByFactura",
                    data: { FacturaID: FacturaID },
                    dataType: "html",
                    success: function (data) {
                        $("#divContentPagos_DetalleFactura").html(data);
                    },
                    error: function (e) {
                        $("#divContentPagos_DetalleFactura").html('<div class="modern-alert-error"><i class="bi bi-exclamation-circle"></i><span>Error al cargar los pagos</span></div>');
                        console.log(e);
                    }
                });
            }
        });
        $("#divPopup_DetalleFactura").dialog("open");
    }
</script>
