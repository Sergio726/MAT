@using MAT.Entities
@using MAT.Enums
@using MAT.Utilities
@using MAT.MVC.Models

@model FacturaStandard
@{
    Guid FacturaID = Model.FacturaID;
    Guid ClienteID = Model.ClienteID;
    double dTotal = 0;
    double dTotalPagos = Model.Monto - Model.Saldo;
    int cantMenores = (int)(ViewBag.CantMenores ?? 0);
    int countMenoresVinculados = ((List<PasajeroMenorModel>)ViewBag.ListMenores)
        .Count(x => x.PasajeroMenorID != 0);
    int cupoRestante = Math.Max(0, cantMenores - countMenoresVinculados);
}

<div class="factura-detail-container" data-facturaid="@FacturaID">
    @{
        string sUSD = "";
        if (Model.MonedaTipo != 1)
        {
            sUSD = "USD";
        }
    }

    <!-- Informacion de la Factura -->
    <div class="factura-info-grid">
        <div class="factura-info-item">
            <span class="factura-info-label">Monto</span>
            <span class="factura-info-value">
                <i class="bi bi-currency-dollar"></i>
                @String.Format("{0:C}", Model.Monto)
                @if (!string.IsNullOrEmpty(sUSD))
                {
                    <span class="currency-badge">@sUSD</span>
                }
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Saldo</span>
            <span class="factura-info-value">
                <i class="bi bi-wallet2"></i>
                @String.Format("{0:C}", Model.Saldo)
                @if (!string.IsNullOrEmpty(sUSD))
                {
                    <span class="currency-badge">@sUSD</span>
                }
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Fecha</span>
            <span class="factura-info-value">
                <i class="bi bi-calendar3"></i>
                @Model.Fecha
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Cliente</span>
            <span class="factura-info-value">
                <i class="bi bi-person"></i>
                @(Model.ClienteApellido + " " + Model.ClienteNombre)
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Vendedor</span>
            <span class="factura-info-value">
                <i class="bi bi-person-badge"></i>
                @(Model.VendedorApellido + " " + Model.VendedorNombre)
            </span>
        </div>
        <div class="factura-info-item">
            <span class="factura-info-label">Paquete</span>
            <span class="factura-info-value">
                <i class="bi bi-box-seam"></i>
                @Model.PaqueteDescripcion
            </span>
        </div>
        @if (!string.IsNullOrEmpty(Model.Observaciones))
        {
            <div class="factura-info-item full-width">
                <span class="factura-info-label">Observaciones</span>
                <span class="factura-info-value">
                    <i class="bi bi-chat-left-text"></i>
                    @Model.Observaciones
                </span>
            </div>
        }
    </div>

    <!-- Tabla de Pasajeros/Butacas -->
    <div class="factura-section">
        <div class="factura-section-title">
            <i class="bi bi-people"></i>
            Pasajeros
        </div>
        <table class="factura-table">
            <thead>
                <tr>
                    <th>Butaca</th>
                    <th>Pasajero</th>
                    <th class="factura-th-acciones">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (FacturaDetalle item in ViewBag.FacturaDetalle)
                {
                    <tr>
                        <td>
                            <strong>@item.ButacaNro</strong>
                        </td>
                        <td>@item.PasajeroNombre @item.PasajeroApellido</td>
                        <td>
                            <div class="factura-cell-actions">
                                <a href="#" class="btn-action-icon btn-cambiar-pasajero" data-pasaje="@item.PasajeID" data-pasajero-actual="@item.PasajeroNombre @item.PasajeroApellido" data-pasajero-id="@item.PasajeroID" title="Cambiar Pasajero">
                                    <i class="bi bi-person-badge"></i>
                                </a>
                                <a href="#" class="btn-action-icon btn-editar-butaca" id="btn-editar-butaca" data-anterior="@item.ButacaID" data-pasaje="@item.PasajeID" title="Editar Butaca">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                @if (item.HabitacionID != new Guid("00000000-0000-0000-0000-000000000000") && item.HabitacionID != null)
                                {
                                    <a href="#" class="btn-action-icon btn-editar-habitacion" id="btn-editar-habitacion" title="Editar Habitacion" data-factura="@(Model.FacturaID.ToString() ?? "")" data-anterior="@item.HabitacionID" data-pasaje="@item.PasajeID" data-viaje="@item.ViajeID" data-pasajero="@item.PasajeroID">
                                        <i class="bi bi-door-open"></i>
                                    </a>
                                }
                                else
                                {
                                    <a href="#" class="btn-action-icon btn-editar-habitacion" id="btn-editar-habitacion" title="Agregar Habitacion" data-factura="@(Model.FacturaID.ToString() ?? "")" data-pasaje="@item.PasajeID" data-viaje="@item.ViajeID" data-pasajero="@item.PasajeroID">
                                        <i class="bi bi-door-open"></i>
                                    </a>
                                }
                                <a href="#" class="btn-action-icon btn-eliminar-pasajero" data-pasaje="@item.PasajeID" data-factura="@Model.FacturaID" data-pasajero="@item.PasajeroNombre @item.PasajeroApellido" title="Eliminar Pasajero">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Tabla de Menores (si existen) -->
    @if (ViewBag.ListMenores.Count > 0)
    {
        <div class="factura-section">
            <div class="factura-section-title">
                <i class="bi bi-shield-check"></i>
                Seguro Menor
            </div>
            <table id="tblListMenores" class="factura-table">
                <thead>
                    <tr>
                        <th class="factura-th-num">#</th>
                        <th>Responsable del menor</th>
                        <th>Menor a cargo</th>
                    </tr>
                </thead>
                <tbody>
                    @{int i = 0;}
                    @foreach (PasajeroMenorModel item in ViewBag.ListMenores)
                    {
                        i++;
                        if (item.PasajeroMenorID != 0)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@(item.ApellidoMayor + ", " + item.NombreMayor + " Doc.: " + item.DocMayor)</td>
                                <td>@(item.ApellidoMenor + ", " + item.NomreMenor + " Doc.: " + item.DocMenor)</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    }

    <!-- Tabla de Items -->
    <div class="factura-section">
        <div class="factura-section-title">
            <i class="bi bi-list-ul"></i>
            Items
        </div>
        <table class="factura-table">
            <thead>
                <tr>
                    <th class="factura-th-num">#</th>
                    <th>Fecha</th>
                    <th>Detalle</th>
                    <th class="factura-th-cant">Cant.</th>
                    <th>Precio</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int iNro = 0;
                    foreach (DBOFacturaDetalle item in ViewBag.ExtendFacturaDetalle)
                    {
                        iNro += 1;
                        dTotal += item.Precio;
                        <tr>
                            <td>@iNro</td>
                            <td>@item.Fecha</td>
                            <td>@item.Detalle</td>
                            <td>@item.Cantidad</td>
                            <td>
                                <div class="factura-precio-row">
                                    <span>@String.Format("{0:C}", item.Precio)</span>
                                    @if (item.Detalle.Contains("PAQUETE"))
                                    {
                                        <a href="javascript: fnCambiarPrecio('@item.Id','@Model.FacturaID');" title="Cambiar Precio" class="btn-action-icon btn-action-icon--sm">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4" class="factura-tfoot-total-label">Total</th>
                    <th>@String.Format("{0:C}", dTotal)</th>
                </tr>
            </tfoot>
        </table>
    </div>

    <!-- Acciones -->
    <div class="factura-actions">
        @if (Model.Estado == (int)eEstadoFactura.Pagado)
        {
            <a href="#" id="btn-imprimirvouchers" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-primary">
                <i class="bi bi-printer"></i>
                Imprimir Vouchers
            </a>
            <a href="#" id="btn-notacredito" data-facturaid="@FacturaID" data-clienteid="@ClienteID" data-fecha="@Model.Fecha" data-monto="@Model.Monto" class="btn-factura btn-factura-secondary">
                <i class="bi bi-file-earmark-minus"></i>
                Nota de Credito
            </a>
        }
        else
        {
            <a href="#" id="btn-abrirregistrarpago" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-primary">
                <i class="bi bi-cash"></i>
                Pago Parcial
            </a>
            <a href="#" id="btn-abrirpagototal" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-primary">
                <i class="bi bi-cash-stack"></i>
                Pago Total
            </a>
            <a href="#" id="btn-descuentoRecargo" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-secondary" onclick="javascript: $('#divDescuentoRecargo').removeClass('dialog-hidden').dialog({width: 400, modal: true, close: function() { $(this).addClass('dialog-hidden').dialog('destroy'); }});">
                <i class="bi bi-percent"></i>
                Descuento/Recargo
            </a>
        }
        <a href="javascript:pagosFactura('@FacturaID');" class="btn-factura btn-factura-secondary" title="Ver pagos de esta factura">
            <i class="bi bi-receipt"></i>
            Pagos
        </a>
        @if (cantMenores > 0)
        {
            <button type="button" class="btn-factura btn-factura-secondary"
                    onclick="showVinculosMenorFactura();"
                    title="Vincular menores a un responsable de este viaje (seguro de menor en la factura)">
                <i class="bi bi-person-heart"></i>
                Vincular Menores
                @if (countMenoresVinculados > 0)
                {
                    <span class="factura-badge-count">@countMenoresVinculados</span>
                }
            </button>
        }
        <a href="#" id="btn-eliminarventa" data-facturaid="@FacturaID" data-clienteid="@ClienteID" class="btn-factura btn-factura-danger">
            <i class="bi bi-trash3"></i>
            Eliminar Venta
        </a>
    </div>
</div>

<!-- Dialogs -->
<div id="divSelectTipoVoucher" title="Tipo de Voucher" class="dialog-hidden">
    <div class="dialog-content">
        <div class="factura-dialog-stack">
            <a href="javascript: imprimirVoucher('@FacturaID','Grupal');" class="btn-factura btn-factura-secondary btn-factura--block">
                <i class="bi bi-people"></i>
                Grupal
            </a>
            <a href="javascript: imprimirVoucher('@FacturaID','Individual');" class="btn-factura btn-factura-secondary btn-factura--block">
                <i class="bi bi-person"></i>
                Individual
            </a>
            <label class="factura-checkbox-label">
                <input type="checkbox" id="chkInfoAdicional" />
                <span>Incluir Informacion Adicional</span>
            </label>
        </div>
    </div>
</div>


<div id="divDescuentoRecargo" title="Descuento/Recargo" class="dialog-hidden">
    <div class="dialog-content">
        <div class="form-group">
            <label for="nMonto">Monto <span class="factura-required">*</span></label>
            <input type="number" id="nMonto" min="0" max="100000" value="0" />
        </div>
        <div class="form-group">
            <label for="txtDetalleDR">Detalle <span class="factura-required">*</span></label>
            <input type="text" id="txtDetalleDR" maxlength="100" />
        </div>
        <div class="form-group">
            <label>Tipo</label>
            <div class="radio-group">
                <label>
                    <input type="radio" name="rDR" value="Descuento" checked />
                    Descuento
                </label>
                <label>
                    <input type="radio" name="rDR" value="Incremento" />
                    Incremento
                </label>
            </div>
        </div>
        <div class="factura-dialog-actions">
            <button type="button" class="btn-factura btn-factura-primary" onclick="addDR()">
                <i class="bi bi-plus-lg"></i>
                Agregar
            </button>
        </div>
    </div>
</div>

<!-- Dialogo: Código de seguridad para eliminar pasajero -->
<div id="divEliminarPasajeroCodigo" title="Código de seguridad" class="dialog-hidden">
    <div class="dialog-content">
        <p class="factura-dialog-hint">
            Para eliminar al pasajero de la factura, ingrese el código de seguridad asignado por el administrador del sistema.
        </p>
        <div class="form-group">
            <label for="txtCodigoEliminarPasajero">Código de seguridad</label>
            <input type="password" id="txtCodigoEliminarPasajero" autocomplete="off" />
        </div>
        <input type="hidden" id="hdnEliminarPasajero_PasajeID" />
        <input type="hidden" id="hdnEliminarPasajero_FacturaID" />
        <div class="factura-dialog-actions">
            <button type="button" id="btnConfirmarEliminarPasajero" class="btn-factura btn-factura-danger">
                <i class="bi bi-trash"></i>
                Eliminar pasajero
            </button>
        </div>
    </div>
</div>

<!-- Dialogo: Cambiar pasajero -->
<div id="divCambiarPasajero" title="Cambiar Pasajero" class="dialog-hidden">
    <div class="dialog-content">
        <p class="factura-dialog-hint">
            Busque y seleccione el nuevo pasajero que ocupará esta butaca.
        </p>
        <div class="form-group">
            <label for="txtBuscarPasajero">Buscar pasajero (nombre, apellido o documento)</label>
            <input type="text" id="txtBuscarPasajero" class="factura-input-search" placeholder="Ingrese nombre, apellido o documento..." autocomplete="off" />
        </div>
        <div id="divResultadosPasajeros" class="factura-resultados-scroll">
            <p class="factura-placeholder-msg">
                Ingrese al menos 2 caracteres para buscar
            </p>
        </div>
        <input type="hidden" id="hdnCambiarPasajero_PasajeID" />
        <input type="hidden" id="hdnCambiarPasajero_PasajeroActualID" />
        <div class="factura-dialog-actions">
            <button type="button" id="btnConfirmarCambiarPasajero" class="btn-factura btn-factura-primary" disabled>
                <i class="bi bi-check-lg"></i>
                Confirmar cambio
            </button>
        </div>
    </div>
</div>

<input type="hidden" id="hdnTotalPagos" value="@dTotalPagos" />
<input type="hidden" id="hdnViajeMonedaTipo" value="@Model.MonedaTipo" />
<input type="hidden" id="hdnSeguroMenorTotal" value="@cantMenores" />
<input type="hidden" id="numMenor" value="@cupoRestante" />

<script type="text/javascript">
    $(function () {
        // Cerrar diálogos hijos cuando el padre (#Detalles) se cierre
        $("#Detalles").on("dialogclose", function() {
            if ($("#divDescuentoRecargo").length && $("#divDescuentoRecargo").hasClass("ui-dialog-content")) {
                $("#divDescuentoRecargo").addClass("dialog-hidden").dialog("destroy");
            }
            if ($("#divSelectTipoVoucher").length && $("#divSelectTipoVoucher").hasClass("ui-dialog-content")) {
                $("#divSelectTipoVoucher").addClass("dialog-hidden").dialog("destroy");
            }
            if ($("#divEliminarPasajeroCodigo").length && $("#divEliminarPasajeroCodigo").hasClass("ui-dialog-content")) {
                $("#divEliminarPasajeroCodigo").addClass("dialog-hidden").dialog("destroy");
            }
            if ($("#divCambiarPasajero").length && $("#divCambiarPasajero").hasClass("ui-dialog-content")) {
                $("#divCambiarPasajero").addClass("dialog-hidden").dialog("destroy");
            }
        });

        // Al cerrar el dialog de vinculación de menores, refrescar DetalleFactura
        $(document).on("dialogclose", "#divVinculosMenorDesdeFactura", function () {
            if (typeof window.PopupDetalleFactura_Load === "function") {
                window.PopupDetalleFactura_Load();
            }
        });

        if ($(".btn-editar-habitacion").length != $(".btn-editar-butaca").length) {
            (window.alertInfo || window.alert)("Opción Imprimir Voucher no disponible. Debe reservar las habitaciones para el/los pasajero/s correspondientes.", "Atención");
            $("#btn-imprimirvouchers").hide();
        }
        $("#btn-abrirregistrarpago").click(function () {
            var url = "/PersonaCliente/RegistrarPago?facturaid=" + $(this).data("facturaid") + "&clienteid=" + $(this).data("clienteid");
            var title = "Registrar Pago";
            var id = "RegistrarPago";
            ShowFormDialog(url, id, title);
        });

        //pago total habilitado solo para pesos ARG
        if ("@Model.MonedaTipo.ToString()" == "1") {
            $("#btn-abrirpagototal").click(function () {
                var url = "/PersonaCliente/RegistrarPagoTotal?facturaid=" + $(this).data("facturaid") + "&clienteid=" + $(this).data("clienteid");
                var title = "Pago Total de Factura";
                var id = "PagoTotal";
                ShowFormDialog(url, id, title);
            });
        }
        else {
            $("#btn-abrirpagototal").attr("disabled", "disabled");
            $("#btn-abrirpagototal").attr("title", "Solo habilitado para pago en Pesos.");
            $("#btn-abrirpagototal").css("opacity", "0.5");
            $("#btn-abrirpagototal").css("cursor", "not-allowed");
        }

        $("#btn-eliminarventa").click(function () {
            var url = "/PersonaCliente/EliminarVenta?facturaid=" + $(this).data("facturaid") + "&clienteid=" + $(this).data("clienteid");
            var title = "Eliminar Venta";
            var id = "EliminarVenta";
            ShowFormDialog(url, id, title, "min");
        });

        $("#aCheckInforAd, #chkInfoAdicional").click(function (e) {
            if (e.target.id === "aCheckInforAd") {
                $("#chkInfoAdicional").prop("checked", !$("#chkInfoAdicional").is(":checked"));
            }
        });

        // Manejar click en botón eliminar pasajero
        $(document).on("click", ".btn-eliminar-pasajero", function (e) {
            e.preventDefault();
            var pasajeID = $(this).data("pasaje");
            var facturaID = $(this).data("factura");
            var pasajeroNombre = $(this).data("pasajero");

            // Guardar IDs seleccionados y abrir popin para pedir código
            $("#hdnEliminarPasajero_PasajeID").val(pasajeID);
            $("#hdnEliminarPasajero_FacturaID").val(facturaID);
            $("#txtCodigoEliminarPasajero").val("");

            $("#divEliminarPasajeroCodigo")
                .removeClass("dialog-hidden")
                .dialog({
                    modal: true,
                    width: 420,
                    resizable: false,
                    close: function () {
                        $("#divEliminarPasajeroCodigo").addClass("dialog-hidden").dialog("destroy");
                    }
                });

            return false;
        });

        // Confirmar eliminación de pasajero (con código)
        $(document).on("click", "#btnConfirmarEliminarPasajero", function (e) {
            e.preventDefault();

            var pasajeID = $("#hdnEliminarPasajero_PasajeID").val();
            var facturaID = $("#hdnEliminarPasajero_FacturaID").val();
            var code = $("#txtCodigoEliminarPasajero").val();

            if (!code) {
                return (window.alertInfo || window.alert)("Debe ingresar el código de seguridad.", "Validación");
            }

            var $btn = $(this);
            var originalHtml = $btn.html();

            $btn.html('<i class="bi bi-hourglass-split"></i>').prop("disabled", true);

            $.ajax({
                url: "/PersonaCliente/EliminarPasajeroDeFactura",
                type: "POST",
                data: {
                    pasajeID: pasajeID,
                    facturaID: facturaID,
                    code: code
                },
                success: function (data) {
                    if (data[0] == "Done.") {
                        $("#divEliminarPasajeroCodigo").dialog("close");
                        if (typeof ShowSuccessMessage === "function") {
                            ShowSuccessMessage(data[1], "Operación Exitosa", function () {
                                if (typeof window.PopupDetalleFactura_Load === "function") {
                                    window.PopupDetalleFactura_Load();
                                } else if (typeof PopupDetalleFactura_Load === "function") {
                                    PopupDetalleFactura_Load();
                                } else {
                                    location.reload();
                                }
                            });
                        } else {
                            (window.alertSuccess || window.alert)(data[1], "Éxito");
                            if (typeof window.PopupDetalleFactura_Load === "function") {
                                window.PopupDetalleFactura_Load();
                            } else if (typeof PopupDetalleFactura_Load === "function") {
                                PopupDetalleFactura_Load();
                            } else {
                                location.reload();
                            }
                        }
                    } else {
                        (window.alertError || window.alert)("Error: " + data[1], "Error");
                        $btn.html(originalHtml).prop("disabled", false);
                    }
                },
                error: function (xhr, status, error) {
                    (window.alertError || window.alert)("Error al eliminar el pasajero. Por favor, intente nuevamente.", "Error");
                    console.error("Error:", error);
                    $btn.html(originalHtml).prop("disabled", false);
                }
            });

            return false;
        });

        // Manejar click en botón cambiar pasajero
        $(document).on("click", ".btn-cambiar-pasajero", function (e) {
            e.preventDefault();
            var pasajeID = $(this).data("pasaje");
            var pasajeroActualID = $(this).data("pasajero-id");
            var pasajeroActualNombre = $(this).data("pasajero-actual");

            // Guardar IDs y limpiar formulario
            $("#hdnCambiarPasajero_PasajeID").val(pasajeID);
            $("#hdnCambiarPasajero_PasajeroActualID").val(pasajeroActualID);
            $("#txtBuscarPasajero").val("");
            $("#divResultadosPasajeros").html('<p class="factura-placeholder-msg">Ingrese al menos 2 caracteres para buscar</p>');
            $("#btnConfirmarCambiarPasajero").prop("disabled", true);

            $("#divCambiarPasajero")
                .removeClass("dialog-hidden")
                .dialog({
                    modal: true,
                    width: 500,
                    resizable: false,
                    close: function () {
                        $("#divCambiarPasajero").addClass("dialog-hidden").dialog("destroy");
                    }
                });

            // Focus en el campo de búsqueda
            setTimeout(function() {
                $("#txtBuscarPasajero").focus();
            }, 100);

            return false;
        });

        // Búsqueda de pasajeros con debounce
        var buscarPasajeroTimeout;
        $(document).on("input", "#txtBuscarPasajero", function () {
            var searchTerm = $(this).val().trim();
            var $resultados = $("#divResultadosPasajeros");
            var $btnConfirmar = $("#btnConfirmarCambiarPasajero");

            clearTimeout(buscarPasajeroTimeout);

            if (searchTerm.length < 2) {
                $resultados.html('<p class="factura-placeholder-msg">Ingrese al menos 2 caracteres para buscar</p>');
                $btnConfirmar.prop("disabled", true);
                return;
            }

            buscarPasajeroTimeout = setTimeout(function () {
                $resultados.html('<p class="factura-placeholder-msg"><i class="bi bi-hourglass-split"></i> Buscando...</p>');

                $.ajax({
                    url: "/PersonaCliente/GetClientesTop",
                    type: "POST",
                    data: { searchTerm: searchTerm },
                    success: function (response) {
                        if (response.success && response.data && response.data.length > 0) {
                            var html = '';
                            response.data.forEach(function (pasajero) {
                                html += '<div class="pasajero-resultado-item" data-pasajero-id="' + pasajero.PersonaId + '" data-pasajero-nombre="' + (pasajero.Nombre || '') + ' ' + (pasajero.Apellido || '') + '">';
                                html += '<div class="pasajero-resultado-nombre">' + (pasajero.Nombre || '') + ' ' + (pasajero.Apellido || '') + '</div>';
                                html += '<div class="pasajero-resultado-detalle">';
                                if (pasajero.NroDocumento) html += 'Doc: ' + pasajero.NroDocumento;
                                if (pasajero.Telefono) html += (pasajero.NroDocumento ? ' | ' : '') + 'Tel: ' + pasajero.Telefono;
                                if (pasajero.Celular) html += (pasajero.NroDocumento || pasajero.Telefono ? ' | ' : '') + 'Cel: ' + pasajero.Celular;
                                html += '</div>';
                                html += '</div>';
                            });
                            $resultados.html(html);
                        } else {
                            $resultados.html('<p class="factura-placeholder-msg">No se encontraron resultados</p>');
                        }
                        $btnConfirmar.prop("disabled", true);
                    },
                    error: function () {
                        $resultados.html('<p class="factura-placeholder-msg factura-placeholder-msg--error">Error al buscar pasajeros. Intente nuevamente.</p>');
                        $btnConfirmar.prop("disabled", true);
                    }
                });
            }, 300);
        });

        // Seleccionar pasajero de los resultados
        var pasajeroSeleccionadoID = null;
        $(document).on("click", ".pasajero-resultado-item", function () {
            $(".pasajero-resultado-item").removeClass("selected");
            $(this).addClass("selected");
            pasajeroSeleccionadoID = $(this).data("pasajero-id");
            $("#btnConfirmarCambiarPasajero").prop("disabled", false);
        });

        // Confirmar cambio de pasajero
        $(document).on("click", "#btnConfirmarCambiarPasajero", function (e) {
            e.preventDefault();

            var pasajeID = $("#hdnCambiarPasajero_PasajeID").val();
            var nuevoPasajeroID = pasajeroSeleccionadoID;

            if (!nuevoPasajeroID) {
                return (window.alertInfo || window.alert)("Debe seleccionar un pasajero de la lista.", "Validación");
            }

            var pasajeroActualID = $("#hdnCambiarPasajero_PasajeroActualID").val();
            if (nuevoPasajeroID === pasajeroActualID) {
                return (window.alertInfo || window.alert)("Debe seleccionar un pasajero diferente al actual.", "Validación");
            }

            var $btn = $(this);
            var originalHtml = $btn.html();

            $btn.html('<i class="bi bi-hourglass-split"></i>').prop("disabled", true);

            $.ajax({
                url: "/PersonaCliente/CambiarPasajeroDePasaje",
                type: "POST",
                data: {
                    pasajeID: pasajeID,
                    nuevoPasajeroID: nuevoPasajeroID
                },
                success: function (data) {
                    if (data[0] == "Done.") {
                        $("#divCambiarPasajero").dialog("close");
                        if (typeof ShowSuccessMessage === "function") {
                            ShowSuccessMessage(data[1], "Operación Exitosa", function () {
                                if (typeof window.PopupDetalleFactura_Load === "function") {
                                    window.PopupDetalleFactura_Load();
                                } else if (typeof PopupDetalleFactura_Load === "function") {
                                    PopupDetalleFactura_Load();
                                } else {
                                    location.reload();
                                }
                            });
                        } else {
                            (window.alertSuccess || window.alert)(data[1], "Éxito");
                            if (typeof window.PopupDetalleFactura_Load === "function") {
                                window.PopupDetalleFactura_Load();
                            } else if (typeof PopupDetalleFactura_Load === "function") {
                                PopupDetalleFactura_Load();
                            } else {
                                location.reload();
                            }
                        }
                    } else {
                        (window.alertError || window.alert)("Error: " + data[1], "Error");
                        $btn.html(originalHtml).prop("disabled", false);
                    }
                },
                error: function (xhr, status, error) {
                    (window.alertError || window.alert)("Error al cambiar el pasajero. Por favor, intente nuevamente.", "Error");
                    console.error("Error:", error);
                    $btn.html(originalHtml).prop("disabled", false);
                }
            });

            return false;
        });
    });

    function addDR() {
        var FacturaID = "@FacturaID";
        var Monto = $("#nMonto").val();
        var Detalle = $("#txtDetalleDR").val()
        if (Monto <= 0) {
            return (window.alertInfo || window.alert)("Debe agregar un monto.", "Validación");
        }
        if (Detalle.trim() == '') {
            return (window.alertInfo || window.alert)("Debe ingresar un detalle.", "Validación");
        }

        var DescuentoIncremento = $("input[name='rDR']:checked").val();

        $.ajax({
            url: "/PersonaCliente/AddDescuentoRecargo",
            data: {
                sFacturaID: FacturaID,
                sMonto: Monto,
                sDetalle: Detalle,
                sDescuentoIncremento: DescuentoIncremento
            },
            success: function (data) {
                if (data.Estado == "Done.") {
                    $('#divDescuentoRecargo').dialog('close');
                    PopupDetalleFactura_Load();
                }
                else {
                    (window.alertError || window.alert)("Se produjo un error. Contáctese con el administrador.", "Error");
                    console.log(data.Estado);
                }
            },
            error: function (e) {
                (window.alertError || window.alert)("Se produjo un error. Contáctese con el administrador.", "Error");
                console.log(e);
            }
        })
    }

    function fnCambiarPrecio(DetalleFacturaId, FacturaId) {
        var htmlLoading = "<div class='loading-container'><div class='loading-spinner'></div></div>";
        ShowFormDialogHTML(htmlLoading, "PopinPrecioList", "Cambiar Precio", "min");
        $.ajax({
            url: "/PersonaCliente/CambiarPrecioList",
            data: {
                DetalleFacturaId: DetalleFacturaId,
                FacturaId: FacturaId
            },
            success: function (data) {
                $("#PopinPrecioList").html(data);
            },
            error: function (e) {
                (window.alertError || window.alert)("Se produjo un error. Contáctese con el administrador.", "Error");
                console.log(e);
            }
        })
    }

    // Pagos (Factura): delega a implementación global (un solo popin top-level)
    function pagosFactura(FacturaID) {
        if (typeof window.openPagosFacturaDialog === "function") {
            window.openPagosFacturaDialog(FacturaID);
        } else {
            // fallback mínimo
            var url = "/PersonaCliente/partialHistorialdePagosByFactura?FacturaID=" + encodeURIComponent(FacturaID || "");
            ShowFormDialog(url, "PopinPagosFactura", "Pagos", "wide");
        }
    }

    function showVinculosMenorFactura() {
        var viajeId = "@ViewBag.ViajeID";
        if (!viajeId) {
            return (window.alertInfo || window.alert)(
                "No se pudo obtener el viaje de esta factura.", "Atención");
        }
        var cantSeguro = parseInt($("#hdnSeguroMenorTotal").val(), 10) || 0;
        var cupo = parseInt($("#numMenor").val(), 10) || 0;
        window.showFormListaMayor = function () {
            ShowFormDialog("/Reserva/FormListaMayor?sViajeId=" + viajeId, "divFormListaMayor", "Lista de Pasajeros", "medium");
        };
        window.showFormListaMenor = function () {
            if (cantSeguro > 0 && cupo === 0) {
                return (window.alertInfo || window.alert)(
                    "Ya se alcanzó la cantidad máxima de menores permitida por el seguro de la factura. Puede desvincular un menor en la lista inferior si necesita corregir datos.",
                    "Atención");
            }
            ShowFormDialog("/Reserva/FormListaMenor?sViajeId=" + viajeId, "divFormListaMenor", "Lista de menores disponibles", "medium");
        };
        var url = "/Reserva/VinculacionMenor?sViajeId=" + encodeURIComponent(viajeId) + "&desdeFactura=1&sFacturaId=" + encodeURIComponent("@FacturaID");
        ShowFormDialog(url, "divVinculosMenorDesdeFactura", "Vinculación de Menores", "medium");
    }
</script>
