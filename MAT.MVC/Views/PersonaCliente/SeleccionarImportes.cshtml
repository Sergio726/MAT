<div id="adicionales">
    <p>
        <h3>Adicionales</h3>
    </p>
    @foreach (var item in @Model.Adicionales)
    {
        <p><input type="checkbox" name="check_adicional" value="@item.Descripcion.ToUpper()" data-monto="@item.Monto" data-id="@item.AdicionalId" /> @item.Descripcion</p>
    }
</div>
<br />

<p class="botonera-form">
    <a class="btn btn-small btn-danger" id="btn-aceptar-cambio-butaca">Confirmar Cambio de Butaca</a>
</p>
<script type="text/javascript">
    jQuery(function ($) {
        var piso = $("#input-piso").val();
        if (piso == "2") {
            $("#adicionales input[type=checkbox][value*=CAMA]").attr("checked",true);
            $("#adicionales input[type=checkbox][value*=CAMA]").parent().css("color", "red");
        }
    });

</script>
