@model MAT.Entities.Viaje
@using MAT.Utilities
@{
    ViewBag.Title = "Nuevo Viaje";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-plus-circle"></i>
            <span>Crear Viaje</span>
        </h2>
    </div>

    <div class="modern-form-container">
        @if (ViewData["error"] != null)
        {
            <div class="modern-alert-error" style="margin-bottom: 1rem;">
                <i class="bi bi-exclamation-circle"></i>
                <span>@ViewData["error"].ToString()</span>
            </div>
        }

        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label" for="PaqueteId">
                        <i class="bi bi-box-seam"></i>
                        <span>Paquete</span>
                    </label>
                    @Html.DropDownListFor(model => model.PaqueteId, Helper.ToSelectEntities("Paquete"), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.PaqueteId, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="Descripcion">
                        <i class="bi bi-card-text"></i>
                        <span>Descripción</span>
                    </label>
                    @Html.TextBoxFor(model => model.Descripcion, new { @class = "modern-form-input", placeholder = "Descripción del viaje" })
                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="Origen">
                        <i class="bi bi-geo-alt"></i>
                        <span>Origen</span>
                    </label>
                    @Html.TextBoxFor(model => model.Origen, new { @class = "modern-form-input", placeholder = "Ciudad de origen" })
                    @Html.ValidationMessageFor(model => model.Origen, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="FechaSalida">
                        <i class="bi bi-calendar-event"></i>
                        <span>Fecha salida</span>
                    </label>
                    <input type="text" id="FechaSalida" name="FechaSalida" class="modern-form-input date" autocomplete="off" />
                    @Html.ValidationMessageFor(model => model.FechaSalida, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="HoraSalida">
                        <i class="bi bi-clock"></i>
                        <span>Hora salida</span>
                    </label>
                    <input type="text" id="HoraSalida" name="HoraSalida" class="modern-form-input time" autocomplete="off" placeholder="hh:mm" />
                    @Html.ValidationMessageFor(model => model.HoraSalida, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="FechaRegreso">
                        <i class="bi bi-calendar-check"></i>
                        <span>Fecha regreso</span>
                    </label>
                    <input type="text" id="FechaRegreso" name="FechaRegreso" class="modern-form-input date" autocomplete="off" />
                    @Html.ValidationMessageFor(model => model.FechaRegreso, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="HoraRegreso">
                        <i class="bi bi-clock-history"></i>
                        <span>Hora regreso</span>
                    </label>
                    <input type="text" id="HoraRegreso" name="HoraRegreso" class="modern-form-input time" autocomplete="off" placeholder="hh:mm" />
                    @Html.ValidationMessageFor(model => model.HoraRegreso, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="PaisOrigen">
                        <i class="bi bi-flag"></i>
                        <span>País origen</span>
                    </label>
                    @Html.TextBoxFor(model => model.PaisOrigen, new { @class = "modern-form-input", placeholder = "País de origen" })
                    @Html.ValidationMessageFor(model => model.PaisOrigen, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="PaisDestino">
                        <i class="bi bi-flag-fill"></i>
                        <span>País destino</span>
                    </label>
                    @Html.TextBoxFor(model => model.PaisDestino, new { @class = "modern-form-input", placeholder = "País de destino" })
                    @Html.ValidationMessageFor(model => model.PaisDestino, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="Paso">
                        <i class="bi bi-signpost-2"></i>
                        <span>Paso</span>
                    </label>
                    @Html.TextBoxFor(model => model.Paso, new { @class = "modern-form-input", placeholder = "Paso / frontera" })
                    @Html.ValidationMessageFor(model => model.Paso, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label" for="Medio">
                        <i class="bi bi-truck"></i>
                        <span>Medio</span>
                    </label>
                    @Html.TextBoxFor(model => model.Medio, new { @class = "modern-form-input", placeholder = "Medio de transporte" })
                    @Html.ValidationMessageFor(model => model.Medio, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="modern-form-actions">
                @Html.ActionLink("Volver a lista de viajes", "Index", null, new { @class = "btn-modern btn-modern-secondary" })
                <button type="submit" id="btn_crear_viaje" class="btn-modern btn-modern-primary">
                    <i class="bi bi-check-circle"></i>
                    <span>Crear</span>
                </button>
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    $(function () {
        $("input.date").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2'
        });
        $("input.time").timepicker({ scrollDefault: 'now', timeFormat: 'H:i' });
    });
</script>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
