@model List<MAT.MVC.Models.ViajeModel>
<link href="~/Content/mat.styles.custom.css" rel="stylesheet" />

<table id="tblviajes" class="mat-customtable">
    <thead>
        <tr>
            <th style="width:150px">
                Paquete
            </th>
            <th style="width:150px">
                Pescripción
            </th>
            <th>
                Fecha de Salida
            </th>
            <th>
                HR de salida
            </th>
            <th>
                Pais Destino
            </th>
            <th>
                Moneda
            </th>
            <th>
                Precio
            </th>
            <th>
                Precio Promo
            </th>
            <th style="width:60px">
                Venc. de Promo
            </th>
            <th>
                Paso
            </th>
            <th>
                Medio
            </th>
            <th>
                Publicado en WEB
            </th>
            <th style="width:250px;"></th>

        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.PaqueteNombre
                </td>
                <td>
                    @item.Descripcion
                </td>
                <td>
                    @item.FechaSalida
                </td>
                <td>
                    @item.HoraSalida
                </td>
                <td>
                    @item.PaisDestino
                </td>
                <td>
                    @(item.MonedaTipo == 1 ? "$ ARG" : "U$D")
                </td>
                <td>
                    @("$ ") @item.PrecioSemicama
                </td>
                <td>
                    @("$ ") @item.PrecioPromocional
                </td>
                <td>
                    @item.FechaPromocion
                </td>
                <td>
                    @item.Paso
                </td>
                <td>
                    @if (item.Medio == "TERRESTRE")
                    {
                        <div class="iconbus_35px" title="@item.Medio"></div>
                    }
                    else
                    {
                        if (item.Medio == "AEREO")
                        {
                            <div class="iconavion_35px" title="@item.Medio"></div>
                        }
                        else
                        {
                            @item.Medio
                        }
                    }
                </td>
                <td>
                    <input type="checkbox" value="@item.IsPublicWeb" @(item.IsPublicWeb==true? "checked" : "")/>
                </td>
                <td>
                    <a href="/viaje/edit/?saction=edit&sviajeid=@item.ViajeID" class="button_edit" title="editar">
                    </a>

                    <a href="/viaje/edit/?saction=detail&sviajeid=@item.ViajeID" class="button_detail" title="ver detalles">
                    </a>
                    <a href="/viaje/hoteles/@item.ViajeID" class="button_hotel" title="ver hoteles">
                    </a>

                    <a href="/pasajeroviaje/index/@item.ViajeID" class="button_pasajero" title="ver pasajeros">
                    </a>

                    <a id="btn-eliminar-viaje" data-id="@item.ViajeID" class="button_delete" title="eliminar viaje (mal cargado o sin uso)">
                    </a>

                    <a id="btn-cancelar-viaje" onclick="javascript: fncancelviaje('@item.ViajeID');" class="button_cancel" title="dar de baja el viaje (fuerza mayor)">
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>

@* DataTables ya está incluido en _Layout.cshtml - usando versión local *@

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblviajes").DataTable({
            "columnDefs": [
                // Plugin date-uk removido - DataTables ordenará fechas en formato dd/MM/yyyy automáticamente
                // { type: 'date-uk', targets: [2, 9] },  // Comentado - plugin no disponible
                { targets: [10, 11, 12], "orderable": false } // Desactiva ordenación en "Paso", "Medio" y "Acciones"
            ],
            "pageLength": 25, // Muestra 25 registros por página
            "order": [[2, "asc"]], // Ordena por FechaSalida de manera ascendente
            "language": {
                "lengthMenu": "Mostrar _MENU_ registros por página",
                "zeroRecords": "No se encontraron resultados",
                "info": "Mostrando _START_ a _END_ de _TOTAL_ registros",
                "infoEmpty": "No hay registros disponibles",
                "infoFiltered": "(filtrado de _MAX_ registros en total)",
                "search": "Buscar:",
                "paginate": {
                    "first": "Primero",
                    "last": "Último",
                    "next": "Siguiente",
                    "previous": "Anterior"
                }
            }
        });
    });
</script>

