@model List<MAT.MVC.Models.ViajeModel>

<style>
    .viajes-list-container {
        padding: 0;
    }
    #tblviajes {
        width: 100% !important;
    }
</style>

<div class="viajes-list-container">
    <table id="tblviajes" class="display">
        <thead>
            <tr>
                <th>Paquete</th>
                <th>Descripción</th>
                <th>Fecha Salida</th>
                <th>Hora</th>
                <th>Destino</th>
                <th>Moneda</th>
                <th>Precio</th>
                <th>Promo</th>
                <th>Venc. Promo</th>
                <th>Paso</th>
                <th>Medio</th>
                <th>Web</th>
                <th style="width:180px;"></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><span class="table-text-primary">@item.PaqueteNombre</span></td>
                    <td>@item.Descripcion</td>
                    <td><span class="table-text-bold">@item.FechaSalida</span></td>
                    <td>@item.HoraSalida</td>
                    <td>@item.PaisDestino</td>
                    <td><span class="badge-moneda @(item.MonedaTipo == 1 ? "badge-moneda-pesos" : "badge-moneda-dolar")">@(item.MonedaTipo == 1 ? "ARS" : "USD")</span></td>
                    <td><span class="precio-value">$ @item.PrecioSemicama</span></td>
                    <td><span class="precio-promo">$ @item.PrecioPromocional</span></td>
                    <td>@item.FechaPromocion</td>
                    <td>@item.Paso</td>
                    <td>
                        @if (item.Medio == "TERRESTRE")
                        {
                            <span class="icon-medio icon-medio-bus" title="@item.Medio">
                                <i class="bi bi-bus-front"></i>
                            </span>
                        }
                        else if (item.Medio == "AEREO")
                        {
                            <span class="icon-medio icon-medio-avion" title="@item.Medio">
                                <i class="bi bi-airplane"></i>
                            </span>
                        }
                        else
                        {
                            @item.Medio
                        }
                    </td>
                    <td>
                        @if (item.IsPublicWeb)
                        {
                            <span class="icon-status icon-status-active" title="Publicado en web">
                                <i class="bi bi-check-circle-fill"></i>
                            </span>
                        }
                        else
                        {
                            <span class="icon-status icon-status-inactive" title="No publicado">
                                <i class="bi bi-circle"></i>
                            </span>
                        }
                    </td>
                    <td>
                        <div class="table-actions">
                            <a href="/viaje/edit/?saction=edit&sviajeid=@item.ViajeID" class="btn-action btn-action-edit" title="Editar">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a href="/viaje/edit/?saction=detail&sviajeid=@item.ViajeID" class="btn-action btn-action-view" title="Ver detalles">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a href="/viaje/hoteles/@item.ViajeID" class="btn-action btn-action-hotel" title="Ver hoteles">
                                <i class="bi bi-building"></i>
                            </a>
                            <a href="/pasajeroviaje/index/@item.ViajeID" class="btn-action btn-action-people" title="Ver pasajeros">
                                <i class="bi bi-people"></i>
                            </a>
                            <a href="#" id="btn-eliminar-viaje" data-id="@item.ViajeID" class="btn-action btn-action-delete" title="Eliminar viaje">
                                <i class="bi bi-trash"></i>
                            </a>
                            <a href="#" onclick="fncancelviaje('@item.ViajeID'); return false;" class="btn-action btn-action-cancel" title="Cancelar viaje">
                                <i class="bi bi-x-circle"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblviajes").DataTable({
            "columnDefs": [
                { targets: [10, 11, 12], "orderable": false }
            ],
            "pageLength": 25,
            "order": [[2, "asc"]],
            "language": {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
            }
        });
    });
</script>

