@model Guid

<input id="guid-viaje" type="hidden" value="@Model.ToString()" />

<div class="custom_margin_top_10">
    <table class="mat-customtable" id="tblHoteles">
    <thead>
        <tr>
            <th>
                Nombre
            </th>
            <th></th>
        </tr>
    </thead>
</table>
</div>

<div id="divTools">
    <a id="btn-vincular-hotel" href="#" data-hotel="{{HotelID}}" data-viaje="@ViewBag.ViajeID"]">
                        <img src="/Images/link.png" width="32" height="32" title="Vincular Hotel" /></a>
</div>

<script type="text/javascript">
    //jQuery(function ($) {
    //    $("div#grid-hotel").load("/Viaje/RenderGridHoteles?id=" + $("#guid-viaje").val());
    //});

    $(document).ready(function(){
        loadHoteles();
    });


    function loadHoteles() {
        var jResult = @Html.Raw(ViewBag.jResult);
        var jTables = eval(jResult);
        var jt = jTables["Table"];

        var table = $("#tblHoteles").DataTable({
            "aaData": jt,
            "columns": [
        	{ "data": "Nombre" },
        	{ "data": "HotelID",
        	    "mRender": function (data, type, row) {
        	        var _data = { "HotelID": row.HotelID}
        	        var data = $("#divTools").html().trim().render(_data);
        	        return data;
        	    }
        	},
            
            ],
            "bAutoWidth": false,
            "pageLength": 25
        });
    }

</script>