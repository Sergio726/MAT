@model IEnumerable<MAT.Entities.Viaje>
@using MAT.Utilities
@using MAT.Enums
@{
    ViewBag.Title = "Lista de Viajes";
}

<style>
    .popup-viajes-container {
        padding: 0.5rem;
    }
    .popup-viajes-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin: 0 0 1rem 0;
    }
    .popup-viajes-title i {
        color: var(--primary-color, #e91e63);
    }
    .popup-viajes-scroll {
        max-height: 300px;
        overflow-y: auto;
        border-radius: 0.5rem;
        border: 1px solid var(--border-color, #e5e7eb);
    }
    .popup-viajes-table {
        width: 100%;
        border-collapse: collapse;
    }
    .popup-viajes-table thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.625rem 0.75rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        text-align: left;
        position: sticky;
        top: 0;
    }
    .popup-viajes-table tbody td {
        padding: 0.625rem 0.75rem;
        font-size: 0.8125rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .popup-viajes-table tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .popup-viajes-table tbody tr:last-child td {
        border-bottom: none;
    }
    .viaje-paquete-name {
        font-weight: 500;
        color: var(--primary-color, #e91e63);
    }
    .viaje-fecha {
        font-weight: 500;
    }
    .popup-actions {
        display: flex;
        align-items: center;
        gap: 0.25rem;
    }
    .btn-popup-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.2s ease;
        text-decoration: none;
    }
    .btn-popup-print {
        background: #dbeafe;
        color: #2563eb;
    }
    .btn-popup-print:hover {
        background: #2563eb;
        color: white;
    }
</style>

<div class="popup-viajes-container">
    <h2 class="popup-viajes-title">
        <i class="bi bi-bus-front"></i>
        Viajes
    </h2>

    <div class="popup-viajes-scroll">
        <table class="popup-viajes-table">
            <thead>
                <tr>
                    <th>Paquete</th>
                    <th>Origen</th>
                    <th>Fecha Salida</th>
                    <th>Hora</th>
                    <th>Destino</th>
                    <th style="width: 110px;"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><span class="viaje-paquete-name">@Helper.ToSelectItem("Paquete", item.PaqueteId.ToString())</span></td>
                        <td>@item.Origen</td>
                        <td><span class="viaje-fecha">@item.FechaSalida.ToString().Substring(0, 10)</span></td>
                        <td>@item.HoraSalida</td>
                        <td>@item.PaisDestino</td>
                        <td>
                            <div class="popup-actions">
                                <a href="/PasajeroViaje/Manifiesto/@item.ViajeId" class="btn-popup-action btn-popup-print" title="Imprimir Manifiesto">
                                    <i class="bi bi-file-earmark-text"></i>
                                </a>
                                <a href="/PasajeroViaje/CNRT/@item.ViajeId" class="btn-popup-action btn-popup-print" title="Imprimir Listado CNRT">
                                    <i class="bi bi-file-earmark-ruled"></i>
                                </a>
                                <a href="/PasajeroViaje/ListadoSimple/@item.ViajeId" class="btn-popup-action btn-popup-print" title="Imprimir Listado Pasajeros">
                                    <i class="bi bi-people"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>