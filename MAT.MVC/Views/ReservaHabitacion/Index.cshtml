@model PagedList.IPagedList<MAT.Entities.Habitacion>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Reserva de Habitación";
}

<div class="modern-reserva-habitacion-container">
    <div class="modern-reserva-habitacion-form">
        <div class="modern-form-group-inline" style="align-items: center;">
            <label class="modern-form-label-inline" style="min-width: 0;">
                <i class="bi bi-building"></i>
                <span>Hotel</span>
            </label>
            <select id="ddHotel" class="modern-form-select" style="flex: 1; min-width: 0;">
                @foreach (MAT.MVC.Models.HotelDropDown item in ViewBag.ListaHoteles)
                {
                    <option value="@item.HotelID" fecha="@item.Fecha.ToString("dd/MM/yyyy")">
                        @item.Nombre - @item.Fecha.ToString("dd/MM/yyyy")
                    </option>
                }
            </select>
            <button id="btnFiltrarHabitacion" type="button" class="btn-modern btn-modern-primary" title="Actualizar habitaciones">
                <i class="bi bi-arrow-repeat"></i>
                <span>Actualizar</span>
            </button>
        </div>
        <div class="text-muted" style="margin-top: .5rem; font-size: .85rem;">
            Seleccioná el hotel y elegí una habitación disponible para reservar.
        </div>
    </div>

    <div id="gridHabitacion" class="modern-reserva-habitacion-grid">
        <div class="modern-loading-placeholder">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted">Cargando habitaciones disponibles...</p>
        </div>
    </div>

    <div class="modern-reserva-habitacion-actions">
        <button type="button" onclick="finalizarReserva();" class="btn-modern btn-modern-secondary">
            <i class="bi bi-x-circle"></i>
            <span>Finalizar Reserva</span>
        </button>
    </div>

    <input type="hidden" id="viaje-id" value="@ViewData["viajeid"]" />
    <input type="hidden" id="hdnPasajeID" value="@ViewBag.PasajeID" />
</div>

    <script type="text/javascript">
    function finalizarReserva() {
        var viajeID = $("#viaje-id").val();
        window.location.href = "/Reserva/Index?viajeid=" + viajeID;
    }

    function loadHabitaciones() {
        var hotelID = $("#ddHotel").val();
        var fecha = $("#ddHotel option:selected").attr("fecha");
        var viajeId = $("#viaje-id").val();
        var pasajeroId = "@ViewBag.PasajeroID";

        var url = "/ReservaHabitacion/GridHotelHabitacion"
            + "?HotelID=" + encodeURIComponent(hotelID || "")
            + "&viajeid=" + encodeURIComponent(viajeId || "")
            + "&PasajeroID=" + encodeURIComponent(pasajeroId || "")
            + "&Fecha=" + encodeURIComponent(fecha || "");

        var t0 = (window.performance && performance.now) ? performance.now() : null;
        $("#gridHabitacion").load(url, function () {
            var perf = $("#gridHabitacion").find(".rh-perf").first();
            if (perf && perf.length) {
                var total = perf.data("totalMs");
                var db = perf.data("dbMs");
                var rsv = perf.data("reservaMs");
                var cnt = perf.data("count");
                if (window.console && console.info) {
                    console.info("[ReservaHabitacion] habitaciones=" + cnt + " | db=" + db + "ms | reserva=" + rsv + "ms | total=" + total + "ms");
                }
            }
            if (t0 != null && window.console && console.debug) {
                console.debug("[ReservaHabitacion] load() client=" + Math.round(performance.now() - t0) + "ms");
            }
        });
    }

    $(function () {
        $("#btnFiltrarHabitacion").on("click", function () { loadHabitaciones(); });
        $("#ddHotel").on("change", function () { loadHabitaciones(); });
        loadHabitaciones();
    });
</script>
