@model PagedList.IPagedList<MAT.Entities.Habitacion>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Reserva de Habitación";
}

<div class="modern-reserva-habitacion-container">
    <div class="modern-reserva-habitacion-header">
        <h3 class="modern-reserva-habitacion-title">
            <i class="bi bi-building"></i>
            <span>Seleccionar Hotel</span>
        </h3>
    </div>

    <div class="modern-reserva-habitacion-form">
        @using (Html.BeginForm())
        {
            <div class="modern-form-group-inline">
                <label class="modern-form-label-inline">
                    <i class="bi bi-building"></i>
                    <span>Hotel</span>
                </label>
                <select id="ddHotel" class="modern-form-select">
                    @foreach (MAT.MVC.Models.HotelDropDown item in ViewBag.ListaHoteles)
                    {
                        <option value="@item.HotelID" fecha="@item.Fecha.ToString("dd/MM/yyyy")">
                            @item.Nombre - @item.Fecha.ToString("dd/MM/yyyy")
                        </option>
                    }
                </select>
                <button id="btnFiltrarHabitacion" type="button" class="btn-modern btn-modern-primary" title="Filtrar por hotel">
                    <i class="bi bi-funnel"></i>
                    <span>Filtrar</span>
                </button>
            </div>
        }
    </div>

    <div id="gridHabitacion" class="modern-reserva-habitacion-grid">
        <div class="modern-loading-placeholder">
            <div class="spinner-border text-primary" role="status">
                <span class="visually-hidden">Cargando...</span>
            </div>
            <p class="text-muted">Cargando habitaciones disponibles...</p>
        </div>
    </div>

    <div class="modern-reserva-habitacion-actions">
        <button type="button" onclick="finalizarReserva();" class="btn-modern btn-modern-secondary">
            <i class="bi bi-x-circle"></i>
            <span>Finalizar Reserva</span>
        </button>
    </div>

    <input type="hidden" id="viaje-id" value="@ViewData["viajeid"]" />
    <input type="hidden" id="hdnPasajeID" value="@ViewBag.PasajeID" />
</div>

<script type="text/javascript">
    function finalizarReserva() {
        var viajeID = $("#viaje-id").val();
        window.location.href = "/Reserva/Index?viajeid=" + viajeID;
    }

    $(function () {
        var HotelID = $('#ddHotel').val();
        var Fecha = $('#ddHotel option:selected').attr("fecha");
        $('#gridHabitacion').load('/ReservaHabitacion/GridHotelHabitacion?HotelID=' + HotelID + "&viajeid=" + $("#viaje-id").val() + "&PasajeroID=" + "@ViewBag.PasajeroID" + "&Fecha=" + Fecha);
    });
</script>
