@model List<MAT.MVC.Models.HabitacionDisponibilidad>

<script type="text/javascript">
    var divOk = "<div class='divOk' title='Habitación reservada para este pasajero.'><div>";
    var tblGrid;
    
    $(document).ready(function () {
        if ($.fn.DataTable.isDataTable("#GridHabitacion")) {
            tblGrid = $("#GridHabitacion").DataTable();
            tblGrid.destroy();
        }
        
        tblGrid = $("#GridHabitacion").DataTable({
            "searching": false,
            "bLengthChange": false,
            "language": {
                "processing": "Procesando...",
                "lengthMenu": "Mostrar _MENU_",
                "zeroRecords": "No se encontraron resultados",
                "info": "Mostrando _START_ a _END_ de _TOTAL_",
                "infoEmpty": "Mostrando 0 a 0 de 0",
                "infoFiltered": "(filtrado de _MAX_)",
                "paginate": { "first": "Primero", "last": "Último", "next": ">", "previous": "<" }
            },
            "order": [[0, "asc"]],
            "pageLength": 10,
            "responsive": true,
            "autoWidth": false,
            "deferRender": true
        });
    });
</script>

<input type="hidden" id="input-viaje-id" value="@ViewData["viajeid"]" />
<input type="hidden" id="hdnHabitacionID" />

<div class="rh-perf"
     data-total-ms="@((ViewBag.PerfTotalMs ?? 0).ToString())"
     data-db-ms="@((ViewBag.PerfDbMs ?? 0).ToString())"
     data-reserva-ms="@((ViewBag.PerfReservaMs ?? 0).ToString())"
     data-count="@((ViewBag.PerfCount ?? 0).ToString())"
     style="display:none"></div>

@if (ViewBag.Error != null)
{
    <div class="modern-alert-error" style="margin-bottom: 1rem;">
        <i class="bi bi-exclamation-circle"></i>
        <span>@ViewBag.Error</span>
    </div>
}

@if (Model != null && Model.Any())
{
    <div class="modern-table-container">
        <table id="GridHabitacion" class="modern-table">
            <thead>
                <tr>
                    <th>
                        <i class="bi bi-hash"></i>
                        Habitación
                    </th>
                    <th>
                        <i class="bi bi-door-open"></i>
                        Tipo
                    </th>
                    <th>
                        <i class="bi bi-check-circle"></i>
                        Disponibilidad
                    </th>
                    <th style="width: 120px;">
                        <i class="bi bi-gear"></i>
                        Acciones
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="modern-habitacion-numero">
                                <span class="badge-categoria">@item.NroHabitacion</span>
                                @if (!string.IsNullOrEmpty(item.HabitacionNombre))
                                {
                                    <span class="text-muted">@item.HabitacionNombre</span>
                                }
                            </div>
                        </td>
                        <td>
                            <span class="badge-pasajero">@item.HabitacionTipo</span>
                        </td>
                        <td>
                            @if (item.Disponibilidad > 0)
                            {
                                <span class="badge badge-success">
                                    <i class="bi bi-check-circle"></i>
                                    @item.Disponibilidad disponible@(item.Disponibilidad > 1 ? "s" : "")
                                </span>
                            }
                            else
                            {
                                <span class="badge badge-danger">
                                    <i class="bi bi-x-circle"></i>
                                    Sin disponibilidad
                                </span>
                            }
                        </td>
                        <td id="td-@item.HabitacionID">
                            @if (item.Disponibilidad > 0 && ViewBag.HabitacionSelected == null)
                            {
                                <a class="aReserva btn-modern btn-modern-primary btn-modern-sm" 
                                   data-viaje="@ViewData["viajeid"]" 
                                   data-habitacionid="@item.HabitacionID" 
                                   id="@item.HabitacionID" 
                                   fecha="@ViewBag.Fecha"
                                   title="Reservar habitación">
                                    <i class="bi bi-check-circle"></i>
                                    <span>Reservar</span>
                                </a>
                            }
                            else if (item.HabitacionID == ViewBag.HabitacionSelected)
                            {
                                <a href="javascript:eliminarReservaHotel('@ViewBag.PasajeroID','@ViewBag.HabitacionSelected','@ViewData["viajeid"].ToString()');" 
                                   class="btn-modern btn-modern-danger btn-modern-sm"
                                   title="Eliminar reserva de habitación">
                                    <i class="bi bi-trash"></i>
                                    <span>Eliminar</span>
                                </a>
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="modern-empty-state">
        <i class="bi bi-inbox"></i>
        <h4>No hay habitaciones disponibles</h4>
        <p class="text-muted">No se encontraron habitaciones para el hotel seleccionado.</p>
    </div>
}
