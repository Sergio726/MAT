@model MAT.MVC.Models.ViajeHotel


<script type="text/javascript">
    $(document).ready(function () {
        $("input[type='text']").attr("disabled", "disabled");

        $("#chkHabilitar").change(function () {
            //debugger;
            if ($("#chkHabilitar").is(":checked")) {

                $("input[type='text']").attr("disabled", "disabled");
                $("input[type='text']").css("background-color", "#dcdcdc")
            }
            else {
                $("input[type='text']").css("background-color", "#fff")
                $("input[type='text']").attr("disabled", false);
            }
        });
    });

</script>

<input type="hidden" id="reserva-viaje-id" value="@ViewData["viajeid"].ToString()" />

<div id="divReservaHabitacion">
    <form id="formDate">
        <input type="hidden" value="@ViewBag.HabitacionId.ToString()" id="habitacionid" />
        <div class="form-label">
            <label for="dpFecha">Fecha de Ingreso</label>
        </div>
        <div class="form-field">
            <input type="text" id="txtFechaDesde" name="dpFecha" class="datepicker" value="@(Model.Desde.ToString()??"" ) " />
        </div>

        <div class="form-label">
            @Html.Label("Hora de Ingreso")
        </div>
        <div class="form-field">
            <input type="text" id="txtHoraDesde" class="time" value="@(Model.HoraIngreso ?? "")" />
        </div>

        <div class="form-label">
            <label for="dpFecha">Fecha de Salida</label>
        </div>
        <div class="form-field">
            <input type="text" id="txtFechaHasta" name="dpFecha" class="datepicker" value="@(Model.Hasta ?? "")" />
        </div>

        <div class="form-label">
            @Html.Label("Hora de Salida")
        </div>
        <div class="form-field">
            <input type="text" id="txtHoraHasta" class="time" value="@(Model.HoraSalida ?? "")" />
        </div>
        <div class="form-label">
            <label>Cambiar valores</label>
        </div>
        <div class="form-field" style="width: 1%;">
            <input type="checkbox" id="chkHabilitar" checked="checked" />
        </div>

        <div style="float:right;margin-top:15px;margin-right: 2px;">
            <input type="button" id="btnReservarHabitacion" value="Reservar" title="Reservar Habitación" class="btn btn-small btn-inverse" />
        </div>
    </form>
    
</div>

<script type="text/javascript">

    $(function () {
        $.date = function (dateObject) {
            var d = new Date(dateObject);
            var day = d.getDate();
            var month = d.getMonth() + 1;
            var year = d.getFullYear();
            if (day < 10) {
                day = "0" + day;
            }
            if (month < 10) {
                month = "0" + month;
            }
            var date = year + "-" + month + "-" + day;

            return date;
        };
        $.customDate = function (dateObject) {
            var arraydate = dateObject.split('/');
            var day = parseInt(arraydate[0]);
            var month = parseInt(arraydate[1]);
            var year = parseInt(arraydate[2]);
            if (day < 10) {
                day = "0" + day;
            }
            if (month < 10) {
                month = "0" + month;
            }
            var date = year + "-" + month + "-" + day;
            return date;
        }
        $("#txtFechaDesde").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2'
        });
        $("#txtFechaHasta").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2'
        });

        $("input[class='time']").timepicker({ 'scrollDefault': 'now', 'timeFormat': 'H:i' });
    });
</script>

