@model MAT.MVC.Models.ViajeHotel

<style>
    .rh-modal-wrap {
        padding: 1rem 1.25rem 1.25rem;
        max-width: 420px;
    }
    .rh-modal-title {
        font-size: 1rem;
        font-weight: 600;
        color: var(--text-primary, #1f2937);
        margin: 0 0 1rem 0;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .rh-modal-title i {
        color: var(--primary-color, #e91e63);
    }
    .rh-form-grid {
        display: grid;
        gap: 0.85rem;
    }
    .rh-field label {
        display: block;
        font-size: 0.8rem;
        font-weight: 500;
        color: var(--text-secondary, #6b7280);
        margin-bottom: 0.35rem;
    }
    .rh-field .modern-form-input {
        width: 100%;
        box-sizing: border-box;
    }
    .rh-toggle-row {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        margin-top: 0.25rem;
    }
    .rh-toggle-row label {
        margin: 0;
        font-size: 0.875rem;
        color: var(--text-primary, #374151);
    }
    .rh-actions {
        display: flex;
        justify-content: flex-end;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        $("input[type='text']").attr("disabled", "disabled");

        $("#chkHabilitar").change(function () {
            if ($("#chkHabilitar").is(":checked")) {
                $("input[type='text']").attr("disabled", "disabled");
                $("input[type='text']").css("background-color", "#e5e7eb");
            }
            else {
                $("input[type='text']").css("background-color", "#fff");
                $("input[type='text']").attr("disabled", false);
            }
        });
    });

</script>

<input type="hidden" id="reserva-viaje-id" value="@ViewData["viajeid"].ToString()" />

<div id="divReservaHabitacion" class="rh-modal-wrap">
    <h3 class="rh-modal-title">
        <i class="bi bi-calendar-check"></i>
        Reservar habitación
    </h3>
    <form id="formDate">
        <input type="hidden" value="@ViewBag.HabitacionId.ToString()" id="habitacionid" />
        <div class="rh-form-grid">
            <div class="rh-field">
                <label for="txtFechaDesde">Fecha de ingreso</label>
                <input type="text" id="txtFechaDesde" name="dpFecha" class="modern-form-input datepicker" value="@(Model.Desde.ToString()??"" ) " />
            </div>
            <div class="rh-field">
                <label for="txtHoraDesde">Hora de ingreso</label>
                <input type="text" id="txtHoraDesde" class="modern-form-input time" value="@(Model.HoraIngreso ?? "")" />
            </div>
            <div class="rh-field">
                <label for="txtFechaHasta">Fecha de salida</label>
                <input type="text" id="txtFechaHasta" name="dpFecha" class="modern-form-input datepicker" value="@(Model.Hasta ?? "")" />
            </div>
            <div class="rh-field">
                <label for="txtHoraHasta">Hora de salida</label>
                <input type="text" id="txtHoraHasta" class="modern-form-input time" value="@(Model.HoraSalida ?? "")" />
            </div>
            <div class="rh-toggle-row">
                <input type="checkbox" id="chkHabilitar" checked="checked" />
                <label for="chkHabilitar">Usar fechas/horas por defecto (desmarcar para editar)</label>
            </div>
        </div>
        <div class="rh-actions">
            <button type="button" id="btnReservarHabitacion" title="Reservar habitación" class="btn-modern btn-modern-primary">
                <i class="bi bi-check-lg"></i>
                <span>Reservar</span>
            </button>
        </div>
    </form>
</div>

<script type="text/javascript">

    $(function () {
        $.date = function (dateObject) {
            var d = new Date(dateObject);
            var day = d.getDate();
            var month = d.getMonth() + 1;
            var year = d.getFullYear();
            if (day < 10) {
                day = "0" + day;
            }
            if (month < 10) {
                month = "0" + month;
            }
            var date = year + "-" + month + "-" + day;

            return date;
        };
        $.customDate = function (dateObject) {
            var arraydate = dateObject.split('/');
            var day = parseInt(arraydate[0]);
            var month = parseInt(arraydate[1]);
            var year = parseInt(arraydate[2]);
            if (day < 10) {
                day = "0" + day;
            }
            if (month < 10) {
                month = "0" + month;
            }
            var date = year + "-" + month + "-" + day;
            return date;
        }
        $("#txtFechaDesde").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2'
        });
        $("#txtFechaHasta").datepicker({
            changeMonth: true,
            changeYear: true,
            yearRange: '-100:+2'
        });

        $("input.time").timepicker({ scrollDefault: 'now', timeFormat: 'H:i' });
    });
</script>
