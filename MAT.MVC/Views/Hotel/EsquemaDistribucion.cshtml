@model List<MAT.MVC.Models.EsquemaDistribucion>

@if (ViewBag.Error != null)
{
    <div class="schema-error"><span>@ViewBag.Error</span></div>
}

<div class="schema-container">
    <!-- Info Section -->
    <div class="info-section">
        <div class="modern-card info-card">
            <div class="info-card-title">Marco Antonio Tours</div>
            <p>
                <span>Empresa de Viajes y Turismo - Leg. N° </span><input name="nro_legajo" placeholder="N° LEGAJO" type="text" class="info-input" value="11.049" /><br />
                <span>Dean Funes N° 29 - Tel. (0387) 4321823</span><br />
                <span>Email: reservas@marcoantoniotours.tur.ar</span><br />
                <span>SALTA - ARGENTINA</span>
            </p>
        </div>
        <div class="modern-card info-card">
            @if (Model.Count > 0)
            {
                <div class="info-card-title">@Model[0].HotelNombre</div>
                <p>
                    <span>Ingreso: </span><input type="text" class="info-input" placeholder="INGRESO" value="@Model[0].HotelIngreso" /><br />
                    <span>Egreso: </span><input type="text" class="info-input" placeholder="EGRESO" value="@Model[0].HotelEgreso" /><br />
                    <span>Total Pax: </span><input type="text" class="info-input" placeholder="TOTAL PAX" value="@ViewBag.CantPax" />
                </p>
            }
        </div>
    </div>

    <!-- Group Info -->
    <div class="group-info-row">
        <div>
            <span>GRUPO:</span> Marco Antonio Tours - SALTA
        </div>
        <div>
            <span>COORDINADOR:</span> <input type="text" id="txt-coordinadora" placeholder="APELLIDO/NOMBRE" />
        </div>
    </div>

    <!-- Room Distribution -->
    @for (int i = 1; i < 9; i++)
    {
        var vModel = Model.Where(mod => mod.HabTipo == i).ToList();

        if (vModel.Count() > 0)
        {
            int iLength = vModel.Count();
            int iLength1 = vModel.Count();

            if (iLength % 2 > 0)
            {
                iLength = iLength + 1;
            }

            <div class="room-type-section">
                <div class="room-type-header">@vModel.First().HabTipoDescripcion</div>
                <div class="room-tables-container">
                    <div class="room-table-wrapper">
                        <table class="modern-table room-table">
                            <thead>
                                <tr>
                                    <th>N° - HAB</th>
                                    <th>RESERVADO A</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int n = 0; n < (iLength / 2); n++)
                                {
                                    <tr>
                                        <td>@vModel[n].NroHabitacion @vModel[n].HabNombre</td>
                                        <td>
                                            @if (vModel[n].lHotelPersona.Any())
                                            {
                                                foreach (var persona in vModel[n].lHotelPersona)
                                                {
                                                    <div class="person-entry divPersona" id="@persona.PersonaID" data-habitacionid="@vModel[n].HabitacionID" data-viajeid="@ViewData["viajeid"]">
                                                        <span class="person-name">- @persona.PersonaNombre @persona.PersonaApellido</span>
                                                        <button type="button" class="btn-modern btn-modern-secondary btn-quitar-pasajero modern-btn-icon modern-btn-icon-danger" title="Quitar pasajero de la habitación" data-pasajeroid="@persona.PersonaID"><i class="bi bi-person-dash"></i></button>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="empty-room">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="room-table-wrapper">
                        <table class="modern-table room-table">
                            <thead>
                                <tr>
                                    <th>N° - HAB</th>
                                    <th>RESERVADO A</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int n = (iLength / 2); n < iLength1; n++)
                                {
                                    <tr>
                                        <td>@vModel[n].NroHabitacion @vModel[n].HabNombre</td>
                                        <td>
                                            @if (vModel[n].lHotelPersona.Any())
                                            {
                                                foreach (var persona in vModel[n].lHotelPersona)
                                                {
                                                    <div class="person-entry divPersona" id="@persona.PersonaID" data-habitacionid="@vModel[n].HabitacionID" data-viajeid="@ViewData["viajeid"]">
                                                        <span class="person-name">- @persona.PersonaNombre @persona.PersonaApellido</span>
                                                        <button type="button" class="btn-modern btn-modern-secondary btn-quitar-pasajero modern-btn-icon modern-btn-icon-danger" title="Quitar pasajero de la habitación" data-pasajeroid="@persona.PersonaID"><i class="bi bi-person-dash"></i></button>
                                                    </div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="empty-room">-</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
    }
</div>

@* Layout ya carga jQuery *@
<script type="text/javascript">
    // Mostrar error visible en la UI (banner rojo encima del contenido)
    function mostrarErrorDistribucion(msg) {
        // Quitar banner anterior si existe
        $(".distribucion-error-banner").remove();
        var $banner = $('<div class="distribucion-error-banner" style="background:#ffebee;color:#c62828;padding:10px 15px;border-left:4px solid #c62828;margin:8px 0;border-radius:4px;font-size:13px;display:flex;align-items:center;gap:8px;">' +
            '<i class="bi bi-exclamation-triangle-fill" style="font-size:16px;flex-shrink:0;"></i>' +
            '<span style="flex:1;"></span>' +
            '<button type="button" style="background:none;border:none;color:#c62828;font-size:18px;cursor:pointer;padding:0 4px;line-height:1;" title="Cerrar">&times;</button>' +
            '</div>');
        $banner.find("span").text(msg);
        $banner.find("button").on("click", function () { $banner.fadeOut(200, function() { $banner.remove(); }); });
        $(".schema-container").prepend($banner);
        // Auto-cerrar después de 15 segundos
        setTimeout(function () { $banner.fadeOut(300, function() { $banner.remove(); }); }, 15000);
    }

    $(document).ready(function () {
        var sViajeId = "@ViewData["viajeid"].ToString()";
        $.ajax({
            url: "/Reserva/GetListTutoresByViajeID",
            data: { sViajeId: sViajeId },
            dataType: "json",
            success: function (data) {
                var list = data.Tutores;
                $(".divPersona").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("tutor-person");
                    }
                });
            }
        });
    });

    $(document).on("click", ".btn-quitar-pasajero", function () {
        var $btn = $(this);
        var $row = $btn.closest(".person-entry");
        var pasajeroId = $btn.attr("data-pasajeroid");
        var habitacionId = $row.attr("data-habitacionid");
        var viajeId = $row.attr("data-viajeid");
        var nombrePersona = $row.find(".person-name").text().replace(/^\s*-\s*/, "").trim();

        $("#modal-quitar-pasajero-mensaje").text("¿Está seguro que desea quitar a \"" + nombrePersona + "\" de esta habitación?");
        var $modal = $("#modalQuitarPasajero");
        $modal.data("quitarPasajero", { pasajeroId: pasajeroId, habitacionId: habitacionId, viajeId: viajeId, $btn: $btn });
        var modalEl = document.getElementById("modalQuitarPasajero");
        if (typeof bootstrap !== "undefined" && bootstrap.Modal) {
            var modal = bootstrap.Modal.getOrCreateInstance(modalEl);
            modal.show();
        } else {
            $modal.modal("show");
        }
    });

    $(document).on("click", "#btn-modal-quitar-aceptar", function () {
        var $modal = $("#modalQuitarPasajero");
        var payload = $modal.data("quitarPasajero");
        if (!payload) return;
        var pasajeroId = payload.pasajeroId, habitacionId = payload.habitacionId, viajeId = payload.viajeId, $btn = payload.$btn;

        $modal.data("quitarPasajero", null);
        var modalEl = document.getElementById("modalQuitarPasajero");
        if (typeof bootstrap !== "undefined" && bootstrap.Modal) {
            bootstrap.Modal.getInstance(modalEl).hide();
        } else {
            $modal.modal("hide");
        }

        $btn.prop("disabled", true).text("...");

        $.ajax({
            url: "/Hotel/QuitarPasajeroHabitacion",
            type: "POST",
            data: { pasajeroId: pasajeroId, habitacionId: habitacionId, viajeId: viajeId },
            dataType: "json",
            traditional: true,
            success: function (data) {
                if (data && data.ok === true) {
                    var idselected = $("#HotelPorViaje option:selected").val();
                    var viajeid = $("#distribucion-viaje-id").val();
                    var fecha = $("#HotelPorViaje option:selected").attr("fecha");
                    $("#esquema-distribucion").html('<div class="loading-container"><div class="loading-spinner"></div><span>Actualizando...</span></div>');
                    $.ajax({
                        url: "/Hotel/EsquemaDistribucion",
                        data: { hotelid: idselected, viajeid: viajeid, fecha: fecha },
                        dataType: "html",
                        success: function (html) {
                            $("#esquema-distribucion").html(html);
                        },
                        error: function () {
                            $("#esquema-distribucion").html('<div class="error-message">Error al actualizar. Recargue la página.</div>');
                        }
                    });
                } else {
                    $btn.prop("disabled", false).text("Quitar");
                    var errorMsg = (data && data.message) ? data.message : "No se pudo quitar el pasajero. Error desconocido.";
                    console.error("[QuitarPasajero] Error del servidor:", errorMsg, data);
                    mostrarErrorDistribucion(errorMsg);
                }
            },
            error: function (xhr, status, err) {
                $btn.prop("disabled", false).text("Quitar");
                var errorDetail = "";
                try { errorDetail = xhr.responseJSON ? xhr.responseJSON.message : xhr.responseText; } catch(e) {}
                console.error("[QuitarPasajero] Error AJAX:", status, err, errorDetail);
                mostrarErrorDistribucion("Error al procesar la solicitud. " + (errorDetail || "Intente nuevamente."));
            }
        });
    });
</script>
