@model List<MAT.MVC.Models.EsquemaDistribucion>

<link href="~/Content/mat.styles.custom.css" rel="stylesheet" />

<script type="text/javascript">
    $(document).ready(function(){
        loadGrid();

    });

    function loadGrid()
    {
        var sViajeId = "@ViewData["viajeid"].ToString()";
        $.ajax({
            url: "/Reserva/GetListTutoresByViajeID",
            data: { sViajeId: sViajeId },
            dataType: "json",
            success: function (data) {
                var list = data.Tutores;
                $(".divPersona").each(function (e) {
                    var Id = $(this).attr("id");
                    if (list.indexOf(Id) > 0) {
                        $(this).addClass("Tutor");
                    }
                })
            }
        });
    }
    
</script>


@if (ViewBag.Error != null)
{
   <div class="msgError"><span>@ViewBag.Error</span></div>    
}

<div id="hoteles" class="container">

    <div class="backMAT">
        <span class="title">DISTRIBUCION DE HABITACIONES</span>

        <div class="tabla custom_margin_bottom_15">
            <div class="row">
                <div class="col_dos">
                    <span class="title">MARCO ANTONIO TOURS</span>
                    <p>
                        <span>Empresa de Viajes y Turismo - Leg. Nº </span><input name="nro_legajo" placeholder="N° LEGAJO" type="text" class="custom_border_none" value="11.049"/><br />
                        <span>Dean Funes Nº 29 - Tel. (0387) 4321823</span><br />
                        <span>Email: reservas@marcoantoniotours.tur.ar</span><br />
                        <span>SALTA - ARGENTINA</span>
                    </p>
                </div>
                <div class="col_dos">
                    @if (Model.Count > 0)
