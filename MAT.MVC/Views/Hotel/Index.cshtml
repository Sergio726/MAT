@model List<MAT.MVC.Models.HotelStandard>
@using MAT.Utilities
@using MAT.Enums
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblHoteles").DataTable({
            order: [[0, 'asc']],
            pageLength: 25,
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ hoteles",
                infoEmpty: "No hay hoteles disponibles",
                infoFiltered: "(filtrado de _MAX_ hoteles totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            }
        });
    });
</script>

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-building"></i>
            <span>Hoteles</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/Hotel/ABM" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Hotel</span>
            </a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="modern-alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table" id="tblHoteles">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Dirección</th>
                    <th>CP</th>
                    <th>Localidad</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Contacto</th>
                    <th style="width: 80px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Nombre</strong></td>
                        <td>@item.Direccion</td>
                        <td>@item.CP</td>
                        <td>@item.Localidad</td>
                        <td>@item.Telefono</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <a href="mailto:@item.Email" style="color: var(--brand-primary);">@item.Email</a>
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>@item.Contacto</td>
                        <td>
                            <div class="table-actions">
                                <a href="/Hotel/ABM?Id=@item.HotelID" class="btn-action btn-action-edit" title="Editar Hotel">
                                    <i class="bi bi-pencil"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>