@model MAT.MVC.Models.tblHotel

@{
    ViewBag.Title = "Create";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-building"></i>
            <span>@(Model.HotelID == "" ? "Nuevo Hotel" : "Editar Hotel: " + Model.Nombre)</span>
        </h2>
    </div>

    <div class="modern-form-container">
        <form id="formHotel" class="modern-form">
            <input type="hidden" id="HotelID" name="HotelID" value="@Model.HotelID"/>

            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-building"></i>
                        Nombre <span style="color: #ef4444;">*</span>
                    </label>
                    <input type="text" name="Nombre" id="Nombre" class="modern-form-input" value="@Model.Nombre" placeholder="Nombre del hotel" required />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-geo-alt"></i>
                        Dirección
                    </label>
                    <input type="text" name="Direccion" id="Direccion" class="modern-form-input" value="@Model.Direccion" placeholder="Dirección del hotel" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-mailbox"></i>
                        Código Postal
                    </label>
                    <input type="text" name="CP" id="CP" class="modern-form-input" value="@Model.CP" placeholder="Código postal" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-geo-alt-fill"></i>
                        Localidad
                    </label>
                    <input type="text" name="Localidad" id="Localidad" class="modern-form-input" value="@Model.Localidad" placeholder="Localidad" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-telephone"></i>
                        Teléfono
                    </label>
                    <input type="text" name="Telefono" id="Telefono" class="modern-form-input" value="@Model.Telefono" placeholder="Teléfono" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-envelope"></i>
                        Email
                    </label>
                    <input type="email" name="Email" id="Email" class="modern-form-input" value="@Model.Email" placeholder="email@ejemplo.com" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-person"></i>
                        Contacto
                    </label>
                    <input type="text" name="Contacto" id="Contacto" class="modern-form-input" value="@Model.Contacto" placeholder="Persona de contacto" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-door-open"></i>
                        Cantidad de Habitaciones
                    </label>
                    <input type="number" name="CantidadHabitaciones" id="CantidadHabitaciones" class="modern-form-input" value="@Model.CantidadHabitaciones" placeholder="0" min="0" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-star"></i>
                        Categoría
                    </label>
                    <div class="modern-select-wrapper">
                        <select name="Categoria" id="Categoria" class="modern-form-select modern-select-stars">
                            <option value="1" @(Model.Categoria == 1 ? "selected" : "") data-stars="1">1 Estrella</option>
                            <option value="2" @(Model.Categoria == 2 ? "selected" : "") data-stars="2">2 Estrellas</option>
                            <option value="3" @(Model.Categoria == 3 ? "selected" : "") data-stars="3">3 Estrellas</option>
                            <option value="4" @(Model.Categoria == 4 ? "selected" : "") data-stars="4">4 Estrellas</option>
                            <option value="5" @(Model.Categoria == 5 ? "selected" : "") data-stars="5">5 Estrellas</option>
                        </select>
                        <div class="modern-select-stars-display" id="starsDisplay">
                            @{
                                int categoriaValue = Model.Categoria > 0 ? Model.Categoria : 1;
                            }
                            @for (int i = 1; i <= categoriaValue; i++)
                            {
                                <i class="bi bi-star-fill"></i>
                            }
                        </div>
                    </div>
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-clock"></i>
                        Check-In
                    </label>
                    <input type="text" name="CheckIn" id="CheckIn" class="modern-form-input" value="@Model.CheckIn" placeholder="Horario de check-in" />
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-clock-history"></i>
                        Check-Out
                    </label>
                    <input type="text" name="CheckOut" id="CheckOut" class="modern-form-input" value="@Model.CheckOut" placeholder="Horario de check-out" />
                </div>

                <div class="modern-form-group" style="grid-column: 1 / -1;">
                    <label class="modern-form-label">
                        <i class="bi bi-map"></i>
                        Código HTML de Google Maps
                    </label>
                    <textarea name="GoogleMapHtml" id="GoogleMapHtml" class="modern-form-textarea" rows="4" placeholder="Código HTML del mapa de Google Maps">@Model.GoogleMapHtml</textarea>
                </div>
            </div>

            <div class="modern-form-actions">
                <button type="button" class="btn-modern btn-modern-secondary" onclick="location.href='/Hotel/Index';">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a la lista</span>
                </button>
                <button type="button" class="btn-modern btn-modern-primary" onclick="javascript: save();">
                    <i class="bi bi-check-circle"></i>
                    <span>Guardar</span>
                </button>
            </div>
        </form>
    </div>
</div>
    


<script type="text/javascript">
    function save() {
        if ($("#Nombre").val().replace(/ /g,'') == "") {
            (window.alertInfo || window.alert)("El campo nombre es obligatorio. Por favor ingrese el nombre del Hotel.", "Validación");
            return;
        }

        
        

        var HotelID = $("#HotelID").val();
        var _data = $("#formHotel").serializeArray();

        if (HotelID == "") //create
        {

            showLoading();
            $.ajax({
                url: "/Hotel/HotelCreate",
                data: _data,
                dataType: "json",
                success: function (data) {

                    hideLoading();

                    if (data.Mensaje === "Done.") {
                        $("#HotelID").val(data.HotelID);
                        confirm("Los datos se guardarón correctamente.", "Operación Exitosa");
                        window.location.href = "/Hotel/ABM?Id=" + data.HotelID;

                    }
                    else {
                        if (data.Mensaje == "Existe.") {
                            confirm("Ya existe un hotel con ese nombre, por favor cambie el nombre.", "Advertencia");
                        }
                        else {
                            (window.alertError || window.alert)("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                            console.log(data.Error);
                        }
                    }
                }
            });

        }
        else //update
        {
            showLoading();
            $.ajax({
                url: "/Hotel/HotelUpdate",
                data: _data,
                dataType: "json",
                success: function (data) {

                    hideLoading();
                    if (data.Mensaje === "Done.") {
                        confirm("Los datos se guardarón correctamente.", "Operación Exitosa");

                        setTimeout(function () {
                            $('.ui-dialog-titlebar-close.ui-corner-all').click()

                        }, 2000);

                    }
                    else {
                        (window.alertError || window.alert)("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                        console.log(data.Error);
                    }
                }
            });
        }

    }

    function checkNombre(Nombre) {
        $.ajax({
            url: "/Hotel/HotelCheckNombre",
            data: { Nombre: Nombre },
            dataType: "json",
            success: function (data) {
                if (data.Mensaje === "Done.") {
                    if (data.Existe == "Yes") {
                        confirm("Ya existe un hotel con ese nombre, por favor cambie el nombre.", "Advertencia");
                        return true;
                    }
                    
                    return false;
                }
                else {
                    (window.alertError || window.alert)("Ha ocurrido un error, al intentar checkear el nombre del hotel.", "Error");
                    console.log(data.Error);
                    return true;
                }
            }
        });
    }

    // Actualizar visualización de estrellas cuando cambia el select
    $(document).ready(function() {
        function updateStarsDisplay() {
            var selectedValue = parseInt($("#Categoria").val()) || 1;
            var starsDisplay = $("#starsDisplay");
            starsDisplay.empty();
            
            for (var i = 1; i <= selectedValue; i++) {
                starsDisplay.append('<i class="bi bi-star-fill"></i>');
            }
        }

        // Actualizar al cargar la página
        updateStarsDisplay();

        // Actualizar cuando cambia el select
        $("#Categoria").on('change', function() {
            updateStarsDisplay();
        });
    });
</script>