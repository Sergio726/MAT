@{
    ViewBag.Title = "Distribución de Hoteles";
}

@section Styles {
    <link href="~/Content/hoteles.css" rel="stylesheet" />
    <link href="~/Content/mat.esquemadistribucion.print.css" rel="stylesheet" media="print" />
}

@if (ViewBag.Error != null)
{
    <div class="hotel-distribucion-error"><i class="bi bi-exclamation-triangle-fill"></i> <span>@ViewBag.Error</span></div>
}

<input type="hidden" id="distribucion-viaje-id" value="@ViewData["viajeid"]" />

<div class="hotel-distribution-page">
    <div class="hotel-header">
        <div class="hotel-header-title">Distribución de Habitaciones</div>
        <div class="hotel-header-logo">
            <img src="/Images/marco_antonio_back3.png" alt="Marco Antonio Tours" />
        </div>
    </div>

    <div class="hotel-toolbar">
        <div class="hotel-selector-group">
            <span class="hotel-selector-label">Hotel:</span>
            @if (ViewBag.ListHotel != null)
            {
                <select id="HotelPorViaje" name="HotelPorViaje" class="modern-form-select hotel-select">
                    @foreach (MAT.MVC.Models.HotelDropDown item in ViewBag.ListHotel)
                    {
                        <option value="@item.HotelID" fecha="@item.Fecha.ToString("dd/MM/yyyy")">@item.Nombre @item.Fecha.ToString("dd/MM/yyyy")</option>
                    }
                </select>
            }
        </div>
        <button id="btn-print-distribucion" type="button" class="btn-print hidden-print">
            <i class="bi bi-printer-fill"></i>
            Imprimir Distribución
        </button>
    </div>

    <div id="esquema-distribucion" class="hotel-content">
        <div class="loading-container">
            <div class="loading-spinner"></div>
            <span>Cargando distribución...</span>
        </div>
    </div>
</div>

<!-- Modal confirmación quitar pasajero de habitación -->
<div class="modal fade" id="modalQuitarPasajero" tabindex="-1" aria-labelledby="modalQuitarPasajeroLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-quitar-pasajero">
            <div class="modal-header modal-quitar-pasajero-header">
                <h5 class="modal-title" id="modalQuitarPasajeroLabel">
                    <i class="bi bi-exclamation-triangle-fill"></i> Confirmar acción
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p id="modal-quitar-pasajero-mensaje" class="mb-0"></p>
                <p class="text-danger small mb-0 mt-2">
                    <strong>Este cambio es irreversible.</strong> El pasajero dejará de estar asignado a esta habitación.
                </p>
            </div>
            <div class="modal-footer modal-quitar-pasajero-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btn-modal-quitar-aceptar">
                    <i class="bi bi-person-dash"></i> Quitar de la habitación
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script type="text/javascript">
    (function () {
        var $ = window.jQuery;
        if (!$) {
            console.error('jQuery no está cargado. Asegúrese de que el layout incluye jQuery.');
            return;
        }
        $(function () {
            var idselected = $("#HotelPorViaje option:selected").val();
            var viajeid = $("#distribucion-viaje-id").val();
            var fecha = $("#HotelPorViaje option:selected").attr("fecha");

            setTimeout(function () {
                loadPage(idselected, viajeid, fecha);
            }, 500);
        });

        $(document).on("change", "#HotelPorViaje", function () {
            var idselected = $("#HotelPorViaje option:selected").val();
            var fecha = $("#HotelPorViaje option:selected").attr("fecha");
            var viajeid = $("#distribucion-viaje-id").val();

            $("#esquema-distribucion").html('<div class="loading-container"><div class="loading-spinner"></div><span>Cargando distribución...</span></div>');

            setTimeout(function () {
                loadPage(idselected, viajeid, fecha);
            }, 300);
        });

        $(document).on("click", "#btn-print-distribucion", function () {
            window.print();
        });

        function loadPage(idselected, viajeid, fecha) {
            $.ajax({
                url: "/Hotel/EsquemaDistribucion",
                data: { hotelid: idselected, viajeid: viajeid, fecha: fecha },
                dataType: "html",
                success: function (data) {
                    $("#esquema-distribucion").html(data);
                },
                error: function() {
                    $("#esquema-distribucion").html('<div class="error-message">Error al cargar la distribución. Por favor, intente nuevamente.</div>');
                }
            });
        }
    })();
</script>
}
