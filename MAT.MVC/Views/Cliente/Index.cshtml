@model IEnumerable<MAT.Entities.PersonaCliente>

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-person-badge"></i>
            <span>Clientes</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/PersonaCliente/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Cliente</span>
            </a>
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblClientes">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Tipo Documento</th>
                    <th>Nro. Documento</th>
                    <th>Razón Social</th>
                    <th>CUIT</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Moneda</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Apellido</strong></td>
                        <td>@item.Nombre</td>
                        <td>@item.TipoDocumento</td>
                        <td>@item.NroDocumento</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.RazonSocial))
                            {
                                @item.RazonSocial
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Cuit))
                            {
                                @item.Cuit
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Telefono))
                            {
                                <i class="bi bi-telephone"></i> @item.Telefono
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <i class="bi bi-envelope"></i> @item.Email
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>@item.Moneda</td>
                        <td>
                            <div class="modern-table-actions">
                                <a href="/PersonaCliente/Edit/@item.PersonaId" class="modern-btn-icon modern-btn-icon-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/PersonaCliente/Details/@item.PersonaId" class="modern-btn-icon" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblClientes").DataTable({
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ clientes",
                infoEmpty: "No hay clientes disponibles",
                infoFiltered: "(filtrado de _MAX_ clientes totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },
            columnDefs: [
                { orderable: false, targets: 9 }
            ]
        });
    });
</script>
