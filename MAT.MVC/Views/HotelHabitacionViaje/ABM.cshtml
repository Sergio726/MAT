@model MAT.MVC.Models.HotelHabitacionViajeModel

@if (ViewBag.Error != null)
{
    <div class="msgError"><span>@ViewBag.Error</span></div>    
}

<div>
    <div class="form-label">
        <label class="custom_font_weigh_bold">VIAJE: @Model.ViajeNombre </label>
        <label class="custom_font_weigh_bold">HOTEL: @Model.HotelNombre (@Model.Comentario) </label>
        <label class="custom_font_weigh_bold">FECHA: @Model.Fecha.ToShortDateString() </label>
    </div>
    <div>
        <fieldset class="customborder">
            <legend>
                Distribucion de Habitaciones
            </legend>
            <label>
                Cantidad 
                <input class="custom_width_45px" type="number" min="1" value="1" id="txtCantidad" />
            @*</label>
            
            <label>*@
                Tipo Hab.
                 <select id="Tipo" name="Tipo" class="valid" title="Cantidad de Habitaciones">
                    @foreach (MAT.MVC.Models.HabitacionTipo item in ViewBag.HabitacionTipo)
                    {
                        <option value="@item.Id" capacidad="@item.CapacidadNormal" >@item.Descripcion</option>
                    }
                </select>
                <input type="button" class="btn btn-small btn-inverse view-all" value="Agregar" style="vertical-align: text-bottom;" title="Agregar Habitaciones" onclick="javascript: addDistribucion()" />
                <input type="button" class="btn btn-small btn-inverse view-all" value="Guardar Plantilla" style="vertical-align: text-bottom;" title="Guardar distribucion en una planilla para usarla después." onclick="javascript: showNombrePlantila()" />
                <input type="button" class="btn btn-small btn-inverse view-all" value="Cargar Plantilla" style="vertical-align: text-bottom;" title="Cargar una plantilla" onclick="javascript: showPlantilas()" />
            </label>
        
            <div>
                <table id="tblHotelHabitacionViaje" class="mat-customtable">
                    <thead>
                        <tr>
                            <th>Nro Hab.</th>
                            <th>Nombre Hab.</th>
                            <th>Tipo</th>
                            <th>Capacidad</th>
                            <th></th>
                        </tr>
                    </thead>
                </table>
            </div>
            

        </fieldset>

    </div>
</div>



<script type="text/javascript">
    $(document).ready(function () {
        Load_tblHotelHabitacionViaje(@Html.Raw(ViewBag.dtDistribucionHab));

    });

    var tblHotelHabitacionViaje;
    function Load_tblHotelHabitacionViaje(datatable) {
        var dataSet = datatable;
        var jTables = eval(dataSet);
        var jt = jTables.Table;

        if (tblHotelHabitacionViaje != undefined) {
            tblHotelHabitacionViaje.clear();
            tblHotelHabitacionViaje.draw();
            tblHotelHabitacionViaje.destroy();
        }

        tblHotelHabitacionViaje = $("#tblHotelHabitacionViaje").DataTable({
            "aaData": jt,
            "columns": [
            { "data": "NroHabitacion" },
            { "data": "Nombre" },
            //{ "data": "Monto", 
            //    "mRender": function (data, type, row) {
            //        var numberFormat = formatNumberMoney(row.Monto);
            //        return numberFormat;
            //    }
            //},
            { "data": "Tipo" },
            { "data": "Capacidad" },
            { "data": "Capacidad",
                "mRender": function (data, type, row) {

                    var data = "<a href=\"javascript:editHabitacion('" + row.HabitacionID + "');\"><img src=\"/Images/pencil.png\" width=\"32\" height=\"32\" title=\"Editar\"></a>"
                    data = data + "<a href='javascript:deleteDistribucionRow(" + row.TransHotelHabitacionViajeID + ");'><img src='/Images/cross.png' width='32' height='32' title='Eliminar Habitacion'></a>";
                    return data;
                }
            }
            //{
            //    "class":          "details-control",
            //    "orderable":      false,
            //    "data":           null,
            //    "defaultContent": ""
            //}
            ],
            "bAutoWidth": false,
            "pageLength": 25
        });
    };

    function addDistribucion() {
        var ViajeID = "@Model.ViajeID";
        var HotelID = "@Model.HotelID";
        var Cantidad = $("#txtCantidad").val();
        var Tipo = $("#Tipo").val();
        var Fecha = "@Model.Fecha";
        
        //AddDistribucion(string HotelID, string ViajeID , string Fecha, int Tipo, int Cantidad)
        $.ajax({
            url: "/HotelHabitacionViaje/AddDistribucion",
            data: {
                HotelID: HotelID,
                ViajeID: ViajeID,
                Fecha: Fecha,
                Tipo: Tipo,
                Cantidad: Cantidad
            },
            dataType: "json",
            success: function (data) {

                if (data.Mensaje == "Done.") {
                    alert("La distribución se agrego con exito", "Operación Exitosa");
                    getDistribucion();
                }
                else {
                    alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                    console.log(data.Error);

                }

            }
        });
    };

    function getDistribucion() {
        var ViajeID = "@Model.ViajeID";
        var HotelID = "@Model.HotelID";
        var Fecha = "@Model.Fecha";
        
        $.ajax({
            url: "/HotelHabitacionViaje/dtDistribucionHab",
            data: {
                HotelID: HotelID,
                ViajeID: ViajeID,
                Fecha: Fecha
            },
            dataType: "json",
            success: function (data) {

                if (data.Mensaje == "Done.") {

                    Load_tblHotelHabitacionViaje(jQuery.parseJSON(data.DataTable));
                }
                else {
                    alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                    console.log(data.Error);

                }

            }
        });
    }

    var divLoading = "<div id='divFullLoading'></div>";
    
    function deleteDistribucionRow(TransHotelHabitacionViajeID) {
        $("#popup_HotelHabitacionViaje").append(divLoading);
         $.ajax({
            url: "/HotelHabitacionViaje/deleteDistribucionRow",
            data: {
                TransHotelHabitacionViajeID: TransHotelHabitacionViajeID,
            },
            dataType: "json",
            success: function (data) {

                if (data.Mensaje == "Done.") {
                    getDistribucion();
                    $("#divFullLoading").remove();
                }
                else {
                    if (data.Mensaje == "Error.") {
                        alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                        console.log(data.Error);
                    }
                    
                }

            }
        });
    }

    function editHabitacion(HabitacionID) {
        var title = "Edición de Habitación";
        var id = "popup_HabitacionEdit";

        var url = "/Habitacion/ABM?Id=" + HabitacionID.trim();
        ShowFormDialog(url, id, title, 'min');
    }

    function showNombrePlantila() {
        var html = '<div class="custom_padding_10"><input type="text" id="txtNombrePlantilla" size="50" /><input Id="btnGuardarPlantilla" type="button" class="custom_margin_left_5 btn btn-small btn-inverse view-all" value="Guardar" style="vertical-align: text-bottom;" title="Guardar plantilla" onclick="javascript: addDistribucion_Plantilla()" /></div>';
        var dialogid = 'popin_NombrePlantila';
        var dialogtitle = 'Nombre de Plantilla';
        var widthsize = '30%';
        ShowFormDialogHTML(html, dialogid, dialogtitle, widthsize);
    }

    function addDistribucion_Plantilla() {
        var Nombre = $("#txtNombrePlantilla").val();
        var ViajeID = "@Model.ViajeID";
        var HotelID = "@Model.HotelID";

        if (Nombre === ""){
            alert("Por favor ingrese el un nombre para asignar a la plantilla.", "Error");
        }
        else
        {
            $("#btnGuardarPlantilla").attr('disabled',true);
            $.ajax({
                url: "/HotelHabitacionViaje/CreatePlantilla",
                data: {
                    Nombre: Nombre,
                    ViajeID: ViajeID,
                    HotelID: HotelID
                },
                dataType: "json",
                success: function (data) {

                    if (data.Mensaje == "Done.") {
                        alert("La plantilla se guardo con exito", "Operación Exitosa");
                        $("#popin_NombrePlantila").dialog("close");
                    }
                    else
                    {
                        if(data.Mensaje == "Alert.")
                        {
                             alert(data.Error, "Atención");
                            $("#btnGuardarPlantilla").attr('disabled',false);
                        }
                        else{ 
                            alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                            console.log(data.Error);
                        }
                    }
                    

                }
            });
        }

        
    };

    function showPlantilas(){
        var title = "Plantillas. Distribución de Habitaciones";
        var id = "popup_PlantillaDistribucionHabitacion";

        var url = "/HotelHabitacionViaje/GetPlantillasDistribucion";
        ShowFormDialog(url, id, title, 'medium');
    }

    function insertByPlantilla(PlantillaId){
        var ViajeID = "@Model.ViajeID";
        var HotelID = "@Model.HotelID";
        var Fecha = "@Model.Fecha";

        $("#popup_PlantillaDistribucionHabitacion").append(divLoading);

        $.ajax({
            url: "/HotelHabitacionViaje/AddDistribucionByPlantilla",
            data: {
                HotelID: HotelID,
                ViajeID: ViajeID,
                Fecha: Fecha,
                PlantillaId: PlantillaId
            },
            dataType: "json",
            success: function (data) {

                if (data.Mensaje == "Done.") {
                    alert("Se agregaron habitaciones de la distribución de la Plantilla seleccionada.", "Operación Exitosa");
                    $("#popup_PlantillaDistribucionHabitacion").dialog("close");
                    getDistribucion();
                }
                else {
                    alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                    console.log(data.Error);

                }

            }
        });
    };

        
    function deletePlantilla(PlantillaId) {
        
        $.ajax({
            url: "/HotelHabitacionViaje/deletePlantilla",
            data: {
                PlantillaId: PlantillaId,
            },
            dataType: "json",
            success: function (data) {

                if (data.Mensaje == "Done.") {
                    $("#popup_divMSGDeletePlantilla").dialog("close");
                    $("#popup_PlantillaDistribucionHabitacion").dialog("close");
                     showPlantilas();
                }
                else {
                    if (data.Mensaje == "Error.") {
                        alert("Ha ocurrido un error, por favor intente nuevamente.", "Error");
                        console.log(data.Error);
                    }

                }

            }
        });
    }

</script>