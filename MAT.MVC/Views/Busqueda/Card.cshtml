@model MAT.MVC.Models.PerfilModel

<div class="profile-card">
    <div class="profile-header">
        @if (Model.Persona.Sexo.Value == 0)
        {
            <img src="/Images/man.png" class="profile-avatar" alt="Avatar" />
        }
        else if (Model.Persona.Sexo.Value == 1)
        {
            <img src="/Images/woman.png" class="profile-avatar" alt="Avatar" />
        }
        <p class="profile-name">
            <a href="#">@Model.Persona.Nombre @Model.Persona.Apellido</a>
        </p>
    </div>
    <div class="profile-body">
        <div class="profile-info-grid">
            <div class="profile-info-item">
                <span class="profile-info-label">DNI</span>
                <span class="profile-info-value">@Model.Persona.NroDocumento</span>
            </div>
            <div class="profile-info-item">
                <span class="profile-info-label">CUIL</span>
                <span class="profile-info-value">@ViewBag.PersonaClienteCUIL</span>
            </div>
            <div class="profile-info-item">
                <span class="profile-info-label">Teléfono</span>
                <span class="profile-info-value">@Model.Persona.Telefono</span>
            </div>
            <div class="profile-info-item">
                <span class="profile-info-label">Email</span>
                <span class="profile-info-value">@Model.Persona.Email</span>
            </div>
        </div>

        @if (Model.EsCliente)
        {
            <div class="profile-actions">
                <a id="btn-perfil-cc" data-personaid="@Model.Persona.PersonaId" class="btn-profile-action">
                    <i class="bi bi-clock-history"></i>
                    Historial de Pagos
                </a>
                <a id="btn-perfil-facturas" data-personaid="@Model.Persona.PersonaId" class="btn-profile-action">
                    <i class="bi bi-file-text"></i>
                    Facturas
                </a>
                <a id="btnMovimientoNotaCredito" data-personaid="@Model.Persona.PersonaId" class="btn-profile-action">
                    <i class="bi bi-credit-card"></i>
                    Movimientos Nota de Crédito
                </a>
            </div>
        }
        else if (Model.EsPasajero)
        {
            <div class="profile-actions">
                <a id="btn-perfil-historialviaje" data-personaid="@Model.Persona.PersonaId" class="btn-profile-action">
                    <i class="bi bi-airplane"></i>
                    Historial de Viajes
                </a>
            </div>
        }
    </div>
</div>

<script type="text/javascript">
    $("#btnMovimientoNotaCredito").click(function () {
        $(".resumen-perfil").html(
            '<div style="display: flex; align-items: center; justify-content: center; padding: 2rem; color: #9ca3af;">' +
            '<div style="width: 24px; height: 24px; border: 2px solid #e5e7eb; border-top-color: #e91e63; border-radius: 50%; animation: spin 0.8s linear infinite; margin-right: 0.5rem;"></div>' +
            'Cargando...' +
            '</div>'
        );
        var ClienteID = $(this).data("personaid");
        $.ajax({
            url: "/NotaCredito/partialMovimientoNotaCredito",
            data: { ClienteID: ClienteID },
            success: function (data) {
                $(".resumen-perfil").html(data);
            },
            error: function (e) {
                (window.alertError || window.alert)("Se produjo un error. Contáctese con el administrador.", "Error");
                console.log(e);
            }
        })
    });
</script>
