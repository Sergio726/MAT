<script type="text/javascript">
    var oSeleccionarPasajeros = {};    
    oSeleccionarPasajeros.Habitacion = {};
    oSeleccionarPasajeros.PasajerosSelected = [];

    oSeleccionarPasajeros.loadTablePasajeros = function (dataSource) {

        const dataFilter = dataSource.filter(p => p.HabitacionAsignada == "");

        if (this.TblPasajeros != undefined) {
            this.TblPasajeros.clear();
            this.TblPasajeros.draw();
            this.TblPasajeros.destroy();
        }
        this.TblPasajeros = $("#selectPasajeros_tblPasajeros").DataTable({
            "aaData": dataFilter,
            "columns": [
                {
                    "mRender": function (data, type, row) {
                        return oSeleccionarPasajeros.fnRenderCheckBoxPasajeros(row);
                    }
                },
                { "title": "Nombre", "data": "Nombre" },
                { "title": "Apellido", "data": "Apellido" },
                { "title": "Email", "data": "Email" },
                { "title": "Nro Documento", "data": "NroDocumento" },               
            ],
            "bAutoWidth": false,
            "paging": false,
            "searching": false,
        });
    }

    oSeleccionarPasajeros.fnRenderCheckBoxPasajeros = function (row) {
        const html = "<input type=\"checkbox\" id=\"selectPasajeros_tblPasajeros_checkbox_" + row.Id + "\" " +
            " onclick=\"oSeleccionarPasajeros.checkBoxPasajero('" + row.Id + "')\" >";
        return html;
    }

    oSeleccionarPasajeros.checkBoxPasajero = function (pasajeroId) {
        const oChecBox = $("#selectPasajeros_tblPasajeros_checkbox_" + pasajeroId);
        if (oChecBox.is(':checked')) {
            const ocupacion = this.PasajerosSelected.length;
            const disponibilidad = this.Habitacion.Capacidad - ocupacion;
            if (disponibilidad > 0) {
                this.PasajerosSelected.push(pasajeroId);
            } else {
                alert("La capacidad de la habitacion ya esta cubierta");
                oChecBox.prop("checked", false);
            }
        }
        else {
            const idx = this.PasajerosSelected.findIndex(x => x == pasajeroId);
            if (idx != -1) {
                this.PasajerosSelected.splice(idx, 1);
            }
        }
    }

    oSeleccionarPasajeros.asignar = function () {
        const habId = this.Habitacion.HabitacionId;        
        $("#AsignarPasajeroHabitacion").dialog("close");
        oReserva.updateHabitacionesSeleted(this.PasajerosSelected, habId);
    }
    
    oSeleccionarPasajeros.loadHabitacion = function (data) {
        const habitacionId = $("#selectPasajeros_habitacionId").val();
        const result = data.HabitacionesDisponibles.filter(h => h.HabitacionId == habitacionId);
        if (result.length > 0) {            
            this.Habitacion = result[0];
            $("#hab_nombre").html(this.Habitacion.HabitacionNombre);
            $("#hab_nro").html(this.Habitacion.NroHabitacion);
            $("#hab_tipo").html(this.Habitacion.HabitacionTipo);
            $("#hab_descripcion").html(this.Habitacion.HabitacionDescripcion);
            $("#hab_precio").html(this.Habitacion.Precio);
            $("#hab_capacidad").html(this.Habitacion.Capacidad);            
        }
    }
</script>
<div>
    <div class="content-box">
        <div>
            <h5>Detalle de la Habitación</h5>
        </div>
        <div class="divflex">
            <div style="width:50%">
                <div class="form-group">
                    <label>Nombre:</label><label class="show-data" id="hab_nombre"></label>
                </div>
                <div class="form-group">
                    <label>Número:</label><label class="show-data" id="hab_nro"></label>
                </div>
                <div class="form-group">
                    <label>Tipo:</label><label class="show-data" id="hab_tipo"></label>
                </div>
            </div>
            <div style="width:50%">
                <div class="form-group">
                    <label>Descripcion:</label><label class="show-data" id="hab_descripcion"></label>
                </div>
                <div class="form-group">
                    <label>Precio:</label><label class="show-data" id="hab_precio"></label>
                </div>
                <div class="form-group">
                    <label>Capacidad:</label><label class="show-data" id="hab_capacidad"></label>
                </div>
            </div>
        </div>        
        <div class="content-table">
            <h5>Pasajeros</h5>
            <table id="selectPasajeros_tblPasajeros" class="mat-customtable" width="100%"></table>
        </div>
        <div>
            <br />
            <input id="selectPasajeros-btn-select" type="button" title="Asignar pajero a la habitación" value="Asignar" class="btn btn-small btn-inverse" onclick="oSeleccionarPasajeros.asignar();" />
        </div>
    </div>
   
    
    
</div>
<input type="hidden" id="selectPasajeros_habitacionId" value="@ViewData["habitacionId"]" />
<script type="text/javascript">
    $(document).ready(function () {
                
        oSeleccionarPasajeros.loadHabitacion(oReserva);
        oSeleccionarPasajeros.loadTablePasajeros(oReserva.Pasajeros);
    });
</script>