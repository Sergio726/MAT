                        { "title": "Nro Habitacion", "data": "NroHabitacion" },
                        { "title": "Nombre Habitacion", "data": "HabitacionNombre" },
                        { "title": "Tipo Habitacion", "data": "HabitacionTipo" },
                        { "title": "Descripcion", "data": "HabitacionDescripcion" },
                        { "title": "Capacidad", "data": "Capacidad" },
                        { "title": "Precio", "data": "Precio" },
