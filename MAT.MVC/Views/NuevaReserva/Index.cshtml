                </div>

                <div id="divPreReservas" title="Pre Reservas Vencidas" style="display:none;max-height: 428px; overflow-y: auto;">
                    <table class="mat-customtable" style="width:95%;">
                        <thead>
                            <tr>
                                <th>Butaca</th>
                                <th>Pasajero</th>
