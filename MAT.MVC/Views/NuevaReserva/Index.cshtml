        <script type="text/javascript">
            let oReserva = {};
            oReserva.ViajeId = "@Model.ViajeId";
            oReserva.Reservas = {}
            oReserva.Cliente = {};
            oReserva.Pasajeros = [];
            oReserva.HabitacionesDisponibles = [];
            oReserva.HabitacionesSelected = [];


            $(document).ready(function () {
                getPasajesSenaIncompleta();
                //checkBus(); acomodaba los labels de escalera y bar

                loadAutoComplete();
                oReserva.buildReservas();
                oReserva.loadTablePasajeros();
                getHabitacionesDisponibles();
                setTimeout(formatDisplay, 2000);
            });

            function getHabitacionesDisponibles() {
                $.ajax({
                    url: "/NuevaReserva/GetHabitacionesDisponiblesByViaje",
                    data: { viajeId: oReserva.ViajeId },
                    success: function (data) {
                        oReserva.HabitacionesDisponibles = data;
                        oReserva.loadTableHabitaciones();
                    }
                })
            }

            function loadAutoComplete() {
                $("#txt-busqueda-cliente").autocomplete({
                    minLength: 3,
                    source: function (request, response) {
                        $.ajax({
                            url: "/NuevaReserva/QuickClienteSearchAsync",
                            data: { query: request.term },
                            success: function (data) {
                                response($.map(data,
                                    function (item) {
                                        return {
                                            label: item.Nombre + " " + item.Apellido + " | DNI " + item.NroDocumento,
                                            value: item.Nombre + " " + item.Apellido,
                                            data: item
                                        }
                                    }));
                            }
                        })

                    },
                    select: function (event, ul) {
                        oReserva.Cliente = ul.item.data;
                        oReserva.addPasajero(ul.item.data);
                        $("#cliente-dni").html(ul.item.data.NroDocumento);
                    }
                });
                $("#txt-busqueda-pasajero").autocomplete({
                    minLength: 3,
                    source: function (request, response) {
                        $.ajax({
                            url: "/NuevaReserva/QuickClienteSearchAsync",
                            data: { query: request.term },
                            success: function (data) {
                                response($.map(data,
                                    function (item) {
                                        return {
                                            label: item.Nombre + " " + item.Apellido + " | DNI " + item.NroDocumento,
                                            value: item.Nombre + " " + item.Apellido,
                                            data: item
                                        }
                                    }));
                            }
                        })

                    },
                    select: function (event, ul) {
                        oReserva.addPasajero(ul.item.data);
                        ul.item.value = ''; //clean input
                    }
                });
            }

            oReserva.buildReservas = function () {
                this._reservas = @Html.Raw(Json.Encode(Model.Reservas));
                for (item of this._reservas) {
                    this.Reservas[item.PasajeId] = item;
                }

                const typeCoche = this._reservas[0].TransporteTipo;
                switch (typeCoche) {
                    case "DOBLEPISO":
                        this.buildButaca("coche51_61-tabs-1", 1);
                        this.buildButaca("coche51_61-tabs-2", 2);
                        break;
                    case "PISOELEVADO":
                        this.buildButaca("coche_pisoelevado-tabs-1", 1);
                        break;
                    case "CAMION 4X4":
                        this.buildButaca("coche_minibus-tabs-1", 1);
                        break;
                    case "MINIBUS":
                        this.buildButaca("coche_minibus-tabs-1", 1);
                        break;                        
                }
            }

            oReserva.buildButaca = function (ulId, butacaPiso) {

                let pasajes = this._reservas.filter(p => p.ButacaPiso == butacaPiso);
                for (pasaje of pasajes) {

                    let aHtml = $("<a onclick=\"oReserva.butacaSeleccionada('" + pasaje.PasajeId + "')\"/>")
                        .html(pasaje.ButacaCodigoButaca)
                        .attr("id", pasaje.PasajeId)
                        .attr("title", pasaje.ButacaCodigoButaca)
                        .addClass(oReserva.getClassButacaByEstado(pasaje.EstadoPasaje));                        

                    if (pasaje.PasajeroId != "00000000-0000-0000-0000-000000000000") {
                        let sPosition = pasaje.ButacaPosicion == "A" ? "bottom": "top";                        
                        aHtml.attr("title", pasaje.PasajeroNombre + " " + pasaje.PasajeroApellido)
                            .attr("data-toggle", "tooltip")
                            .attr("data-placement", sPosition);
                    }

                    let liHtml = $("<li/>")
                        .addClass("seat_" + pasaje.ButacaFila)
                        .addClass(pasaje.ButacaPosicion)
                        

                    liHtml.append(aHtml);

                    $("#" + ulId).append(liHtml);
                }
            }

            oReserva.getClassButacaByEstado = function (estado) {
                let classCss = "";
                switch (estado) {
                    case 1: classCss = "disponible"
                        break;
                    case 3: classCss = "señado"
                        break;
                    case 4: classCss = "reservado"
                        break;
                    case 5: classCss = "prereserva"
                        break;
                    case 6: classCss = "reservahotel"
                        break;
                    case 8: classCss = "reservapasajehotel"
                        break;
                    case 9: classCss = "prereservahotel"
                        break;
                }
                return classCss;
            }

            oReserva.butacaSeleccionada = function (pasajeId) {

                if (this.Reservas[pasajeId].EstadoPasaje != 1)
                    return false;

                if ($("#" + pasajeId).hasClass("selected")) {
                    
                    confirm("La butaca ya esta asignada. Quiere liberar la butaca?",
                        "Confirmar",
                        function () {
                            var $dlg = $(this);
                            oReserva.updateButacasSeleted([], pasajeId);                            
                            $dlg.dialog("close");
                            $dlg.remove();
                        },
                        
                        function () {
                            var $dlg = $(this);
                            $dlg.dialog("close");
                            $dlg.remove();
                        }
                    );
                    return false;
                }

                if (this.Pasajeros.length == 0) {
                    alert("Agregue pasajeros para continuar.")
                    return false;
                }

                const pasajerosSinButacas = this.Pasajeros.filter(p => p.Butaca.Id == "");
                if (pasajerosSinButacas.length == 0) {
                    alert("Todos los pasajeros estan asignados a butacas.")
                    return false;
                }

                var url = "/NuevaReserva/SeleccionarPasajero?entityId=" + pasajeId + "&source=BUTACA";
                var dialogid = "AsignarPasajero";
                var dialogtitle = "Asignar pasajero a la butaca";
                ShowFormDialog(url, dialogid, dialogtitle, "medium");
                return false;
            }

            oReserva.loadTablePasajeros = function () {
                if (this.TblPasajeros != undefined) {
                    this.TblPasajeros.clear();
                    this.TblPasajeros.draw();
                    this.TblPasajeros.destroy();
                }
                this.TblPasajeros = $("#tblPasajeros").DataTable({
                    "aaData": this.Pasajeros,
                    "columns": [
                        { "title": "Nombre", "data": "Nombre" },
                        { "title": "Apellido", "data": "Apellido" },
                        { "title": "Email", "data": "Email" },
                        { "title": "Nro Documento", "data": "NroDocumento" },
                        {
                            "title": "Habitacion Asignada", "data": "HabitacionAsignada"
                        },
                        {
                            "title": "Butaca Asignada", "data": "Butaca.Codigo"
                        },
                        {
                            "mRender": function (data, type, row) {
                                return oReserva.fnRenderButtonRemovePasajero(row);
                            }
                        },
                    ],
                    "bAutoWidth": false,
                    "paging": false,
                    "searching": false,
                });
            }

            oReserva.loadTableHabitaciones = function() {
                if (this.TblHabitaciones != undefined) {
                    this.TblHabitaciones.clear();
