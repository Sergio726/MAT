        <script type="text/javascript">
            let oReserva = {};
            oReserva.viajeId = "@Model.ViajeId";
            oReserva.Cliente = {};
            oReserva.Pasajeros = [];
            oReserva.HabitacionesDisponibles = [];
            oReserva.HabitacionesSelected = [];


            $(document).ready(function () {
                getPasajesSenaIncompleta();
                //getDetalleViaje();
                checkBus();
                loadAutoComplete();
                loadTablePasajeros();
                getHabitacionesDisponibles();
                setTimeout(formatDisplay, 2000);

            });

            function loadAutoComplete() {
                $("#txt-busqueda-cliente").autocomplete({
                    minLength: 3,
                    source: function (request, response) {
                        $.ajax({
                            url: "/NuevaReserva/QuickClienteSearchAsync",
                            data: { query: request.term },
                            success: function (data) {
                                response($.map(data,
                                    function (item) {
                                        return {
                                            label: item.Nombre + " " + item.Apellido + " | DNI " + item.NroDocumento,
                                            value: item.Nombre + " " + item.Apellido,
                                            data: item
                                        }
                                    }));
                            }
                        })

                    },
                    select: function (event, ul) {
                        oReserva.Cliente = ul.item.data;
                        oReserva.Pasajeros.push(ul.item.data);
                        loadTablePasajeros();
                        $("#cliente-dni").html(ul.item.data.NroDocumento);
                    }
                });
                $("#txt-busqueda-pasajero").autocomplete({
                    minLength: 3,
                    source: function (request, response) {
                        $.ajax({
                            url: "/NuevaReserva/QuickClienteSearchAsync",
                            data: { query: request.term },
                            success: function (data) {
                                response($.map(data,
                                    function (item) {
                                        return {
                                            label: item.Nombre + " " + item.Apellido + " | DNI " + item.NroDocumento,
                                            value: item.Nombre + " " + item.Apellido,
                                            data: item
                                        }
                                    }));
                            }
                        })

                    },
                    select: function (event, ul) {
                        oReserva.Pasajeros.push(ul.item.data);
                        loadTablePasajeros();
                        ul.item.value = ''; //clean input
                    }
                });
            }

            function loadTablePasajeros() {
                if (oReserva.tblPasajeros != undefined) {
                    oReserva.tblPasajeros.clear();
                    oReserva.tblPasajeros.draw();
                    oReserva.tblPasajeros.destroy();
                }
                oReserva.tblPasajeros = $("#tblPasajeros").DataTable({
                    "aaData": oReserva.Pasajeros,
                    "columns": [
                        { "title": "Nombre", "data": "Nombre" },
                        { "title": "Apellido", "data": "Apellido" },
                        { "title": "Email", "data": "Email" },
                        { "title": "Nro Documento", "data": "NroDocumento" },
                        {
                            "title": "Habitacion Asignada",
                            "mRender": function (data, type, row) {
                                return "";
                            }
                        },
                        {
                            "mRender": function (data, type, row) {
                                return oReserva.fnRenderButtonRemovePasajero(row);
                            }
                        },
                    ],
                    "bAutoWidth": false,
                    "paging": false,
                    "searching": false,
                });
            }

            function getHabitacionesDisponibles() {
                $.ajax({
                    url: "/NuevaReserva/GetHabitacionesDisponiblesByViaje",
                    data: { viajeId: oReserva.viajeId },
                    success: function (data) {
                        oReserva.HabitacionesDisponibles = data;
                        loadTableHabitaciones();
                    }
                })
            }

            function loadTableHabitaciones() {
                if (oReserva.tblHabitaciones != undefined) {
                    oReserva.tblHabitaciones.clear();
                    oReserva.tblHabitaciones.draw();
                    oReserva.tblHabitaciones.destroy();
                }
                oReserva.tblHabitaciones = $("#tblHabitaciones").DataTable({
                    "aaData": oReserva.HabitacionesDisponibles,
                    "columns": [
                        {
                            "mRender": function (data, type, row) {
                                return oReserva.fnRenderCheckBoxHabitaciones(row);
                            }
                        },
                        { "title": "Hotel", "data": "HotelNombre" },
                        { "title": "Nro Habitacion", "data": "NroHabitacion" },
                        { "title": "Nombre Habitacion", "data": "HabitacionNombre" },
                        { "title": "Tipo Habitacion", "data": "HabitacionTipo" },
                        { "title": "Descripcion", "data": "HabitacionDescripcion" },
                        { "title": "Capacidad", "data": "Capacidad" },
                        { "title": "Precio", "data": "Precio" },
                        //{
                        //    "mRender": function (data, type, row) {
                        //        return oReserva.fnRenderButtonRemovePasajero(row);
                        //    }
                        //},
                    ],
                    "bAutoWidth": false,
                    "paging": false,
                    "searching": false,
                });
            }

            oReserva.fnRenderCheckBoxHabitaciones = function (row) {
                var html = "<input type=\"checkbox\" id=\"tblHabitacion_checkbox_" + row.HabitacionId + "\" " +
                    " onclick=\"oReserva.checkBoxHabitacionesDispoinbles('" + row.HabitacionId + "')\" >";
                return html;
            }

            oReserva.checkBoxHabitacionesDispoinbles = function (id) {
                if ($("#tblHabitacion_checkbox_" + id).is(':checked')) {
                    let capacidadActual = oReserva.calularCapacidadCubierta();
                    switch (true) {
                        case capacidadActual < 0:
                            oReserva.HabitacionesSelected.push(id);
                            oReserva.AsignarPasajeroHabitacion(id);
                            break;
                        case capacidadActual > 0:
                            alert("La capacidad ya esta cubierta y tiene disponible " + capacidadActual);
                            $("#tblHabitacion_checkbox_" + id).prop("checked", false);
                            break;
                        case capacidadActual == 0:
                            alert("La capacidad ya esta cubierta");
                            $("#tblHabitacion_checkbox_" + id).prop("checked", false);
                            break;
                    }

                } else {
                    const idx = oReserva.HabitacionesSelected.findIndex(x => x == id);
                    if (idx != -1) {
                        oReserva.HabitacionesSelected.splice(idx, 1);
                    }
                }
                oReserva.RecalcularDetallePago();
            }

            oReserva.calularCapacidadCubierta = function () {
                const cantidadPasajeros = oReserva.Pasajeros.length;
                let capacidadCubierta = 0;

                for (const item of oReserva.HabitacionesSelected) {
                    const habitacion = oReserva.HabitacionesDisponibles.filter(x => x.HabitacionId == item);
                    if (habitacion.length > 0)
                        capacidadCubierta = capacidadCubierta + habitacion[0].Capacidad;
                }

                return capacidadCubierta - cantidadPasajeros;
            }

            oReserva.fnRenderButtonRemovePasajero = function(row)
            {
                var button = "<a href=\"#\" onclick=\"oReserva.removePasajero('" + row.Id + "')\" >" +
                    "<img src =\"/Images/cross.png\" width=\"32\" height=\"32\" title=\"Eliminar\"></a >";
                return button;
            }

            oReserva.removePasajero = function (pasajeroId)
            {
                const idx = oReserva.Pasajeros.findIndex(x => x.Id == pasajeroId);
                if (idx != -1) {
                    oReserva.Pasajeros.splice(idx, 1);
                    loadTablePasajeros();
                }
            }

            oReserva.RecalcularDetallePago = function () {
                let precioTotal = 0;
                let html = "";
                html += "<h4>Detalle de compra</h4>"
                //html += "<h5>Habitaciones</h5>"
                for (let item of this.HabitacionesSelected) {
                    const result = this.HabitacionesDisponibles.filter(h => h.HabitacionId == item);
                    if (result.length > 0) {
                        const habitacion = result[0];
                        precioTotal += habitacion.Precio;
                        html += `<h5>Habitacion ${habitacion.HabitacionDescripcion} Precio: ${habitacion.Precio}"</h5>`;
                    }
                }
                html += "<br>";
                html += `<h5>Total: ${precioTotal}</h5>`;
                $("#detalle-pago").html(html);
            }

            oReserva.AsignarPasajeroHabitacion = function (habitacionId) {
                var url = "/NuevaReserva/SeleccionarPasajero?habitacionId=" + habitacionId; 
                var dialogid = "AsignarPasajeroHabitacion";
                var dialogtitle = "Asignar pasajero a la habitación";
                ShowFormDialog(url, dialogid, dialogtitle, "medium");                
                return false;
            }

