@model List<MAT.MVC.Models.MovimientoNotaCredito>

<style>
    .movimiento-nota-container {
        padding: 0.5rem;
    }
    .error-message {
        background: #fef2f2;
        border: 1px solid #fecaca;
        border-radius: 0.5rem;
        padding: 1rem;
        color: #dc2626;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }
    .error-message i {
        font-size: 1.25rem;
    }
    .movimiento-table-container {
        background: white;
        border-radius: 0.5rem;
        overflow: hidden;
    }
    .movimiento-table {
        width: 100%;
        border-collapse: collapse;
    }
    .movimiento-table thead th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.75rem 1rem;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-secondary, #6b7280);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-bottom: 1px solid var(--border-color, #e5e7eb);
        text-align: left;
    }
    .movimiento-table thead th.title-header {
        background: var(--primary-color, #e91e63);
        color: white;
        font-size: 0.875rem;
        text-transform: none;
        letter-spacing: normal;
    }
    .movimiento-table thead th:first-child {
        width: 40px;
        text-align: center;
    }
    .movimiento-table tbody td {
        padding: 0.75rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-bottom: 1px solid var(--border-color, #e5e7eb);
    }
    .movimiento-table tbody td:first-child {
        text-align: center;
        font-weight: 500;
        color: var(--text-secondary, #6b7280);
    }
    .movimiento-table tbody tr:hover {
        background: var(--bg-secondary, #f9fafb);
    }
    .monto-cell {
        font-weight: 500;
        color: #059669;
    }
    .btn-details {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background: #dbeafe;
        color: #2563eb;
        border: none;
        border-radius: 0.375rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .btn-details:hover {
        background: #2563eb;
        color: white;
    }
    .movimiento-table tfoot th {
        background: var(--bg-secondary, #f9fafb);
        padding: 0.875rem 1rem;
        font-size: 0.875rem;
        color: var(--text-primary, #1f2937);
        border-top: 2px solid var(--border-color, #e5e7eb);
    }
    .total-value {
        font-size: 1rem;
        font-weight: 600;
        color: var(--primary-color, #e91e63);
    }
    .movimiento-actions {
        margin-top: 1rem;
        padding-top: 0.75rem;
        border-top: 1px solid var(--border-color, #e5e7eb);
        display: flex;
        justify-content: flex-end;
    }
    .btn-cerrar-movimientos {
        display: inline-flex;
        align-items: center;
        gap: 0.35rem;
        padding: 0.5rem 1rem;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        background: #f3f4f6;
        border: 1px solid #e5e7eb;
        border-radius: 0.375rem;
        cursor: pointer;
    }
    .btn-cerrar-movimientos:hover {
        background: #e5e7eb;
        color: #1f2937;
    }
</style>

<div class="movimiento-nota-container">
    @if (ViewBag.Error != null)
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@ViewBag.Error</span>
        </div>
        return;
    }

    @{int i = 0;
      double dTotal = 0;}

    <div class="movimiento-table-container">
        <table class="movimiento-table">
            <thead>
                <tr>
                    <th colspan="6" class="title-header">
                        <i class="bi bi-credit-card-2-front"></i>
                        Movimientos Nota de Crédito
                    </th>
                </tr>
                <tr>
                    <th>#</th>
                    <th>Descripción</th>
                    <th>Fecha</th>
                    <th>Vendedor</th>
                    <th>Monto</th>
                    <th style="width: 50px;" title="Ver nota de crédito emitida">Ver nota</th>
                </tr>
            </thead>
            <tbody>
                @foreach (MAT.MVC.Models.MovimientoNotaCredito item in Model.ToList().OrderByDescending(l => l.Fecha))
                {
                    i += 1;
                    dTotal += item.Monto;
                    <tr>
                        <td>@i</td>
                        <td>@item.Descripcion</td>
                        <td>@item.Fecha</td>
                        <td>@item.Vendedor</td>
                        <td class="monto-cell">@string.Format("{0:C}", item.Monto)</td>
                        <td>
                            @if (item.NotaCreditoID != null && item.NotaCreditoID != "")
                            {
                                <button type="button" class="btn-details" onclick="showNota('@item.NotaCreditoID');" title="Ver nota de crédito emitida">
                                    <i class="bi bi-file-text"></i>
                                </button>
                            }
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr>
                    <th colspan="4">Crédito Disponible</th>
                    <th colspan="2" class="total-value">@string.Format("{0:C}", dTotal)</th>
                </tr>
            </tfoot>
        </table>
    </div>
    <div class="movimiento-actions">
        <button type="button" class="btn-cerrar-movimientos" id="btn-cerrar-movimientos-nota" title="Cerrar">
            <i class="bi bi-x-lg"></i> Cerrar
        </button>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var $title = $("#modalMovimientosNotaCreditoTitle");
        if ($title.length) $title.text("@(ViewBag.Cliente ?? "")");
    });
    function showNota(NotaID) {
        var url = "/NotaCredito/partialNotaCredito?NotaID=" + NotaID;
        ShowFormDialog(url, "popinNota", "Nota de Crédito", "min");
    }
</script>
