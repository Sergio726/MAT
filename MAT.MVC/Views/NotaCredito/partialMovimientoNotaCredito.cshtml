@model List<MAT.MVC.Models.MovimientoNotaCredito>

<div class="movimiento-nota-container">
    @if (ViewBag.Error != null)
    {
        <div class="error-message">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <span>@ViewBag.Error</span>
        </div>
        return;
    }

    <div class="movimiento-nota-header">
        <span class="badge-cliente" aria-label="Cliente">
            <i class="bi bi-person-fill"></i>
            @(ViewBag.Cliente ?? "—")
        </span>
    </div>

    @{ int i = 0; double dTotal = 0; }

    <div class="movimiento-list">
        @foreach (MAT.MVC.Models.MovimientoNotaCredito item in Model.ToList().OrderByDescending(l => l.Fecha))
        {
            i += 1;
            dTotal += item.Monto;
            <div class="movimiento-card">
                <div class="movimiento-card-desc">
                    @item.Descripcion
                    @if (item.Monto < 0 && (item.NroRecibo != null || item.NroFactura != null))
                    {
                        <div class="movimiento-card-ref">Recibo @(item.NroRecibo ?? "-") · Factura @(item.NroFactura ?? "-")</div>
                    }
                </div>
                <div class="movimiento-card-meta movimiento-card-fecha">@item.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="movimiento-card-meta">@item.Vendedor</div>
                <div class="movimiento-card-monto">@string.Format("{0:C}", item.Monto)</div>
                <div>
                    @if (item.NotaCreditoID != null && item.NotaCreditoID != "")
                    {
                        <button type="button" class="btn-ver-nota" onclick="showNota('@item.NotaCreditoID');" title="Ver nota de crédito">
                            <i class="bi bi-file-earmark-text"></i> Ver nota
                        </button>
                    }
                </div>
            </div>
        }
    </div>

    <div class="movimiento-total @(dTotal > 0 ? "movimiento-total--con-credito" : "")">
        <span class="movimiento-total-label">Crédito disponible</span>
        <span class="movimiento-total-value">@string.Format("{0:C}", dTotal)</span>
    </div>

    <div class="movimiento-actions">
        <button type="button" class="btn-cerrar-movimientos" id="btn-cerrar-movimientos-nota" title="Cerrar">
            <i class="bi bi-x-lg"></i> Cerrar
        </button>
    </div>
</div>

<script type="text/javascript">
    function showNota(NotaID) {
        var url = "/NotaCredito/partialNotaCredito?NotaID=" + NotaID;
        ShowFormDialog(url, "popinNota", "Nota de Crédito", "medium");
    }
</script>
