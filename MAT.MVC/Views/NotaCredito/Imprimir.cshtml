@model MAT.MVC.Models.NotaCreditoModel
@{
    Layout = null;
    var titulo = "Nota de Crédito " + (Model != null ? (Model.NroNota ?? "") : "");
}
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@titulo</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; font-size: 14px; color: #1f2937; padding: 24px; max-width: 700px; margin: 0 auto; }
        .nc-header-wrap {
            background: linear-gradient(135deg, #2A307D 0%, #3d4494 100%);
            padding: 16px 20px;
            margin: -24px -24px 20px -24px;
            display: flex;
            align-items: center;
            gap: 20px;
        }
        .nc-logo { flex-shrink: 0; }
        .nc-logo img { max-height: 56px; width: auto; display: block; }
        .nc-header { border: none; padding: 0; margin: 0; flex: 1; }
        .nc-title { font-size: 1.5rem; font-weight: 700; color: white; margin: 0; }
        .nc-subtitle { font-size: 0.875rem; color: rgba(255,255,255,0.9); margin-top: 4px; }
        .nc-grid { display: table; width: 100%; }
        .nc-row { display: table-row; }
        .nc-label { display: table-cell; padding: 8px 12px 8px 0; font-weight: 600; color: #6b7280; width: 220px; }
        .nc-value { display: table-cell; padding: 8px 0; }
        .nc-value.monto { font-weight: 600; color: #059669; }
        .nc-value.retencion { color: #dc2626; }
        .nc-value.devolucion { color: #2563eb; }
        .nc-footer { margin-top: 28px; font-size: 0.8125rem; color: #6b7280; }
        @@media print {
            body { padding: 16px; }
            .nc-header-wrap { margin: -16px -16px 16px -16px; }
            .no-print { display: none !important; }
        }
    </style>
</head>
<body>
    @if (ViewBag.Error != null)
    {
        <p class="nc-value">@ViewBag.Error</p>
        return;
    }
    <div class="nc-header-wrap">
        <div class="nc-logo">
            <img src="@Url.Content("~/Images/marco_antonio_back3.png")" alt="Marco Antonio Tours" />
        </div>
        <div class="nc-header">
            <div class="nc-title">Nota de Crédito</div>
            <div class="nc-subtitle">@(Model != null ? (Model.NroNota ?? "-") : "-")</div>
        </div>
    </div>
    <div class="nc-grid">
        <div class="nc-row">
            <div class="nc-label">N° de nota</div>
            <div class="nc-value">@(Model != null ? (Model.NroNota ?? "-") : "-")</div>
        </div>
        <div class="nc-row">
            <div class="nc-label">Fecha</div>
            <div class="nc-value">@(Model != null && Model.Fecha != default(DateTime) ? Model.Fecha.ToString("dd/MM/yyyy") : "-")</div>
        </div>
        <div class="nc-row">
            <div class="nc-label">Cliente</div>
            <div class="nc-value">@(Model != null ? (Model.Cliente ?? "-") : "-")</div>
        </div>
        @if (Model != null && (Model.ViajeFecha.HasValue || !string.IsNullOrEmpty(Model.ViajeNombre)))
        {
        <div class="nc-row">
            <div class="nc-label">Viaje</div>
            <div class="nc-value">@(Model.ViajeNombre ?? "-")@(Model.ViajeFecha.HasValue ? " · Salida: " + Model.ViajeFecha.Value.ToString("dd/MM/yyyy") : "")</div>
        </div>
        }
        <div class="nc-row">
            <div class="nc-label">Crédito para próximas compras</div>
            <div class="nc-value monto">@string.Format("{0:C}", Model != null ? Model.MontoNota : 0)</div>
        </div>
        <div class="nc-row">
            <div class="nc-label">Monto retenido</div>
            <div class="nc-value retencion">@string.Format("{0:C}", Model != null ? Model.MontoRetencion : 0)</div>
        </div>
        @if (Model != null && Model.MontoDevolucion > 0)
        {
            <div class="nc-row">
                <div class="nc-label">Devolución al cliente</div>
                <div class="nc-value devolucion">@string.Format("{0:C}", Model.MontoDevolucion)</div>
            </div>
        }
        <div class="nc-row">
            <div class="nc-label">Vendedor</div>
            <div class="nc-value">@(Model != null ? (Model.Vendedor ?? "-") : "-")</div>
        </div>
        <div class="nc-row">
            <div class="nc-label">Detalle</div>
            <div class="nc-value">@(Model != null ? (Model.Detalle ?? "-") : "-")</div>
        </div>
    </div>
    <div class="nc-footer no-print">
        <p>Use la función imprimir del navegador (Ctrl+P) para imprimir o guardar como PDF.</p>
    </div>
    <script>
        (function () {
            if (window.opener) return;
            var q = window.location.search;
            if (q.indexOf('print=1') !== -1) window.print();
        })();
    </script>
</body>
</html>
