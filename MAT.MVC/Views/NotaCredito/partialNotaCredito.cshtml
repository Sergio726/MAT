@model MAT.MVC.Models.NotaCreditoModel
@{
    var notaIdStr = Model.NotaID != Guid.Empty ? Model.NotaID.ToString() : "";
    var fechaNotaStr = Model.Fecha != default(DateTime) ? Model.Fecha.ToString("dd/MM/yyyy HH:mm") : "—";
    var pctRetencion = Math.Round((Model.PorcentajeRetencion * 100), 2);
    var nroNotaDisplay = !string.IsNullOrEmpty(Model.NroNota) ? Model.NroNota : "—";
}

@if (ViewBag.Error != null)
{
    <script type="text/javascript">console.log("@ViewBag.Error");</script>
    return;
}

<div class="mat-nc-detail" data-notaid="@notaIdStr" data-nronota="@nroNotaDisplay">
    <!-- Header con resumen -->
    <div class="mat-nc-header">
        <div class="mat-nc-header-item">
            <div class="mat-nc-header-icon">
                <i class="bi bi-person"></i>
            </div>
            <div class="mat-nc-header-data">
                <div class="mat-nc-header-label">Cliente</div>
                <div class="mat-nc-header-value">@(Model.Cliente ?? "—")</div>
            </div>
        </div>
        <div class="mat-nc-header-item">
            <div class="mat-nc-header-icon">
                <i class="bi bi-calendar3"></i>
            </div>
            <div class="mat-nc-header-data">
                <div class="mat-nc-header-label">Fecha</div>
                <div class="mat-nc-header-value">@fechaNotaStr</div>
            </div>
        </div>
        <div class="mat-nc-header-item">
            <div class="mat-nc-header-icon">
                <i class="bi bi-clock-history"></i>
            </div>
            <div class="mat-nc-header-data">
                <div class="mat-nc-header-label">Días a la salida</div>
                <div class="mat-nc-header-value">@Model.Dias días</div>
            </div>
        </div>
    </div>

    @if (Model.ViajeFecha.HasValue || !string.IsNullOrEmpty(Model.ViajeNombre))
    {
    <div class="mat-nc-info-section">
        <div class="mat-nc-info-row">
            <div class="mat-nc-info-item full">
                <span class="mat-nc-info-label"><i class="bi bi-geo-alt"></i> Viaje</span>
                <span class="mat-nc-info-value">@(Model.ViajeNombre ?? "—")@(Model.ViajeFecha.HasValue ? " · Salida: " + Model.ViajeFecha.Value.ToString("dd/MM/yyyy") : "")</span>
            </div>
        </div>
    </div>
    }

    <!-- Montos -->
    <div class="mat-nc-montos">
        <div class="mat-nc-monto credito">
            <div class="mat-nc-monto-header">
                <div class="mat-nc-monto-icon"><i class="bi bi-piggy-bank"></i></div>
                <span class="mat-nc-monto-label">Crédito a favor</span>
            </div>
            <div class="mat-nc-monto-value">@string.Format("{0:C}", Model.MontoNota)</div>
            <div class="mat-nc-monto-hint">Para futuras compras</div>
        </div>

        <div class="mat-nc-monto retencion">
            <div class="mat-nc-monto-header">
                <div class="mat-nc-monto-icon"><i class="bi bi-dash-circle"></i></div>
                <span class="mat-nc-monto-label">Retenido</span>
                <span class="mat-nc-monto-badge">@(pctRetencion.ToString("0.##"))%</span>
            </div>
            <div class="mat-nc-monto-value">@string.Format("{0:C}", Model.MontoRetencion)</div>
            <div class="mat-nc-monto-hint">Gastos operativos</div>
        </div>

        <div class="mat-nc-monto devolucion">
            <div class="mat-nc-monto-header">
                <div class="mat-nc-monto-icon"><i class="bi bi-cash"></i></div>
                <span class="mat-nc-monto-label">Devolución</span>
            </div>
            <div class="mat-nc-monto-value">@string.Format("{0:C}", Model.MontoDevolucion)</div>
            <div class="mat-nc-monto-hint">Dinero al cliente</div>
        </div>
    </div>

    <!-- Información adicional -->
    <div class="mat-nc-info-section">
        <div class="mat-nc-info-row">
            <div class="mat-nc-info-item">
                <span class="mat-nc-info-label">Vendedor</span>
                <span class="mat-nc-info-value">@(Model.Vendedor ?? "—")</span>
            </div>
        </div>
        <div class="mat-nc-info-row">
            <div class="mat-nc-info-item full">
                <span class="mat-nc-info-label">Detalle</span>
                <span class="mat-nc-info-value">@(Model.Detalle ?? "—")</span>
            </div>
        </div>
    </div>

    <!-- Footer con acciones -->
    <div class="mat-nc-actions">
        @if (Model.NotaID != Guid.Empty)
        {
            <a href="/NotaCredito/Imprimir?NotaID=@Model.NotaID" target="_blank" class="mat-nc-btn mat-nc-btn-primary" title="Abrir para imprimir o guardar como PDF">
                <i class="bi bi-file-earmark-pdf"></i>
                Imprimir PDF
            </a>
        }
    </div>
</div>

<script type="text/javascript">
    (function() {
        var nroNota = "@Html.Raw(nroNotaDisplay)";
        var $dialog = $("#popinNota").closest(".ui-dialog");
        if ($dialog.length && nroNota && nroNota !== "—") {
            var $title = $dialog.find(".ui-dialog-title");
            if ($title.length) {
                $title.html('Nota de Crédito <span class="mat-nc-title-badge">#' + nroNota + '</span>');
            }
        }
    })();
</script>
