@model MAT.MVC.Models.LoginModel

@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" class="account-page-body">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Marco Antonio Tours</title>
    <link href="~/Content/modern-account.css" rel="stylesheet" />
    <link href="~/Content/saas-variables.css" rel="stylesheet" />
    <style>
        html.account-page-body,
        body.account-page-body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow-x: hidden;
        }
    </style>
</head>
<body class="account-page-body">
    <div class="account-page">
        <div class="account-card">
            @if (ViewBag.IsDev == "true")
            {
                <div class="dev-banner">
                    Entorno de Prueba
                </div>
            }

            <div class="account-card-header">
                <div class="logo">
                    <img src="~/Images/mat header.png" alt="Marco Antonio Tours" />
                </div>
                <h1>Iniciar Sesión</h1>
                <h2>Ingresa tus credenciales para continuar</h2>
            </div>

            @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "account-form" }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                <div class="account-form-group">
                    @Html.LabelFor(m => m.UserName, new { @class = "account-form-label" })
                    @Html.TextBoxFor(m => m.UserName, new { @class = "account-form-input", placeholder = "Usuario", autocomplete = "username" })
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-validation-error" })
                </div>

                <div class="account-form-group">
                    @Html.LabelFor(m => m.Password, new { @class = "account-form-label" })
                    @Html.PasswordFor(m => m.Password, new { @class = "account-form-input", placeholder = "Contraseña", autocomplete = "current-password" })
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                <button type="submit" class="account-btn">Iniciar Sesión</button>

                <p class="account-message">
                    ¿Aún no estás registrado? <a href="@Url.Action("RegistrarVendedor", "Account")">Regístrate ahora</a>
                </p>
            }
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
</body>
</html>
