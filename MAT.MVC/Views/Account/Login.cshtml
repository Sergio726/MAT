@model MAT.MVC.Models.LoginModel
@using System.Collections.Generic

@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es" class="account-page-body">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - Marco Antonio Tours</title>
    <link href="~/Content/saas-variables.css" rel="stylesheet" />
    <link href="~/Content/modern-account.css?v=20260330" rel="stylesheet" />
    <style>
        html.account-page-body,
        body.account-page-body {
            margin: 0;
            padding: 0;
            height: 100%;
            overflow-x: hidden;
        }
        /* Aislamiento: vence estilos globales (p. ej. .form-group + label en fila) */
        body.account-page-body .account-card--compact-login .account-float-group {
            display: block !important;
            width: 100% !important;
        }
        body.account-page-body .account-card--compact-login .account-float-label {
            position: absolute !important;
            float: none !important;
            left: 1rem !important;
            right: auto !important;
            width: auto !important;
            max-width: calc(100% - 3.5rem) !important;
            margin: 0 !important;
            padding: 0 !important;
            text-align: left !important;
            pointer-events: none;
        }
        body.account-page-body .account-card--compact-login .account-float-input--shell {
            width: 100% !important;
            max-width: none !important;
            box-sizing: border-box !important;
        }
        body.account-page-body .account-card--compact-login .account-password-toggle-icon--hide {
            display: none !important;
        }
        body.account-page-body .account-card--compact-login .account-password-toggle[aria-pressed="true"] .account-password-toggle-icon--show {
            display: none !important;
        }
        body.account-page-body .account-card--compact-login .account-password-toggle[aria-pressed="true"] .account-password-toggle-icon--hide {
            display: inline-flex !important;
        }
    </style>
</head>
<body class="account-page-body">
    <div class="account-page">
        <div class="account-card account-card--compact-login">
            @if (ViewBag.IsDev == "true")
            {
                <div class="dev-banner">
                    Entorno de Prueba
                </div>
            }

            <div class="account-card-header">
                <div class="logo">
                    <img src="~/Images/mat header.png" alt="Marco Antonio Tours" />
                </div>
            </div>

            @using (Html.BeginForm(null, null, FormMethod.Post, new Dictionary<string, object> {
                { "class", "account-form account-form--float-labels" },
                { "aria-label", "Formulario de acceso" }
            }))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                <div class="account-float-group">
                    <div class="account-field-shell">
                        @Html.TextBoxFor(m => m.UserName, new { @class = "account-float-input account-float-input--shell", placeholder = " ", autocomplete = "username", autofocus = "autofocus" })
                        <label class="account-float-label" for="UserName">Nombre de usuario</label>
                    </div>
                    @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-validation-error" })
                </div>

                <div class="account-float-group account-float-group--password">
                    <div class="account-password-shell">
                        @Html.PasswordFor(m => m.Password, new { @class = "account-float-input account-float-input--shell", placeholder = " ", autocomplete = "current-password" })
                        <label class="account-float-label" for="Password">Contraseña</label>
                        <button type="button" class="account-password-toggle" aria-label="Mostrar contraseña" aria-pressed="false">
                            <span class="account-password-toggle-icon account-password-toggle-icon--show" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
                            </span>
                            <span class="account-password-toggle-icon account-password-toggle-icon--hide" aria-hidden="true">
                                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><path d="M17.94 17.94A10.07 10.07 0 0112 20c-7 0-11-8-11-8a18.45 18.45 0 015.06-5.94M9.9 4.24A9.12 9.12 0 0112 4c7 0 7 0 11 8a18.5 18.5 0 01-2.16 3.19m-6.72-1.07a3 3 0 10-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
                            </span>
                        </button>
                    </div>
                    @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
                </div>

                <button type="submit" class="account-btn">Iniciar Sesión</button>

                <p class="account-message">
                    ¿Aún no estás registrado? <a href="@Url.Action("RegistrarVendedor", "Account")">Regístrate ahora</a>
                </p>
            }
        </div>
    </div>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        (function () {
            var form = document.querySelector('.account-form--float-labels');
            if (!form) return;
            var pwd = form.querySelector('#Password');
            var btn = form.querySelector('.account-password-toggle');
            if (!pwd || !btn) return;
            btn.addEventListener('click', function () {
                var reveal = pwd.type === 'password';
                pwd.type = reveal ? 'text' : 'password';
                btn.setAttribute('aria-pressed', reveal ? 'true' : 'false');
                btn.setAttribute('aria-label', reveal ? 'Ocultar contraseña' : 'Mostrar contraseña');
            });
        })();
    </script>
</body>
</html>
