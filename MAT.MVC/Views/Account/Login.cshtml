@model MAT.MVC.Models.LoginModel
@using System.Collections.Generic

@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<div class="login-split__header">
    <img src="~/Images/mat header.png" alt="Marco Antonio Tours" class="login-split__logo" />
    <h1 class="login-split__title">Iniciar sesión</h1>
    <p class="login-split__subtitle">Ingresá con tu cuenta de vendedor</p>
</div>

@using (Html.BeginForm(null, null, FormMethod.Post, new Dictionary<string, object> {
    { "class", "login-split-form login-split-form--float-labels" },
    { "id", "loginForm" },
    { "aria-label", "Formulario de acceso" }
}))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    <div class="login-split-float-group">
        <div class="login-split-field-shell">
            @Html.TextBoxFor(m => m.UserName, new { @class = "login-split-float-input", placeholder = " ", autocomplete = "username", autofocus = "autofocus" })
            <label class="login-split-float-label" for="UserName">Nombre de usuario</label>
        </div>
        @Html.ValidationMessageFor(m => m.UserName, "", new { @class = "field-validation-error" })
    </div>

    <div class="login-split-float-group">
        <div class="login-split-password-shell">
            @Html.PasswordFor(m => m.Password, new { @class = "login-split-float-input", placeholder = " ", autocomplete = "current-password" })
            <label class="login-split-float-label" for="Password">Contraseña</label>
            <button type="button" class="login-split-password-toggle" aria-label="Mostrar contraseña" aria-pressed="false">
                <span class="login-split-password-toggle-icon login-split-password-toggle-icon--show" aria-hidden="true">
                    <i class="bi bi-eye"></i>
                </span>
                <span class="login-split-password-toggle-icon login-split-password-toggle-icon--hide" aria-hidden="true">
                    <i class="bi bi-eye-slash"></i>
                </span>
            </button>
        </div>
        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="login-split-btn" id="loginSubmitBtn">
        <span class="login-split-btn__spinner" aria-hidden="true"></span>
        <span class="login-split-btn__text">Iniciar sesión</span>
    </button>

    <p class="login-split-message">
        ¿Aún no estás registrado? <a href="@Url.Action("RegistrarVendedor", "Account")">Regístrate ahora</a>
    </p>
}

@section scripts {
    <script>
        (function () {
            var form = document.getElementById('loginForm');
            if (!form) return;

            var pwd = form.querySelector('#Password');
            var toggle = form.querySelector('.login-split-password-toggle');
            if (pwd && toggle) {
                toggle.addEventListener('click', function () {
                    var reveal = pwd.type === 'password';
                    pwd.type = reveal ? 'text' : 'password';
                    toggle.setAttribute('aria-pressed', reveal ? 'true' : 'false');
                    toggle.setAttribute('aria-label', reveal ? 'Ocultar contraseña' : 'Mostrar contraseña');
                });
            }

            var submitBtn = document.getElementById('loginSubmitBtn');
            form.addEventListener('submit', function () {
                if (!submitBtn || submitBtn.disabled) return;
                submitBtn.disabled = true;
                submitBtn.classList.add('is-loading');
                var text = submitBtn.querySelector('.login-split-btn__text');
                if (text) text.textContent = 'Ingresando…';
            });
        })();
    </script>
}
