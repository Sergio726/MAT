@model MAT.MVC.Models.LocalPasswordModel
@{
    var passwordFormAction = ViewBag.PasswordFormAction as string ?? "Manage";
    var passwordFormController = ViewBag.PasswordFormController as string ?? "Account";
}
<h3 style="font-size: 1.5rem; font-weight: 600; color: var(--text-primary); margin-bottom: 1.5rem;">Cambiar contraseña</h3>

@using (Html.BeginForm(passwordFormAction, passwordFormController, FormMethod.Post, new { @class = "account-form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    <div class="account-form-group">
        @Html.LabelFor(m => m.OldPassword, new { @class = "account-form-label" })
        @Html.PasswordFor(m => m.OldPassword, new { @class = "account-form-input", placeholder = "Contraseña actual", autocomplete = "current-password" })
        @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "field-validation-error" })
    </div>

    <div class="account-form-group">
        @Html.LabelFor(m => m.NewPassword, new { @class = "account-form-label" })
        @Html.PasswordFor(m => m.NewPassword, new { @class = "account-form-input", placeholder = "Nueva contraseña (mínimo 6 caracteres)", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-validation-error" })
    </div>

    <div class="account-form-group">
        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "account-form-label" })
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "account-form-input", placeholder = "Confirma la nueva contraseña", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="account-btn">Cambiar contraseña</button>
}
