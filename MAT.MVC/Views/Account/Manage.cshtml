@model MAT.MVC.Models.LocalPasswordModel

@{
    ViewBag.Title = "Administrar Cuenta";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/modern-account.css" rel="stylesheet" />
<link href="~/Content/saas-variables.css" rel="stylesheet" />

<div class="modern-dashboard">
    <div class="modern-dashboard-header">
        <h2>Administrar Cuenta <span>Gestiona tu cuenta y contraseña</span></h2>
    </div>

    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-6 col-md-8 col-sm-12">
                <div class="account-card">
                    <div class="account-card-content" style="padding: 2rem;">
                        @if (!string.IsNullOrEmpty(ViewBag.StatusMessage as string))
                        {
                            <div class="message-success">@ViewBag.StatusMessage</div>
                        }

                        <p style="color: var(--text-secondary); margin-bottom: 2rem;">
                            Ha iniciado sesión como <strong style="color: var(--text-primary);">@User.Identity.Name</strong>.
                        </p>

                        @if (ViewBag.HasLocalPassword)
                        {
                            @Html.Partial("_ChangePasswordPartial")
                        }
                        else
                        {
                            @Html.Partial("_SetPasswordPartial")
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
