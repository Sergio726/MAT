@model MAT.MVC.Models.LocalPasswordModel

<p style="color: var(--text-secondary); margin-bottom: 1.5rem; line-height: 1.6;">
    No dispone de contraseña local para este sitio. Agregue una contraseña local para iniciar sesión sin que sea necesario ningún inicio de sesión externo.
</p>

@using (Html.BeginForm("Manage", "Account", FormMethod.Post, new { @class = "account-form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

    <div class="account-form-group">
        @Html.LabelFor(m => m.NewPassword, new { @class = "account-form-label" })
        @Html.PasswordFor(m => m.NewPassword, new { @class = "account-form-input", placeholder = "Nueva contraseña (mínimo 6 caracteres)", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-validation-error" })
    </div>

    <div class="account-form-group">
        @Html.LabelFor(m => m.ConfirmPassword, new { @class = "account-form-label" })
        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "account-form-input", placeholder = "Confirma la nueva contraseña", autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-validation-error" })
    </div>

    <button type="submit" class="account-btn">Establecer contraseña</button>
}
