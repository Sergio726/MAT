@model MAT.MVC.Models.RegisterModel

@{
    ViewBag.Title = "Regístrese";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/modern-account.css" rel="stylesheet" />
<link href="~/Content/saas-variables.css" rel="stylesheet" />

<div style="padding: 3rem 1rem;">
    <div class="account-card" style="max-width: 440px;">
        <div class="account-card-header">
            <h1>Crear Cuenta</h1>
            <h2>Cree una cuenta nueva</h2>
        </div>

        @using (Html.BeginForm(null, null, FormMethod.Post, new { @class = "account-form" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

            <div class="account-form-group">
                @Html.LabelFor(model => model.UserName, new { @class = "account-form-label" })
                @Html.TextBoxFor(model => model.UserName, new { @class = "account-form-input", placeholder = "Usuario", autocomplete = "username" })
                @Html.ValidationMessageFor(model => model.UserName, "", new { @class = "field-validation-error" })
            </div>

            <div class="account-form-group">
                @Html.LabelFor(model => model.Password, new { @class = "account-form-label" })
                @Html.PasswordFor(model => model.Password, new { @class = "account-form-input", placeholder = "Mínimo 6 caracteres", autocomplete = "new-password" })
                @Html.ValidationMessageFor(model => model.Password, "", new { @class = "field-validation-error" })
            </div>

            <div class="account-form-group">
                @Html.LabelFor(model => model.ConfirmPassword, new { @class = "account-form-label" })
                @Html.PasswordFor(model => model.ConfirmPassword, new { @class = "account-form-input", placeholder = "Repite la contraseña", autocomplete = "new-password" })
                @Html.ValidationMessageFor(model => model.ConfirmPassword, "", new { @class = "field-validation-error" })
            </div>

            <button type="submit" class="account-btn">Registrarse</button>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
