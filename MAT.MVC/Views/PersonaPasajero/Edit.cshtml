@model MAT.Entities.PersonaPasajero
@using MAT.Utilities
@using MAT.Enums

@{
    ViewBag.Title = "Editar Pasajero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-person-gear"></i>
            <span>Editar Pasajero</span>
        </h2>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="modern-alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>@ViewBag.Error</span>
        </div>
    }

    <div class="modern-form-container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-person"></i>
                        @Html.LabelFor(model => model.Apellido)
                    </label>
                    @Html.TextBoxFor(model => model.Apellido, new { @class = "modern-form-input", placeholder = "Apellido" })
                    @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-person"></i>
                        @Html.LabelFor(model => model.Nombre)
                    </label>
                    @Html.TextBoxFor(model => model.Nombre, new { @class = "modern-form-input", placeholder = "Nombre" })
                    @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-card-text"></i>
                        @Html.LabelFor(model => model.TipoDocumento)
                    </label>
                    @if (Model.TipoDocumento.HasValue)
                    {
                        @Html.DropDownListFor(model => model.TipoDocumento, eTipoDocumento.DNI.ToSelectList(Model.TipoDocumento.ToString()), new { @class = "modern-form-select" })
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.TipoDocumento, eTipoDocumento.DNI.ToSelectList(), new { @class = "modern-form-select" })
                    }
                    @Html.ValidationMessageFor(model => model.TipoDocumento, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-123"></i>
                        @Html.LabelFor(model => model.NroDocumento)
                    </label>
                    @Html.TextBoxFor(model => model.NroDocumento, new { @class = "modern-form-input", placeholder = "Número de documento" })
                    @Html.ValidationMessageFor(model => model.NroDocumento, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-geo-alt"></i>
                        @Html.LabelFor(model => model.LocalidadId, "Localidad")
                    </label>
                    @if (Model.LocalidadId.HasValue)
                    {
                        <input type="text" id="txt-busqueda-localidad" class="modern-form-input" value="@Helper.GetLocalidadName(Model.LocalidadId.Value)" placeholder="Buscar localidad..." />
                        <input type="hidden" id="Localidad" name="LocalidadId" value="@Model.LocalidadId" />
                    }
                    else
                    {
                        <input type="text" id="txt-busqueda-localidad" class="modern-form-input" placeholder="Buscar localidad..." />
                        <input type="hidden" id="Localidad" name="LocalidadId" />
                    }
                    @Html.ValidationMessageFor(model => model.LocalidadId, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-telephone"></i>
                        @Html.LabelFor(model => model.Telefono)
                    </label>
                    @Html.TextBoxFor(model => model.Telefono, new { @class = "modern-form-input", placeholder = "Teléfono" })
                    @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-envelope"></i>
                        @Html.LabelFor(model => model.Email)
                    </label>
                    @Html.TextBoxFor(model => model.Email, new { @class = "modern-form-input", type = "email", placeholder = "email@ejemplo.com" })
                    @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-calendar3"></i>
                        @Html.LabelFor(model => model.FechaNacimiento)
                    </label>
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        @Html.TextBoxFor(model => model.FechaNacimiento, "{0:yyyy-MM-dd}", new { @class = "modern-form-input", type = "date" })
                    }
                    else
                    {
                        @Html.TextBoxFor(model => model.FechaNacimiento, "", new { @class = "modern-form-input", type = "date" })
                    }
                    @Html.ValidationMessageFor(model => model.FechaNacimiento, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-gender-ambiguous"></i>
                        @Html.LabelFor(model => model.Sexo)
                    </label>
                    @if (Model.Sexo.HasValue)
                    {
                        @Html.DropDownListFor(model => model.Sexo, eSexo.Femenino.ToSelectList(Model.Sexo.ToString()), new { @class = "modern-form-select" })
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.Sexo, eSexo.Femenino.ToSelectList(), new { @class = "modern-form-select" })
                    }
                    @Html.ValidationMessageFor(model => model.Sexo, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-passport"></i>
                        @Html.LabelFor(model => model.Pasaporte)
                    </label>
                    @Html.TextBoxFor(model => model.Pasaporte, new { @class = "modern-form-input", placeholder = "Número de pasaporte" })
                    @Html.ValidationMessageFor(model => model.Pasaporte, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-calendar-event"></i>
                        @Html.LabelFor(model => model.VencimientoPasaporte)
                    </label>
                    @if (Model.VencimientoPasaporte.HasValue)
                    {
                        @Html.TextBoxFor(model => model.VencimientoPasaporte, "{0:yyyy-MM-dd}", new { @class = "modern-form-input", type = "date" })
                    }
                    else
                    {
                        @Html.TextBoxFor(model => model.VencimientoPasaporte, "", new { @class = "modern-form-input", type = "date" })
                    }
                    @Html.ValidationMessageFor(model => model.VencimientoPasaporte, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-calendar-check"></i>
                        @Html.LabelFor(model => model.EmisionPasaporte)
                    </label>
                    @if (Model.EmisionPasaporte.HasValue)
                    {
                        @Html.TextBoxFor(model => model.EmisionPasaporte, "{0:yyyy-MM-dd}", new { @class = "modern-form-input", type = "date" })
                    }
                    else
                    {
                        @Html.TextBoxFor(model => model.EmisionPasaporte, "", new { @class = "modern-form-input", type = "date" })
                    }
                    @Html.ValidationMessageFor(model => model.EmisionPasaporte, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-globe"></i>
                        @Html.LabelFor(model => model.PaisOrigen)
                    </label>
                    @Html.TextBoxFor(model => model.PaisOrigen, new { @class = "modern-form-input", placeholder = "País de origen" })
                    @Html.ValidationMessageFor(model => model.PaisOrigen, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="modern-form-actions">
                <button type="button" class="btn-modern btn-modern-secondary" onclick="location.href='@Url.Action("Index", "PersonaPasajero")'">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a la Lista</span>
                </button>
                <button type="submit" class="btn-modern btn-modern-primary">
                    <i class="bi bi-check-circle"></i>
                    <span>Guardar Cambios</span>
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
