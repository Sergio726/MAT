@model MAT.Entities.PersonaPasajero
@using MAT.Utilities
@using MAT.Enums

@{
    ViewBag.Title = "Detalle del Pasajero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-person-badge"></i>
            <span>Detalle del Pasajero</span>
        </h2>
    </div>

    <div class="modern-form-container">
        <div class="modern-details-grid">
            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-hash"></i>
                    ID
                </label>
                <div class="modern-details-value">@Model.PersonaId</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-person"></i>
                    Apellido
                </label>
                <div class="modern-details-value"><strong>@Model.Apellido</strong></div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-person"></i>
                    Nombre
                </label>
                <div class="modern-details-value"><strong>@Model.Nombre</strong></div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-card-text"></i>
                    Tipo Documento
                </label>
                <div class="modern-details-value">@((eTipoDocumento)Model.TipoDocumento)</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-123"></i>
                    Nro. Documento
                </label>
                <div class="modern-details-value">@(Model.NroDocumento ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-geo-alt"></i>
                    Localidad
                </label>
                <div class="modern-details-value">
                    @if (Model.LocalidadId.HasValue)
                    {
                        @Helper.ToSelectItem("Localidad", Model.LocalidadId.ToString())
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-telephone"></i>
                    Telefono
                </label>
                <div class="modern-details-value">@(Model.Telefono ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-envelope"></i>
                    Email
                </label>
                <div class="modern-details-value">@(Model.Email ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-calendar3"></i>
                    Fecha Nacimiento
                </label>
                <div class="modern-details-value">
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        @Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-gender-ambiguous"></i>
                    Sexo
                </label>
                <div class="modern-details-value">@Model.Sexo</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-passport"></i>
                    Pasaporte
                </label>
                <div class="modern-details-value">@(Model.Pasaporte ?? "-")</div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-calendar-x"></i>
                    Vencimiento Pasaporte
                </label>
                <div class="modern-details-value">
                    @if (Model.VencimientoPasaporte.HasValue)
                    {
                        @Model.VencimientoPasaporte.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-calendar-check"></i>
                    Emision Pasaporte
                </label>
                <div class="modern-details-value">
                    @if (Model.EmisionPasaporte.HasValue)
                    {
                        @Model.EmisionPasaporte.Value.ToString("dd/MM/yyyy")
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-details-group">
                <label class="modern-details-label">
                    <i class="bi bi-globe"></i>
                    Pais de Origen
                </label>
                <div class="modern-details-value">@(Model.PaisOrigen ?? "-")</div>
            </div>
        </div>

        <div class="modern-form-actions">
            <a href="@Url.Action("Index", "PersonaPasajero")" class="btn-modern btn-modern-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Volver a la Lista</span>
            </a>
            <a href="@Url.Action("Edit", "PersonaPasajero", new { id = Model.PersonaId })" class="btn-modern btn-modern-primary">
                <i class="bi bi-pencil"></i>
                <span>Editar</span>
            </a>
        </div>
    </div>
</div>

<style>
    .modern-details-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 1.5rem;
        padding: 1rem 0;
    }

    .modern-details-group {
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }

    .modern-details-label {
        font-size: 0.85rem;
        color: var(--text-secondary, #64748b);
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .modern-details-label i {
        color: var(--primary-color, #e91e63);
    }

    .modern-details-value {
        font-size: 1rem;
        color: var(--text-primary, #1e293b);
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--border-color, #e2e8f0);
    }
</style>
