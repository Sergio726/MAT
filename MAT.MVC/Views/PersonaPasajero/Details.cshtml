@model MAT.Entities.PersonaPasajero
@using MAT.Utilities
@using MAT.Enums

@{
    ViewBag.Title = "Detalles del Pasajero";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-person-badge"></i>
            <span>Detalles del Pasajero</span>
        </h2>
        <div class="modern-page-actions">
            <a href="@Url.Action("Edit", "PersonaPasajero", new { id = Model.PersonaId })" class="btn-modern btn-modern-primary">
                <i class="bi bi-pencil"></i>
                <span>Editar</span>
            </a>
        </div>
    </div>

    <div class="modern-form-container">
        <div class="modern-form-grid">
            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-hash"></i>
                    ID
                </label>
                <div class="modern-detail-value">
                    <span class="badge-categoria">@Model.PersonaId</span>
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-person"></i>
                    @Html.DisplayNameFor(model => model.Apellido)
                </label>
                <div class="modern-detail-value">
                    <strong>@Html.DisplayFor(model => model.Apellido)</strong>
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-person"></i>
                    @Html.DisplayNameFor(model => model.Nombre)
                </label>
                <div class="modern-detail-value">
                    <strong>@Html.DisplayFor(model => model.Nombre)</strong>
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-card-text"></i>
                    @Html.DisplayNameFor(model => model.TipoDocumento)
                </label>
                <div class="modern-detail-value">
                    @if (Model.TipoDocumento.HasValue)
                    {
                        <span class="badge-categoria">@((eTipoDocumento)Model.TipoDocumento.Value)</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-123"></i>
                    @Html.DisplayNameFor(model => model.NroDocumento)
                </label>
                <div class="modern-detail-value">
                    @Html.DisplayFor(model => model.NroDocumento)
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-geo-alt"></i>
                    Localidad
                </label>
                <div class="modern-detail-value">
                    @if (Model.LocalidadId.HasValue)
                    {
                        <span>@Helper.GetLocalidadName(Model.LocalidadId.Value)</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-telephone"></i>
                    @Html.DisplayNameFor(model => model.Telefono)
                </label>
                <div class="modern-detail-value">
                    @if (!string.IsNullOrEmpty(Model.Telefono))
                    {
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-telephone"></i>
                            <span>@Model.Telefono</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-envelope"></i>
                    @Html.DisplayNameFor(model => model.Email)
                </label>
                <div class="modern-detail-value">
                    @if (!string.IsNullOrEmpty(Model.Email))
                    {
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-envelope"></i>
                            <span>@Model.Email</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-calendar3"></i>
                    @Html.DisplayNameFor(model => model.FechaNacimiento)
                </label>
                <div class="modern-detail-value">
                    @if (Model.FechaNacimiento.HasValue)
                    {
                        <div style="display: flex; align-items: center; gap: 0.5rem;">
                            <i class="bi bi-calendar3"></i>
                            <span>@Model.FechaNacimiento.Value.ToString("dd/MM/yyyy")</span>
                        </div>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-gender-ambiguous"></i>
                    @Html.DisplayNameFor(model => model.Sexo)
                </label>
                <div class="modern-detail-value">
                    @if (Model.Sexo.HasValue)
                    {
                        <span class="badge-categoria">@((eSexo)Model.Sexo.Value)</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-passport"></i>
                    @Html.DisplayNameFor(model => model.Pasaporte)
                </label>
                <div class="modern-detail-value">
                    @if (!string.IsNullOrEmpty(Model.Pasaporte))
                    {
                        <strong>@Model.Pasaporte</strong>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-calendar-event"></i>
                    @Html.DisplayNameFor(model => model.VencimientoPasaporte)
                </label>
                <div class="modern-detail-value">
                    @if (Model.VencimientoPasaporte.HasValue)
                    {
                        <span>@Model.VencimientoPasaporte.Value.ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-calendar-check"></i>
                    @Html.DisplayNameFor(model => model.EmisionPasaporte)
                </label>
                <div class="modern-detail-value">
                    @if (Model.EmisionPasaporte.HasValue)
                    {
                        <span>@Model.EmisionPasaporte.Value.ToString("dd/MM/yyyy")</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>

            <div class="modern-form-group">
                <label class="modern-form-label">
                    <i class="bi bi-globe"></i>
                    @Html.DisplayNameFor(model => model.PaisOrigen)
                </label>
                <div class="modern-detail-value">
                    @if (!string.IsNullOrEmpty(Model.PaisOrigen))
                    {
                        <span>@Model.PaisOrigen</span>
                    }
                    else
                    {
                        <span class="text-muted">-</span>
                    }
                </div>
            </div>
        </div>

        <div class="modern-form-actions">
            <a href="@Url.Action("Index", "PersonaPasajero")" class="btn-modern btn-modern-secondary">
                <i class="bi bi-arrow-left"></i>
                <span>Volver a la Lista</span>
            </a>
        </div>
    </div>
</div>
