@model IEnumerable<MAT.Entities.PersonaPasajero>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-people"></i>
            <span>Pasajeros</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/PersonaPasajero/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Pasajero</span>
            </a>
        </div>
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblPasajeros">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Tipo Documento</th>
                    <th>Nro. Documento</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Apellido</strong>
                        </td>
                        <td>@item.Nombre</td>
                        <td>@((eTipoDocumento)item.TipoDocumento)</td>
                        <td>@item.NroDocumento</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Telefono))
                            {
                                <i class="bi bi-telephone"></i> @item.Telefono
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.Email))
                            {
                                <i class="bi bi-envelope"></i> @item.Email
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            <div class="table-actions">
                                <a href="/PersonaPasajero/Edit/@item.PersonaId" class="btn-action btn-action-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/PersonaPasajero/Details/@item.PersonaId" class="btn-action btn-action-view" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblPasajeros").DataTable({
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ pasajeros",
                infoEmpty: "No hay pasajeros disponibles",
                infoFiltered: "(filtrado de _MAX_ pasajeros totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },
            columnDefs: [
                { orderable: false, targets: 6 }
            ]
        });
    });
</script>
