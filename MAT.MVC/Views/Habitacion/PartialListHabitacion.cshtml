@if (ViewBag.Error != null)
{
    <div class="error-message">
        <i class="bi bi-exclamation-triangle-fill"></i>
        <span>@ViewBag.Error</span>
    </div>
}

<div id="divTools" class="hide">
    <div class="action-buttons">
        <a href="/Habitacion/Edit/{{HabitacionID}}" class="btn-action-icon btn-edit" title="Editar">
            <i class="bi bi-pencil"></i>
        </a>
        <a href="/Habitacion/Details/{{HabitacionID}}" class="btn-action-icon btn-details" title="Detalles">
            <i class="bi bi-file-text"></i>
        </a>
        <a href="/Habitacion/Delete?HotelID={{HotelID}}&HabitacionID={{HabitacionID}}" class="btn-action-icon btn-delete" title="Eliminar">
            <i class="bi bi-trash"></i>
        </a>
    </div>
</div>

<div class="habitacion-list-container">
    <div class="table-container">
        <table id="tblHabitaciones" class="display">
            <thead>
                <tr>
                    <th>Nro Habitación</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Hotel</th>
                    <th>Estado</th>
                    <th>Capacidad</th>
                    <th>Ocupación</th>
                    <th style="width: 100px;"></th>
                </tr>
            </thead>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        var jResult = @Html.Raw(ViewBag.jResult);
        var jTables = eval(jResult);
        var jt = jTables["Table"];

        var table = $("#tblHabitaciones").DataTable({
            "aaData": jt,
            "columns": [
                { "data": "nrohabitacion" },
                { "data": "nombre" },
                { "data": "tipo" },
                { "data": "Hotel" },
                { "data": "estado" },
                { "data": "capacidad" },
                { "data": "ocupacion" },
                {
                    "data": "habitacionid",
                    "mRender": function (data, type, row) {
                        var _data = { "HabitacionID": row.habitacionid, "HotelID": row.hotelid };
                        var data = $("#divTools").html().trim().render(_data);
                        return data;
                    }
                },
            ],
            "bAutoWidth": false,
            "pageLength": 25,
            "language": {
                "url": "/Scripts/dataTable/i18n/Spanish.json"
            }
        });
    });
</script>
