</style>

<script type="text/javascript">
    // Variables globales para almacenar cotizaciones
    var cotizaciones = {
        oficial: null,
        blue: null
    };

    $(document).ready(function () {
        registerFormatNumber();
        $('.money').mask("#.##0,00", { reverse: true });
    });
    
    var mode = "@ViewBag.Mode";
    if (mode == "1") {
        $("#btnCargarMonto").show();
    }

    // Cargar cotizaciones al iniciar
    cargarCotizaciones();

    function cargarCotizaciones() {
        // Cargar dólar oficial
        $.ajax({
            url: 'https://dolarapi.com/v1/dolares/oficial',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                cotizaciones.oficial = data.venta;
                var formattedValue = formatearCotizacion(data.venta);
                $("#sCotizacionOficial").text("$" + formattedValue).removeClass("loading");
                actualizarHoraUpdate(data.fechaActualizacion);
            },
            error: function (e) {
                console.log("Error al cargar dólar oficial:", e);
                $("#sCotizacionOficial").text("Sin conexión").removeClass("loading").css("color", "#dc2626");
            }
        });

        // Cargar dólar blue
        $.ajax({
            url: 'https://dolarapi.com/v1/dolares/blue',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                cotizaciones.blue = data.venta;
                var formattedValue = formatearCotizacion(data.venta);
                $("#sCotizacionBlue").text("$" + formattedValue).removeClass("loading");
            },
            error: function (e) {
                console.log("Error al cargar dólar blue:", e);
                $("#sCotizacionBlue").text("Sin conexión").removeClass("loading").css("color", "#dc2626");
            }
        });
    }

    function formatearCotizacion(valor) {
        if (!valor) return "0,00";
        return valor.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function actualizarHoraUpdate(fechaISO) {
        if (!fechaISO) return;
        try {
            var fecha = new Date(fechaISO);
            var opciones = { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' };
            $("#lastUpdate").text("Actualizado: " + fecha.toLocaleString('es-AR', opciones));
        } catch (e) {
            console.log("Error al parsear fecha:", e);
        }
    }

    // Helper para parsear montos con formato ARS (ej: "1.234.567,89")
    function parseMonto(value) {
        if (!value) return 0;

        // Normalizar: quitar todos los separadores de miles y usar punto como separador decimal
        var normalized = value
            .toString()
            .trim()
            .replace(/\./g, '')   // quitar TODOS los puntos (miles)
            .replace(',', '.');   // cambiar coma decimal por punto

        var parsed = parseFloat(normalized);
        return isNaN(parsed) ? 0 : parsed;
    }

    function selectCotizacion(tipo) {
        // Actualizar visual de radio cards
        $(".cotizador-radio-card").removeClass("active");
        
        switch(tipo) {
            case 'oficial':
                $("#radioCardOficial").addClass("active");
                $("#txtCotizacion").attr("disabled", true);
                break;
            case 'blue':
                $("#radioCardBlue").addClass("active");
                $("#txtCotizacion").attr("disabled", true);
                break;
            case 'personalizado':
                $("#radioCardManual").addClass("active");
                $("#txtCotizacion").attr("disabled", false).focus();
                break;
        }
    }

    function calcularCotizacion() {
        var sourceCotizacion = $("input[name='rCotizacion']:checked").val();
        
        if ($("#txtCotizacion").val() == "" && sourceCotizacion == "personalizado") {
            $("#txtCotizacion").val(0);
            $("#MontoInt").val(0);
            $("#MontoOut").val(0);
            return;
        }
        if ($("#MontoInt").val() == "") {
            $("#MontoInt").val(0);
        }
        if ($("#MontoOut").val() == "") {
            $("#MontoOut").val(0);
        }

        var dCotizacion = 0;
        
        switch (sourceCotizacion) {
            case "oficial":
                if (!cotizaciones.oficial) {
                    mostrarError("No se pudo obtener la cotización del dólar oficial. Use cotización manual.");
                    return;
                }
                dCotizacion = cotizaciones.oficial;
                $("#hdnCotizacion").val(dCotizacion);
                break;
                
            case "blue":
                if (!cotizaciones.blue) {
                    mostrarError("No se pudo obtener la cotización del dólar blue. Use cotización manual.");
                    return;
                }
                dCotizacion = cotizaciones.blue;
                $("#hdnCotizacion").val(dCotizacion);
                break;

            case "personalizado":
                dCotizacion = parseMonto($("#txtCotizacion").val());
                if (isNaN(dCotizacion) || dCotizacion <= 0) {
                    mostrarError("Ingrese una cotización válida.");
                    return;
                }
                $("#hdnCotizacion").val($("#txtCotizacion").val());
                break;
        }

        // Realizar el cálculo
        var dARG = parseMonto($("#MontoInt").val());
        var dUSD = parseMonto($("#MontoOut").val());
        var dtotal = 0;

        if (dARG == 0 && dUSD > 0) {
            // Convertir USD a ARS
            dtotal = dUSD * dCotizacion;
            var rTotal = formatNumberMoney(dtotal).replace('$', '');
            $("#MontoInt").val(rTotal);
        } else if (dARG > 0) {
            // Convertir ARS a USD
            dtotal = dARG / dCotizacion;
            var rTotal = formatNumberMoney(dtotal).replace('$', '');
            $("#MontoOut").val(rTotal);
        }
    }

    function mostrarError(mensaje) {
        $("#divError").html('<i class="bi bi-exclamation-triangle"></i> ' + mensaje).show();
        setTimeout(function() { $("#divError").fadeOut(); }, 8000);
    }

    function cargarMonto() {
        calcularCotizacion();
        var tipoMoneda = $("#sMonedaTipo option:selected").text().trim();

        switch (tipoMoneda) {
            case "ARS":
                $("#txtPago").val($("#MontoInt").val());
                break;
            case "USD":
                $("#txtPago").val($("#MontoOut").val());
                break;
        }
    }
</script>
