<div class="cotizador-container">
    <div class="cotizador-header">
        <div class="cotizador-icon">
            <i class="bi bi-currency-exchange"></i>
        </div>
        <div class="cotizador-title">
            <h4>Cotización USD</h4>
            <span class="cotizador-source">dolarapi.com</span>
        </div>
    </div>

    <div class="cotizador-body">
        <!-- Opciones de cotización -->
        <div class="cotizador-options">
            <label class="cotizador-radio-card active" id="radioCardOficial">
                <input type="radio" name="rCotizacion" value="oficial" checked onclick="selectCotizacion('oficial');" />
                <div class="radio-card-content">
                    <div class="radio-card-header">
                        <i class="bi bi-bank"></i>
                        <span>Dólar Oficial</span>
                    </div>
                    <div class="radio-card-value">
                        <span class="currency-label">Venta:</span>
                        <span id="sCotizacionOficial" class="currency-value loading">Cargando...</span>
                    </div>
                </div>
            </label>

            <label class="cotizador-radio-card" id="radioCardBlue">
                <input type="radio" name="rCotizacion" value="blue" onclick="selectCotizacion('blue');" />
                <div class="radio-card-content">
                    <div class="radio-card-header">
                        <i class="bi bi-cash-stack"></i>
                        <span>Dólar Blue</span>
                    </div>
                    <div class="radio-card-value">
                        <span class="currency-label">Venta:</span>
                        <span id="sCotizacionBlue" class="currency-value loading">Cargando...</span>
                    </div>
                </div>
            </label>

            <label class="cotizador-radio-card" id="radioCardManual">
                <input type="radio" name="rCotizacion" value="personalizado" onclick="selectCotizacion('personalizado');" />
                <div class="radio-card-content">
                    <div class="radio-card-header">
                        <i class="bi bi-pencil-square"></i>
                        <span>Cotización Manual</span>
                    </div>
                    <div class="radio-card-value">
                        <span class="currency-label">1 USD =</span>
                        <input type="text" id="txtCotizacion" class="cotizador-input-inline money" disabled placeholder="0,00" />
                    </div>
                </div>
            </label>
        </div>
        
        <div class="cotizador-api-info">
            <a class="cotizador-link" href="https://dolarapi.com" target="_blank">
                <i class="bi bi-box-arrow-up-right"></i> dolarapi.com
            </a>
            <span class="cotizador-last-update" id="lastUpdate"></span>
        </div>

        <!-- Calculadora -->
        <div class="cotizador-calculator">
            <div class="cotizador-field">
                <label class="cotizador-label">
                    <span class="currency-badge ars">ARS</span>
                    Pesos Argentinos
                </label>
                <div class="cotizador-input-wrapper">
                    <span class="input-prefix">$</span>
                    <input type="text" id="MontoInt" class="cotizador-input money" placeholder="0,00" />
                </div>
            </div>

            <div class="cotizador-swap">
                <i class="bi bi-arrow-left-right"></i>
            </div>

            <div class="cotizador-field">
                <label class="cotizador-label">
                    <span class="currency-badge usd">USD</span>
                    Dólares
                </label>
                <div class="cotizador-input-wrapper">
                    <span class="input-prefix">$</span>
                    <input type="text" id="MontoOut" class="cotizador-input money" placeholder="0,00" />
                </div>
            </div>
        </div>

        <!-- Acciones -->
        <div class="cotizador-actions">
            <button type="button" onclick="calcularCotizacion();" class="btn-modern btn-modern-primary">
                <i class="bi bi-calculator"></i>
                Calcular
            </button>
            <button type="button" id="btnCargarMonto" onclick="cargarMonto();" class="btn-modern btn-modern-secondary" style="display:none;" title="Tomar el valor calculado como monto a abonar">
                <i class="bi bi-check-lg"></i>
                Cargar Monto
            </button>
        </div>

        <!-- Mensaje de error -->
        <div id="divError" class="cotizador-error" style="display:none;"></div>
    </div>

    <input type="hidden" id="hdnPersonID" name="PersonaID">
    <input type="hidden" id="hdnViajeID" name="ViajeID">
    <input type="hidden" id="hdnCotizacion" />
</div>

<script type="text/javascript">
    // Variables globales para almacenar cotizaciones
    var cotizaciones = {
        oficial: null,
        blue: null
    };

    $(document).ready(function () {
        registerFormatNumber();
        $('.money').mask("#.##0,00", { reverse: true });
    });
    
    var mode = "@ViewBag.Mode";
    if (mode == "1") {
        $("#btnCargarMonto").show();
    }

    // Cargar cotizaciones al iniciar
    cargarCotizaciones();

    function cargarCotizaciones() {
        // Cargar dólar oficial
        $.ajax({
            url: 'https://dolarapi.com/v1/dolares/oficial',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                cotizaciones.oficial = data.venta;
                var formattedValue = formatearCotizacion(data.venta);
                $("#sCotizacionOficial").text("$" + formattedValue).removeClass("loading");
                actualizarHoraUpdate(data.fechaActualizacion);
            },
            error: function (e) {
                console.log("Error al cargar dólar oficial:", e);
                $("#sCotizacionOficial").text("Sin conexión").removeClass("loading").css("color", "#dc2626");
            }
        });

        // Cargar dólar blue
        $.ajax({
            url: 'https://dolarapi.com/v1/dolares/blue',
            type: 'GET',
            dataType: 'json',
            success: function (data) {
                cotizaciones.blue = data.venta;
                var formattedValue = formatearCotizacion(data.venta);
                $("#sCotizacionBlue").text("$" + formattedValue).removeClass("loading");
            },
            error: function (e) {
                console.log("Error al cargar dólar blue:", e);
                $("#sCotizacionBlue").text("Sin conexión").removeClass("loading").css("color", "#dc2626");
            }
        });
    }

    function formatearCotizacion(valor) {
        if (!valor) return "0,00";
        return valor.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function actualizarHoraUpdate(fechaISO) {
        if (!fechaISO) return;
        try {
            var fecha = new Date(fechaISO);
            var opciones = { hour: '2-digit', minute: '2-digit', day: '2-digit', month: '2-digit' };
            $("#lastUpdate").text("Actualizado: " + fecha.toLocaleString('es-AR', opciones));
        } catch (e) {
            console.log("Error al parsear fecha:", e);
        }
    }

    // Helper para parsear montos con formato ARS (ej: "1.234.567,89")
    function parseMonto(value) {
        if (!value) return 0;

        // Normalizar: quitar todos los separadores de miles y usar punto como separador decimal
        var normalized = value
            .toString()
            .trim()
            .replace(/\./g, '')   // quitar TODOS los puntos (miles)
            .replace(',', '.');   // cambiar coma decimal por punto

        var parsed = parseFloat(normalized);
        return isNaN(parsed) ? 0 : parsed;
    }

    function selectCotizacion(tipo) {
        // Actualizar visual de radio cards
        $(".cotizador-radio-card").removeClass("active");
        
        switch(tipo) {
            case 'oficial':
                $("#radioCardOficial").addClass("active");
                $("#txtCotizacion").attr("disabled", true);
                break;
            case 'blue':
                $("#radioCardBlue").addClass("active");
                $("#txtCotizacion").attr("disabled", true);
                break;
            case 'personalizado':
                $("#radioCardManual").addClass("active");
                $("#txtCotizacion").attr("disabled", false).focus();
                break;
        }
    }

    function calcularCotizacion() {
        var sourceCotizacion = $("input[name='rCotizacion']:checked").val();
        
        if ($("#txtCotizacion").val() == "" && sourceCotizacion == "personalizado") {
            $("#txtCotizacion").val(0);
            $("#MontoInt").val(0);
            $("#MontoOut").val(0);
            return;
        }
        if ($("#MontoInt").val() == "") {
            $("#MontoInt").val(0);
        }
        if ($("#MontoOut").val() == "") {
            $("#MontoOut").val(0);
        }

        var dCotizacion = 0;
        
        switch (sourceCotizacion) {
            case "oficial":
                if (!cotizaciones.oficial) {
                    mostrarError("No se pudo obtener la cotización del dólar oficial. Use cotización manual.");
                    return;
                }
                dCotizacion = cotizaciones.oficial;
                $("#hdnCotizacion").val(dCotizacion);
                break;
                
            case "blue":
                if (!cotizaciones.blue) {
                    mostrarError("No se pudo obtener la cotización del dólar blue. Use cotización manual.");
                    return;
                }
                dCotizacion = cotizaciones.blue;
                $("#hdnCotizacion").val(dCotizacion);
                break;

            case "personalizado":
                dCotizacion = parseMonto($("#txtCotizacion").val());
                if (isNaN(dCotizacion) || dCotizacion <= 0) {
                    mostrarError("Ingrese una cotización válida.");
                    return;
                }
                $("#hdnCotizacion").val($("#txtCotizacion").val());
                break;
        }

        // Realizar el cálculo
        var dARG = parseMonto($("#MontoInt").val());
        var dUSD = parseMonto($("#MontoOut").val());
        var dtotal = 0;

        if (dARG == 0 && dUSD > 0) {
            // Convertir USD a ARS
            dtotal = dUSD * dCotizacion;
            var rTotal = formatNumberMoney(dtotal).replace('$', '');
            $("#MontoInt").val(rTotal);
        } else if (dARG > 0) {
            // Convertir ARS a USD
            dtotal = dARG / dCotizacion;
            var rTotal = formatNumberMoney(dtotal).replace('$', '');
            $("#MontoOut").val(rTotal);
        }
    }

    function mostrarError(mensaje) {
        $("#divError").html('<i class="bi bi-exclamation-triangle"></i> ' + mensaje).show();
        setTimeout(function() { $("#divError").fadeOut(); }, 8000);
    }

    function cargarMonto() {
        calcularCotizacion();
        var tipoMoneda = $("#sMonedaTipo option:selected").text().trim();

        switch (tipoMoneda) {
            case "ARS":
                $("#txtPago").val($("#MontoInt").val());
                break;
            case "USD":
                $("#txtPago").val($("#MontoOut").val());
                break;
        }
    }
</script>
