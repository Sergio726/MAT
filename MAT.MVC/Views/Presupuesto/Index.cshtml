@{
    Response.ContentType = "text/html; charset=utf-8";
    Response.Charset = "utf-8";
    ViewBag.Title = "Módulo de Presupuestos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var estadisticas = ViewBag.Estadisticas as Dictionary<string, int> ?? new Dictionary<string, int>();
    int pendientes = estadisticas.ContainsKey("Pendientes") ? estadisticas["Pendientes"] : 0;
    int cerrados = estadisticas.ContainsKey("Cerrados") ? estadisticas["Cerrados"] : 0;
    int expirados = estadisticas.ContainsKey("Expirados") ? estadisticas["Expirados"] : 0;
    int total = estadisticas.ContainsKey("Total") ? estadisticas["Total"] : 0;
}

<div class="modern-dashboard">
    <div class="modern-dashboard-header">
        <h2>
            <i class="bi bi-file-earmark-text"></i>
            Módulo de Presupuestos
            <span>Gestión y seguimiento de presupuestos telefónicos</span>
        </h2>
    </div>

    <div class="container-fluid">
        <!-- Estadísticas -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-primary">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Pendientes</div>
                        <i class="bi bi-clock-history modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@pendientes</div>
                        <p class="modern-stat-label">Presupuestos en espera</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-success">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Cerrados</div>
                        <i class="bi bi-check-circle modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@cerrados</div>
                        <p class="modern-stat-label">Presupuestos convertidos</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-warning">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Expirados</div>
                        <i class="bi bi-exclamation-triangle modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@expirados</div>
                        <p class="modern-stat-label">Presupuestos vencidos</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-info">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Total</div>
                        <i class="bi bi-bar-chart modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@total</div>
                        <p class="modern-stat-label">Presupuestos registrados</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Acciones Principales -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6 col-md-6">
                <div class="modern-card modern-card-success" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Presupuesto/Create'">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-plus-circle me-2"></i>
                            Crear Nuevo Presupuesto
                        </div>
                        <i class="bi bi-telephone-forward modern-card-icon-large"></i>
                    </div>
                    <div class="modern-card-content">
                        <p style="color: var(--text-secondary); margin-bottom: 1rem;">
                            Genera un presupuesto rápido para clientes telefónicos. El sistema generará automáticamente un código único de seguimiento.
                        </p>
                        <a href="/Presupuesto/Create" class="modern-card-link">
                            Ir a crear presupuesto <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-6 col-md-6">
                <div class="modern-card modern-card-primary" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Presupuesto/Seguimiento'">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-search me-2"></i>
                            Panel de Seguimiento
                        </div>
                        <i class="bi bi-clipboard-data modern-card-icon-large"></i>
                    </div>
                    <div class="modern-card-content">
                        <p style="color: var(--text-secondary); margin-bottom: 1rem;">
                            Consulta, filtra y gestiona todos los presupuestos. Busca por código, DNI, vendedor o estado.
                        </p>
                        <a href="/Presupuesto/Seguimiento" class="modern-card-link">
                            Ver panel de seguimiento <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información Adicional -->
        <div class="row g-4">
            <div class="col-lg-12">
                <div class="modern-card modern-card-info">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Información del Módulo
                        </div>
                    </div>
                    <div class="modern-card-content">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div style="display: flex; align-items: start; gap: 0.75rem;">
                                    <i class="bi bi-shield-check" style="font-size: 1.5rem; color: var(--brand-primary); flex-shrink: 0;"></i>
                                    <div>
                                        <h5 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary);">Atribución de Comisiones</h5>
                                        <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
                                            Los presupuestos garantizan que tanto el vendedor telefónico como el de cierre reciban su comisión correspondiente.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div style="display: flex; align-items: start; gap: 0.75rem;">
                                    <i class="bi bi-clock" style="font-size: 1.5rem; color: var(--brand-primary); flex-shrink: 0;"></i>
                                    <div>
                                        <h5 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary);">Expiración Automática</h5>
                                        <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
                                            Los presupuestos expiran automáticamente después de 48 horas para incentivar el cierre rápido de ventas.
                                        </p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div style="display: flex; align-items: start; gap: 0.75rem;">
                                    <i class="bi bi-qr-code" style="font-size: 1.5rem; color: var(--brand-primary); flex-shrink: 0;"></i>
                                    <div>
                                        <h5 style="font-size: 1rem; font-weight: 600; margin-bottom: 0.5rem; color: var(--text-primary);">Código Único</h5>
                                        <p style="font-size: 0.875rem; color: var(--text-secondary); margin: 0;">
                                            Cada presupuesto genera un código único (MAT-YYYYMMDD-XXXX) que permite el seguimiento y la vinculación con la venta final.
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modern-stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--brand-primary);
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .modern-stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .modern-card-icon-large {
        font-size: 3rem;
        opacity: 0.1;
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
    }

    .modern-card[onclick]:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }
</style>

