@using MAT.MVC.Models
@{
    Response.ContentType = "text/html; charset=utf-8";
    Response.Charset = "utf-8";
    ViewBag.Title = "Módulo de Presupuestos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var estadisticas = ViewBag.Estadisticas as Dictionary<string, int> ?? new Dictionary<string, int>();
    int pendientes = estadisticas.ContainsKey("Pendientes") ? estadisticas["Pendientes"] : 0;
    int cerrados = estadisticas.ContainsKey("Cerrados") ? estadisticas["Cerrados"] : 0;
    int expirados = estadisticas.ContainsKey("Expirados") ? estadisticas["Expirados"] : 0;
    int total = estadisticas.ContainsKey("Total") ? estadisticas["Total"] : 0;
    var proximosVencer = ViewBag.ProximosVencer as List<PresupuestoProximoVencer> ?? new List<PresupuestoProximoVencer>();
}

<div class="modern-dashboard presupuesto-dashboard">
    <div class="modern-dashboard-header">
        <h2>
            <i class="bi bi-file-earmark-text"></i>
            Módulo de Presupuestos
            <span>Gestión y seguimiento de presupuestos telefónicos</span>
        </h2>
    </div>

    <div class="container-fluid">
        <!-- Estadísticas -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-primary">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Pendientes</div>
                        <i class="bi bi-clock-history modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="presupuesto-stat-number">@pendientes</div>
                        <p class="presupuesto-stat-label">Presupuestos en espera</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-success">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Cerrados</div>
                        <i class="bi bi-check-circle modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="presupuesto-stat-number">@cerrados</div>
                        <p class="presupuesto-stat-label">Presupuestos convertidos</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-warning">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Expirados</div>
                        <i class="bi bi-exclamation-triangle modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="presupuesto-stat-number">@expirados</div>
                        <p class="presupuesto-stat-label">Presupuestos vencidos</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-info">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Total</div>
                        <i class="bi bi-bar-chart modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="presupuesto-stat-number">@total</div>
                        <p class="presupuesto-stat-label">Presupuestos registrados</p>
                    </div>
                </div>
            </div>
        </div>

        @if (proximosVencer.Count > 0)
        {
        <div class="row g-4 mb-4">
            <div class="col-12">
                <div class="modern-card modern-card-warning">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            Presupuestos próximos a vencer (@proximosVencer.Count)
                        </div>
                        <a href="/Presupuesto/Seguimiento" class="btn-modern btn-modern-primary btn-sm">
                            <i class="bi bi-arrow-right"></i> Ir a Seguimiento
                        </a>
                    </div>
                    <div class="modern-card-content">
                        <div class="table-responsive">
                            <table class="modern-table" style="width:100%">
                                <thead>
                                    <tr>
                                        <th>Código</th>
                                        <th>Cliente</th>
                                        <th>Vendedor</th>
                                        <th>Monto</th>
                                        <th>Expira</th>
                                        <th></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var p in proximosVencer.Take(10))
                                    {
                                        var mins = p.MinutosRestantes;
                                        var horas = mins / 60;
                                        var minsRest = mins % 60;
                                        var tiempoStr = horas > 0 ? string.Format("{0}h {1}m", horas, minsRest) : string.Format("{0} min", mins);
                                        <tr>
                                            <td><strong>@p.CodigoSeguimiento</strong></td>
                                            <td>@(p.NombreCliente ?? p.DniCliente ?? "-")</td>
                                            <td>@(p.VendedorOrigenNombre ?? "-")</td>
                                            <td>@string.Format("{0:C}", p.MontoPactado)</td>
                                            <td><span class="badge bg-warning text-dark">@tiempoStr</span></td>
                                            <td>
                                                <a href="/Presupuesto/Seguimiento" class="btn-modern btn-modern-primary btn-sm">Ver</a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        @if (proximosVencer.Count > 10)
                        {
                            <p class="text-muted mb-0 mt-2"><small>Mostrando 10 de @proximosVencer.Count. <a href="/Presupuesto/Seguimiento">Ver todos</a></small></p>
                        }
                    </div>
                </div>
            </div>
        </div>
        }

        <!-- Acciones Principales -->
        <div class="row g-4 mb-4">
            <div class="col-lg-4 col-md-6">
                <div class="modern-card modern-card-success presupuesto-card-clickable" onclick="window.location.href='/Presupuesto/Create'">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-plus-circle me-2"></i>
                            Crear Nuevo Presupuesto
                        </div>
                        <i class="bi bi-telephone-forward presupuesto-card-icon-large"></i>
                    </div>
                    <div class="modern-card-content">
                        <p class="presupuesto-card-desc">
                            Genera un presupuesto rápido para clientes telefónicos. El sistema generará automáticamente un código único de seguimiento.
                        </p>
                        <a href="/Presupuesto/Create" class="modern-card-link">
                            Ir a crear presupuesto <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="modern-card modern-card-primary presupuesto-card-clickable" onclick="window.location.href='/Presupuesto/Seguimiento'">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-search me-2"></i>
                            Panel de Seguimiento
                        </div>
                        <i class="bi bi-clipboard-data presupuesto-card-icon-large"></i>
                    </div>
                    <div class="modern-card-content">
                        <p class="presupuesto-card-desc">
                            Consulta, filtra y gestiona todos los presupuestos. Busca por código, DNI, vendedor o estado.
                        </p>
                        <a href="/Presupuesto/Seguimiento" class="modern-card-link">
                            Ver panel de seguimiento <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="modern-card modern-card-info presupuesto-card-clickable" onclick="window.location.href='/Presupuesto/Metricas'">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-graph-up me-2"></i>
                            Métricas de Conversión
                        </div>
                        <i class="bi bi-bar-chart-line presupuesto-card-icon-large"></i>
                    </div>
                    <div class="modern-card-content">
                        <p class="presupuesto-card-desc">
                            Analiza la tasa de conversión de presupuestos a ventas por vendedor y período.
                        </p>
                        <a href="/Presupuesto/Metricas" class="modern-card-link">
                            Ver métricas <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Información Adicional -->
        <div class="row g-4">
            <div class="col-lg-12">
                <div class="modern-card modern-card-info">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            <i class="bi bi-info-circle me-2"></i>
                            Información del Módulo
                        </div>
                    </div>
                    <div class="modern-card-content">
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <div class="presupuesto-info-item">
                                    <i class="bi bi-shield-check"></i>
                                    <div>
                                        <h5 class="presupuesto-info-title">Atribución de Comisiones</h5>
                                        <p class="presupuesto-info-text">Los presupuestos garantizan que tanto el vendedor telefónico como el de cierre reciban su comisión correspondiente.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="presupuesto-info-item">
                                    <i class="bi bi-clock"></i>
                                    <div>
                                        <h5 class="presupuesto-info-title">Expiración Automática</h5>
                                        <p class="presupuesto-info-text">Los presupuestos expiran automáticamente después de 48 horas para incentivar el cierre rápido de ventas.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <div class="presupuesto-info-item">
                                    <i class="bi bi-qr-code"></i>
                                    <div>
                                        <h5 class="presupuesto-info-title">Código Único</h5>
                                        <p class="presupuesto-info-text">Cada presupuesto genera un código único (MAT-YYYYMMDD-XXXX) que permite el seguimiento y la vinculación con la venta final.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

