        html += '<div style="font-size: 1rem; font-weight: 600; color: var(--text-primary);">' + (p.dniCliente || '-') + '</div>';
        html += '</div>';
        // Nombre
        html += '<div class="col-md-4">';
        html += '<div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.25rem;">Nombre</div>';
        html += '<div style="font-size: 1rem; font-weight: 600; color: var(--text-primary);">' + (p.clienteNombre || '-') + '</div>';
        html += '</div>';
        // Teléfono
        html += '<div class="col-md-4">';
        html += '<div style="font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.25rem;">Teléfono</div>';
        html += '<div style="font-size: 1rem; font-weight: 600; color: var(--text-primary);">' + (p.clienteTelefono || '-') + '</div>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
        
        // Monto pactado
        html += '<div class="col-md-6">';
        html += '<div style="background: linear-gradient(135deg, rgba(230, 51, 117, 0.1) 0%, rgba(230, 51, 117, 0.05) 100%); padding: 1rem; border-radius: 8px; border: 1px solid rgba(230, 51, 117, 0.2);">';
        html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Monto Pactado</div>';
        html += '<div style="font-size: 1.5rem; font-weight: 700; color: var(--brand-primary);">$' + parseFloat(p.montoPactado).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '</div>';
        html += '</div>';
        html += '</div>';
        
        // Vendedores
        html += '<div class="col-md-6">';
        html += '<div style="background: var(--bg-main); padding: 1rem; border-radius: 8px;">';
        html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Vendedor Origen</div>';
        html += '<div style="font-size: 1rem; font-weight: 500; color: var(--text-primary);">' + (p.vendedorOrigenNombre || 'N/A') + '</div>';
        html += '</div>';
        html += '</div>';
        
        if (p.vendedorCierreNombre && p.vendedorCierreNombre !== 'N/A') {
            html += '<div class="col-md-6">';
            html += '<div style="background: var(--bg-main); padding: 1rem; border-radius: 8px;">';
            html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Vendedor de Cierre</div>';
            html += '<div style="font-size: 1rem; font-weight: 500; color: var(--text-primary);">' + p.vendedorCierreNombre + '</div>';
            html += '</div>';
            html += '</div>';
        }
        
        html += '</div>';
        
        // Viaje si existe
        if (p.viajeDescripcion && p.viajeDescripcion !== 'N/A') {
            html += '<div class="mb-4">';
            html += '<div style="background: var(--bg-main); padding: 1rem; border-radius: 8px;">';
            html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Viaje</div>';
            html += '<div style="font-size: 1rem; font-weight: 500; color: var(--text-primary);">' + p.viajeDescripcion + '</div>';
            if (p.paqueteDescripcion && p.paqueteDescripcion !== 'N/A') {
                html += '<div style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.25rem;">' + p.paqueteDescripcion + '</div>';
            }
            html += '</div>';
            html += '</div>';
        }
        
        // Fechas
        html += '<div class="row g-4 mb-4">';
        html += '<div class="col-md-6">';
        html += '<div style="background: var(--bg-main); padding: 1rem; border-radius: 8px;">';
        html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Fecha de Creación</div>';
        html += '<div style="font-size: 1rem; font-weight: 500; color: var(--text-primary);"><i class="bi bi-calendar3"></i> ' + p.fechaCreacion + '</div>';
        html += '</div>';
        html += '</div>';
        html += '<div class="col-md-6">';
        html += '<div style="background: var(--bg-main); padding: 1rem; border-radius: 8px;">';
        html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Fecha de Expiración</div>';
        html += '<div style="font-size: 1rem; font-weight: 500; color: var(--text-primary);"><i class="bi bi-calendar-x"></i> ' + p.fechaExpiracion;
        if (p.isExpirado) {
            html += ' <span class="presupuesto-badge badge-expirado" style="margin-left: 0.5rem;">Expirado</span>';
        }
        html += '</div>';
        html += '</div>';
        html += '</div>';
        html += '</div>';
        
        // Factura asociada si existe
        if (p.facturaId) {
            html += '<div class="mb-4">';
            html += '<div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.1) 0%, rgba(16, 185, 129, 0.05) 100%); padding: 1rem; border-radius: 8px; border: 1px solid rgba(16, 185, 129, 0.2);">';
            html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Factura Asociada</div>';
            html += '<a href="/PersonaCliente/PopupDetalleFactura?facturaid=' + p.facturaId + '" class="btn-modern btn-modern-primary" target="_blank" style="margin-top: 0.5rem;"><i class="bi bi-receipt"></i> Ver Factura</a>';
            html += '</div>';
            html += '</div>';
        }
        
        // Observaciones si existen
        if (p.observaciones) {
            html += '<div class="mb-4">';
            html += '<div style="background: var(--bg-main); padding: 1rem; border-radius: 8px;">';
            html += '<div style="font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.5px; color: var(--text-secondary); margin-bottom: 0.5rem;">Observaciones</div>';
            html += '<div style="font-size: 1rem; color: var(--text-primary); line-height: 1.6;">' + p.observaciones + '</div>';
            html += '</div>';
            html += '</div>';
        }
        
        // Botones de acción
        html += '<div class="d-flex justify-content-end gap-2 mt-4" style="border-top: 2px solid var(--border-color); padding-top: 1.5rem;">';
        html += '<button class="btn-modern btn-modern-secondary" onclick="copiarCodigo(\'' + p.codigoSeguimiento + '\')"><i class="bi bi-clipboard"></i> Copiar Código</button>';
        html += '<button class="btn-modern btn-modern-secondary" onclick="cerrarModalDetalle()"><i class="bi bi-x-lg"></i> Cerrar</button>';
        html += '</div>';

        html += '</div>';

        $('#contenidoDetallePresupuesto').html(html);

        // Destruir diálogo previo si existe
        if ($('#modalDetallePresupuesto').data('ui-dialog')) {
            $('#modalDetallePresupuesto').dialog('destroy');
        }

        $('#modalDetallePresupuesto').dialog({
            title: 'Detalle de Presupuesto',
            modal: true,
            width: '70%',
            maxWidth: '900px',
            resizable: true,
            position: { my: 'center', at: 'center', of: window },
            dialogClass: 'modern-dialog',
            close: function() {
                // Limpiar overlay al cerrar
                $('.ui-widget-overlay').remove();
            },
            open: function() {
                // Agregar icono al título después de que se abra el diálogo
                var $dialog = $(this).closest('.ui-dialog');
                var $titlebar = $dialog.find('.ui-dialog-title');
                if ($titlebar.find('i').length === 0) {
                    $titlebar.prepend('<i class="bi bi-file-earmark-text" style="margin-right: 8px;"></i>');
                }

                // Reasignar el evento del botón X para usar cerrarModalDetalle
                $dialog.find('.ui-dialog-titlebar-close').off('click').on('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    cerrarModalDetalle();
                });
            }
        });
    }

    function cerrarModalDetalle() {
        // Ocultar el diálogo y el overlay con !important para forzar el cierre
        var dialog = document.querySelector('.ui-dialog');
        var overlay = document.querySelector('.ui-widget-overlay');

        if (dialog) {
            dialog.style.setProperty('display', 'none', 'important');
        }
        if (overlay) {
            overlay.style.setProperty('display', 'none', 'important');
        }

        // Destruir el diálogo de jQuery UI si existe
        try {
            if ($('#modalDetallePresupuesto').data('ui-dialog')) {
                $('#modalDetallePresupuesto').dialog('destroy');
            }
        } catch (e) {
            console.log('Error al destruir dialog:', e);
        }
    }

    function copiarCodigo(codigo) {
        navigator.clipboard.writeText(codigo).then(function() {
            mostrarMensaje('Código copiado al portapapeles: ' + codigo, 'success');
        }, function() {
            // Fallback para navegadores antiguos
            var textArea = document.createElement("textarea");
            textArea.value = codigo;
            document.body.appendChild(textArea);
            textArea.select();
            document.execCommand('copy');
            document.body.removeChild(textArea);
            mostrarMensaje('Código copiado al portapapeles: ' + codigo, 'success');
        });
    }

    function mostrarMensaje(mensaje, tipo) {
        // Usar el sistema de mensajes existente o crear uno simple
        var alertClass = tipo === 'success' ? 'alert-success' : tipo === 'danger' ? 'alert-danger' : 'alert-info';
        var alertHtml = '<div class="alert ' + alertClass + ' alert-dismissible fade show" role="alert" style="position: fixed; top: 20px; right: 20px; z-index: 10001; min-width: 300px;">';
        alertHtml += mensaje;
        alertHtml += '<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>';
        alertHtml += '</div>';
        
        $('body').append(alertHtml);
        setTimeout(function() {
            $('.alert').fadeOut(function() {
                $(this).remove();
            });
        }, 3000);
    }

    // Búsqueda rápida con Enter
    $('#txtBusquedaRapida').on('keypress', function(e) {
        if (e.which === 13) {
            aplicarFiltros();
        }
    });
</script>

