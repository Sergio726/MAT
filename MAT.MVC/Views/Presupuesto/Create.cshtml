@{
    Response.ContentType = "text/html; charset=utf-8";
    Response.Charset = "utf-8";
    ViewBag.Title = "Preventa Telefonica - Generar Presupuesto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container presupuesto-create">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-telephone-forward"></i>
            <span>Módulo de Preventa Telefónica</span>
        </h2>
        <p class="modern-page-subtitle">Registra al cliente y asegura tu comisión generando un código de seguimiento único</p>
    </div>

    <div class="row g-4 presupuesto-create-row">
        <div class="col-lg-6 presupuesto-col-flex">
            <div class="modern-card presupuesto-form-card">
                <div class="modern-card-header">
                    <div class="modern-card-title">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Datos del Presupuesto Rapido</span>
                    </div>
                </div>
                <div class="modern-card-content presupuesto-form-content">
                    <form id="formPresupuesto" class="presupuesto-form-container presupuesto-form-flex">
                        @Html.AntiForgeryToken()
                        <div class="modern-form-group">
                            <label for="txt-busqueda-cliente" class="modern-form-label">
                                <i class="bi bi-search"></i>
                                Buscar Cliente <span class="text-danger">*</span>
                            </label>
                            <div class="presupuesto-input-wrapper">
                                <input type="text" 
                                       class="modern-form-input" 
                                       id="txt-busqueda-cliente" 
                                       placeholder="Ingrese nombre o DNI del cliente (mínimo 3 caracteres)..." 
                                       autocomplete="off" />
                                <span id="loading-cliente" class="presupuesto-loading-indicator">
                                    <i class="bi bi-hourglass-split"></i>
                                </span>
                            </div>
                            <input type="hidden" id="txtDniCliente" />
                            <input type="hidden" id="ClienteId" />
                            <input type="hidden" id="txtTelefonoCliente" />
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Busque por nombre, apellido o DNI. El DNI sera usado para vincular el presupuesto con la venta final
                            </small>
                        </div>

                        <div class="modern-form-group presupuesto-u-hidden" id="divClienteSeleccionado">
                            <div class="presupuesto-cliente-seleccionado">
                                <div class="presupuesto-cliente-header">
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi bi-person-check presupuesto-icon-primary"></i>
                                        <strong class="presupuesto-cliente-nombre">Cliente Seleccionado</strong>
                                    </div>
                                    <button type="button" class="btn-close btn-close-sm" onclick="limpiarCliente();" aria-label="Limpiar"></button>
                                </div>
                                <div class="presupuesto-cliente-nombre">
                                    <div><strong id="lblNombreCliente"></strong></div>
                                    <div class="presupuesto-cliente-dni">DNI: <span id="lblDniCliente"></span></div>
                                </div>
                            </div>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtNombreCliente" class="modern-form-label">
                                <i class="bi bi-person"></i>
                                Nombre del Cliente (Manual)
                            </label>
                            <input type="text" 
                                   class="modern-form-input" 
                                   id="txtNombreCliente" 
                                   placeholder="Si no encuentra el cliente, ingrese el nombre manualmente" 
                                   autocomplete="name" />
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Si no encuentra al cliente, ingrese el nombre. Cuando no hay DNI, complete también teléfono o email.
                            </small>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtTelefonoVisible" class="modern-form-label">
                                <i class="bi bi-whatsapp"></i>
                                Teléfono / WhatsApp
                            </label>
                            <input type="text" 
                                   class="modern-form-input" 
                                   id="txtTelefonoVisible" 
                                   placeholder="Ej: 11 1234-5678 o 54911..." 
                                   autocomplete="tel" />
                            <small class="form-text text-muted">
                                Requerido si no hay DNI. Se usa para enviar el código por WhatsApp.
                            </small>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtEmailCliente" class="modern-form-label">
                                <i class="bi bi-envelope"></i>
                                Email
                            </label>
                            <input type="email" 
                                   class="modern-form-input" 
                                   id="txtEmailCliente" 
                                   placeholder="cliente@ejemplo.com" 
                                   autocomplete="email" />
                            <small class="form-text text-muted">
                                Alternativa al teléfono cuando no hay DNI.
                            </small>
                        </div>

                        <div class="modern-form-group">
                            <label for="ddlViaje" class="modern-form-label">
                                <i class="bi bi-airplane"></i>
                                Destino / Viaje
                            </label>
                            @Html.DropDownList("ddlViaje", (List<SelectListItem>)ViewBag.Viajes, "Seleccione un viaje (opcional)", new { @class = "modern-form-select" })
                        </div>

                        <div id="divViajeInfo" class="presupuesto-u-hidden">
                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="bi bi-tag"></i>
                                    Precio Base del Viaje
                                </label>
                                <div class="presupuesto-viaje-info-box">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="presupuesto-label-text">Precio Base:</span>
                                        <strong class="presupuesto-value-brand" id="lblPrecioBase">$0</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="modern-form-group presupuesto-u-hidden" id="divAdicionales">
                                <label class="modern-form-label">
                                    <i class="bi bi-plus-circle"></i>
                                    Adicionales Disponibles
                                </label>
                                <div id="adicionalesContainer" class="presupuesto-adicionales-grid"></div>
                            </div>

                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="bi bi-calculator"></i>
                                    Monto Total
                                </label>
                                <div class="presupuesto-monto-total-box">
                                    <div class="d-flex align-items-center justify-content-between">
                                        <span class="presupuesto-monto-label">Total:</span>
                                        <strong class="presupuesto-monto-value" id="lblMontoTotal">$0</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtMontoPactado" class="modern-form-label">
                                <i class="bi bi-currency-dollar"></i>
                                Monto Pactado <span class="text-danger">*</span>
                            </label>
                            <div class="presupuesto-input-group">
                                <span class="presupuesto-input-group-text">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>
                                <input type="number" 
                                       class="modern-form-input" 
                                       id="txtMontoPactado" 
                                       placeholder="450000" 
                                       step="0.01" 
                                       min="0" 
                                       required 
                                       autocomplete="off" />
                            </div>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Puede modificar el monto manualmente o usar el monto total calculado arriba
                            </small>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtObservaciones" class="modern-form-label">
                                <i class="bi bi-chat-left-text"></i>
                                Observaciones
                            </label>
                            <textarea class="modern-form-textarea" 
                                      id="txtObservaciones" 
                                      rows="3" 
                                      placeholder="Notas adicionales sobre el presupuesto"></textarea>
                        </div>

                        <div class="modern-form-actions presupuesto-form-actions">
                            <button type="submit" class="btn-modern btn-modern-primary" id="btnGenerarCodigo">
                                <i class="bi bi-send-check"></i>
                                <span>Generar Codigo y Enviar WhatsApp</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-6 presupuesto-col-flex">
            <div class="presupuesto-sidebar">
                <div class="modern-card modern-card-info presupuesto-sidebar-card">
                    <div class="modern-card-header presupuesto-sidebar-header">
                        <div class="modern-card-title" style="font-size: 0.9375rem;">
                            <i class="bi bi-chat-quote"></i>
                            <span>Script Sugerido</span>
                        </div>
                    </div>
                    <div class="modern-card-content presupuesto-script-content">
                        <div class="presupuesto-script-box">
                            <p class="presupuesto-script-text">
                                "<span id="scriptNombreCliente" style="font-weight: 600;">[Nombre del Cliente]</span>, 
                                para que no tengas que repetir todo cuando vayas a la agencia y te respeten este precio de 
                                $<span id="scriptMonto" style="font-weight: 600;">[Monto]</span>, te acabo de enviar un 
                                <strong>Codigo de Reserva Preferencial</strong> a tu WhatsApp. Presentalo al llegar y quien este en caja te va a atender directamente con tu ficha lista."
                            </p>
                        </div>
                    </div>
                </div>

                <div class="modern-card presupuesto-sidebar-card">
                    <div class="modern-card-header presupuesto-sidebar-header">
                        <div class="modern-card-title presupuesto-sidebar-title">
                            <i class="bi bi-ticket-perforated"></i>
                            <span>Previsualización de Ticket</span>
                        </div>
                        <span class="badge bg-warning text-dark presupuesto-badge-ticket" id="lblNumeroTicket">#----</span>
                    </div>
                    <div class="modern-card-content presupuesto-ticket-content">
                        <div class="presupuesto-ticket-preview">
                            <div class="presupuesto-codigo-display" id="lblCodigoSeguimiento">
                                MAT-XXXX-XXXX
                            </div>
                            <div class="presupuesto-vendedor-info">
                                <i class="bi bi-person-check"></i>
                                <span>Vendedor: <strong id="lblVendedor">@MAT.MVC.Common.MATContext.CurrentVendedor?.Descripcion</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Modal centrado para resultado de presupuesto -->
            <div id="divResultadoOverlay" class="presupuesto-resultado-overlay presupuesto-u-hidden">
                <div id="divResultado" class="alert presupuesto-alert-resultado presupuesto-resultado-modal">
                    <div class="presupuesto-alert-inner">
                        <i class="bi presupuesto-alert-icon" id="iconResultado"></i>
                        <div class="presupuesto-alert-body">
                            <strong id="titleResultado"></strong>
                            <div id="msgResultado" class="presupuesto-alert-msg"></div>
                            <div id="divResultadoAcciones" class="presupuesto-resultado-acciones presupuesto-u-hidden">
                                <button type="button" class="btn-modern btn-modern-outline btn-sm" id="btnCopiarWppModal">
                                    <i class="bi bi-whatsapp"></i> Copiar mensaje WhatsApp
                                </button>
                            </div>
                        </div>
                        <button type="button" class="btn-close presupuesto-resultado-close" id="btnCerrarResultado" aria-label="Cerrar"></button>
                    </div>
                </div>
            </div>
            <!-- Botón persistente para copiar mensaje WhatsApp (visible tras cerrar el modal) -->
            <div id="divCopiarWppPersistente" class="presupuesto-copiar-wpp-persistente presupuesto-u-hidden">
                <button type="button" class="btn-modern btn-modern-outline btn-sm" id="btnCopiarWppPersistente">
                    <i class="bi bi-whatsapp"></i> Copiar mensaje WhatsApp
                </button>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        // Verificar que jQuery UI este cargado
        if (typeof $.ui === 'undefined' || typeof $.ui.autocomplete === 'undefined') {
            console.error('jQuery UI Autocomplete no esta cargado. Verifique que jquery-ui este incluido en el layout.');
            mostrarResultado('Error: jQuery UI no esta cargado. Por favor, recargue la pagina.', 'danger');
            return;
        }

        // Inicializar autocomplete de cliente usando endpoint optimizado
        $("#txt-busqueda-cliente").autocomplete({
            minLength: 2,
            delay: 300,
            source: function (request, response) {
                // Mostrar indicador de carga
                $("#loading-cliente").show();
                
                $.ajax({
                    url: "@Url.Action("GetClientesTop", "PersonaCliente")",
                    type: "POST",
                    data: { searchTerm: request.term },
                    dataType: "json",
                    success: function (responseData) {
                        $("#loading-cliente").hide();
                        
                        if (responseData && responseData.success && responseData.data && Array.isArray(responseData.data)) {
                            var items = $.map(responseData.data, function (item) {
                                var nombre = item.Nombre || '';
                                var apellido = item.Apellido || '';
                                var dni = item.NroDocumento || 'Sin DNI';
                                var nombreCompleto = (apellido + (apellido && nombre ? ", " : "") + nombre).trim();
                                if (!nombreCompleto) nombreCompleto = "Sin nombre";
                                
                                return {
                                    label: nombreCompleto + " | DNI " + dni,
                                    value: nombreCompleto,
                                    data: item
                                };
                            });
                            response(items);
                        } else {
                            console.warn("Datos recibidos no tienen el formato esperado:", responseData);
                            response([]);
                        }
                    },
                    error: function (xhr, status, error) {
                        $("#loading-cliente").hide();
                        console.error("Error en autocomplete:", error);
                        response([]);
                    }
                });
            },
            select: function (event, ui) {
                event.preventDefault();
                if (ui.item && ui.item.data) {
                    var cliente = ui.item.data;
                    
                    // Llenar campos con datos del cliente
                    var dni = cliente.NroDocumento || '';
                    var nombre = cliente.Nombre || '';
                    var apellido = cliente.Apellido || '';
                    var nombreCompleto = (apellido + (apellido && nombre ? ", " : "") + nombre).trim();
                    if (!nombreCompleto) nombreCompleto = "Sin nombre";
                    var personaId = cliente.PersonaId || '';
                    var telefono = cliente.Telefono || cliente.TelefonoMovil || cliente.TelefonoCelular || '';
                    
                    $("#txtDniCliente").val(dni);
                    $("#ClienteId").val(personaId);
                    $("#txtTelefonoCliente").val(telefono);
                    $("#txtTelefonoVisible").val(telefono);
                    $("#txtNombreCliente").val(nombreCompleto);
                    $("#txt-busqueda-cliente").val(nombreCompleto);
                    
                    // Mostrar informacion del cliente seleccionado
                    $("#lblNombreCliente").text(nombreCompleto);
                    $("#lblDniCliente").text(dni || 'No especificado');
                    $("#divClienteSeleccionado").slideDown();
                    
                    // Actualizar script sugerido
                    actualizarScriptSugerido();
                }
                return false;
            },
            focus: function (event, ui) {
                event.preventDefault();
                return false;
            }
        });

        // Funcion para limpiar cliente seleccionado
        window.limpiarCliente = function() {
            $("#txt-busqueda-cliente").val('');
            $("#txtDniCliente").val('');
            $("#ClienteId").val('');
            $("#txtTelefonoCliente").val('');
            $("#txtTelefonoVisible").val('');
            $("#txtNombreCliente").val('');
            $("#divClienteSeleccionado").slideUp();
            actualizarScriptSugerido();
        };

        // Funcion para actualizar el script sugerido
        function actualizarScriptSugerido() {
            var nombre = $("#txtNombreCliente").val() || $("#lblNombreCliente").text() || '[Nombre del Cliente]';
            var monto = $('#txtMontoPactado').val() || '[Monto]';
            var montoFormateado = monto;
            
            if (monto !== '[Monto]' && !isNaN(parseFloat(monto))) {
                montoFormateado = parseFloat(monto).toLocaleString('es-AR', { 
                    minimumFractionDigits: 0, 
                    maximumFractionDigits: 0 
                });
            }
            
            $('#scriptNombreCliente').text(nombre);
            $('#scriptMonto').text(montoFormateado);
        }

        // Actualizar script sugerido cuando cambia el monto
        $('#txtMontoPactado').on('input', function () {
            actualizarScriptSugerido();
        });

        // Actualizar script sugerido cuando cambia el nombre manualmente
        $('#txtNombreCliente').on('input', function () {
            actualizarScriptSugerido();
        });

        // Manejar cambio de viaje
        $('#ddlViaje').on('change', function () {
            var viajeId = $(this).val();
            if (viajeId && viajeId !== '') {
                cargarInfoViaje(viajeId);
            } else {
                // Limpiar informacion del viaje
                $('#divViajeInfo').slideUp();
                $('#divAdicionales').hide();
                $('#adicionalesContainer').empty();
                $('#txtMontoPactado').val('');
                window.precioBaseViaje = 0;
                window.adicionalesSeleccionados = [];
                actualizarMontoTotal();
            }
        });

        // Funcion para cargar informacion del viaje
        function cargarInfoViaje(viajeId) {
            $.ajax({
                url: '@Url.Action("GetViajeInfo", "Presupuesto")',
                type: 'POST',
                data: { viajeId: viajeId },
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        // Mostrar precio base
                        var precioBase = parseFloat(response.precioBase) || 0;
                        $('#lblPrecioBase').text('$' + precioBase.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                        
                        // Guardar precio base
                        window.precioBaseViaje = precioBase;
                        window.adicionalesSeleccionados = [];
                        
                        // Cargar adicionales
                        if (response.adicionales && response.adicionales.length > 0) {
                            renderizarAdicionales(response.adicionales);
                            $('#divAdicionales').show();
                        } else {
                            $('#divAdicionales').hide();
                            $('#adicionalesContainer').empty();
                        }
                        
                        // Mostrar seccion de informacion del viaje
                        $('#divViajeInfo').slideDown();
                        
                        // Actualizar monto total
                        actualizarMontoTotal();
                    } else {
                        mostrarResultado(response.message || 'Error al cargar informacion del viaje.', 'danger');
                    }
                },
                error: function (xhr, status, error) {
                    mostrarResultado('Error al cargar informacion del viaje. Por favor, intente nuevamente.', 'danger');
                }
            });
        }

        // Funcion para renderizar adicionales
        function renderizarAdicionales(adicionales) {
            var html = '';
            $.each(adicionales, function (index, adicional) {
                var adicionalId = adicional.adicionalId || adicional.AdicionalId;
                var descripcion = adicional.descripcion || adicional.Descripcion || 'Sin descripcion';
                var precio = parseFloat(adicional.precio || adicional.Precio || 0);
                var precioFormateado = precio.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                
                html += '<div class="adicional-item">';
                html += '<div class="adicional-item-inner">';
                html += '<input type="checkbox" class="adicional-checkbox" data-adicional-id="' + adicionalId + '" data-precio="' + precio + '" id="adicional-' + adicionalId + '" />';
                html += '<label for="adicional-' + adicionalId + '">';
                html += '<div class="adicional-desc">' + escapeHtml(descripcion) + '</div>';
                html += '<div class="adicional-precio">$' + precioFormateado + '</div>';
                html += '</label>';
                html += '</div>';
                html += '</div>';
            });
            
            $('#adicionalesContainer').html(html);
            
            $('.adicional-checkbox').on('change', function () {
                var adicionalId = $(this).data('adicional-id');
                var precio = parseFloat($(this).data('precio')) || 0;
                var isChecked = $(this).is(':checked');
                
                if (isChecked) {
                    window.adicionalesSeleccionados.push({ id: adicionalId, precio: precio });
                } else {
                    window.adicionalesSeleccionados = window.adicionalesSeleccionados.filter(function (a) {
                        return a.id !== adicionalId;
                    });
                }
                actualizarMontoTotal();
            });
        }

        // Funcion para actualizar el monto total
        function actualizarMontoTotal() {
            var precioBase = window.precioBaseViaje || 0;
            var totalAdicionales = 0;
            
            if (window.adicionalesSeleccionados && window.adicionalesSeleccionados.length > 0) {
                totalAdicionales = window.adicionalesSeleccionados.reduce(function (sum, adicional) {
                    return sum + (parseFloat(adicional.precio) || 0);
                }, 0);
            }
            
            var montoTotal = precioBase + totalAdicionales;
            $('#lblMontoTotal').text('$' + montoTotal.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            
            if (!$('#txtMontoPactado').data('manual-edit')) {
                $('#txtMontoPactado').val(montoTotal.toFixed(2));
            }
            
            actualizarScriptSugerido();
        }

        $('#txtMontoPactado').on('input', function () {
            $(this).data('manual-edit', true);
            actualizarScriptSugerido();
        });

        function escapeHtml(text) {
            if (!text) return "";
            var map = { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' };
            return String(text).replace(/[&<>"']/g, function (m) { return map[m]; });
        }

        window.precioBaseViaje = 0;
        window.adicionalesSeleccionados = [];

        $('#formPresupuesto').on('submit', function (e) {
            e.preventDefault();
            var dniCliente = $('#txtDniCliente').val().trim().replace(/\./g, '');
            var nombreCliente = $('#txtNombreCliente').val().trim();
            var telefonoCliente = $('#txtTelefonoVisible').val().trim();
            var emailCliente = $('#txtEmailCliente').val().trim();
            var viajeId = $('#ddlViaje').val();
            var montoPactado = parseFloat($('#txtMontoPactado').val());
            var observaciones = $('#txtObservaciones').val();

            if (!dniCliente && !nombreCliente) {
                mostrarResultado('Debe buscar y seleccionar un cliente o ingresar al menos el nombre del cliente.', 'danger');
                return;
            }
            if (!dniCliente && nombreCliente && !telefonoCliente && !emailCliente) {
                mostrarResultado('Cuando no hay DNI, debe ingresar teléfono o email del cliente.', 'danger');
                return;
            }

            if (!montoPactado || montoPactado <= 0) {
                mostrarResultado('El monto debe ser mayor a cero.', 'danger');
                return;
            }

            var $btn = $('#btnGenerarCodigo');
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i><span>Generando...</span>');

            var telefonoCliente = $('#txtTelefonoCliente').val().trim();
            
            $.ajax({
                url: '@Url.Action("CreatePresupuesto", "Presupuesto")',
                type: 'POST',
                data: {
                    dniCliente: dniCliente || '',
                    nombreCliente: nombreCliente,
                    viajeId: viajeId || null,
                    montoPactado: montoPactado,
                    observaciones: observaciones,
                    telefonoCliente: telefonoCliente || null,
                    emailCliente: emailCliente || null,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        $('#lblCodigoSeguimiento').text(response.codigoSeguimiento);
                        $('#lblNumeroTicket').text('#' + response.codigoSeguimiento.split('-').pop());
                        
                        // Mostrar mensaje según si se envió WhatsApp o no
                        var mensaje = '¡Presupuesto generado exitosamente! Código: ' + response.codigoSeguimiento;
                        
                        if (response.whatsappEnviado) {
                            mensaje += '\n\n✅ El mensaje de WhatsApp ha sido enviado exitosamente al cliente.';
                            if (response.mensajeWhatsApp) {
                                window.mensajeWhatsAppParaCopiar = response.mensajeWhatsApp;
                            }
                        } else if (response.whatsappLink) {
                            // Si hay enlace de WhatsApp, abrirlo automáticamente
                            mensaje += '\n\n📱 Abriendo WhatsApp para enviar el mensaje...';
                            
                            // Abrir WhatsApp en una nueva ventana/pestaña
                            window.open(response.whatsappLink, '_blank');
                            
                            // Guardar enlace y mensaje en variables globales para acceso fácil
                            window.whatsappLinkParaCopiar = response.whatsappLink;
                            window.mensajeWhatsAppParaCopiar = response.mensajeWhatsApp;
                            window.codigoSeguimientoParaCopiar = response.codigoSeguimiento;
                        } else if (response.mensajeWhatsApp) {
                            mensaje += '\n\n📱 No se pudo generar el enlace de WhatsApp.';
                            mensaje += '\n\nMensaje para copiar y enviar manualmente:';
                            mensaje += '\n\n' + response.mensajeWhatsApp;
                            
                            // Guardar mensaje en variable global para acceso fácil
                            window.mensajeWhatsAppParaCopiar = response.mensajeWhatsApp;
                            window.codigoSeguimientoParaCopiar = response.codigoSeguimiento;
                        }
                        
                        mostrarResultado(mensaje, 'success');
                    } else {
                        mostrarResultado(response.message || 'Error al generar el presupuesto.', 'danger');
                    }
                },
                complete: function () {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });
    });

    function mostrarResultado(mensaje, tipo) {
        var $overlay = $('#divResultadoOverlay');
        var $div = $('#divResultado');
        var $msg = $('#msgResultado');
        var $title = $('#titleResultado');
        var $icon = $('#iconResultado');
        var $acciones = $('#divResultadoAcciones');
        
        $div.removeClass('alert-success alert-danger alert-warning alert-info').addClass('alert-' + tipo);
        
        var config = {
            'success': { icon: 'bi-check-circle-fill', title: '¡Exito!', color: '#10b981' },
            'danger': { icon: 'bi-exclamation-triangle-fill', title: 'Error', color: '#ef4444' }
        };
        
        var tipoConfig = config[tipo] || { icon: 'bi-info-circle-fill', title: 'Informacion', color: '#3b82f6' };
        $icon.removeClass().addClass('bi ' + tipoConfig.icon).css('color', tipoConfig.color);
        $title.text(tipoConfig.title);
        $msg.html(mensaje);
        
        if (tipo === 'success' && window.mensajeWhatsAppParaCopiar) {
            $acciones.removeClass('presupuesto-u-hidden');
        } else {
            $acciones.addClass('presupuesto-u-hidden');
        }
        $('#divCopiarWppPersistente').addClass('presupuesto-u-hidden');
        $overlay.removeClass('presupuesto-u-hidden');
    }

    function cerrarResultadoModal() {
        $('#divResultadoOverlay').addClass('presupuesto-u-hidden');
        if (window.mensajeWhatsAppParaCopiar) {
            $('#divCopiarWppPersistente').removeClass('presupuesto-u-hidden');
        }
    }

    function copiarMensajeWhatsApp() {
        var texto = window.mensajeWhatsAppParaCopiar;
        if (!texto) return;
        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(texto).then(function() {
                (window.alertSuccess || alert)('Mensaje copiado al portapapeles.', 'Listo');
            }).catch(function() { fallbackCopiar(texto); });
        } else {
            fallbackCopiar(texto);
        }
    }

    function fallbackCopiar(texto) {
        var $ta = $('<textarea>').val(texto).css({ position: 'fixed', left: '-9999px' }).appendTo('body');
        $ta.select();
        try {
            document.execCommand('copy');
            (window.alertSuccess || alert)('Mensaje copiado al portapapeles.', 'Listo');
        } catch (e) {}
        $ta.remove();
    }

    $(document).ready(function () {
        $('#btnCerrarResultado').on('click', cerrarResultadoModal);
        $('#divResultadoOverlay').on('click', function(e) {
            if (e.target === this) cerrarResultadoModal();
        });
        $('#divResultado').on('click', function(e) { e.stopPropagation(); });
        $('#btnCopiarWppModal').on('click', copiarMensajeWhatsApp);
        $('#btnCopiarWppPersistente').on('click', copiarMensajeWhatsApp);
    });
</script>