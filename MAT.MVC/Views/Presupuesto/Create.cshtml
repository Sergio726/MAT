@{
    Response.ContentType = "text/html; charset=utf-8";
    Response.Charset = "utf-8";
    ViewBag.Title = "Preventa Telefónica - Generar Presupuesto";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-telephone-forward"></i>
            <span>Modulo de Preventa Telefonica</span>
        </h2>
        <p class="modern-page-subtitle">Registra al cliente y asegura tu comision generando un codigo de seguimiento unico</p>
    </div>

    <div class="row g-4" style="align-items: stretch;">
        <!-- Formulario Principal -->
        <div class="col-lg-6" style="display: flex;">
            <div class="modern-card" style="display: flex; flex-direction: column; height: 100%;">
                <div class="modern-card-header">
                    <div class="modern-card-title">
                        <i class="bi bi-file-earmark-text"></i>
                        <span>Datos del Presupuesto Rapido</span>
                    </div>
                </div>
                <div class="modern-card-content" style="flex: 1; display: flex; flex-direction: column; overflow-y: auto;">
                    <form id="formPresupuesto" class="modern-form-container" style="flex: 1; display: flex; flex-direction: column;">
                        <div class="modern-form-group">
                            <label for="txt-busqueda-cliente" class="modern-form-label">
                                <i class="bi bi-search"></i>
                                Buscar Cliente <span class="text-danger">*</span>
                            </label>
                            <div style="position: relative;">
                                <input type="text" 
                                       class="modern-form-input" 
                                       id="txt-busqueda-cliente" 
                                       placeholder="Ingrese nombre o DNI del cliente (mínimo 3 caracteres)..." 
                                       autocomplete="off" />
                                <span id="loading-cliente" style="display: none; position: absolute; right: 1rem; top: 50%; transform: translateY(-50%); color: var(--text-secondary);">
                                    <i class="bi bi-hourglass-split"></i>
                                </span>
                            </div>
                            <input type="hidden" id="txtDniCliente" />
                            <input type="hidden" id="ClienteId" />
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Busque por nombre, apellido o DNI. El DNI será usado para vincular el presupuesto con la venta final
                            </small>
                        </div>

                        <div class="modern-form-group" id="divClienteSeleccionado" style="display: none;">
                            <div style="background: var(--bg-main); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.5rem;">
                                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                                        <i class="bi bi-person-check" style="color: var(--brand-primary);"></i>
                                        <strong style="color: var(--text-primary);">Cliente Seleccionado</strong>
                                    </div>
                                    <button type="button" class="btn-close" onclick="limpiarCliente();" aria-label="Limpiar" style="font-size: 0.875rem;"></button>
                                </div>
                                <div style="color: var(--text-primary);">
                                    <div><strong id="lblNombreCliente"></strong></div>
                                    <div style="font-size: 0.875rem; color: var(--text-secondary); margin-top: 0.25rem;">
                                        DNI: <span id="lblDniCliente"></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtNombreCliente" class="modern-form-label">
                                <i class="bi bi-person"></i>
                                Nombre del Cliente (Manual)
                            </label>
                            <input type="text" 
                                   class="modern-form-input" 
                                   id="txtNombreCliente" 
                                   placeholder="Si no encuentra el cliente, ingrese el nombre manualmente" 
                                   autocomplete="name" />
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Opcional: Use este campo si el cliente no está registrado en el sistema
                            </small>
                        </div>

                        <div class="modern-form-group">
                            <label for="ddlViaje" class="modern-form-label">
                                <i class="bi bi-airplane"></i>
                                Destino / Viaje
                            </label>
                            @Html.DropDownList("ddlViaje", (List<SelectListItem>)ViewBag.Viajes, "Seleccione un viaje (opcional)", new { @class = "modern-form-select" })
                        </div>

                        <!-- Sección de Precio y Adicionales (se muestra cuando se selecciona un viaje) -->
                        <div id="divViajeInfo" style="display: none;">
                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="bi bi-tag"></i>
                                    Precio Base del Viaje
                                </label>
                                <div style="background: var(--bg-main); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color);">
                                    <div style="display: flex; align-items: center; justify-content: space-between;">
                                        <span style="font-size: 1.125rem; color: var(--text-primary);">Precio Base:</span>
                                        <strong style="font-size: 1.25rem; color: var(--brand-primary);" id="lblPrecioBase">$0</strong>
                                    </div>
                                </div>
                            </div>

                            <div class="modern-form-group" id="divAdicionales" style="display: none;">
                                <label class="modern-form-label">
                                    <i class="bi bi-plus-circle"></i>
                                    Adicionales Disponibles
                                </label>
                                <div id="adicionalesContainer" style="display: flex; flex-direction: column; gap: 0.75rem;">
                                    <!-- Los adicionales se cargarán aquí dinámicamente -->
                                </div>
                            </div>

                            <div class="modern-form-group">
                                <label class="modern-form-label">
                                    <i class="bi bi-calculator"></i>
                                    Monto Total
                                </label>
                                <div style="background: linear-gradient(135deg, var(--brand-primary) 0%, #ff6b9d 100%); padding: 1.25rem; border-radius: 8px; color: white;">
                                    <div style="display: flex; align-items: center; justify-content: space-between;">
                                        <span style="font-size: 1rem; font-weight: 500;">Total:</span>
                                        <strong style="font-size: 1.5rem; font-weight: 700;" id="lblMontoTotal">$0</strong>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtMontoPactado" class="modern-form-label">
                                <i class="bi bi-currency-dollar"></i>
                                Monto Pactado <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <span class="input-group-text" style="background: var(--bg-main); border-right: none;">
                                    <i class="bi bi-currency-dollar"></i>
                                </span>
                                <input type="number" 
                                       class="modern-form-input" 
                                       id="txtMontoPactado" 
                                       placeholder="450000" 
                                       step="0.01" 
                                       min="0" 
                                       required 
                                       autocomplete="off" />
                            </div>
                            <small class="form-text text-muted">
                                <i class="bi bi-info-circle"></i>
                                Puede modificar el monto manualmente o usar el monto total calculado arriba
                            </small>
                        </div>

                        <div class="modern-form-group">
                            <label for="txtObservaciones" class="modern-form-label">
                                <i class="bi bi-chat-left-text"></i>
                                Observaciones
                            </label>
                            <textarea class="modern-form-textarea" 
                                      id="txtObservaciones" 
                                      rows="3" 
                                      placeholder="Notas adicionales sobre el presupuesto"></textarea>
                        </div>

                        <div class="modern-form-actions" style="margin-top: 2rem; padding-top: 1.5rem; border-top: 1px solid var(--border-color);">
                            <button type="submit" class="btn-modern btn-modern-primary" id="btnGenerarCodigo">
                                <i class="bi bi-send-check"></i>
                                <span>Generar Codigo y Enviar WhatsApp</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Panel Lateral -->
        <div class="col-lg-6" style="display: flex;">
            <div style="display: flex; flex-direction: column; gap: 1rem; width: 100%;">
                <!-- Script Sugerido -->
                <div class="modern-card modern-card-info" style="flex: 1; display: flex; flex-direction: column;">
                    <div class="modern-card-header" style="padding: 1rem 1.5rem; flex-shrink: 0;">
                        <div class="modern-card-title" style="font-size: 0.9375rem;">
                            <i class="bi bi-chat-quote"></i>
                            <span>Script Sugerido</span>
                        </div>
                    </div>
                    <div class="modern-card-content" style="padding: 1rem 1.5rem; flex: 1; display: flex; align-items: center;">
                        <div style="background: var(--bg-main); padding: 0.875rem; border-radius: 8px; border-left: 3px solid var(--brand-primary); width: 100%;">
                            <p style="font-style: italic; color: var(--text-primary); margin: 0; line-height: 1.4; font-size: 0.875rem;">
                                "<span id="scriptNombreCliente" style="font-weight: 600;">[Nombre del Cliente]</span>, 
                                para que no tengas que repetir todo cuando vayas a la agencia y te respeten este precio de 
                                $<span id="scriptMonto" style="font-weight: 600;">[Monto]</span>, te acabo de enviar un 
                                <strong>Codigo de Reserva Preferencial</strong> a tu WhatsApp. Preséntalo al llegar y quien esté en caja te va a atender directamente con tu ficha lista."
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Previsualización de Ticket -->
                <div class="modern-card" style="flex: 1; display: flex; flex-direction: column;">
                    <div class="modern-card-header" style="padding: 1rem 1.5rem; flex-shrink: 0;">
                        <div class="modern-card-title" style="font-size: 0.9375rem;">
                            <i class="bi bi-ticket-perforated"></i>
                            <span>Previsualizacion de Ticket</span>
                        </div>
                        <span class="badge bg-warning text-dark" id="lblNumeroTicket" style="font-size: 0.75rem; padding: 0.375rem 0.625rem;">#----</span>
                    </div>
                    <div class="modern-card-content" style="padding: 1rem 1.5rem; flex: 1; display: flex; align-items: center; justify-content: center;">
                        <div style="text-align: center; padding: 1.25rem; background: linear-gradient(135deg, var(--bg-main) 0%, #ffffff 100%); border-radius: 8px; border: 2px dashed var(--border-color); width: 100%;">
                            <div style="font-size: 1.5rem; font-weight: 700; font-family: 'Courier New', monospace; color: var(--brand-primary); margin-bottom: 0.75rem; letter-spacing: 1px;" id="lblCodigoSeguimiento">
                                MAT-XXXX-XXXX
                            </div>
                            <div style="font-size: 0.8125rem; color: var(--text-secondary); display: flex; align-items: center; justify-content: center; gap: 0.5rem;">
                                <i class="bi bi-person-check"></i>
                                <span>Vendedor: <strong id="lblVendedor" style="font-size: 0.8125rem;">@MAT.MVC.Common.MATContext.CurrentVendedor?.Descripcion</strong></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Mensaje de Resultado -->
            <div id="divResultado" class="alert" style="display: none; margin-top: 1.5rem; border-radius: 12px; border: none; box-shadow: var(--card-shadow);">
                <div style="display: flex; align-items: flex-start; gap: 1rem;">
                    <i class="bi" id="iconResultado" style="font-size: 1.5rem; flex-shrink: 0;"></i>
                    <div style="flex: 1;">
                        <strong id="titleResultado"></strong>
                        <div id="msgResultado" style="margin-top: 0.5rem;"></div>
                    </div>
                    <button type="button" class="btn-close" onclick="$('#divResultado').fadeOut();" aria-label="Cerrar"></button>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .modern-form-container {
        padding: 0;
    }

    .modern-form-group {
        margin-bottom: 1.5rem;
    }

    .modern-form-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 0.5rem;
        font-size: 0.875rem;
    }

    .modern-form-label i {
        color: var(--brand-primary);
        font-size: 1rem;
    }

    .modern-form-input,
    .modern-form-textarea,
    .modern-form-select {
        width: 100%;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        font-size: 0.9375rem;
        transition: all 0.2s ease;
        background: var(--white);
        color: var(--text-primary);
    }

    .modern-form-input:focus,
    .modern-form-textarea:focus,
    .modern-form-select:focus {
        outline: none;
        border-color: var(--brand-primary);
        box-shadow: 0 0 0 3px rgba(230, 51, 117, 0.1);
    }

    .modern-form-textarea {
        resize: vertical;
        min-height: 100px;
    }

    .input-group {
        display: flex;
        align-items: stretch;
    }

    .input-group-text {
        display: flex;
        align-items: center;
        padding: 0.75rem 1rem;
        border: 1px solid var(--border-color);
        border-right: none;
        border-radius: 8px 0 0 8px;
        background: var(--bg-main);
        color: var(--text-secondary);
    }

    .input-group .modern-form-input {
        border-radius: 0 8px 8px 0;
        border-left: none;
    }

    .form-text {
        display: flex;
        align-items: center;
        gap: 0.375rem;
        font-size: 0.8125rem;
        color: var(--text-secondary);
        margin-top: 0.375rem;
    }

    .form-text i {
        color: var(--brand-primary);
    }

    .modern-form-actions {
        display: flex;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .badge {
        display: inline-flex;
        align-items: center;
        padding: 0.5rem 0.75rem;
        font-weight: 600;
        border-radius: 8px;
    }

    /* Estilos para autocomplete de jQuery UI */
    .ui-autocomplete {
        max-height: 300px;
        overflow-y: auto;
        overflow-x: hidden;
        background: var(--white);
        border: 1px solid var(--border-color);
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        z-index: 1000;
        padding: 0.5rem 0;
    }

    .ui-autocomplete .ui-menu-item {
        padding: 0;
        margin: 0;
    }

    .ui-autocomplete .ui-menu-item-wrapper {
        padding: 0.75rem 1rem;
        border: none;
        border-bottom: 1px solid var(--bg-main);
        color: var(--text-primary);
        transition: all 0.2s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .ui-autocomplete .ui-menu-item-wrapper:hover,
    .ui-autocomplete .ui-menu-item-wrapper.ui-state-active {
        background: var(--bg-main);
        border-color: var(--brand-primary);
        color: var(--text-primary);
        margin: 0;
    }

    .ui-autocomplete .ui-menu-item:last-child .ui-menu-item-wrapper {
        border-bottom: none;
    }

    /* Scrollbar personalizado para autocomplete */
    .ui-autocomplete::-webkit-scrollbar {
        width: 6px;
    }

    .ui-autocomplete::-webkit-scrollbar-track {
        background: var(--bg-main);
        border-radius: 3px;
    }

    .ui-autocomplete::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: 3px;
    }

    .ui-autocomplete::-webkit-scrollbar-thumb:hover {
        background: var(--text-muted);
    }

    /* Estilos para adicionales */
    .adicional-item {
        transition: all 0.2s ease;
    }

    .adicional-item:hover {
        border-color: var(--brand-primary) !important;
        box-shadow: 0 2px 8px rgba(230, 51, 117, 0.1);
    }

    .adicional-item input[type="checkbox"]:checked + label {
        color: var(--brand-primary);
    }

    .adicional-item input[type="checkbox"]:checked ~ label {
        font-weight: 600;
    }

    .adicional-checkbox:checked {
        accent-color: var(--brand-primary);
    }
</style>

<script type="text/javascript">
    $(document).ready(function () {
        // Verificar que jQuery UI esté cargado
        if (typeof $.ui === 'undefined' || typeof $.ui.autocomplete === 'undefined') {
            console.error('jQuery UI Autocomplete no está cargado. Verifique que jquery-ui esté incluido en el layout.');
            mostrarResultado('Error: jQuery UI no está cargado. Por favor, recargue la página.', 'danger');
            return;
        }

        // Inicializar autocomplete de cliente usando endpoint optimizado
        $("#txt-busqueda-cliente").autocomplete({
            minLength: 2,
            delay: 300,
            source: function (request, response) {
                // Mostrar indicador de carga
                $("#loading-cliente").show();
                
                $.ajax({
                    url: "@Url.Action("GetClientesTop", "PersonaCliente")",
                    type: "POST",
                    data: { searchTerm: request.term },
                    dataType: "json",
                    success: function (responseData) {
                        $("#loading-cliente").hide();
                        
                        if (responseData && responseData.success && responseData.data && Array.isArray(responseData.data)) {
                            var items = $.map(responseData.data, function (item) {
                                var nombre = item.Nombre || '';
                                var apellido = item.Apellido || '';
                                var dni = item.NroDocumento || 'Sin DNI';
                                var nombreCompleto = (apellido + (apellido && nombre ? ", " : "") + nombre).trim();
                                if (!nombreCompleto) nombreCompleto = "Sin nombre";
                                
                                return {
                                    label: nombreCompleto + " | DNI " + dni,
                                    value: nombreCompleto,
                                    data: item
                                };
                            });
                            response(items);
                        } else {
                            console.warn("Datos recibidos no tienen el formato esperado:", responseData);
                            response([]);
                        }
                    },
                    error: function (xhr, status, error) {
                        $("#loading-cliente").hide();
                        console.error("Error en autocomplete:", error);
                        console.error("Status:", status);
                        console.error("Response:", xhr.responseText);
                        response([]);
                    }
                });
            },
            select: function (event, ui) {
                event.preventDefault();
                if (ui.item && ui.item.data) {
                    var cliente = ui.item.data;
                    
                    // Llenar campos con datos del cliente
                    var dni = cliente.NroDocumento || '';
                    var nombre = cliente.Nombre || '';
                    var apellido = cliente.Apellido || '';
                    var nombreCompleto = (apellido + (apellido && nombre ? ", " : "") + nombre).trim();
                    if (!nombreCompleto) nombreCompleto = "Sin nombre";
                    var personaId = cliente.PersonaId || '';
                    
                    $("#txtDniCliente").val(dni);
                    $("#ClienteId").val(personaId);
                    $("#txtNombreCliente").val(nombreCompleto);
                    $("#txt-busqueda-cliente").val(nombreCompleto);
                    
                    // Mostrar información del cliente seleccionado
                    $("#lblNombreCliente").text(nombreCompleto);
                    $("#lblDniCliente").text(dni || 'No especificado');
                    $("#divClienteSeleccionado").slideDown();
                    
                    // Actualizar script sugerido
                    actualizarScriptSugerido();
                }
                return false;
            },
            focus: function (event, ui) {
                // Prevenir que se llene el input con el label completo
                event.preventDefault();
                return false;
            }
        });

        // Función para limpiar cliente seleccionado
        window.limpiarCliente = function() {
            $("#txt-busqueda-cliente").val('');
            $("#txtDniCliente").val('');
            $("#ClienteId").val('');
            $("#txtNombreCliente").val('');
            $("#divClienteSeleccionado").slideUp();
            actualizarScriptSugerido();
        };

        // Función para actualizar el script sugerido
        function actualizarScriptSugerido() {
            var nombre = $("#txtNombreCliente").val() || $("#lblNombreCliente").text() || '[Nombre del Cliente]';
            var monto = $('#txtMontoPactado').val() || '[Monto]';
            var montoFormateado = monto;
            
            if (monto !== '[Monto]' && !isNaN(parseFloat(monto))) {
                montoFormateado = parseFloat(monto).toLocaleString('es-AR', { 
                    minimumFractionDigits: 0, 
                    maximumFractionDigits: 0 
                });
            }
            
            $('#scriptNombreCliente').text(nombre);
            $('#scriptMonto').text(montoFormateado);
        }

        // Actualizar script sugerido cuando cambia el monto
        $('#txtMontoPactado').on('input', function () {
            actualizarScriptSugerido();
        });

        // Actualizar script sugerido cuando cambia el nombre manualmente
        $('#txtNombreCliente').on('input', function () {
            actualizarScriptSugerido();
        });

        // Manejar cambio de viaje
        $('#ddlViaje').on('change', function () {
            var viajeId = $(this).val();
            if (viajeId && viajeId !== '') {
                cargarInfoViaje(viajeId);
            } else {
                // Limpiar información del viaje
                $('#divViajeInfo').slideUp();
                $('#divAdicionales').hide();
                $('#adicionalesContainer').empty();
                $('#txtMontoPactado').val('');
                window.precioBaseViaje = 0;
                window.adicionalesSeleccionados = [];
                actualizarMontoTotal();
            }
        });

        // Función para cargar información del viaje
        function cargarInfoViaje(viajeId) {
            $.ajax({
                url: '@Url.Action("GetViajeInfo", "Presupuesto")',
                type: 'POST',
                data: { viajeId: viajeId },
                dataType: 'json',
                success: function (response) {
                    if (response.success) {
                        // Mostrar precio base
                        var precioBase = parseFloat(response.precioBase) || 0;
                        $('#lblPrecioBase').text('$' + precioBase.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
                        
                        // Guardar precio base
                        window.precioBaseViaje = precioBase;
                        window.adicionalesSeleccionados = [];
                        
                        // Cargar adicionales
                        if (response.adicionales && response.adicionales.length > 0) {
                            renderizarAdicionales(response.adicionales);
                            $('#divAdicionales').show();
                        } else {
                            $('#divAdicionales').hide();
                            $('#adicionalesContainer').empty();
                        }
                        
                        // Mostrar sección de información del viaje
                        $('#divViajeInfo').slideDown();
                        
                        // Actualizar monto total
                        actualizarMontoTotal();
                    } else {
                        mostrarResultado(response.message || 'Error al cargar información del viaje.', 'danger');
                    }
                },
                error: function (xhr, status, error) {
                    console.error('Error al cargar información del viaje:', error);
                    mostrarResultado('Error al cargar información del viaje. Por favor, intente nuevamente.', 'danger');
                }
            });
        }

        // Función para renderizar adicionales
        function renderizarAdicionales(adicionales) {
            var html = '';
            $.each(adicionales, function (index, adicional) {
                var adicionalId = adicional.adicionalId || adicional.AdicionalId;
                var descripcion = adicional.descripcion || adicional.Descripcion || 'Sin descripción';
                var precio = parseFloat(adicional.precio || adicional.Precio || 0);
                var precioFormateado = precio.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
                
                html += '<div style="background: var(--white); padding: 1rem; border-radius: 8px; border: 1px solid var(--border-color); display: flex; align-items: center; justify-content: space-between; transition: all 0.2s ease;" class="adicional-item">';
                html += '<div style="display: flex; align-items: center; gap: 0.75rem; flex: 1;">';
                html += '<input type="checkbox" class="adicional-checkbox" data-adicional-id="' + adicionalId + '" data-precio="' + precio + '" id="adicional-' + adicionalId + '" style="width: 18px; height: 18px; cursor: pointer;" />';
                html += '<label for="adicional-' + adicionalId + '" style="margin: 0; cursor: pointer; flex: 1; color: var(--text-primary);">';
                html += '<div style="font-weight: 500;">' + escapeHtml(descripcion) + '</div>';
                html += '<div style="font-size: 0.875rem; color: var(--text-secondary);">$' + precioFormateado + '</div>';
                html += '</label>';
                html += '</div>';
                html += '</div>';
            });
            
            $('#adicionalesContainer').html(html);
            
            // Agregar event listeners a los checkboxes
            $('.adicional-checkbox').on('change', function () {
                var adicionalId = $(this).data('adicional-id');
                var precio = parseFloat($(this).data('precio')) || 0;
                var isChecked = $(this).is(':checked');
                
                if (isChecked) {
                    window.adicionalesSeleccionados.push({ id: adicionalId, precio: precio });
                } else {
                    window.adicionalesSeleccionados = window.adicionalesSeleccionados.filter(function (a) {
                        return a.id !== adicionalId;
                    });
                }
                
                actualizarMontoTotal();
            });
        }

        // Función para actualizar el monto total
        function actualizarMontoTotal() {
            var precioBase = window.precioBaseViaje || 0;
            var totalAdicionales = 0;
            
            if (window.adicionalesSeleccionados && window.adicionalesSeleccionados.length > 0) {
                totalAdicionales = window.adicionalesSeleccionados.reduce(function (sum, adicional) {
                    return sum + (parseFloat(adicional.precio) || 0);
                }, 0);
            }
            
            var montoTotal = precioBase + totalAdicionales;
            $('#lblMontoTotal').text('$' + montoTotal.toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            
            // Actualizar el campo de monto pactado si está vacío o si el usuario no lo ha modificado manualmente
            if (!$('#txtMontoPactado').data('manual-edit')) {
                $('#txtMontoPactado').val(montoTotal.toFixed(2));
            }
            
            actualizarScriptSugerido();
        }

        // Marcar cuando el usuario edita manualmente el monto
        $('#txtMontoPactado').on('input', function () {
            $(this).data('manual-edit', true);
            actualizarScriptSugerido();
        });

        // Función para escapar HTML
        function escapeHtml(text) {
            if (!text) return "";
            var map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return String(text).replace(/[&<>"']/g, function (m) { return map[m]; });
        }

        // Inicializar variables
        window.precioBaseViaje = 0;
        window.adicionalesSeleccionados = [];

        // Submit del formulario
        $('#formPresupuesto').on('submit', function (e) {
            e.preventDefault();

            var dniCliente = $('#txtDniCliente').val().trim().replace(/\./g, '');
            var nombreCliente = $('#txtNombreCliente').val().trim();
            var viajeId = $('#ddlViaje').val();
            var montoPactado = parseFloat($('#txtMontoPactado').val());
            var observaciones = $('#txtObservaciones').val();

            // Validar que se haya seleccionado un cliente o ingresado DNI/nombre manualmente
            if (!dniCliente && !nombreCliente) {
                mostrarResultado('Debe buscar y seleccionar un cliente o ingresar al menos el nombre del cliente manualmente.', 'danger');
                $('#txt-busqueda-cliente').focus();
                return;
            }

            // Si hay DNI, validar formato
            if (dniCliente && dniCliente.length < 7) {
                mostrarResultado('El DNI del cliente debe tener al menos 7 dígitos.', 'danger');
                $('#txt-busqueda-cliente').focus();
                return;
            }

            if (!montoPactado || montoPactado <= 0) {
                mostrarResultado('El monto debe ser mayor a cero.', 'danger');
                $('#txtMontoPactado').focus();
                return;
            }

            // Deshabilitar botón
            var $btn = $('#btnGenerarCodigo');
            var originalHtml = $btn.html();
            $btn.prop('disabled', true).html('<i class="bi bi-hourglass-split"></i><span>Generando...</span>');

            $.ajax({
                url: '@Url.Action("CreatePresupuesto", "Presupuesto")',
                type: 'POST',
                data: {
                    dniCliente: dniCliente,
                    viajeId: viajeId || null,
                    montoPactado: montoPactado,
                    observaciones: observaciones
                },
                success: function (response) {
                    if (response.success) {
                        // Actualizar código en la previsualización
                        $('#lblCodigoSeguimiento').text(response.codigoSeguimiento);
                        $('#lblNumeroTicket').text('#' + response.codigoSeguimiento.split('-').pop());
                        
                        mostrarResultado(
                            '¡Presupuesto generado exitosamente! El codigo de seguimiento ha sido enviado al cliente.',
                            'success'
                        );
                        
                        // Scroll suave al resultado
                        $('html, body').animate({
                            scrollTop: $('#divResultado').offset().top - 100
                        }, 500);
                    } else {
                        mostrarResultado(response.message || 'Error al generar el presupuesto. Por favor, intente nuevamente.', 'danger');
                    }
                },
                error: function (xhr) {
                    var errorMsg = 'Error al generar el presupuesto. Por favor, intente nuevamente.';
                    if (xhr.responseJSON && xhr.responseJSON.message) {
                        errorMsg = xhr.responseJSON.message;
                    }
                    mostrarResultado(errorMsg, 'danger');
                },
                complete: function () {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
        });
    });

    function mostrarResultado(mensaje, tipo) {
        var $div = $('#divResultado');
        var $msg = $('#msgResultado');
        var $title = $('#titleResultado');
        var $icon = $('#iconResultado');
        
        // Remover todas las clases de alert
        $div.removeClass('alert-success alert-danger alert-warning alert-info')
            .addClass('alert-' + tipo);
        
        // Configurar icono y título según el tipo
        var config = {
            'success': {
                icon: 'bi-check-circle-fill',
                title: '¡Éxito!',
                color: '#10b981'
            },
            'danger': {
                icon: 'bi-exclamation-triangle-fill',
                title: 'Error',
                color: '#ef4444'
            },
            'warning': {
                icon: 'bi-exclamation-circle-fill',
                title: 'Advertencia',
                color: '#f59e0b'
            },
            'info': {
                icon: 'bi-info-circle-fill',
                title: 'Información',
                color: '#3b82f6'
            }
        };
        
        var tipoConfig = config[tipo] || config['info'];
        
        $icon.removeClass().addClass('bi ' + tipoConfig.icon).css('color', tipoConfig.color);
        $title.text(tipoConfig.title);
        $msg.html(mensaje);
        
        $div.fadeIn();
        
        // Auto-ocultar después de 5 segundos si es éxito
        if (tipo === 'success') {
            setTimeout(function() {
                $div.fadeOut();
            }, 5000);
        }
    }
</script>
