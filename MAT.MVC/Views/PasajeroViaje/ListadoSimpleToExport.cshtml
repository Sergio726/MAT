@model List<MAT.MVC.Models.PasajeroViajeModel>

@using MAT.Enums
@using MAT.Entities
@using MAT.Services
@using MAT.Utilities
@using System.Linq
@functions {
    string SexoLetra(int? sexo)
    {
        if (!sexo.HasValue || !Enum.IsDefined(typeof(eSexo), sexo.Value)) { return ""; }
        return sexo.Value == (int)eSexo.Masculino ? "M" : sexo.Value == (int)eSexo.Femenino ? "F" : "";
    }
}
@{
    ViewBag.Title = "Listado para exportación";
    int numeracion = 1;
}

@section Styles {
    <link href="~/Content/mat.listadosimple.css" rel="stylesheet" />
    <link href="~/Content/mat.listadosimple.print.css" rel="stylesheet" media="print" />
}

<div id="divContent" class="listado-simple Content listado-export-modelo">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-warning m-3" role="alert">@ViewBag.Error</div>
    }
    @if (Model != null && Model.Any())
    {
        var viajeService = new ViajeService();
        var viajeId = new Guid(Model.First().ViajeID);
        var viaje = viajeService.GetByViajeId(viajeId);

        <div id="divEncabezadoViaje" class="listado-simple-header EncabezadoViaje headMAT">
            <div class="viaje-info">
                <div class="viaje-titulo">@viaje.Descripcion</div>
                <div class="viaje-fechas">
                    <span><strong>Salida:</strong> @viaje.FechaSalida.Value.ToShortDateString()</span>
                    <span class="fecha-separador">|</span>
                    <span><strong>Regreso:</strong> @viaje.FechaRegreso.Value.ToShortDateString()</span>
                </div>
            </div>
        </div>

        <div class="toolbar HideToPrint">
            <span class="total-pasajeros">Total: <strong>@Model.Count</strong> pasajeros (formato MODELO)</span>
            <a href="@Url.Action("ExportListadoPasajerosExcel", "PasajeroViaje", new { id = viajeId })" class="btn-print btn-excel" role="button">
                <i class="bi bi-file-earmark-excel"></i>
                Descargar Excel
            </a>
            <button type="button" class="btn-print" onclick="window.print();">
                <i class="bi bi-printer-fill"></i>
                Imprimir
            </button>
        </div>

        <div id="tablaPasajeros" class="backMAT">
            <div class="listado-pantalla">
                <table class="tabla listado-simple-tabla listado-tabla-modelo" style="width: 100%;">
                    <thead>
                        <tr>
                            <td class="celda">N</td>
                            <td class="celda">APELLIDO</td>
                            <td class="celda">NOMBRES</td>
                            <td class="celda">TIPO DE DOCUMENTO</td>
                            <td class="celda">N° DE DOCUMENTO</td>
                            <td class="celda">FECHA DE NAC.</td>
                            <td class="celda">SEXO</td>
                            <td class="celda">MENOR</td>
                            <td class="celda">NACIONALIDAD</td>
                            <td class="celda">TRIPULANTE</td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.EsMenorVinculado ? "tr-row-menor-vinculado" : null)">
                                <td class="celda">@numeracion</td>
                                <td class="celda">@((item.Apellido ?? "").ToUpper())</td>
                                <td class="celda">@((item.Nombre ?? "").ToUpper())</td>
                                <td class="celda">@(Enum.IsDefined(typeof(eTipoDocumento), item.TipoDocumento) ? ((eTipoDocumento)item.TipoDocumento).GetDescription() : item.TipoDocumento.ToString())</td>
                                <td class="celda">@(item.NroDocumento != null ? item.NroDocumento.Replace(".", "") : "")</td>
                                <td class="celda">
                                    @if (!string.IsNullOrWhiteSpace(item.FechaNacimiento))
                                    {
                                        @Html.Label(item.FechaNacimiento)
                                    }
                                </td>
                                <td class="celda">@SexoLetra(item.Sexo)</td>
                                <td class="celda">@(item.EsMenorVinculado ? 1 : 0)</td>
                                <td class="celda">@(item.Nacionalidad ?? "")</td>
                                <td class="celda"></td>
                            </tr>
                            numeracion += 1;
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <p class="px-3 py-2">No hay pasajeros para este viaje.</p>
    }
</div>
