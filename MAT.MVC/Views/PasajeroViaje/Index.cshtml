@model List<MAT.MVC.Models.PasajeroViaje>
@using MAT.Enums
@using MAT.Utilities 
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">Lista - Pasajeros</h2>


<table class="mat-customtable">
    <thead>
    <tr>
        
        <th>
            Apellido
        </th>
        <th>
            Nombre
        </th>
        <th>
            Tipo Documento
        </th>
        <th>
            Nro Documento
        </th>
        <th>
            Telefono
        </th>
        <th>
            Email
        </th>
        <th>
            Fecha Nacimiento
        </th>
        <th>
            Sexo
        </th>
        
        
        <th></th>
    </tr>
</thead>
    <tbody>
@foreach (var item in Model) {
    <tr>
        
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroApellido)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroNombre)
        </td>
        <td>
            @((eTipoDocumento)(Convert.ToInt32(item.PasajeroTipoDocumento)))
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroDocumento)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroTelefono)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroEmail)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroFechaNacimiento)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.PasajeroSexo)
        </td>
                
    </tr>
}

</table>
</tbody>
@if (Model.Count > 0)
{
<p class="botonera-form">
         @Html.ActionLink("Imprimir Manifiesto", "Manifiesto", new { id = Model.First().ViajeID }, new {@class="btn btn-inverse btn-small"})
        @Html.ActionLink("Imprimir CNRT", "CNRT", new { id = Model.First().ViajeID }, new {@class="btn btn-inverse btn-small"})
</p>    
}
