@model List<MAT.MVC.Models.PasajeroViaje>
@using MAT.Enums
@using MAT.Utilities 
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-list-ul"></i>
            <span>Lista de Pasajeros</span>
        </h2>
        @if (Model.Count > 0)
        {
            <div class="modern-page-actions">
                <a href="/PasajeroViaje/Manifiesto/@Model.First().ViajeID" class="btn-modern btn-modern-secondary" target="_blank">
                    <i class="bi bi-printer"></i>
                    <span>Imprimir Manifiesto</span>
                </a>
                <a href="/PasajeroViaje/CNRT/@Model.First().ViajeID" class="btn-modern btn-modern-secondary" target="_blank">
                    <i class="bi bi-file-pdf"></i>
                    <span>Imprimir CNRT</span>
                </a>
            </div>
        }
    </div>

    <div class="modern-table-container">
        <table class="modern-table" id="tblPasajerosViaje">
            <thead>
                <tr>
                    <th>Apellido</th>
                    <th>Nombre</th>
                    <th>Tipo Documento</th>
                    <th>Nro. Documento</th>
                    <th>Teléfono</th>
                    <th>Email</th>
                    <th>Fecha Nacimiento</th>
                    <th>Sexo</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.PasajeroApellido</strong></td>
                        <td>@item.PasajeroNombre</td>
                        <td>@((eTipoDocumento)(Convert.ToInt32(item.PasajeroTipoDocumento)))</td>
                        <td>@item.PasajeroDocumento</td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.PasajeroTelefono))
                            {
                                <i class="bi bi-telephone"></i> @item.PasajeroTelefono
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (!string.IsNullOrEmpty(item.PasajeroEmail))
                            {
                                <i class="bi bi-envelope"></i> @item.PasajeroEmail
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>
                            @if (item.PasajeroFechaNacimiento.HasValue)
                            {
                                @item.PasajeroFechaNacimiento.Value.ToString("dd/MM/yyyy")
                            }
                            else
                            {
                                <span class="table-text-muted">-</span>
                            }
                        </td>
                        <td>@item.PasajeroSexo</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblPasajerosViaje").DataTable({
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ pasajeros",
                infoEmpty: "No hay pasajeros disponibles",
                infoFiltered: "(filtrado de _MAX_ pasajeros totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            }
        });
    });
</script>
