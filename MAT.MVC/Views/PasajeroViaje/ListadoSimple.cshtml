@model List<MAT.MVC.Models.PasajeroViajeModel>

@using MAT.Enums
@using MAT.Entities
@using MAT.Services
@{
    ViewBag.Title = "Lista de pasajeros";
    int numeracion = 1;
}

@section Styles {
    <link href="~/Content/mat.listadosimple.css" rel="stylesheet" />
    <link href="~/Content/mat.listadosimple.print.css" rel="stylesheet" media="print" />
}

<div id="divContent" class="listado-simple Content">
    <div id="divEncabezadoViaje" class="listado-simple-header EncabezadoViaje headMAT">
        @{
            var viajeService = new ViajeService();
            var viajeId = new Guid(Model.First().ViajeID);
            var viaje = viajeService.GetByViajeId(viajeId);
        }
        <div class="viaje-info">
            <div class="viaje-titulo">@viaje.Descripcion</div>
            <div class="viaje-fechas">
                <span><strong>Salida:</strong> @viaje.FechaSalida.Value.ToShortDateString()</span>
                <span class="fecha-separador">|</span>
                <span><strong>Regreso:</strong> @viaje.FechaRegreso.Value.ToShortDateString()</span>
            </div>
        </div>
        <div class="viaje-logo">
            <img src="/Images/marco_antonio_back3.png" alt="Marco Antonio Turismo" />
        </div>
    </div>

    <div class="toolbar HideToPrint">
        <span class="total-pasajeros">Total: <strong>@Model.Count</strong> pasajeros</span>
        <button type="button" class="btn-print" onclick="printListado();">
            <i class="bi bi-printer-fill"></i>
            Imprimir Listado
        </button>
    </div>

    <div id="tablaPasajeros" class="backMAT">
        <div class="listado-pantalla">
            <table class="tabla listado-simple-tabla">
                <thead>
                    <tr>
                        <td class="celda column_nro">N° <input type="checkbox" checked class="chkIsPrint" column="column_nro" title="Incluir esta columna en la impresión." /></td>
                        <td class="celda column_apellido_nombre">APELLIDO Y NOMBRE <input type="checkbox" checked class="chkIsPrint" column="column_apellido_nombre" title="Incluir esta columna en la impresión." /></td>
                        <td class="celda column_tipo_doc">TIPO Y N° DOC <input type="checkbox" checked class="chkIsPrint" column="column_tipo_doc" title="Incluir esta columna en la impresión." /></td>
                        <td class="celda column_cuit_cuil">CUIT/CUIL <input type="checkbox" checked class="chkIsPrint" column="column_cuit_cuil" title="Incluir esta columna en la impresión." /></td>
                        <td class="celda column_fecha_nac">FECHA NAC. <input type="checkbox" checked class="chkIsPrint" column="column_fecha_nac" title="Incluir esta columna en la impresión." /></td>
                        <td class="celda column_telefono">TELEFONO <input type="checkbox" checked class="chkIsPrint" column="column_telefono" title="Incluir esta columna en la impresión." /></td>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="celda column_nro">@numeracion</td>
                            <td class="celda column_apellido_nombre">@item.Apellido @item.Nombre</td>
                            <td class="celda column_tipo_doc">@((eTipoDocumento)item.TipoDocumento) @item.NroDocumento.ToString()</td>
                            <td class="celda column_cuit_cuil">@item.CUIT</td>
                            <td class="celda column_fecha_nac">
                                @if (item.FechaNacimiento != null)
                                {
                                    @Html.Label(item.FechaNacimiento)
                                }
                            </td>
                            <td class="celda column_telefono">@item.Telefono.ToString()</td>
                        </tr>
                        numeracion += 1;
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
<script type="text/javascript">
    function printListado() {
        $("input[type='checkbox'].chkIsPrint").each(function () {
            var column = $(this).attr("column");
            if ($(this).is(":checked")) {
                $("." + column).removeClass("HideToPrint");
            } else {
                $("." + column).addClass("HideToPrint");
            }
        });
        window.print();
    }
</script>
}
