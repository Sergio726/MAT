@model List<MAT.Entities.PasajeroViaje>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "CNRT";
    int numeracion = 1;
}
<link rel="STYLESHEET" type="text/css" href="~/Content/mat.cnrt.css">
<link rel="STYLESHEET" type="text/css" href="~/Content/mat.cnrt.print.css" media="print">

<div style="display:flex; ">
    <table style="margin-right:55px;line-height: 0.7cm;">
    <thead class="Encabezado">
        <tr>
            <th  style="width:45px;">N°</th>
            <th  style="width:330px;">Apellido y Nombre</th>
            <th style="padding-left:30px;">DNI</th>
        </tr>
    </thead>
    <tbody>
        @for (int i = 0; i < 51; i++)
        {
            if ((i + 1)> Model.Count)
            {
                break;
            }
            var item = Model[i];
            <tr>
                <td style="width:45px;">
                    @(i + 1)
                </td>
                <td style="width:330px;width:110px;">
                    @{string sFullName = item.Apellido+ ", " + item.Nombre;}
                    @if (sFullName.Length < 30)
	                {
		               @sFullName;
	                }
                    else
                    {
                        @(sFullName.Substring(0,29) + ".");
                    }
                </td>
                <td style="padding-left:30px;width:110px;">
                    @item.NroDocumento.ToString()
                </td>
            </tr>
        }
        
    </tbody>
</table>


