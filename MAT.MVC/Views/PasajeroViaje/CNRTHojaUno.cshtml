<div style="line-height:33px;padding-top:2px;">
	<h1 style="padding-bottom: 0px;margin-bottom: 0px;padding-top: 0px;">SERVICIO DE TRANSPORTE AUTOMOTOR DE PASAJEROS PARA EL TURISMO</h1>
    <div style="margin-left:44px;padding-top:3px;">
        <div class="cols" style="width:475px;">
            <label>Empresa de Transporte: </label><input type="text" id="nombre_empresa" class="input" placeholder="Ingrese Empresa de Transporte" style="padding-left:10px;width:280px;" />
        </div>
        <div class="cols">
            <label>CUIT:</label><input type="text" id="cuit_empresa" class="input custom_width_200px" placeholder="Ingrese CUIT de la Empresa" style="margin-left:17px;" />
        </div>
    </div>
    
   
    <div style="margin-left:44px;padding-top:4px;">
        <div class="cols" style="width:475px;">
    	    <label>Domicilio: </label>
            <input type="text" id="domicilio_empresa" class="input custom_width_215px" placeholder="Ingrese Domicilio de la Empresa" />
        </div>
        <div class="cols">
    	    <label>Inscripcion Reg. Nac.: </label>
            <input type="text" id="inscripcion_empresa" class="input custom_width_95px" placeholder="Reg. Nac." style="margin-left: 30px;padding-left: 10px;" />
        </div>
    </div>
   
    <h2 style="margin-bottom: 0px;padding-bottom: 10px;";">CONTRATANTE</h2>
    <div style="margin-left:44px;padding-top:1px;">
        <div class="cols" style="width:475px;">
            <label>Contratante: </label>
            <input type="text" id="nombre_contratante" class="input" placeholder="Ingrese Nombre de Contratante" style="margin-left: 4px; width:340px;" />
        </div>
            <div class="cols ">
            <label>CUIT: </label>
            <input type="text" id="cuit_contratante" class="input custom_width_196px" placeholder="Ingrese CUIT de Contratante"  style="margin-left: 5px;padding-left: 15px;"/>
        </div>
    </div>
    
    <div style="margin-left:44px;padding-top:6px;">
        <div class="cols" style="width:475px;">
            <label>Domicilio: </label>
            <input type="text" id="domicilio_contratante" class="input " placeholder="Ingrese Domicilio de Contratante" style="width:365px;" />
        </div>
        <div class="cols ">
            <label>Legajo: </label>
            <input type="text" id="legajo_contratante" class="input custom_width_185px" placeholder="Leg. del Contratante" style="margin-left: 10px;padding-left: 15px;" />
        </div>
    </div>
    
	<h2 style="margin-bottom: 24px;">DATOS DEL VIAJE</h2>

    <div style="margin-left:44px;">
        <div class="cols" style="width:249px;">
    	    <label>Origen: </label>
            <input type="text" id="origen_viaje" class="input" placeholder="Ingrese Origen del Viaje" />
        </div>
        <div class="cols" style="width:222px;">
    	    <label>Destino: </label>
            <input type="text" id="destino_viaje" class="input" placeholder="Destino del Viaje" style="width: 145px;padding-left: 20px;margin-left:5px;" />
        </div>
        <div class="cols">
    	    <label>Hora: </label>
            <input type="text" id="hora_viaje" class="input" placeholder="Ingrese Hora del Viaje" style="padding-left: 15px;margin-left:15px;" />
        </div>
    </div>
    
    <div style="margin-left:44px;">
        <div class="cols" style="width:475px;">
    	    <label>Clase: </label>
            <input type="text" id="clase_viaje" class="input" placeholder="Ingrese Clase del Viaje" style="width:400px;" />
        </div>
        <div class="cols col_33">
    	    <label>KM: </label>
            <input type="text" id="km_viaje" class="input" placeholder="Ingrese KM del Viaje" style="margin-left: 8px;margin-left:15px; padding-left:10px;" />
        </div>
    </div>    
    
    
    <div style="margin-left:44px;">
         <div class="cols" style="width:249px;">
    	    <label>Fecha de Inicio: </label>
            <input type="text" id="inicio_viaje" class="input" placeholder="Inicio del Viaje" style="width:125px; margin-left:10px;" />
        </div>
        <div class="cols" style="width:216px;">
    	    <label>Fecha Fin: </label>
            <input type="text" id="fin_viaje" class="input" placeholder="Fin del Viaje" style="width:130px;margin-left:12px;padding-left: 17px;" />
        </div>
    </div>    
    
   
    
    
    <h2 style="margin-bottom: 9px;">CONTENIDO DE LA PROGRAMACION TURISTICA</h2>
    <div style="margin-left:44px;">
        <div class="cols" style="width:625px;">
            <textarea id="contenido_prog_turistica" class="textarea" rows="6" style="line-height: 30px;margin: 0px;max-width: 684px;min-width: 684px;min-height: 100px;max-height: 100px;" placeholder="INGRESE CONTENIDO DE LA PROGRAMACION"></textarea>
        </div>
    </div>
    
 
