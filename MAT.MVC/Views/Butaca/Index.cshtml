@*@model IEnumerable<MAT.Entities.Butaca>*@
@model PagedList.IPagedList<MAT.Entities.Butaca>
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @ViewBag.Error
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["Error"]
        </div>
    }
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-grid-3x3-gap"></i>
            <span>Butacas</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/Butaca/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Butaca</span>
            </a>
        </div>
    </div>

    @using (Html.BeginForm(null, null, FormMethod.Get, new { @class = "modern-form-container", style = "margin-bottom: 1.5rem; padding: 1.5rem;" }))
    {
        <div style="display: flex; gap: 1rem; align-items: center; flex-wrap: wrap;">
            <label style="font-weight: 600; margin: 0;">Coche:</label>
            @Html.DropDownList("SearchString", Helper.ToSelectEntities("Transporte"), new { @class = "modern-form-select", style = "width: auto; min-width: 200px;" })
            <button type="submit" class="btn-modern btn-modern-secondary">
                <i class="bi bi-funnel"></i>
                <span>Filtrar</span>
            </button>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table" id="tblButacas">
            <thead>
                <tr>
                    <th>Nro. Butaca</th>
                    <th>Piso</th>
                    <th>Ubicación</th>
                    <th>Tipo</th>
                    <th>Coche</th>
                    <th>Fila</th>
                    <th>Posición</th>
                    <th>Código</th>
                    <th style="width: 120px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong style="color: var(--brand-primary);">@item.NroButaca</strong>
                        </td>
                        <td>@((ePisoButaca)item.Piso)</td>
                        <td>@((eUbicacionButaca)item.Ubicacion)</td>
                        <td>@((eTipoButaca)item.Tipo)</td>
                        <td>
                            <span class="badge-pasajero">
                                <i class="bi bi-bus-front"></i>
                                <span>@Helper.ToSelectItem("Transporte", item.TransporteId.ToString())</span>
                            </span>
                        </td>
                        <td>@item.Fila</td>
                        <td>@item.Posicion</td>
                        <td><code>@item.CodigoButaca</code></td>
                        <td>
                            <div class="table-actions">
                                <a href="/Butaca/Edit/@item.ButacaId" class="btn-action btn-action-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="/Butaca/Details/@item.ButacaId" class="btn-action btn-action-view" title="Ver Detalles">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a href="/Butaca/Delete/@item.ButacaId" class="btn-action btn-action-delete" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblButacas").DataTable({
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ butacas",
                infoEmpty: "No hay butacas disponibles",
                infoFiltered: "(filtrado de _MAX_ butacas totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },
            columnDefs: [
                { orderable: false, targets: 8 }
            ]
        });
    });
</script>
