@model MAT.MVC.Models.Comprobante

<div class="comprobante-detail-container">
    <div class="comprobante-detail-grid">
        <div class="comprobante-detail-item">
            <div class="comprobante-detail-label">
                <i class="bi bi-calendar3"></i>
                Fecha
            </div>
            <div class="comprobante-detail-value">@Model.Movimiento.FechaRegistro.Value.Date.ToShortDateString()</div>
        </div>

        <div class="comprobante-detail-item">
            <div class="comprobante-detail-label">
                <i class="bi bi-clock"></i>
                Hora
            </div>
            <div class="comprobante-detail-value">@string.Format("{0:00}:{1:00}", Model.Movimiento.FechaRegistro.Value.TimeOfDay.Hours, Model.Movimiento.FechaRegistro.Value.TimeOfDay.Minutes)</div>
        </div>

        <div class="comprobante-detail-item">
            <div class="comprobante-detail-label">
                <i class="bi bi-file-earmark"></i>
                Tipo de Comprobante
            </div>
            <div class="comprobante-detail-value">@Model.TipoComprobante</div>
        </div>

        @if (!Model.Movimiento.PagoId.HasValue && !Model.Movimiento.NotaId.HasValue)
        {
            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-hash"></i>
                    N° Factura
                </div>
                <div class="comprobante-detail-value">@Model.Factura.NroFactura</div>
            </div>

            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-cash"></i>
                    Importe
                </div>
                <div class="comprobante-detail-value monto">@string.Format("{0:C}", Model.Factura.Monto)</div>
            </div>
        }
        else if (Model.Movimiento.PagoId.HasValue)
        {
            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-receipt"></i>
                    N° Recibo
                </div>
                <div class="comprobante-detail-value">@Model.Pago.NroRecibo</div>
            </div>

            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-cash"></i>
                    Importe
                </div>
                <div class="comprobante-detail-value monto">@string.Format("{0:C}", Model.Pago.Monto)</div>
            </div>
        }
        else if (Model.Movimiento.NotaId.HasValue)
        {
            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-credit-card"></i>
                    N° Nota
                </div>
                <div class="comprobante-detail-value">@Model.Nota.NroNota</div>
            </div>

            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-cash"></i>
                    Importe
                </div>
                <div class="comprobante-detail-value monto">@string.Format("{0:C}", Model.Nota.MontoNota)</div>
            </div>

            <div class="comprobante-detail-item">
                <div class="comprobante-detail-label">
                    <i class="bi bi-dash-circle"></i>
                    Monto Retenido
                </div>
                <div class="comprobante-detail-value retencion">@string.Format("{0:C}", Model.Nota.MontoRetencion)</div>
            </div>
        }

        <div class="comprobante-detail-item">
            <div class="comprobante-detail-label">
                <i class="bi bi-person-badge"></i>
                Vendedor de Transacción
            </div>
            <div class="comprobante-detail-value">@Model.Vendedor</div>
        </div>
    </div>
</div>
