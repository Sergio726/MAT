@using MAT.MVC.Infrastructure
@{
    var frequentActions = QuickAccessCatalog.GetFrequentActions();
}
@* Accesos frecuentes del inicio: una fila de chips arriba de todo (bloque B del plan del panel principal).
   Antes eran tarjetas altas al pie, a dos scrolls. Las altas (EsAccion) se distinguen de la navegación.
   El resto de los módulos se encuentra con el buscador global (bloque F). *@
<section class="home-card home-accesos" aria-labelledby="qa-titulo">
    <div class="home-card__head">
        <h2 class="home-card__title" id="qa-titulo">
            <i class="bi bi-lightning-charge" aria-hidden="true"></i>
            <span>Accesos frecuentes</span>
        </h2>
        @* Bloque F: el acordeón "Todos los módulos" se reemplaza por el buscador, que con el campo vacío lista
           todos los módulos (incluidos los que no están en el menú lateral: Todos los viajes, Paquetes,
           Notas de crédito, Historial de pagos) *@
        <button type="button" class="home-card__link" onclick="if (window.MatBuscador) { MatBuscador.abrir(); }" aria-keyshortcuts="Control+K">
            <i class="bi bi-search" aria-hidden="true"></i>
            <span>Buscar módulo</span>
            <kbd class="home-card__atajo" aria-hidden="true">Ctrl K</kbd>
        </button>
    </div>

    <div class="qa-fila">
        @foreach (var action in frequentActions)
        {
            <a href="@action.Url" class="qa-chip @(action.EsAccion ? "qa-chip--accion" : "qa-chip--navegacion")" title="@action.Description">
                <i class="bi @action.Icon" aria-hidden="true"></i>
                <span>@action.Title</span>
            </a>
        }
    </div>
</section>
