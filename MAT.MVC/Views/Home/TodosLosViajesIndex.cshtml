@model IEnumerable<SelectListItem>

@{
    ViewBag.Title = "Todos los Viajes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="todos-viajes-filtros-section" aria-label="Filtros y búsqueda de viajes">
    <div class="todos-viajes-header">
        <div class="todos-viajes-toolbar">
            <div class="todos-viajes-search-box">
                <label for="viajes-search" class="visually-hidden">Buscar viajes</label>
                <span class="todos-viajes-search-icon-wrap" aria-hidden="true">
                    <i class="bi bi-search todos-viajes-search-icon"></i>
                </span>
                <input type="text"
                       id="viajes-search"
                       class="todos-viajes-search-input"
                       placeholder="Buscar por paquete, destino, descripción o fecha..."
                       autocomplete="off" />
                <button type="button" class="todos-viajes-search-clear" id="viajes-search-clear" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" style="display: none;">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
            <div class="todos-viajes-year-wrap">
                <label for="dropyear">Año</label>
                @Html.DropDownList("dropyear", Model, new { @id = "dropyear", @class = "todos-viajes-year-select" })
            </div>
        </div>
        <div class="todos-viajes-info-msg" id="viajes-search-hint" role="status">
            <i class="bi bi-info-circle-fill"></i>
            <span>Escriba para filtrar por el texto de cada tarjeta. No se realizan nuevas cargas.</span>
        </div>
    </div>
</section>

<div id="viajes-item" class="todos-viajes-content"></div>

<div id="viajes-sin-resultados" class="todos-viajes-sin-resultados" style="display: none;">
    <i class="bi bi-search"></i>
    <p>No hay viajes que coincidan con "<strong id="viajes-query-text"></strong>".</p>
    <p class="todos-viajes-sin-resultados-hint">Pruebe con otras palabras o limpie el buscador.</p>
</div>

<script type="text/javascript">
    $(function () {
        var $search = $("#viajes-search");
        var $clear = $("#viajes-search-clear");
        var $sinResultados = $("#viajes-sin-resultados");
        var $queryText = $("#viajes-query-text");

        function escapeRegex(s) {
            return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function removeHighlightsFromCards() {
            $("#viajes-item .viaje-search-highlight").each(function () {
                var $this = $(this);
                $this.replaceWith($this.text());
            });
        }

        function highlightMatchesInCard($card, q) {
            if (!q || q.length < 2) return;
            var pattern = "(" + escapeRegex(q) + ")";
            function process($el) {
                var contents = $el.contents().toArray();
                for (var i = 0; i < contents.length; i++) {
                    var node = contents[i];
                    if (node.nodeType === 3) {
                        var text = node.textContent;
                        if (text && text.toLowerCase().indexOf(q) !== -1) {
                            var regex = new RegExp(pattern, "gi");
                            var span = $('<span>').html(text.replace(regex, '<span class="viaje-search-highlight">$1</span>'));
                            $(node).replaceWith(span.contents());
                        }
                    } else if (node.nodeType === 1 && !$(node).hasClass("viaje-search-highlight")) {
                        process($(node));
                    }
                }
            }
            $card.find(".viaje-container").each(function () { process($(this)); });
        }

        function loadViajes() {
            var idselected = $("#dropyear option:selected").val();
            var url = "/Home/TodosLosViajes?yearfilter=" + idselected;
            $("#viajes-item").load(url, function () {
                applyViajesFilter();
            });
        }

        function getViajesList() {
            return $("#viajes-item").find("ul.viajes-lista");
        }

        function applyViajesFilter() {
            var q = $search.val().trim().toLowerCase();
            var $container = $("#viajes-item");
            var $ul = getViajesList();
            if (!$ul.length) {
                $sinResultados.hide();
                return;
            }

            var $wrapper = $ul.parent();
            var isWrapped = $wrapper.hasClass("simplePagerContainer");
            var $pager = $container.find("ul.simplePagerNav");

            if (q === "") {
                removeHighlightsFromCards();
                $sinResultados.hide();
                $ul.find("li").show();
                if (isWrapped) {
                    $ul.unwrap();
                    $pager.remove();
                }
                $ul.quickPagination({ pageSize: 4 });
                return;
            }

            removeHighlightsFromCards();
            var visibleCount = 0;
            $ul.find("li").each(function () {
                var $li = $(this);
                var text = $li.text().toLowerCase();
                var match = text.indexOf(q) !== -1;
                $li.toggle(match);
                if (match) {
                    visibleCount++;
                    highlightMatchesInCard($li, q);
                }
            });

            if (isWrapped) {
                $ul.unwrap();
                $pager.remove();
            }

            if (visibleCount === 0) {
                $queryText.text($search.val().trim());
                $sinResultados.show();
            } else {
                $sinResultados.hide();
            }
        }

        loadViajes();

        $("#dropyear").on("change", function () {
            $search.val("");
            $clear.hide();
            loadViajes();
        });

        $search.on("input", function () {
            var v = $(this).val().trim();
            $clear.toggle(v.length > 0);
            applyViajesFilter();
        });

        $clear.on("click", function () {
            $search.val("").focus();
            $clear.hide();
            applyViajesFilter();
        });

        $search.on("keydown", function (e) {
            if (e.key === "Escape") {
                $search.val("");
                $clear.hide();
                applyViajesFilter();
                $search.blur();
            }
        });
    });
</script>
