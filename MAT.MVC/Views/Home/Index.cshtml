@{
    Response.ContentType = "text/html; charset=utf-8";
    Response.Charset = "utf-8";
    ViewBag.Title = "Panel Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var estadisticas = ViewBag.Estadisticas as Dictionary<string, object> ?? new Dictionary<string, object>();
    var cantidadPresupuestos = estadisticas.ContainsKey("CantidadPresupuestos") ? Convert.ToInt32(estadisticas["CantidadPresupuestos"]) : 0;
    var totalPresupuestos = estadisticas.ContainsKey("TotalPresupuestos") ? Convert.ToDouble(estadisticas["TotalPresupuestos"]) : 0.0;
    var clientesNuevos = estadisticas.ContainsKey("ClientesNuevos") ? Convert.ToInt32(estadisticas["ClientesNuevos"]) : 0;
    var totalFacturado = estadisticas.ContainsKey("TotalFacturado") ? Convert.ToDouble(estadisticas["TotalFacturado"]) : 0.0;
    var totalPendiente = estadisticas.ContainsKey("TotalPendiente") ? Convert.ToDouble(estadisticas["TotalPendiente"]) : 0.0;
    var cantidadVentas = estadisticas.ContainsKey("CantidadVentas") ? Convert.ToInt32(estadisticas["CantidadVentas"]) : 0;
    var isAdmin = ViewBag.IsAdmin ?? false;

    var ci = new System.Globalization.CultureInfo("es-AR");
    var mesActual = ci.DateTimeFormat.GetMonthName(DateTime.Now.Month);
    mesActual = char.ToUpper(mesActual[0]) + mesActual.Substring(1);
    var anioActual = DateTime.Now.Year;

    var hora = DateTime.Now.Hour;
    var saludo = hora < 12 ? "Buenos días" : hora < 20 ? "Buenas tardes" : "Buenas noches";
    var fechaRaw = DateTime.Now.ToString("dddd d 'de' MMMM 'de' yyyy", ci);
    var fechaFormateada = char.ToUpper(fechaRaw[0]) + fechaRaw.Substring(1);

    var totalCobrado = totalFacturado - totalPendiente;
    var porcentajeCobrado = totalFacturado > 0 ? (int)Math.Round(totalCobrado / totalFacturado * 100) : 0;
}

<div class="modern-dashboard">
    <div class="container-fluid">

        <div class="dashboard-welcome">
            <div class="dashboard-welcome-text">
                <h2 class="dashboard-welcome-title">@saludo, @User.Identity.Name</h2>
                <p class="dashboard-welcome-subtitle">@fechaFormateada</p>
            </div>
            @if ((bool)isAdmin)
            {
                <span class="dashboard-role-badge">
                    <i class="bi bi-shield-check me-1"></i> Administrador
                </span>
            }
        </div>

        <p class="section-label">Resumen de @mesActual @anioActual</p>

        <div class="row g-4 mb-4">
            <div class="col-lg-4 col-md-6">
                <div class="modern-card modern-card-success dashboard-stat-card" onclick="openDetalleModal('presupuestos')" title="Ver detalle de presupuestos del mes">
                    <div class="modern-card-header">
                        <div>
                            <div class="modern-card-title">Presupuestos</div>
                            <span class="kpi-month-chip">@mesActual @anioActual</span>
                        </div>
                        <i class="bi bi-file-earmark-text modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@cantidadPresupuestos</div>
                        <p class="modern-stat-label">Realizados en @mesActual</p>
                        <p class="modern-stat-label mt-1">
                            <span class="stat-amount-primary">Total: $@totalPresupuestos.ToString("N2")</span>
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-6">
                <div class="modern-card modern-card-warning dashboard-stat-card" onclick="openDetalleModal('clientes')" title="Ver detalle de clientes nuevos del mes">
                    <div class="modern-card-header">
                        <div>
                            <div class="modern-card-title">Clientes Nuevos</div>
                            <span class="kpi-month-chip">@mesActual @anioActual</span>
                        </div>
                        <i class="bi bi-people modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@clientesNuevos</div>
                        <p class="modern-stat-label">Dados de alta en @mesActual</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 col-md-12">
                <div class="modern-card modern-card-info dashboard-stat-card" onclick="openDetalleModal('ventas')" title="Ver detalle de ventas del mes">
                    <div class="modern-card-header">
                        <div>
                            <div class="modern-card-title">Ventas Realizadas</div>
                            <span class="kpi-month-chip">@mesActual @anioActual</span>
                        </div>
                        <i class="bi bi-cart-check modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@cantidadVentas</div>
                        <div class="kpi-amounts-row">
                            <p class="modern-stat-label mb-0">
                                <span class="stat-amount-primary">Total: $@totalFacturado.ToString("N2")</span>
                            </p>
                            <p class="modern-stat-label mb-0">
                                <span class="stat-amount-danger">Pend: $@totalPendiente.ToString("N2")</span>
                            </p>
                        </div>
                        @if (totalFacturado > 0)
                        {
                            <div class="kpi-progress mt-2" title="@porcentajeCobrado% cobrado">
                                <div class="kpi-progress-bar" style="width: @porcentajeCobrado%"></div>
                            </div>
                            <p class="modern-stat-label mt-1">Cobrado: @porcentajeCobrado%</p>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="dashboardDetalleModal" tabindex="-1" aria-labelledby="dashboardDetalleModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-scrollable">
                <div class="modal-content modal-content-rounded">
                    <div class="modal-header modal-header-branded">
                        <h5 class="modal-title" id="dashboardDetalleModalLabel">Detalle</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                    </div>
                    <div class="modal-body modal-body-min" id="dashboardDetalleBody">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Cargando detalle...</p>
                        </div>
                    </div>
                    <div class="modal-footer border-0">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                            <i class="bi bi-x-lg me-1"></i> Cerrar
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="section-divider">
            <div class="section-divider-line"></div>
            <div class="section-divider-content">
                <h3 class="section-divider-title">
                    <i class="bi bi-grid-3x3-gap"></i>
                    Accesos Rápidos
                </h3>
                <span class="section-divider-badge" id="accessCountBadge">9</span>
            </div>
            <div class="section-divider-line"></div>
        </div>

        <div class="quick-access-grid">
            <div class="quick-access-item">
                <a href="/Presupuesto/Index" class="quick-access-link">
                    <div class="modern-card modern-card-success">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Módulo de Presupuestos</div>
                            <i class="bi bi-file-earmark-text modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Gestiona presupuestos telefónicos y cotizaciones.</p>
                            <span class="modern-card-link">Ir a presupuestos <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/Viaje/Index" class="quick-access-link">
                    <div class="modern-card modern-card-primary">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Gestión de Viajes</div>
                            <i class="bi bi-airplane modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Administra viajes, reservas y disponibilidad.</p>
                            <span class="modern-card-link">Ver gestión <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/Home/ViajesPorFecha" class="quick-access-link">
                    <div class="modern-card modern-card-warning">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Viajes por Fecha</div>
                            <i class="bi bi-calendar-event modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Consulta viajes disponibles por fecha específica.</p>
                            <span class="modern-card-link">Ver viajes <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/Home/TodosLosViajesIndex" class="quick-access-link">
                    <div class="modern-card modern-card-info">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Todos los Viajes</div>
                            <i class="bi bi-suitcase modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Visualiza todos los viajes disponibles en el sistema.</p>
                            <span class="modern-card-link">Ver todos <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/Paquete/Index" class="quick-access-link">
                    <div class="modern-card modern-card-success">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Gestión de Paquetes</div>
                            <i class="bi bi-box-seam modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Administra paquetes turísticos y sus configuraciones.</p>
                            <span class="modern-card-link">Ver paquetes <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/PersonaCliente/Index" class="quick-access-link">
                    <div class="modern-card modern-card-primary">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Clientes</div>
                            <i class="bi bi-people modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Ver el listado completo de clientes del sistema.</p>
                            <span class="modern-card-link">Ver clientes <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/Factura/Index" class="quick-access-link">
                    <div class="modern-card modern-card-warning">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Búsqueda de Facturas</div>
                            <i class="bi bi-receipt modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Consulta y gestiona facturas del sistema.</p>
                            <span class="modern-card-link">Ver facturas <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            <div class="quick-access-item">
                <a href="/PersonaCliente/NotaCreditoList" class="quick-access-link">
                    <div class="modern-card modern-card-info">
                        <div class="modern-card-header">
                            <div class="modern-card-title">Notas de Crédito</div>
                            <i class="bi bi-file-earmark-minus modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <p class="modern-card-description">Gestiona notas de crédito y devoluciones.</p>
                            <span class="modern-card-link">Ver notas <i class="bi bi-arrow-right ms-1"></i></span>
                        </div>
                    </div>
                </a>
            </div>

            @if (User.Identity.Name.ToUpper().Equals("ADMINDEV"))
            {
                <div class="quick-access-item">
                    <a href="/Home/HistorialPagos" class="quick-access-link">
                        <div class="modern-card modern-card-success">
                            <div class="modern-card-header">
                                <div class="modern-card-title">Historial de Pagos</div>
                                <i class="bi bi-clock-history modern-card-icon-small"></i>
                            </div>
                            <div class="modern-card-content">
                                <p class="modern-card-description">Consulta el historial completo de pagos.</p>
                                <span class="modern-card-link">Ver historial <i class="bi bi-arrow-right ms-1"></i></span>
                            </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    /* ===== Welcome Header ===== */
    .dashboard-welcome {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 1rem;
        padding: 1.25rem 1.5rem;
        background: linear-gradient(135deg, var(--surface-card, #fff) 0%, rgba(230, 51, 117, 0.04) 100%);
        border-radius: 12px;
        border: 1px solid var(--border-color, #e9ecef);
        margin-bottom: 1.5rem;
    }

    .dashboard-welcome-title {
        font-size: 1.4rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0 0 0.2rem 0;
        line-height: 1.2;
    }

    .dashboard-welcome-subtitle {
        font-size: 0.85rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .dashboard-role-badge {
        display: inline-flex;
        align-items: center;
        padding: 0.4rem 1rem;
        background: linear-gradient(135deg, var(--brand-primary) 0%, #c92a5f 100%);
        color: #fff;
        font-size: 0.8rem;
        font-weight: 600;
        border-radius: 50px;
        white-space: nowrap;
        box-shadow: 0 3px 10px rgba(230, 51, 117, 0.25);
    }

    /* ===== Section label ===== */
    .section-label {
        font-size: 0.75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        color: var(--text-secondary);
        margin-bottom: 0.75rem;
    }

    /* ===== KPI Cards ===== */
    .modern-stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--brand-primary);
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .modern-stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .kpi-month-chip {
        display: inline-flex;
        align-items: center;
        padding: 0.15rem 0.55rem;
        background: rgba(230, 51, 117, 0.1);
        color: var(--brand-primary);
        font-size: 0.68rem;
        font-weight: 600;
        border-radius: 50px;
        margin-top: 0.2rem;
    }

    .stat-amount-primary {
        color: var(--brand-primary);
        font-weight: 600;
    }

    .stat-amount-danger {
        color: #dc3545;
        font-weight: 600;
    }

    .kpi-amounts-row {
        display: flex;
        justify-content: space-between;
        gap: 1rem;
        margin-top: 0.25rem;
    }

    .kpi-progress {
        height: 6px;
        background: rgba(0, 0, 0, 0.08);
        border-radius: 3px;
        overflow: hidden;
    }

    .kpi-progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #198754, #20c997);
        border-radius: 3px;
        transition: width 0.6s ease;
    }

    .dashboard-stat-card {
        cursor: pointer;
        transition: all 0.3s ease;
    }

    .dashboard-stat-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    /* ===== Modal ===== */
    .modal-content-rounded {
        border-radius: 12px;
        border: none;
    }

    .modal-header-branded {
        background: linear-gradient(135deg, var(--brand-primary) 0%, #c92a5f 100%);
        color: white;
        border-radius: 12px 12px 0 0;
    }

    .modal-body-min {
        min-height: 200px;
    }

    .detalle-table {
        width: 100%;
        font-size: 0.85rem;
    }

    .detalle-table th {
        background-color: #f8f9fa;
        position: sticky;
        top: 0;
        z-index: 1;
        font-weight: 600;
        white-space: nowrap;
    }

    .detalle-table td,
    .detalle-table th {
        padding: 0.5rem 0.75rem;
        vertical-align: middle;
    }

    .detalle-table tbody tr:hover {
        background-color: rgba(230, 51, 117, 0.04);
    }

    .detalle-table tfoot td {
        background-color: #f8f9fa;
        font-weight: 700;
        border-top: 2px solid #dee2e6;
    }

    .detalle-resumen {
        display: flex;
        gap: 1.5rem;
        padding: 0.75rem 1rem;
        background: #f8f9fa;
        border-radius: 8px;
        margin-bottom: 1rem;
        flex-wrap: wrap;
    }

    .detalle-resumen-item {
        font-size: 0.85rem;
    }

    .detalle-resumen-item strong {
        font-weight: 700;
    }

    .detalle-amount-primary {
        color: var(--brand-primary);
    }

    .detalle-amount-success {
        color: #198754;
    }

    .detalle-amount-danger {
        color: #dc3545;
    }

    /* ===== Section Divider ===== */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin: 3rem 0 2rem 0;
        padding: 0 1rem;
    }

    .section-divider-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(90deg, transparent 0%, var(--brand-primary) 50%, transparent 100%);
        position: relative;
    }

    .section-divider-line::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
        height: 8px;
        background: var(--brand-primary);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(230, 51, 117, 0.1);
    }

    .section-divider-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
    }

    .section-divider-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        letter-spacing: -0.01em;
    }

    .section-divider-title i {
        font-size: 1.75rem;
        color: var(--brand-primary);
    }

    .section-divider-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.5rem;
        height: 2.5rem;
        padding: 0 0.75rem;
        background: linear-gradient(135deg, var(--brand-primary) 0%, #c92a5f 100%);
        color: var(--white);
        font-size: 0.875rem;
        font-weight: 700;
        border-radius: 50px;
        box-shadow: 0 4px 12px rgba(230, 51, 117, 0.3);
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 4px 12px rgba(230, 51, 117, 0.3);
        }
        50% {
            transform: scale(1.05);
            box-shadow: 0 6px 16px rgba(230, 51, 117, 0.4);
        }
    }

    /* ===== Quick Access Grid ===== */
    .quick-access-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .quick-access-item {
        min-width: 0;
    }

    .quick-access-link {
        display: flex;
        flex-direction: column;
        height: 100%;
        text-decoration: none;
        color: inherit;
    }

    .quick-access-link:hover {
        text-decoration: none;
        color: inherit;
    }

    .quick-access-link .modern-card {
        flex: 1;
        transition: all 0.3s ease;
    }

    .quick-access-link:hover .modern-card {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    .modern-card-description {
        font-size: 0.8rem;
        color: var(--text-secondary);
        margin: 0 0 0.75rem 0;
        line-height: 1.45;
    }

    /* ===== Responsive ===== */
    @@media (max-width: 768px) {
        .section-divider {
            margin: 2rem 0 1.5rem 0;
            gap: 1rem;
        }

        .section-divider-title {
            font-size: 1.25rem;
        }

        .section-divider-title i {
            font-size: 1.5rem;
        }

        .section-divider-badge {
            min-width: 2rem;
            height: 2rem;
            font-size: 0.75rem;
        }

        .quick-access-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }

        .dashboard-welcome-title {
            font-size: 1.15rem;
        }
    }

    @@media (max-width: 1400px) {
        .quick-access-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 1200px) {
        .quick-access-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 576px) {
        .quick-access-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@* Banner flotante moderno - Oculto por defecto, se muestra solo cuando hay viajes por vencer *@
<div>
    <div class="bnn_floating-banner hidden" id="banner" style="display: none !important;">
        <button class="bnn_close-banner" onclick="closeBanner()" aria-label="Cerrar"><span>&times;</span></button>
        <div style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
            <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                <i class="bi bi-clock-history" style="color: var(--brand-primary);"></i>
                Viajes Próximos a Salir
            </h3>
        </div>
        <ul id="banner-list" style="list-style: none; padding: 0; margin: 0;"></ul>
    </div>

    <script>
        const BANNER_DISMISS_KEY = "mat.banner.viajesPorVencer.dismissUntil";
        const BANNER_DISMISS_HOURS = 12;

        function closeBanner() {
            const banner = document.getElementById('banner');
            banner.style.display = 'none';
            banner.classList.add('hidden');
            try {
                const until = Date.now() + (BANNER_DISMISS_HOURS * 60 * 60 * 1000);
                localStorage.setItem(BANNER_DISMISS_KEY, String(until));
            } catch (e) { }
        }

        function isBannerDismissed() {
            try {
                const raw = localStorage.getItem(BANNER_DISMISS_KEY);
                if (!raw) return false;
                const until = parseInt(raw, 10);
                return !isNaN(until) && until > Date.now();
            } catch (e) {
                return false;
            }
        }

        function parseNetDate(dateString) {
            if (!dateString) return null;
            if (typeof dateString === "string") {
                const m = /\/Date\((\d+)\)\//.exec(dateString);
                if (m && m[1]) return new Date(parseInt(m[1], 10));
            }
            const d = new Date(dateString);
            return isNaN(d.getTime()) ? null : d;
        }

        function formatDateDiff(dateString) {
            const targetDate = parseNetDate(dateString);
            if (!targetDate) return null;
            const today = new Date();
            const t0 = new Date(today.getFullYear(), today.getMonth(), today.getDate());
            const t1 = new Date(targetDate.getFullYear(), targetDate.getMonth(), targetDate.getDate());
            const diffTime = t1.getTime() - t0.getTime();
            return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        }

        function openDetalleModal(tipo) {
            const modal = new bootstrap.Modal(document.getElementById('dashboardDetalleModal'));
            const body = document.getElementById('dashboardDetalleBody');
            const title = document.getElementById('dashboardDetalleModalLabel');

            body.innerHTML = '<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div><p class="mt-2 text-muted">Cargando detalle...</p></div>';

            const urlMap = {
                'presupuestos': '/Home/GetPresupuestosDetalle',
                'clientes': '/Home/GetClientesNuevosDetalle',
                'ventas': '/Home/GetVentasDetalle'
            };

            const titleMap = {
                'presupuestos': 'Presupuestos del Mes',
                'clientes': 'Clientes Nuevos del Mes',
                'ventas': 'Ventas Realizadas del Mes'
            };

            title.textContent = titleMap[tipo] || 'Detalle';
            modal.show();

            $.ajax({
                url: urlMap[tipo],
                dataType: 'json',
                success: function (response) {
                    if (response.success && response.data) {
                        body.innerHTML = renderDetalle(tipo, response.data);
                    } else {
                        body.innerHTML = '<div class="alert alert-warning">No se pudieron obtener los datos: ' + (response.message || '') + '</div>';
                    }
                },
                error: function () {
                    body.innerHTML = '<div class="alert alert-danger">Error al cargar los datos.</div>';
                }
            });
        }

        function renderDetalle(tipo, data) {
            if (!data || data.length === 0) {
                return '<div class="alert alert-info">No hay registros para el mes actual.</div>';
            }

            if (tipo === 'presupuestos') {
                let html = '<div class="detalle-resumen"><div class="detalle-resumen-item"><strong>' + data.length + '</strong> presupuestos</div></div>';
                html += '<div class="table-responsive"><table class="table table-sm table-bordered detalle-table"><thead><tr>';
                html += '<th>Codigo</th><th>Cliente</th><th>DNI</th><th>Monto</th><th>Estado</th><th>Fecha</th><th>Viaje</th><th>Vendedor</th>';
                html += '</tr></thead><tbody>';
                for (let i = 0; i < data.length; i++) {
                    const p = data[i];
                    html += '<tr>';
                    html += '<td>' + escapeHtml(p.CodigoSeguimiento) + '</td>';
                    html += '<td>' + escapeHtml(p.NombreCliente) + '</td>';
                    html += '<td>' + escapeHtml(p.DniCliente) + '</td>';
                    html += '<td class="text-end">$' + formatNumber(p.MontoPactado) + '</td>';
                    html += '<td>' + escapeHtml(p.Estado) + '</td>';
                    html += '<td>' + escapeHtml(p.FechaCreacion) + '</td>';
                    html += '<td>' + escapeHtml(p.ViajeDescripcion || '') + '</td>';
                    html += '<td>' + escapeHtml(p.VendedorOrigenNombre || '') + '</td>';
                    html += '</tr>';
                }
                html += '</tbody></table></div>';
                return html;
            }

            if (tipo === 'clientes') {
                let html = '<div class="detalle-resumen"><div class="detalle-resumen-item"><strong>' + data.length + '</strong> clientes nuevos</div></div>';
                html += '<div class="table-responsive"><table class="table table-sm table-bordered detalle-table"><thead><tr>';
                html += '<th>Nombre</th><th>Documento</th><th>Celular</th><th>Email</th><th>1ra Factura</th><th>Vendedor</th>';
                html += '</tr></thead><tbody>';
                for (let i = 0; i < data.length; i++) {
                    const c = data[i];
                    html += '<tr>';
                    html += '<td>' + escapeHtml(c.ClienteNombre) + '</td>';
                    html += '<td>' + escapeHtml(c.NroDocumento) + '</td>';
                    html += '<td>' + escapeHtml(c.Celular) + '</td>';
                    html += '<td>' + escapeHtml(c.Email) + '</td>';
                    html += '<td>' + escapeHtml(c.PrimeraFactura) + '</td>';
                    html += '<td>' + escapeHtml(c.VendedorNombre || '') + '</td>';
                    html += '</tr>';
                }
                html += '</tbody></table></div>';
                return html;
            }

            if (tipo === 'ventas') {
                let totalFact = 0, totalPag = 0, totalSaldo = 0;
                for (let i = 0; i < data.length; i++) {
                    totalFact += data[i].TotalFactura || 0;
                    totalPag += data[i].MontoPagado || 0;
                    totalSaldo += data[i].Saldo || 0;
                }
                let html = '<div class="detalle-resumen">';
                html += '<div class="detalle-resumen-item"><strong>' + data.length + '</strong> facturas</div>';
                html += '<div class="detalle-resumen-item">Total Facturado: <strong class="detalle-amount-primary">$' + formatNumber(totalFact) + '</strong></div>';
                html += '<div class="detalle-resumen-item">Total Cobrado: <strong class="detalle-amount-success">$' + formatNumber(totalPag) + '</strong></div>';
                html += '<div class="detalle-resumen-item">Pendiente: <strong class="detalle-amount-danger">$' + formatNumber(totalSaldo) + '</strong></div>';
                html += '</div>';
                html += '<div class="table-responsive"><table class="table table-sm table-bordered detalle-table"><thead><tr>';
                html += '<th>Fecha</th><th>Cliente</th><th>Vendedor</th><th>Viaje</th><th>Salida</th><th>Butacas</th><th>Estado</th><th class="text-end">Facturado</th><th class="text-end">Pagado</th><th class="text-end">Saldo</th>';
                html += '</tr></thead><tbody>';
                for (let i = 0; i < data.length; i++) {
                    const v = data[i];
                    const saldoClass = (v.Saldo > 0) ? ' class="detalle-amount-danger fw-semibold"' : '';
                    html += '<tr>';
                    html += '<td>' + escapeHtml(v.FacturaFecha) + '</td>';
                    html += '<td>' + escapeHtml(v.ClienteFullName) + '</td>';
                    html += '<td>' + escapeHtml(v.VendedorFullName) + '</td>';
                    html += '<td>' + escapeHtml(v.ViajeDescripcion) + '</td>';
                    html += '<td>' + escapeHtml(v.FechaSalida) + '</td>';
                    html += '<td class="text-center">' + v.CantidadButacas + '</td>';
                    html += '<td>' + escapeHtml(v.FacturaEstado) + '</td>';
                    html += '<td class="text-end">$' + formatNumber(v.TotalFactura) + '</td>';
                    html += '<td class="text-end">$' + formatNumber(v.MontoPagado) + '</td>';
                    html += '<td class="text-end"' + saldoClass + '>$' + formatNumber(v.Saldo) + '</td>';
                    html += '</tr>';
                }
                html += '</tbody>';
                html += '<tfoot>';
                html += '<tr>';
                html += '<td colspan="7" class="text-end">Totales:</td>';
                html += '<td class="text-end">$' + formatNumber(totalFact) + '</td>';
                html += '<td class="text-end">$' + formatNumber(totalPag) + '</td>';
                html += '<td class="text-end' + (totalSaldo > 0 ? ' detalle-amount-danger' : '') + '">$' + formatNumber(totalSaldo) + '</td>';
                html += '</tr>';
                html += '</tfoot>';
                html += '</table></div>';
                return html;
            }

            return '<div class="alert alert-info">Sin datos.</div>';
        }

        function escapeHtml(str) {
            if (str == null) return '';
            const div = document.createElement('div');
            div.appendChild(document.createTextNode(str));
            return div.innerHTML;
        }

        function formatNumber(num) {
            if (num == null || isNaN(num)) return '0.00';
            return parseFloat(num).toLocaleString('es-AR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        }

        $(document).ready(function () {
            const accessCount = $('.quick-access-item').length;
            $('#accessCountBadge').text(accessCount);

            if (isBannerDismissed()) {
                return;
            }

            $.ajax({
                url: "/Viaje/GetViajesPorVencer",
                data: {},
                dataType: "json",
                success: function (data) {
                    if (data && data.sMensaje) {
                        console.warn("GetViajesPorVencer:", data.sMensaje);
                        return;
                    }

                    let items = (data && Array.isArray(data.items)) ? data.items : null;
                    if (!items) {
                        let jsonData;
                        if (typeof data.sJsonResult === 'string') {
                            jsonData = JSON.parse(data.sJsonResult);
                        } else {
                            jsonData = data.sJsonResult || data;
                        }
                        if (jsonData && jsonData.Table && Array.isArray(jsonData.Table)) {
                            items = jsonData.Table;
                        }
                    }

                    if (items && Array.isArray(items) && items.length > 0) {
                        const banner = document.getElementById('banner');
                        const bannerList = document.getElementById('banner-list');

                        bannerList.innerHTML = '';

                        const MAX_ITEMS = 7;
                        items.slice(0, MAX_ITEMS).forEach(item => {
                            const daysToDeparture = (typeof item.DaysToDeparture === "number")
                                ? item.DaysToDeparture
                                : formatDateDiff(item.fechasalida || item.FechaSalida);
                            const listItem = document.createElement('li');

                            const h2 = document.createElement('h2');
                            const a = document.createElement('a');
                            a.href = "/Reserva/Index?viajeid=" + encodeURIComponent(item.ViajeID || item.ViajeId || "");
                            a.textContent = ((item.Descripcion || item.descripcion) || "").toString();
                            h2.appendChild(a);

                            const p1 = document.createElement('p');
                            if (typeof daysToDeparture === "number") {
                                p1.textContent = "A " + daysToDeparture + " días de la salida";
                            } else {
                                p1.textContent = "Próximo a salir";
                            }

                            const p2 = document.createElement('p');
                            p2.textContent = "Lugares disponibles: " + (item.Disponibles != null ? item.Disponibles : (item.disponibles != null ? item.disponibles : "-"));

                            listItem.appendChild(h2);
                            listItem.appendChild(p1);
                            listItem.appendChild(p2);

                            bannerList.appendChild(listItem);
                        });

                        if (bannerList.children.length > 0) {
                            banner.classList.remove('hidden');
                            banner.style.display = '';
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error al cargar viajes por vencer:", error);
                }
            });
        });
    </script>
</div>
