@{
    Response.ContentType = "text/html; charset=utf-8";
    Response.Charset = "utf-8";
    ViewBag.Title = "Panel Principal";
    Layout = "~/Views/Shared/_Layout.cshtml";
    
    var estadisticas = ViewBag.Estadisticas as Dictionary<string, object> ?? new Dictionary<string, object>();
    var totalPorCobrar = estadisticas.ContainsKey("TotalPorCobrar") ? Convert.ToDouble(estadisticas["TotalPorCobrar"]) : 0.0;
    var cantidadPresupuestos = estadisticas.ContainsKey("CantidadPresupuestos") ? Convert.ToInt32(estadisticas["CantidadPresupuestos"]) : 0;
    var clientesNuevos = estadisticas.ContainsKey("ClientesNuevos") ? Convert.ToInt32(estadisticas["ClientesNuevos"]) : 0;
    var totalVentas = estadisticas.ContainsKey("TotalVentas") ? Convert.ToDouble(estadisticas["TotalVentas"]) : 0.0;
    var cantidadVentas = estadisticas.ContainsKey("CantidadVentas") ? Convert.ToInt32(estadisticas["CantidadVentas"]) : 0;
    
    var mesActual = System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(DateTime.Now.Month);
    var añoActual = DateTime.Now.Year;
}

<div class="modern-dashboard">
    <div class="container-fluid">
        <!-- Estadísticas del Mes -->
        <div class="row g-4 mb-4">
            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-primary">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Total por Cobrar</div>
                        <i class="bi bi-currency-dollar modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">$@totalPorCobrar.ToString("N2")</div>
                        <p class="modern-stat-label">Saldo pendiente del mes</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-success">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Presupuestos</div>
                        <i class="bi bi-file-earmark-text modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@cantidadPresupuestos</div>
                        <p class="modern-stat-label">Presupuestos del mes</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-warning">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Clientes Nuevos</div>
                        <i class="bi bi-people modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@clientesNuevos</div>
                        <p class="modern-stat-label">Nuevos clientes del mes</p>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6">
                <div class="modern-card modern-card-info">
                    <div class="modern-card-header">
                        <div class="modern-card-title">Ventas Realizadas</div>
                        <i class="bi bi-cart-check modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <div class="modern-stat-number">@cantidadVentas</div>
                        <p class="modern-stat-label">Total: $@totalVentas.ToString("N2")</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Separador Visual -->
        <div class="section-divider">
            <div class="section-divider-line"></div>
            <div class="section-divider-content">
                <h3 class="section-divider-title">
                    <i class="bi bi-grid-3x3-gap"></i>
                    Accesos Rápidos
                </h3>
                <span class="section-divider-badge" id="accessCountBadge">9</span>
            </div>
            <div class="section-divider-line"></div>
        </div>

        <!-- Accesos Rápidos -->
        <div class="quick-access-grid">
            <!-- Primera Fila -->
            <div class="quick-access-item">
                <div class="modern-card modern-card-success" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Presupuesto/Index'" title="Gestiona presupuestos telefónicos y cotizaciones.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Módulo de Presupuestos
                        </div>
                        <i class="bi bi-file-earmark-text modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Presupuesto/Index" class="modern-card-link">
                            Ir a presupuestos <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="quick-access-item">
                <div class="modern-card modern-card-primary" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Viaje/Index'" title="Administra viajes, reservas y disponibilidad.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Gestión de Viajes
                        </div>
                        <i class="bi bi-airplane modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Viaje/Index" class="modern-card-link">
                            Ver gestión <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="quick-access-item">
                <div class="modern-card modern-card-warning" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Home/ViajesPorFecha'" title="Consulta viajes disponibles por fecha específica.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Viajes por Fecha
                        </div>
                        <i class="bi bi-calendar-event modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Home/ViajesPorFecha" class="modern-card-link">
                            Ver viajes <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="quick-access-item">
                <div class="modern-card modern-card-info" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Home/TodosLosViajesIndex'" title="Visualiza todos los viajes disponibles en el sistema.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Todos los Viajes
                        </div>
                        <i class="bi bi-suitcase modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Home/TodosLosViajesIndex" class="modern-card-link">
                            Ver todos <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="quick-access-item">
                <div class="modern-card modern-card-success" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Paquete/Index'" title="Administra paquetes turísticos y sus configuraciones.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Gestión de Paquetes
                        </div>
                        <i class="bi bi-box-seam modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Paquete/Index" class="modern-card-link">
                            Ver paquetes <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Segunda Fila -->
            <div class="quick-access-item">
                <div class="modern-card modern-card-primary" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Busqueda/Perfil'" title="Busca clientes y perfiles en el sistema.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Búsqueda de Perfiles
                        </div>
                        <i class="bi bi-search modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Busqueda/Perfil" class="modern-card-link">
                            Buscar perfiles <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="quick-access-item">
                <div class="modern-card modern-card-warning" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Factura/Index'" title="Consulta y gestiona facturas del sistema.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Búsqueda de Facturas
                        </div>
                        <i class="bi bi-receipt modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/Factura/Index" class="modern-card-link">
                            Ver facturas <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            <div class="quick-access-item">
                <div class="modern-card modern-card-info" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/PersonaCliente/NotaCreditoList'" title="Gestiona notas de crédito y devoluciones.">
                    <div class="modern-card-header">
                        <div class="modern-card-title">
                            Notas de Crédito
                        </div>
                        <i class="bi bi-file-earmark-text modern-card-icon-small"></i>
                    </div>
                    <div class="modern-card-content">
                        <a href="/PersonaCliente/NotaCreditoList" class="modern-card-link">
                            Ver notas <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>

            @if (User.Identity.Name.ToUpper().Equals("ADMINDEV"))
            {
                <div class="quick-access-item">
                    <div class="modern-card modern-card-success" style="cursor: pointer; transition: all 0.3s ease;" onclick="window.location.href='/Home/HistorialPagos'" title="Consulta el historial completo de pagos.">
                        <div class="modern-card-header">
                            <div class="modern-card-title">
                                Historial de Pagos
                            </div>
                            <i class="bi bi-clock-history modern-card-icon-small"></i>
                        </div>
                        <div class="modern-card-content">
                            <a href="/Home/HistorialPagos" class="modern-card-link">
                                Ver historial <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .modern-stat-number {
        font-size: 2.5rem;
        font-weight: 700;
        color: var(--brand-primary);
        line-height: 1.2;
        margin-bottom: 0.5rem;
    }

    .modern-stat-label {
        font-size: 0.875rem;
        color: var(--text-secondary);
        margin: 0;
    }

    .modern-card-icon-large {
        font-size: 3rem;
        opacity: 0.1;
        position: absolute;
        right: 1.5rem;
        top: 50%;
        transform: translateY(-50%);
    }

    .modern-card[onclick]:hover {
        transform: translateY(-4px);
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
    }

    /* Separador Visual entre Secciones */
    .section-divider {
        display: flex;
        align-items: center;
        gap: 1.5rem;
        margin: 3rem 0 2rem 0;
        padding: 0 1rem;
    }

    .section-divider-line {
        flex: 1;
        height: 2px;
        background: linear-gradient(90deg, transparent 0%, var(--brand-primary) 50%, transparent 100%);
        position: relative;
    }

    .section-divider-line::before {
        content: '';
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: 8px;
        height: 8px;
        background: var(--brand-primary);
        border-radius: 50%;
        box-shadow: 0 0 0 4px rgba(230, 51, 117, 0.1);
    }

    .section-divider-content {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-shrink: 0;
    }

    .section-divider-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-primary);
        margin: 0;
        letter-spacing: -0.01em;
    }

    .section-divider-title i {
        font-size: 1.75rem;
        color: var(--brand-primary);
    }

    .section-divider-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 2.5rem;
        height: 2.5rem;
        padding: 0 0.75rem;
        background: linear-gradient(135deg, var(--brand-primary) 0%, #c92a5f 100%);
        color: var(--white);
        font-size: 0.875rem;
        font-weight: 700;
        border-radius: 50px;
        box-shadow: 0 4px 12px rgba(230, 51, 117, 0.3);
        animation: pulse 2s ease-in-out infinite;
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            box-shadow: 0 4px 12px rgba(230, 51, 117, 0.3);
        }
        50% {
            transform: scale(1.05);
            box-shadow: 0 6px 16px rgba(230, 51, 117, 0.4);
        }
    }

    @@media (max-width: 768px) {
        .section-divider {
            margin: 2rem 0 1.5rem 0;
            gap: 1rem;
        }

        .section-divider-title {
            font-size: 1.25rem;
        }

        .section-divider-title i {
            font-size: 1.5rem;
        }

        .section-divider-badge {
            min-width: 2rem;
            height: 2rem;
            font-size: 0.75rem;
        }
    }

    /* Grid de 5 columnas para accesos rápidos */
    .quick-access-grid {
        display: grid;
        grid-template-columns: repeat(5, 1fr);
        gap: 1.5rem;
        margin-bottom: 2rem;
    }

    .quick-access-item {
        min-width: 0;
    }

    .quick-access-item .modern-card {
        height: 100%;
    }

    @@media (max-width: 1400px) {
        .quick-access-grid {
            grid-template-columns: repeat(4, 1fr);
        }
    }

    @@media (max-width: 1200px) {
        .quick-access-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 768px) {
        .quick-access-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 1rem;
        }
    }

    @@media (max-width: 576px) {
        .quick-access-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

@* Banner flotante moderno - Oculto por defecto, se muestra solo cuando hay viajes por vencer *@
<div>
    <div class="bnn_floating-banner hidden" id="banner" style="display: none !important;">
        <button class="bnn_close-banner" onclick="closeBanner()" aria-label="Cerrar"><span>&times;</span></button>
        <div style="margin-bottom: 1rem; padding-bottom: 1rem; border-bottom: 1px solid var(--border-color);">
            <h3 style="margin: 0; font-size: 1.125rem; font-weight: 600; color: var(--text-primary); display: flex; align-items: center; gap: 0.5rem;">
                <i class="bi bi-clock-history" style="color: var(--brand-primary);"></i>
                Viajes Próximos a Salir
            </h3>
        </div>
        <ul id="banner-list" style="list-style: none; padding: 0; margin: 0;"></ul>
    </div>

    <script>
        function closeBanner() {
            const banner = document.getElementById('banner');
            banner.style.display = 'none';
            banner.classList.add('hidden');
        }

        function formatDateDiff(dateString) {
            const today = new Date();
            const targetDate = new Date(dateString);
            const diffTime = targetDate - today;
            return Math.ceil(diffTime / (1000 * 60 * 60 * 24));
        }

        $(document).ready(function() {
            // Contar dinámicamente el número de accesos rápidos
            var accessCount = $('.quick-access-item').length;
            $('#accessCountBadge').text(accessCount);

            $.ajax({
                url: "/Viaje/GetViajesPorVencer",
                data: {},
                dataType: "json",
                success: function (data) {
                    // jQuery 3.x puede devolver el JSON ya parseado
                    // Verificar si data.sJsonResult es string o ya es objeto
                    let jsonData;
                    if (typeof data.sJsonResult === 'string') {
                        jsonData = JSON.parse(data.sJsonResult);
                    } else {
                        jsonData = data.sJsonResult || data;
                    }

                    // Verificar que Table exista y tenga elementos
                    if (jsonData && jsonData.Table && Array.isArray(jsonData.Table) && jsonData.Table.length > 0) {
                        const banner = document.getElementById('banner');
                        const bannerList = document.getElementById('banner-list');
                        
                        // Limpiar la lista antes de agregar elementos
                        bannerList.innerHTML = '';
                        
                        jsonData.Table.forEach(item => {
                            const daysToDeparture = formatDateDiff(item.fechasalida);
                            const listItem = document.createElement('li');

                            listItem.innerHTML = `
                                <h2><a href="/Reserva/Index?viajeid=${item.ViajeID}">${item.descripcion}</a></h2>
                                <p>A ${daysToDeparture} días de la salida</p>
                                <p>Lugares disponibles: ${item.Disponibles}</p>
                                `;

                            bannerList.appendChild(listItem);
                        });

                        // Mostrar el banner solo si hay elementos
                        if (bannerList.children.length > 0) {
                            banner.classList.remove('hidden');
                            banner.style.display = '';
                        }
                    }
                },
                error: function (xhr, status, error) {
                    console.error("Error al cargar viajes por vencer:", error);
                }
            });
        });
    </script>
</div>
