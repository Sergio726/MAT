@{
    ViewBag.Title = "Viajes por Fecha";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-dashboard">
    <div class="modern-dashboard-header">
        <h2>Viajes por Fecha <span>Selecciona una fecha en el calendario para ver los viajes disponibles</span></h2>
    </div>

    <div class="container-fluid">
        <div class="row g-4">
            <div class="col-lg-4 col-md-5">
                <div class="modern-calendar-container">
                    <div id="calendar_vendedor"></div>
                </div>
            </div>
            <div class="col-lg-8 col-md-7">
                <div class="modern-viajes-container">
                    <section id="Viajes" class="Viajes-Fecha">
                    </section>
                </div>
            </div>
        </div>
    </div>
</div>

<script type="text/javascript">
    $(function () {
        var array = ["2015-06-23", "2015-06-19", "2015-06-25"];
        var fechas = new Array();
        $.ajax({
            url: "/Home/GetFechasDeViajes",
            async: false,
            success: function (data) {
                fechas = data.split(',');
                console.log(fechas);
            }
        });
        $("#calendar_vendedor").datepicker({
            dateFormat: 'dd/mm/yy',
            onSelect: function () {
                var date = escape($(this).datepicker().val());
                console.log(date);
                var url = "/Home/GetViajes?fecha=" + date;
                $("#Viajes").load(url);
                $("ul.viajes-lista").quickPagination({ pageSize: '4' });
            },
            beforeShowDay: function (date) {
                console.log(fechas);
                if ($.inArray($.datepicker.formatDate('yy-mm-dd', date), fechas) > -1) {
                    arr = [true, "", "No disponible"];
                }
                else {
                    arr = [false, '', "Disponible"];
                }
                return arr;
            }
        });
    });
</script>
