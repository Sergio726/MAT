@*@model List<MAT.MVC.Models.PaqueteModel>*@
@model List<MAT.MVC.Models.ViajeModel>

<section id="Viajes" class="Viajes-Default">
    <ul class="viajes-lista">
        @foreach (var item in Model)
        {
            <li data-image="">
                <a href='#' class='btn_viaje' data-id="@item.ViajeID">
                    <div class="viaje-container">
                        <h4>@item.PaqueteNombre</h4>
                        @if (!string.IsNullOrEmpty(item.Descripcion))
                        {
                            <h5>@item.Descripcion</h5>
                        }
                        else
                        {
                            <h5>-</h5>
                        }
                        <h5>Destino: @item.Descripcion</h5>
                        <h5>Salida: @item.FechaSalida.ToString()</h5>
                    </div>
                </a>
            </li>

        }
    </ul>
</section>
<script>
    $('ul.viajes-lista').quickPagination({ pageSize: '4' })
    $(".viajes-lista li").each(function () {
        $(this).css("background-image", "url(" + $(this).data("image") + ")");
    });
</script>
