@*@model List<MAT.MVC.Models.PaqueteModel>*@
@model List<MAT.MVC.Models.ViajeModel>

<section id="Viajes" class="Viajes-Default modern-viajes-container">
    <ul class="viajes-lista">
        @foreach (var item in Model)
        {
            var textoCompleto = string.Format("{0} {1} {2} salida {3}",
                item.PaqueteNombre ?? "",
                item.Descripcion ?? "",
                item.Origen ?? "",
                item.FechaSalida ?? "").ToLowerInvariant();
            <li class="viaje-card" data-searchable="@Html.Raw(HttpUtility.HtmlAttributeEncode(textoCompleto))">
                <a href="#" class="btn_viaje" data-id="@item.ViajeID">
                    <div class="viaje-container">
                        <h4 class="viaje-titulo">@(item.PaqueteNombre ?? "-")</h4>
                        @if (!string.IsNullOrEmpty(item.Descripcion))
                        {
                            <p class="viaje-descripcion">@item.Descripcion</p>
                        }
                        @if (!string.IsNullOrEmpty(item.Origen))
                        {
                            <p class="viaje-origen"><span class="viaje-meta-label">Origen:</span> @item.Origen</p>
                        }
                        <div class="viaje-salida-wrap">
                            <span class="viaje-meta-label">Salida</span>
                            <span class="viaje-fecha-badge">@(item.FechaSalida ?? "-")</span>
                        </div>
                    </div>
                </a>
            </li>
        }
    </ul>
</section>
<script>
    $(function () {
        var $ul = $('#viajes-item ul.viajes-lista');
        if ($ul.length) {
            $ul.quickPagination({ pageSize: 4 });
        }
        $("#viajes-item .viajes-lista li").each(function () {
            var img = $(this).data("image");
            if (img) $(this).css("background-image", "url(" + img + ")");
        });
    });
</script>
