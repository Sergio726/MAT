@model List<MAT.MVC.Models.PaqueteModel>

<section id="Viajes" class="Viajes-Default">
    <ul class="viajes-lista">
        @foreach (var item in Model)
        {            
            <li data-image="@item.Paquete.Foto">
                <a href='#' class='btn_viaje' data-id="@item.Viaje.ViajeId">
                    <div class="viaje-container">
                        <h4>@item.Paquete.Descripcion</h4>
                        @if (!string.IsNullOrEmpty(item.Viaje.Descripcion))
                        {
                            <h5>@item.Viaje.Descripcion</h5>
                        }
                        else
                        {
                            <h5>-</h5>
                        }
                        <h5>Destino: @item.Destino.Nombre</h5>
                        <h5>Salida: @item.Viaje.FechaSalida.Value.ToString("dd-MMMM-yyyy")</h5>
                    </div>
                </a>
            </li>
            
        }
    </ul>
</section>
<script>
    $('ul.viajes-lista').quickPagination({ pageSize: '4' })
    $(".viajes-lista li").each(function () {
        $(this).css("background-image", "url(" + $(this).data("image") + ")");
    });
</script>
