@model MAT.Entities.Servicio
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Nuevo Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-cone-striped"></i>
            <span>Nuevo Servicio</span>
        </h2>
    </div>

    <div class="modern-form-container">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger" })

            <div class="modern-form-grid">
                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-tag"></i>
                        @Html.LabelFor(model => model.Descripcion)
                    </label>
                    @Html.TextBoxFor(model => model.Descripcion, new { @class = "modern-form-input", placeholder = "Descripción del servicio" })
                    @Html.ValidationMessageFor(model => model.Descripcion, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-currency-dollar"></i>
                        @Html.LabelFor(model => model.Precio)
                    </label>
                    @Html.TextBoxFor(model => model.Precio, new { @class = "modern-form-input", type = "number", step = "0.01", min = "0", placeholder = "0.00" })
                    @Html.ValidationMessageFor(model => model.Precio, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-cash-coin"></i>
                        @Html.LabelFor(model => model.Moneda)
                    </label>
                    <select id="Moneda" name="Moneda" class="modern-form-select">
                        @foreach (MAT.MVC.Models.MonedaTipo item in MAT.MVC.Models.MonedaMethod.GetMonedaTipoAll())
                        {
                            <option value="@item.Id" @(item.Id == 1 ? "selected" : "")>@item.Descripcion.ToString().ToUpper() (@item.Codigo)</option>
                        }
                    </select>
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-building"></i>
                        Proveedor
                    </label>
                    @Html.DropDownListFor(model => model.ProveedorId, Helper.ToSelectEntities("Proveedor"), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.ProveedorId, "", new { @class = "text-danger" })
                </div>

                <div class="modern-form-group">
                    <label class="modern-form-label">
                        <i class="bi bi-check-square"></i>
                        <span>Coche</span>
                    </label>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        @Html.CheckBox("chk_transporte", false, new { @style = "width: 20px; height: 20px; cursor: pointer;" })
                        <span>Asociar a transporte</span>
                    </div>
                </div>

                <div class="modern-form-group" id="transporte-group" style="display: none;">
                    <label class="modern-form-label">
                        <i class="bi bi-bus-front"></i>
                        Transporte
                    </label>
                    @Html.DropDownListFor(model => model.TransporteId, Helper.ToSelectEntities("Transporte"), new { @class = "modern-form-select" })
                    @Html.ValidationMessageFor(model => model.TransporteId, "", new { @class = "text-danger" })
                </div>
            </div>

            <div class="modern-form-actions">
                <button type="button" class="btn-modern btn-modern-secondary" onclick="location.href='@Url.Action("Index", "Servicio")'">
                    <i class="bi bi-arrow-left"></i>
                    <span>Volver a la Lista</span>
                </button>
                <button type="submit" class="btn-modern btn-modern-primary">
                    <i class="bi bi-check-circle"></i>
                    <span>Crear Servicio</span>
                </button>
            </div>
        }
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script type="text/javascript">
    $(document).ready(function () {
        $("input[type=number]").attr("min", 0);

        // Habilitar/deshabilitar select de transporte según checkbox
        $("#chk_transporte").on("change", function () {
            if ($(this).is(":checked")) {
                $("#transporte-group").slideDown();
                $("select[name='TransporteId']").prop("disabled", false);
            } else {
                $("#transporte-group").slideUp();
                $("select[name='TransporteId']").prop("disabled", true).val("");
            }
        });
    });
</script>
