@model MAT.Entities.Servicio
@using MAT.Enums
@using MAT.Utilities
@{
    ViewBag.Title = "Nuevo Servicio";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">Nuevo Servicio</h2>

@if (ViewBag.Error != null)
{
    <div class="msgError"><span>@ViewBag.Error</span></div>    
}


@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="form">

        <div class="form-label">
            @Html.LabelFor(model => model.Descripcion)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Descripcion)
            @Html.ValidationMessageFor(model => model.Descripcion)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Precio)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Precio)
            @Html.ValidationMessageFor(model => model.Precio)
        </div>

        <div class="form-label">
            @Html.LabelFor(model => model.Moneda)
        </div>
        <div class="form-field">
            <select id="Moneda" name="Moneda">
                @foreach (MAT.MVC.Models.MonedaTipo item in MAT.MVC.Models.MonedaMethod.GetMonedaTipoAll())
                {
                    <option value="@item.Id" @(item.Id == 1 ? "selected" : "") >@item.Descripcion.ToString().ToUpper() ( @(item.Codigo))</option>
                }
            </select>
        </div>
        

        <div class="form-label">
            Proveedor
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.ProveedorId, Helper.ToSelectEntities("Proveedor"))
            @Html.ValidationMessageFor(model => model.ProveedorId)
        </div>

        <div class="form-label">
            @Html.CheckBox("chk_transporte", false)
            Coche
        </div>
        <div class="form-field">
            @Html.DropDownListFor(model => model.TransporteId, Helper.ToSelectEntities("Transporte"))
            @Html.ValidationMessageFor(model => model.TransporteId)
        </div>

        <p class="botonera-form">
            <input type="submit" value="Crear" class="btn btn-inverse btn-small" />
            <input type="button" value="Volver a la lista" class="btn btn-inverse btn-small" onclick="location.href='@Url.Action("Index", "Servicio")'" />
        </p>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
    $("select[name='TransporteId']").attr("disabled", true);
    $("select[name='HotelId']").attr("disabled", true);
</script>
