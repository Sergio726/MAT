@model MAT.Entities.Servicio
@using MAT.Utilities
@using MAT.Enums

@{
    ViewBag.Title = "Edit";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<h2 class="title">Editar Servicio</h2>

@using (Html.BeginForm()) {
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true)

    <div class="form">    
        <div class="form-label">
            @Html.LabelFor(model => model.Descripcion)
        </div>
        <div class="form-field">
            @Html.EditorFor(model => model.Descripcion)
            @Html.ValidationMessageFor(model => model.Descripcion)
        </div>        

        <div class="form-label">
            Proveedor
        </div>
        <div class="form-field">
            @if (Model.ProveedorId.HasValue)
            {
              @Html.DropDownListFor(model => model.ProveedorId, Helper.ToSelectEntities("Proveedor",Model.ProveedorId.Value))  
            } else {
             @Html.DropDownListFor(model => model.ProveedorId, Helper.ToSelectEntities("Proveedor"))   
            }
            @Html.ValidationMessageFor(model => model.ProveedorId)
        </div>

        <div class="form-label">
            @if (Model.TransporteId.HasValue)
            {
                @Html.CheckBox("chk_transporte", true) 
            }  else{
              @Html.CheckBox("chk_transporte", false)   
            }
            Coche
        </div>
        <div class="form-field">
            @if (Model.TransporteId.HasValue)
            {
            @Html.DropDownListFor(model => model.TransporteId, Helper.ToSelectEntities("Transporte",Model.TransporteId.Value))    
            } else {
             @Html.DropDownListFor(model => model.TransporteId, Helper.ToSelectEntities("Transporte"))   
            }
            
            @Html.ValidationMessageFor(model => model.TransporteId)
        </div>

        <p class="botonera-form">
            <input class="btn btn-inverse btn-small" type="submit" value="Guardar" />
            <a class="btn btn-inverse btn-small" href="/Servicio/Index">Lista de Servicios</a>
        </p>
    </div>
}

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}

<script>
    if ($("input[name='chk_transporte']").is(":checked")) {
        $("select[name='TransporteId']").attr("disabled", false);
    } else {
        $("select[name='TransporteId']").attr("disabled", true);
    }

    if ($("input[name='chk_hotel']").is(":checked")) {
        $("select[name='HotelId']").attr("disabled", false);
    } else {
        $("select[name='HotelId']").attr("disabled", true);
    }
</script>