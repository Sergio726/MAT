@model IEnumerable<MAT.MVC.Models.ServicioModel>
@using MAT.Enums
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="modern-page-container">
    <div class="modern-page-header">
        <h2 class="modern-page-title">
            <i class="bi bi-cone-striped"></i>
            <span>Servicios</span>
        </h2>
        <div class="modern-page-actions">
            <a href="/Servicio/Create" class="btn-modern btn-modern-primary">
                <i class="bi bi-plus-circle"></i>
                <span>Agregar Servicio</span>
            </a>
        </div>
    </div>

    @if (ViewBag.Error != null)
    {
        <div class="modern-alert-error">
            <i class="bi bi-exclamation-circle"></i>
            <span>Error al cargar página. @ViewBag.Error</span>
        </div>
    }

    <div class="modern-table-container">
        <table class="modern-table" id="tblServices">
            <thead>
                <tr>
                    <th>Descripción</th>
                    <th>Precio</th>
                    <th>Moneda</th>
                    <th style="width: 100px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <strong>@item.Descripcion</strong>
                        </td>
                        <td>
                            @if (item.Precio.HasValue)
                            {
                                if (item.Moneda == "PES" || item.Moneda == "ARS")
                                {
                                    <span class="badge badge-pesos">$@item.Precio.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="badge badge-dolares">U$S@item.Precio.Value.ToString("N2")</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted">-</span>
                            }
                        </td>
                        <td>
                            @item.Moneda
                        </td>
                        <td>
                            <div class="modern-table-actions">
                                <a href="/Servicio/Edit/@item.ServicioID" class="modern-btn-icon modern-btn-icon-edit" title="Editar">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <a href="#" class="modern-btn-icon btn-danger-icon btn-eliminar-servicio" data-id="@item.ServicioID" title="Eliminar">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<script type="text/javascript">
    $(document).ready(function () {
        $("#tblServices").DataTable({
            pageLength: 25,
            order: [[0, 'asc']],
            language: {
                search: "Buscar:",
                lengthMenu: "Mostrar _MENU_ registros",
                info: "Mostrando _START_ a _END_ de _TOTAL_ servicios",
                infoEmpty: "No hay servicios disponibles",
                infoFiltered: "(filtrado de _MAX_ servicios totales)",
                paginate: {
                    first: "Primero",
                    last: "Último",
                    next: "Siguiente",
                    previous: "Anterior"
                }
            },
            columnDefs: [
                { orderable: false, targets: 3 }
            ]
        });
    });
</script>