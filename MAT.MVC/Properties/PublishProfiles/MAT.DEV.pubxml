<?xml version="1.0" encoding="utf-8"?>
<!--
  Publicación local a IIS (carpeta).
  Destino fijo: C:\inetpub\MAT
  Antes de publicar: Stop del Application Pool / sitio MAT en IIS
  (si no, Access Denied / DeploymentManager al intentar borrar DLLs en uso).
  Cadenas de conexión: Web.MAT.DEV.config hace que el Web.config publicado las lea de
  C:\inetpub\MAT\connectionStrings.local.config (solo en esta PC; si falta, el sitio no arranca).
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProvider>FileSystem</PublishProvider>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <SiteUrlToLaunchAfterPublish />
    <LaunchSiteAfterPublish>False</LaunchSiteAfterPublish>
    <ExcludeApp_Data>False</ExcludeApp_Data>
    <publishUrl>C:\inetpub\MAT</publishUrl>
    <PublishUrl>C:\inetpub\MAT</PublishUrl>
    <!-- False evita borrar todo el sitio; solo sobrescribe. Menos fricción con IIS. -->
    <DeleteExistingFiles>False</DeleteExistingFiles>
  </PropertyGroup>
</Project>
