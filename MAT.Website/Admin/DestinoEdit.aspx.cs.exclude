#region Imports...
using System;
using System.Data;
using System.Configuration;
using System.Collections;
using System.Web;
using System.Web.Security;
using System.Web.UI;
using System.Web.UI.WebControls;
using System.Web.UI.WebControls.WebParts;
using System.Web.UI.HtmlControls;
using MAT.Web.UI;
#endregion

public partial class DestinoEdit : System.Web.UI.Page
{
	protected void Page_Load(object sender, EventArgs e)
	{		
		FormUtil.RedirectAfterInsertUpdate(FormView1, "DestinoEdit.aspx?{0}", DestinoDataSource);
		FormUtil.RedirectAfterAddNew(FormView1, "DestinoEdit.aspx");
		FormUtil.RedirectAfterCancel(FormView1, "Destino.aspx");
		FormUtil.SetDefaultMode(FormView1, "DestinoId");
	}
	protected void GridViewPaquete1_SelectedIndexChanged(object sender, EventArgs e)
	{
		string urlParams = string.Format("PaqueteId={0}", GridViewPaquete1.SelectedDataKey.Values[0]);
		Response.Redirect("PaqueteEdit.aspx?" + urlParams, true);		
	}	
}


